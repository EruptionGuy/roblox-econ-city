	cyl(out, "pondEdge", 3.6, 0.3, 0, 0.3, -4.1, STONE, M.Cobblestone)
	cyl(out, "pond", 3, 0.32, 0, 0.3, -4.1, WATER, GLASSMAT, { transparency = 0.1, reflectance = 0.35 })
