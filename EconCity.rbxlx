<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><External>null</External><External>nil</External><Item class="Workspace" referent="RBX00000025"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="Lighting" referent="RBX00000026"><Properties><string name="Name">Lighting</string><token name="Technology">3</token></Properties></Item><Item class="ReplicatedStorage" referent="RBX00000027"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000009"><Properties><string name="Name">EconCity</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">CityEngine</string><ProtectedString name="Source"><![CDATA[-- Luật thành phố trên lưới (docs/luat-choi-moi.md mục 2-5). Hàm thuần, không gọi Roblox API: server, client (số dự kiến) và test đều dùng.
-- Bản JS: prototypes/luat-moi/engine.js. Phải tính đúng thứ tự như bên đó để ra cùng số, balance_sim so điểm 2 bên.
--
-- ô đánh số 1..N*N theo hàng: (hàng-1)*N + cột. session.cells[i] là:
--   Config.EMPTY   ô trống
--   "<id mẫu>"     ô góc trên-trái của công trình (Config.BUILDINGS[id]), hoặc "road"
--   "+<ô góc>"     ô phụ của công trình nhiều ô, vd "+37" là thuộc công trình có góc ở ô 37

local Config = require(script.Parent.Config)
local Util = require(script.Parent.Util)
local Scenarios = require(script.Parent.Scenarios)

local B = Config.BUILDINGS
local F = Config.FORMULA
local N = Config.GRID_SIZE
local EMPTY = Config.EMPTY

local CityEngine = {}

function CityEngine.newCells()
	local cells = {}
	for i = 1, N * N do
		cells[i] = EMPTY
	end
	cells[Config.GATE_INDEX] = "road"
	return cells
end

-- client gửi gì cũng có thể, nên check: số nguyên, nằm trong lưới
function CityEngine.isValidIndex(i)
	return type(i) == "number" and i == math.floor(i) and i >= 1 and i <= N * N
end

local function neighbours(i)
	local x = (i - 1) % N
	local out = {}
	if i > N then
		table.insert(out, i - N)
	end
	if i <= N * (N - 1) then
		table.insert(out, i + N)
	end
	if x > 0 then
		table.insert(out, i - 1)
	end
	if x < N - 1 then
		table.insert(out, i + 1)
	end
	return out
end
CityEngine.neighbours = neighbours

-- các ô công trình cạnh size chiếm khi góc trên-trái ở index, ô góc đứng đầu. Tràn lưới thì nil
function CityEngine.footprint(index, size)
	local col, row = (index - 1) % N + 1, math.floor((index - 1) / N) + 1
	if col + size - 1 > N or row + size - 1 > N then
		return nil
	end
	local out = {}
	for dy = 0, size - 1 do
		for dx = 0, size - 1 do
			table.insert(out, index + dy * N + dx)
		end
	end
	return out
end

-- ô góc của công trình chứa i. ô góc/đường/trống thì trả về chính i
function CityEngine.anchorOf(cells, i)
	local v = cells[i]
	if type(v) == "string" and string.sub(v, 1, 1) == "+" then
		return tonumber(string.sub(v, 2)) or i
	end
	return i
end

-- sửa lưới đọc từ DataStore, data cũ/hỏng không được làm sập game.
-- bỏ mã lạ, gắn lại ô "+góc", công trình không đủ chỗ thì bỏ. Sửa tại chỗ
function CityEngine.sanitizeCells(cells)
	local total = N * N
	for i = 1, total do
		local v = cells[i]
		if not B[v] then
			cells[i] = EMPTY
		end
	end
	for i = 1, total do
		local def = B[cells[i]]
		if def and def.size > 1 then
			local fp = CityEngine.footprint(i, def.size)
			local free = fp ~= nil
			for k = 2, fp and #fp or 0 do
				if cells[fp[k]] ~= EMPTY then
					free = false
				end
			end
			if free then
				for k = 2, #fp do
					cells[fp[k]] = "+" .. i
				end
			else
				cells[i] = EMPTY
			end
		end
	end
	return cells
end

-- (2) conn[i]: ô đường thông tới cổng, hoặc ô của công trình có ít nhất 1 ô kề đường đó
function CityEngine.connectivity(cells)
	local linked = { [Config.GATE_INDEX] = true }
	local stack = { Config.GATE_INDEX }
	while #stack > 0 do
		local i = table.remove(stack)
		for _, j in ipairs(neighbours(i)) do
			if not linked[j] and cells[j] == "road" then
				linked[j] = true
				table.insert(stack, j)
			end
		end
	end
	local conn = {}
	for i = 1, N * N do
		conn[i] = false
	end
	for i = 1, N * N do
		local t = cells[i]
		local def = B[t]
		if t == "road" then
			conn[i] = linked[i] == true
		elseif def then
			local fp = CityEngine.footprint(i, def.size) or { i }
			local ok = false
			for _, c in ipairs(fp) do
				for _, j in ipairs(neighbours(c)) do
					if linked[j] then
						ok = true
					end
				end
			end
			for _, c in ipairs(fp) do
				conn[c] = ok
			end
		end
	end
	return conn
end

-- (4) bước 2 và 4-9 của 1 tháng với dân số pop cho trước. Không sửa session
function CityEngine.compute(session, pop, eff)
	eff = eff or Scenarios.aggregate(session.scenarios)
	local cells = session.cells
	local conn = CityEngine.connectivity(cells)
	local slots = { shop = 0, factory = 0, office = 0 }
	local counts = {}
	local C, J, pts, M = 0, 0, 0, 0
	-- mỗi mẫu có lương/người riêng nên cộng dồn chỗ làm x lương theo loại đất
	local wages = { shop = 0, factory = 0, office = 0 }
	for i = 1, N * N do
		local b = B[cells[i]] -- chỉ ô góc (ô "+góc" không có trong B)
		if b then
			M = M + b.maint -- chưa nối vẫn tốn bảo trì
			counts[b.kind] = (counts[b.kind] or 0) + 1
			if conn[i] then
				C = C + (b.cap or 0)
				J = J + (b.jobs or 0)
				pts = pts + (b.pts or 0)
				if slots[b.kind] then
					slots[b.kind] = slots[b.kind] + b.jobs
					wages[b.kind] = wages[b.kind] + b.jobs * b.rev
				end
			end
		end
	end
	M = M * eff.maintenanceMultiplier
	local emp = math.min(pop, J)
	local f = J > 0 and emp / J or 0
	local E = pop > 0 and (emp / pop) * 100 or 100
	local G = slots.shop > 0 and math.min(1, (slots.factory * eff.goodsMultiplier) / slots.shop) or 1
	local R = f * (wages.shop * G + wages.factory + wages.office) * eff.revenueMultiplier
	local tax = session.tax
	local taxIn = (R * tax) / 100
	local S = pop > 0 and math.min(100, ((pts * F.residentsPerPoint) / pop) * 100) or 100
	local parts = {
		E = F.happinessEmploymentWeight * E,
		T = F.happinessTaxWeight * (100 - 2 * tax),
		S = F.happinessServiceWeight * S,
		event = eff.happinessPenalty,
	}
	local H = Util.clamp(parts.E + parts.T + parts.S + parts.event, 0, 100)
	return {
		conn = conn, counts = counts, slots = slots, C = C, J = J, pts = pts, emp = emp, f = f,
		E = E, G = G, R = R, taxIn = taxIn, M = M, net = taxIn - M, S = S, H = H, parts = parts,
	}
end

-- (4, bước 3) độ hấp dẫn A, dân mục tiêu P*
function CityEngine.attraction(H)
	return F.attractionMax * Util.clamp((H - F.attractionLow) / (F.attractionHigh - F.attractionLow), 0, 1)
end

function CityEngine.targetPop(C, J, H)
	return math.min(C, math.floor(J * CityEngine.attraction(H)))
end

-- H là của tháng trước, dân phản ứng trễ 1 tháng
function CityEngine.migrate(pop, C, J, H, leaveRate)
	pop = math.min(pop, C) -- nhà bị phá hoặc mất nối: dân đi ngay
	local diff = CityEngine.targetPop(C, J, H) - pop
	if diff > 0 then
		pop = pop + math.ceil(diff * F.moveRate)
	elseif diff < 0 then
		pop = pop - math.ceil(-diff * F.moveRate)
	end
	return pop - Util.round(pop * (leaveRate or 0))
end

-- mục 7
function CityEngine.crises(session, d)
	local c = Config.CRISIS
	local out = {}
	if session.budget < c.budgetBelow then
		table.insert(out, "BUDGET")
	end
	if d.H < c.happinessBelow then
		table.insert(out, "HAPPINESS")
	end
	if session.population > 0 and d.E < c.employmentBelow then
		table.insert(out, "UNEMPLOYMENT")
	end
	if d.slots.shop > 0 and d.G < c.goodsBelow then
		table.insert(out, "SHORTAGE")
	end
	return out
end

-- mục 6, điểm không âm
function CityEngine.score(employed, happiness, budget)
	return math.max(0, Util.round((employed * happiness) / 100 + budget / 100))
end

-- (5) Thao tác người chơi, trả về (true, data) hoặc (false, lỗi).
-- server validate mọi thứ client gửi lên qua mấy hàm này. client cũng gọi priceOf để hiện giá

local function finished(session)
	return session.status == "ENDED" or session.status == "FAILED"
end
local FINISHED_TEXT = "Ván đã kết thúc, hãy bắt đầu ván mới"

function CityEngine.priceOf(session, kind)
	return Util.round(B[kind].price * Scenarios.aggregate(session.scenarios).priceMultiplier)
end

function CityEngine.build(session, kind, index)
	if finished(session) then
		return false, FINISHED_TEXT
	end
	if type(kind) ~= "string" or not B[kind] then
		return false, "Loại công trình không hợp lệ"
	end
	if not CityEngine.isValidIndex(index) then
		return false, "Ô không hợp lệ"
	end
	local size = B[kind].size
	local fp = CityEngine.footprint(index, size)
	if not fp then
		return false, string.format("%s cần %dx%d ô, tràn ra ngoài lưới", B[kind].label, size, size)
	end
	for _, c in ipairs(fp) do
		if session.cells[c] ~= EMPTY then
			return false, size > 1 and string.format("%s cần %dx%d ô trống", B[kind].label, size, size) or "Ô này đã có công trình"
		end
	end
	local cost = CityEngine.priceOf(session, kind)
	if session.budget < cost then
		return false, "Không đủ tiền: cần " .. Util.formatMoneyFull(cost)
	end
	session.budget = session.budget - cost
	session.cells[index] = kind
	for k = 2, #fp do
		session.cells[fp[k]] = "+" .. index
	end
	return true, { cost = cost }
end

-- 1 lần kéo đường. Ô đã là đường thì bỏ qua, gặp công trình hoặc thiếu tiền thì từ chối cả đoạn
function CityEngine.buildRoad(session, path)
	if finished(session) then
		return false, FINISHED_TEXT
	end
	if type(path) ~= "table" then
		return false, "Đoạn đường không hợp lệ"
	end
	local n = #path
	if n == 0 or n > Config.MAX_ROAD_PATH then
		return false, string.format("Mỗi lần kéo tối đa %d ô", Config.MAX_ROAD_PATH)
	end
	local todo, seen = {}, {}
	for k = 1, n do
		local i = path[k]
		if not CityEngine.isValidIndex(i) then
			return false, "Ô không hợp lệ"
		end
		if not seen[i] and session.cells[i] ~= "road" then
			if session.cells[i] ~= EMPTY then
				return false, "Đoạn đường đi qua ô đã có công trình"
			end
			table.insert(todo, i)
		end
		seen[i] = true
	end
	local cost = #todo * CityEngine.priceOf(session, "road")
	if session.budget < cost then
		return false, string.format("Không đủ tiền: cần %s cho %d ô đường", Util.formatMoneyFull(cost), #todo)
	end
	session.budget = session.budget - cost
	for _, i in ipairs(todo) do
		session.cells[i] = "road"
	end
	return true, { cost = cost, built = #todo }
end

function CityEngine.demolish(session, index)
	if finished(session) then
		return false, FINISHED_TEXT
	end
	if not CityEngine.isValidIndex(index) then
		return false, "Ô trống"
	end
	-- bấm ô nào của công trình nhiều ô cũng phá cả công trình
	local anchor = CityEngine.anchorOf(session.cells, index)
	local def = CityEngine.isValidIndex(anchor) and B[session.cells[anchor]]
	if not def then
		return false, "Ô trống"
	end
	if anchor == Config.GATE_INDEX then
		return false, "Không phá được ô cổng"
	end
	local refund = math.floor(def.price * Config.DEMOLISH_REFUND)
	session.budget = session.budget + refund
	for _, c in ipairs(CityEngine.footprint(anchor, def.size) or { anchor }) do
		session.cells[c] = EMPTY
	end
	return true, { refund = refund, anchor = anchor }
end

function CityEngine.setTax(session, tax)
	if finished(session) then
		return false, FINISHED_TEXT
	end
	if type(tax) ~= "number" or tax ~= math.floor(tax) or tax < 0 or tax > Config.TAX_MAX then
		return false, string.format("Thuế từ 0 đến %d%%", Config.TAX_MAX)
	end
	session.tax = tax
	return true, { tax = tax }
end

return CityEngine
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">CityLayout</string><ProtectedString name="Source"><![CDATA[-- Hình học lưới 12x12, server (spawn) và client (vẽ, chọn ô) dùng chung.
-- ô i: cột (i-1) % 12 + 1, hàng floor((i-1)/12) + 1. Hàng 12 nằm phía +Z (gần camera), cổng ở hàng này

local Config = require(script.Parent.Config)

local N = Config.GRID_SIZE

local CityLayout = {}

CityLayout.ORIGIN = { x = 0, y = 0, z = 0 } -- tâm thành phố (mặt đất y = 0)
CityLayout.CELL = 14 -- cạnh ô, stud
CityLayout.HALF_EXTENT = CityLayout.CELL * N / 2 -- 84

function CityLayout.cellXY(i)
	return (i - 1) % N + 1, math.floor((i - 1) / N) + 1
end

function CityLayout.cellCenter(i)
	local col, row = CityLayout.cellXY(i)
	return CityLayout.ORIGIN.x + (col - (N + 1) / 2) * CityLayout.CELL, CityLayout.ORIGIN.z + (row - (N + 1) / 2) * CityLayout.CELL
end

-- ô chứa điểm (x, z) trên mặt đất, ngoài lưới thì nil
function CityLayout.cellAt(x, z)
	local col = math.floor((x - CityLayout.ORIGIN.x + CityLayout.HALF_EXTENT) / CityLayout.CELL) + 1
	local row = math.floor((z - CityLayout.ORIGIN.z + CityLayout.HALF_EXTENT) / CityLayout.CELL) + 1
	if col < 1 or col > N or row < 1 or row > N then
		return nil
	end
	return (row - 1) * N + col
end

-- spawn trên đường dẫn vào cổng, ngay ngoài mép lưới
CityLayout.SPAWN = { x = (CityLayout.cellCenter(Config.GATE_INDEX)), y = 0, z = CityLayout.HALF_EXTENT + 20 }

return CityLayout
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Hằng số của game. Luật: docs/luat-choi-moi.md.
-- Số cân bằng đã chạy thử bằng prototypes/luat-moi/sim.js và tests/balance_sim.lua, 2 bên phải ra cùng điểm.
-- sửa số xong thì chạy `lua tests/balance_sim.lua` xem điểm theo từng mức thuế

local Config = {}

Config.VERSION = "0.2.2"

-- Nhịp
-- 1 lượt = 1 tháng, đổi số giây không làm lệch cân bằng
Config.TICK_SECONDS = 20
Config.GAME_DURATION_MONTHS = 24

-- Ngân sách, thắng/thua (mục 6)
Config.START_BUDGET = 10000
Config.FAIL_BUDGET = -5000 -- dưới mức này là thua
Config.BUDGET_CLAMP = { -10000000, 1000000000 }

-- Lưới, đường (mục 2)
Config.GRID_SIZE = 12
-- ô cổng: cột 6, hàng 12 (hàng gần camera). Ô đánh số 1..144 theo hàng: (hàng-1)*12 + cột
Config.GATE_INDEX = (12 - 1) * 12 + 6
Config.EMPTY = "" -- ô trống. Không dùng nil vì DataStore không lưu được mảng có lỗ

-- Thuế, thao tác (mục 5)
Config.START_TAX = 20
Config.TAX_MAX = 50
Config.DEMOLISH_REFUND = 0.5
Config.MAX_ROAD_PATH = 24 -- số ô tối đa mỗi lần kéo đường

-- Công trình (mục 3)
-- 8 loại đất. code + color (RGB) dùng chung cho ô chú giải, nền lô và màu nhà trên sa bàn.
-- inkLight: chữ trắng trên ô màu. Thứ tự = thứ tự trên bảng Chú giải
Config.CATEGORY_ORDER = { "house", "shop", "factory", "office", "hospital", "school", "park", "road" }
Config.BUILDING_ORDER = Config.CATEGORY_ORDER -- tên cũ
Config.CATEGORIES = {
	house = { code = "Ở", zone = "Đất ở", color = { 242, 194, 48 } },
	shop = { code = "TM", zone = "Thương mại", color = { 208, 52, 52 }, inkLight = true },
	factory = { code = "CN", zone = "Công nghiệp", color = { 126, 79, 181 }, inkLight = true },
	office = { code = "VP", zone = "Văn phòng", color = { 47, 111, 208 }, inkLight = true },
	hospital = { code = "YT", zone = "Y tế", color = { 192, 58, 124 }, inkLight = true },
	school = { code = "GD", zone = "Giáo dục", color = { 240, 138, 36 } },
	park = { code = "CX", zone = "Cây xanh", color = { 60, 157, 74 } },
	road = { code = "GT", zone = "Giao thông", color = { 107, 112, 120 }, inkLight = true },
}

-- mẫu chuẩn: id trùng tên loại, số đã cân bằng (bot, balance_sim và bản JS dùng mẫu này).
-- mẫu nhỏ 1x1 rẻ, lãi/ô thấp hơn. mẫu lớn 2x2 đắt, lãi/ô cao hơn ~15-25%, đáng xây khi lưới đã chật.
-- size = cạnh (ô), công trình 2x2 lấy ô bấm làm góc trên-trái
Config.BUILDINGS = {
	house = { kind = "house", label = "Nhà", price = 600, maint = 10, cap = 40 },
	house_small = { kind = "house", label = "Nhà nhỏ", price = 350, maint = 6, cap = 20 },
	apartment = { kind = "house", label = "Chung cư", size = 2, price = 3000, maint = 60, cap = 200 },

	shop = { kind = "shop", label = "Shop", price = 1600, maint = 60, jobs = 20, rev = 105 },
	cafe = { kind = "shop", label = "Quán cà phê", price = 900, maint = 35, jobs = 10, rev = 100 },
	supermarket = { kind = "shop", label = "Siêu thị", size = 2, price = 7000, maint = 260, jobs = 90, rev = 110 },

	factory = { kind = "factory", label = "Nhà máy", price = 1200, maint = 80, jobs = 30, rev = 55 },
	workshop = { kind = "factory", label = "Xưởng nhỏ", price = 700, maint = 45, jobs = 15, rev = 55 },
	plant = { kind = "factory", label = "Nhà máy lớn", size = 2, price = 5000, maint = 320, jobs = 130, rev = 58 },

	office = { kind = "office", label = "Văn phòng", price = 3000, maint = 100, jobs = 20, rev = 160 },
	office_small = { kind = "office", label = "Văn phòng nhỏ", price = 1500, maint = 55, jobs = 10, rev = 155 },
	tower = { kind = "office", label = "Tháp văn phòng", size = 2, price = 14000, maint = 420, jobs = 90, rev = 170 },

	hospital = { kind = "hospital", label = "Bệnh viện", price = 2400, maint = 120, jobs = 20, pts = 10 },
	clinic = { kind = "hospital", label = "Trạm y tế", price = 1200, maint = 60, jobs = 8, pts = 5 },

	school = { kind = "school", label = "Trường học", price = 2000, maint = 100, jobs = 20, pts = 10 },
	school_big = { kind = "school", label = "Trường lớn", size = 2, price = 7000, maint = 350, jobs = 80, pts = 40 },

	park = { kind = "park", label = "Công viên", price = 1800, maint = 100, pts = 5 },
	park_big = { kind = "park", label = "Công viên lớn", size = 2, price = 6000, maint = 360, pts = 22 },

	road = { kind = "road", label = "Đường", price = 50, maint = 0 },
}
-- thứ tự hiện trên Chú giải, mẫu chuẩn đứng đầu
Config.VARIANTS = {
	house = { "house", "house_small", "apartment" },
	shop = { "shop", "cafe", "supermarket" },
	factory = { "factory", "workshop", "plant" },
	office = { "office", "office_small", "tower" },
	hospital = { "hospital", "clinic" },
	school = { "school", "school_big" },
	park = { "park", "park_big" },
	road = { "road" },
}
-- chép code/zone/color của loại đất vào từng mẫu, UI và sa bàn đọc thẳng từ mẫu
for id, def in pairs(Config.BUILDINGS) do
	local cat = Config.CATEGORIES[def.kind]
	def.id = id
	def.size = def.size or 1
	def.code, def.zone, def.color, def.inkLight = cat.code, cat.zone, cat.color, cat.inkLight
end

-- 1 dòng ghi chú trên thẻ thông tin
Config.BUILDING_NOTES = {
	house = "Dân chỉ đến khi có việc làm.",
	house_small = "Rẻ nhất để có dân, nhưng ít chỗ ở trên mỗi ô.",
	apartment = "Nhiều chỗ ở nhất trên mỗi ô, khi lưới đã chật.",
	shop = "Cần hàng từ nhà máy.",
	cafe = "Rẻ, ít người làm. Vẫn cần hàng từ nhà máy.",
	supermarket = "Lãi mỗi ô cao nhất trong thương mại. Cần nhiều hàng.",
	factory = "Cấp hàng cho shop: 1 công nhân đủ hàng cho 1 nhân viên shop.",
	workshop = "Rẻ, ít người làm. Cấp hàng cho shop.",
	plant = "Nhiều chỗ làm, cấp nhiều hàng cho shop.",
	office = "Lương cao, không cần hàng.",
	office_small = "Rẻ hơn, ít chỗ làm. Không cần hàng.",
	tower = "Lãi mỗi ô cao nhất, rất đắt.",
	hospital = "Dân vui hơn.",
	clinic = "Rẻ, phục vụ ít dân hơn.",
	school = "Dân vui hơn.",
	school_big = "Phục vụ nhiều dân, rẻ hơn 4 trường nhỏ.",
	park = "Không cần người làm.",
	park_big = "Phục vụ nhiều dân hơn 4 công viên nhỏ.",
	road = "Mọi công trình phải nối đường về CỔNG.",
}

-- Công thức (mục 4)
Config.FORMULA = {
	-- H = wE*E + wT*(100 - 2T) + wS*S
	happinessEmploymentWeight = 0.35,
	happinessTaxWeight = 0.45,
	happinessServiceWeight = 0.20,
	-- độ hấp dẫn A = aMax * clamp((H - hLo) / (hHi - hLo), 0, 1), dân mục tiêu = min(chỗ ở, floor(việc làm * A))
	attractionLow = 50,
	attractionHigh = 75,
	attractionMax = 1.2,
	moveRate = 0.5, -- mỗi tháng đi nửa quãng tới mục tiêu
	residentsPerPoint = 20, -- 1 điểm dịch vụ phục vụ 20 dân
}

-- Cảnh báo (mục 7), chỉ báo, không làm thua
Config.CRISIS = {
	budgetBelow = 0,
	happinessBelow = 50,
	employmentBelow = 80,
	goodsBelow = 0.7,
}

-- dạng "tiêu đề: giải thích". UI in đậm phần trước dấu hai chấm, phần sau thành dòng phụ
Config.CRISIS_LABELS = {
	BUDGET = "Ngân sách âm: đang lỗ, chưa xây được gì",
	HAPPINESS = "Hạnh phúc dưới 50: không ai muốn chuyển đến",
	UNEMPLOYMENT = "Việc làm dưới 80%: thiếu chỗ làm",
	SHORTAGE = "Shop thiếu hàng: cần thêm nhà máy",
}

-- Lớp học, vai trò
-- UserId giáo viên (xem README). Chủ game luôn là giáo viên
Config.TEACHER_USER_IDS = {
	-- 123456789,
}
-- admin mở được bảng Quản trị (thêm/bớt giáo viên, cấm, xoá dữ liệu). Chủ game luôn là admin
Config.ADMIN_USER_IDS = {
	-- 123456789,
}
-- tuỳ chọn: ai trong Group này có rank >= MIN_RANK là giáo viên
Config.TEACHER_GROUP_ID = 0
Config.TEACHER_GROUP_MIN_RANK = 200
-- trong Studio ai cũng là giáo viên, cho dễ test
Config.STUDIO_EVERYONE_IS_TEACHER = true

-- tắt chat mặc định: đè lên bảng chỉ số, mà lớp học cũng không cần chat
Config.SHOW_CHAT_WINDOW = false

Config.CLASS_CODE_LENGTH = 6
-- bỏ nguyên âm (khỏi ghép ra từ nhạy cảm) và 0/1 dễ nhầm, Roblox khuyến nghị vậy
Config.CLASS_CODE_ALPHABET = "BCDFGHJKLMNPQRSTVWXZ23456789"
Config.MAX_CLASSES_PER_TEACHER = 20
Config.MAX_CLASSES_PER_STUDENT = 10
Config.MAX_CLASS_MEMBERS = 60
Config.MAX_CUSTOM_SCENARIOS = 20
Config.MAX_TEXT_BYTES = 200 -- chặn chuỗi dài trước mọi xử lý
-- sự kiện gán lúc học sinh vắng: vào game vẫn nhận nếu chưa cũ hơn mức này
Config.SCENARIO_SYNC_MAX_AGE = 7 * 24 * 3600

-- Lưu trữ
Config.DATASTORE = {
	profiles = "EconCity_Profiles_v1",
	classes = "EconCity_Classes_v1",
	scenarios = "EconCity_Scenarios_v1",
	admin = "EconCity_Admin_v1",
	-- v2: điểm luật xây thành phố không so được với điểm luật cũ nên tách bảng mới
	leaderboardGlobal = "EconCity_LB_Global_v2",
	leaderboardClassPrefix = "EconCity_LB_Class_v2_",
	classLiveMap = "EconCity_ClassLive_v1",
	messagingTopic = "EconCity_Class_v1",
}
-- bảng xếp hạng luật cũ: không ghi nữa nhưng vẫn phải xoá khi có yêu cầu xoá dữ liệu (Right to be Forgotten)
Config.LEGACY_LEADERBOARDS = {
	{ global = "EconCity_LB_Global_v1", classPrefix = "EconCity_LB_Class_v1_" },
}
-- Studio có bật API thì ghi vào kho có hậu tố này, khỏi lẫn với game thật
Config.STUDIO_STORE_SUFFIX = "_Studio"
Config.MAX_PAST_SESSIONS = 20
Config.LEADERBOARD_UPDATE_EVERY_TICKS = 2 -- 2 lượt mới ghi 1 lần, cho khỏi vượt hạn mức
Config.LEADERBOARD_SIZE = 20
Config.LEADERBOARD_CACHE_SECONDS = 30
Config.LIVE_SUMMARY_TTL = 120 -- giây, tiến độ live trong MemoryStore. mỗi lượt (20s) làm mới
Config.ONLINE_WINDOW_SECONDS = 60 -- cập nhật trong khoảng này thì coi là "đang chơi"
Config.SESSION_LOCK_STALE_SECONDS = 90 -- lock của server khác quá khoảng này thì coi như bị bỏ
Config.LOCK_REFRESH_SECONDS = 60 -- profile đang mở được ghi lại ít nhất mỗi khoảng này để làm mới lock

-- chống spam request từ client
Config.REQUEST_BURST = 8 -- số request gửi dồn được
Config.REQUEST_REFILL_PER_SECOND = 4
-- cooldown (giây) giữa 2 lần gọi cùng 1 action, tính theo người chơi.
-- chữ tự nhập mà người khác thấy (tên lớp, tên kịch bản): Roblox quy định tối thiểu 60s
Config.ACTION_COOLDOWNS = {
	joinClass = 2,
	leaveClass = 2,
	createClass = 60,
	createScenario = 60,
	openClassRoom = 10,
	enterClassRoom = 5,
	assignScenario = 3,
	getLeaderboard = 1,
	exportClassCsv = 5,
	getStudentDetail = 1,
	listScenarios = 2,
	deleteScenario = 2,
	closeClassRoom = 5,
	newGame = 2,
	adminAddTeacher = 2,
	adminRemoveTeacher = 2,
	adminBan = 2,
	adminUnban = 2,
	adminDeleteUserData = 5,
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">DemoBot</string><ProtectedString name="Source"><![CDATA[-- Bot xây thành phố, đi qua CityEngine như người chơi nên không ăn gian được.
-- Dùng cho nút "Bot xây mẫu" (Studio) và balance_sim. Dịch 1:1 từ prototypes/luat-moi/sim.js,
-- balance_sim so từng số với bản JS nên sửa cách bot chơi ở đây thì sửa luôn sim.js.
--
-- bố cục: trục đường dọc ở cột cổng + 4 hàng đường ngang, công trình sát đường (89 ô công trình, 55 ô đường)
-- SHOWCASE (nút Xây mẫu) = BALANCED + đủ tiền thì xây mẫu 2x2 trong dải 2 hàng giữa 2 hàng đường.
-- chiến thuật của balance_sim không bật big nên vẫn khớp bản JS

local Config = require(script.Parent.Config)
local CityEngine = require(script.Parent.CityEngine)

local B = Config.BUILDINGS
local N = Config.GRID_SIZE
local GX = (Config.GATE_INDEX - 1) % N -- cột cổng, đếm từ 0
local JOBS = { "shop", "factory", "office", "hospital", "school" }

local DemoBot = {}

-- mix: tỉ lệ chỗ làm theo loại, S: dịch vụ tối thiểu, houseRatio: chỗ ở / việc làm,
-- reserveMonths: số tháng tiền bảo trì phải chừa lại
DemoBot.BALANCED = {
	mix = { { "shop", 0.4 }, { "factory", 0.4 }, { "office", 0.2 } },
	S = 60,
	service = { "park", "hospital", "school" },
	houseRatio = 1.2,
	reserveMonths = 2,
}

local function with(over)
	local s = {}
	for k, v in pairs(DemoBot.BALANCED) do
		s[k] = v
	end
	for k, v in pairs(over) do
		s[k] = v
	end
	return s
end
DemoBot.SHOWCASE = with({ big = true })

-- mẫu 2x2 của từng loại đất, nếu có
local BIG = {}
for cat, ids in pairs(Config.VARIANTS) do
	for _, id in ipairs(ids) do
		if B[id].size == 2 then
			BIG[cat] = id
		end
	end
end

local ROAD_ROWS = { N - 2, N - 5, N - 8, N - 11 } -- hàng đường ngang, đếm từ 0
local function roadRowOf(y)
	for _, r in ipairs(ROAD_ROWS) do
		if math.abs(r - y) == 1 then
			return r
		end
	end
end
local function isRoadRow(y)
	for _, r in ipairs(ROAD_ROWS) do
		if r == y then
			return true
		end
	end
	return false
end

local SLOTS = {}
for y = 0, N - 1 do
	for x = 0, N - 1 do
		if not isRoadRow(y) and not (x == GX and y >= 1) then
			table.insert(SLOTS, { x = x, y = y, i = y * N + x + 1 })
		end
	end
end
-- giả sort ổn định của JS: hàng đường gần cổng trước, rồi gần trục, rồi theo thứ tự sinh ra
table.sort(SLOTS, function(a, b)
	local ra, rb = roadRowOf(a.y), roadRowOf(b.y)
	if ra ~= rb then
		return ra > rb
	end
	local da, db = math.abs(a.x - GX), math.abs(b.x - GX)
	if da ~= db then
		return da < db
	end
	return a.i < b.i
end)
DemoBot.SLOTS = SLOTS

-- ô đường còn thiếu để nối slot về cổng: trục dọc tới hàng đường của slot, rồi đi ngang tới cột
local function roadsFor(session, slot)
	local r, out = roadRowOf(slot.y), {}
	for y = r, N - 1 do
		table.insert(out, y * N + GX + 1)
	end
	for x = math.min(GX, slot.x), math.max(GX, slot.x) do
		table.insert(out, r * N + x + 1)
	end
	local todo = {}
	for _, i in ipairs(out) do
		if session.cells[i] ~= "road" then
			table.insert(todo, i)
		end
	end
	return todo
end

-- ô góc vùng 2x2 trống chứa slot, gọn giữa 2 hàng đường, không đè trục dọc. Không có thì nil
local function bigAnchor(session, slot)
	for _, dy in ipairs({ 0, 1 }) do
		for _, dx in ipairs({ 0, 1 }) do
			local x, y = slot.x - dx, slot.y - dy
			local fp = x >= 0 and y >= 0 and CityEngine.footprint(y * N + x + 1, 2)
			if fp and not isRoadRow(y) and not isRoadRow(y + 1) and not (x <= GX and GX <= x + 1) then
				local free = true
				for _, c in ipairs(fp) do
					free = free and session.cells[c] == Config.EMPTY
				end
				if free then
					return fp[1]
				end
			end
		end
	end
	return nil
end

-- đếm theo loại đất (gộp mọi mẫu): số công trình, chỗ ở, chỗ làm.
-- lưới chỉ có mẫu chuẩn thì ra y như bản JS (count x số mẫu chuẩn)
local function tally(session)
	local n, cap, jobs = {}, 0, {}
	for _, c in ipairs(session.cells) do
		local def = B[c]
		if def then
			n[def.kind] = (n[def.kind] or 0) + 1
			cap = cap + (def.cap or 0)
			jobs[def.kind] = (jobs[def.kind] or 0) + (def.jobs or 0)
		end
	end
	return n, cap, jobs
end

local function choose(session, st)
	local n, C, jobs = tally(session)
	local function count(kind)
		return n[kind] or 0
	end
	local J = 0
	for _, t in ipairs(JOBS) do
		J = J + (jobs[t] or 0)
	end
	local d = CityEngine.compute(session, math.max(1, math.min(C, J)))
	if C < J * st.houseRatio or (C == 0 and J == 0) then
		return "house", d
	elseif d.S < st.S then
		local built = count("hospital") + count("school") + count("park")
		return st.service[built % #st.service + 1], d
	end
	local total = 1
	for _, m in ipairs(st.mix) do
		total = total + (jobs[m[1]] or 0)
	end
	local best
	for _, m in ipairs(st.mix) do
		local gap = (jobs[m[1]] or 0) / total - m[2]
		if not best or gap < best.gap then
			best = { kind = m[1], gap = gap }
		end
	end
	return best.kind, d
end

-- xây bằng tiền đang có, chừa reserveMonths tháng bảo trì. Trả về số công trình đã xây (không tính đường)
-- slot bị công trình của người chơi chắn đường thì bỏ qua
function DemoBot.act(session, st)
	st = st or DemoBot.BALANCED
	local built, blocked = 0, {}
	while true do
		local slot
		for _, p in ipairs(SLOTS) do
			if not blocked[p.i] and session.cells[p.i] == Config.EMPTY then
				slot = p
				break
			end
		end
		if not slot then
			return built
		end
		local pick, d = choose(session, st)
		local roads = roadsFor(session, slot)
		local roadCost = #roads * CityEngine.priceOf(session, "road")
		local at = slot.i
		-- st.big: chỉ xây 2x2 phủ lên slot khi đã có dân, có chỗ, và mua xong vẫn còn >= giá mẫu lớn + dự trữ.
		-- mua sớm hơn là chôn tiền vào chỗ thừa (200 chỗ ở khi mới cần 40) hoặc hết tiền trước khi có chỗ làm.
		-- balance_sim check bot này vẫn chơi ngang mẫu chuẩn
		local anchor = st.big and BIG[pick] and (session.population or 0) > 0 and bigAnchor(session, slot)
		if anchor and session.budget - 2 * CityEngine.priceOf(session, BIG[pick]) - roadCost >= st.reserveMonths * d.M then
			pick, at = BIG[pick], anchor
		else
			-- st.variants (tuỳ chọn): thay mẫu chuẩn bằng mẫu 1x1 khác, vd { house = "house_small" }
			pick = (st.variants and st.variants[pick]) or pick
		end
		local clear = true
		for _, i in ipairs(roads) do
			if session.cells[i] ~= Config.EMPTY then
				clear = false
			end
		end
		if not clear then
			blocked[slot.i] = true
		else
			local cost = CityEngine.priceOf(session, pick) + roadCost
			if session.budget < cost or session.budget - cost < st.reserveMonths * d.M then
				return built
			end
			local ok = #roads == 0 or CityEngine.buildRoad(session, roads)
			if not (ok and CityEngine.build(session, pick, at)) then
				return built -- ván xong hoặc data lạ: dừng luôn, kẻo lặp mãi
			end
			built = built + 1
		end
	end
end

return DemoBot
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">GameTick</string><ProtectedString name="Source"><![CDATA[-- Vòng đời phiên chơi và 1 lượt tính (1 tháng), docs/luat-choi-moi.md mục 4-6.
-- session là bảng Lua thuần, lưu thẳng vào DataStore được

local Config = require(script.Parent.Config)
local Util = require(script.Parent.Util)
local Scenarios = require(script.Parent.Scenarios)
local CityEngine = require(script.Parent.CityEngine)

local GameTick = {}

GameTick.STATUS = {
	ACTIVE = "ACTIVE",
	PAUSED = "PAUSED",
	ENDED = "ENDED",
	FAILED = "FAILED",
}

-- ván mới: tháng 0, PAUSED (người chơi xây trước rồi bấm Bắt đầu), lưới trống trừ ô cổng
function GameTick.newSession(userId, sessionId, now)
	local session = {
		id = sessionId,
		userId = userId,
		createdAt = now or 0,
		month = 0,
		maxMonths = Config.GAME_DURATION_MONTHS,
		status = GameTick.STATUS.PAUSED,
		budget = Config.START_BUDGET,
		tax = Config.START_TAX,
		population = 0,
		employed = 0,
		employment = 100,
		gdp = 0, -- thật ra là doanh thu R tháng gần nhất, giữ tên gdp cho báo cáo lớp/CSV
		happiness = 0,
		prosperityScore = 0,
		cells = CityEngine.newCells(),
		scenarios = {},
		crises = {},
		history = {},
		autoPaused = false,
	}
	session.happiness = CityEngine.compute(session, 0).H -- = 82 với thuế 20%
	return session
end

function GameTick.isFinished(session)
	return session.status == GameTick.STATUS.ENDED or session.status == GameTick.STATUS.FAILED
end

-- mục 6
function GameTick.prosperityScore(session)
	return CityEngine.score(session.employed or 0, session.happiness or 0, session.budget or 0)
end

-- false nếu sự kiện không tồn tại hoặc đang chạy.
-- customDef (tuỳ chọn, kịch bản giáo viên tự tạo): { name, description, severity, durationMonths, effects }
function GameTick.addScenario(session, scenarioId, meta, customDef)
	if not Scenarios.get(scenarioId) and type(customDef) ~= "table" then
		return false, "Kịch bản không tồn tại"
	end
	if GameTick.isFinished(session) then
		return false, "Ván đã kết thúc"
	end
	for _, s in ipairs(session.scenarios) do
		if s.id == scenarioId then
			return false, "Kịch bản đang diễn ra"
		end
	end
	local entry = { id = scenarioId, monthsActive = 0 }
	if not Scenarios.get(scenarioId) then
		entry.custom = true
		entry.name = customDef.name
		entry.description = customDef.description
		entry.severity = customDef.severity
		entry.durationMonths = customDef.durationMonths
		entry.effects = Util.deepCopy(customDef.effects)
	end
	if meta then
		for k, v in pairs(meta) do
			entry[k] = v
		end
	end
	table.insert(session.scenarios, entry)
	return true
end

-- 1 lượt = 1 tháng. Sửa session tại chỗ, trả về tóm tắt lượt.
-- thứ tự (mục 4): dân đến/đi theo H tháng trước, việc làm, hàng hoá, doanh thu, ngân sách,
-- dịch vụ, hạnh phúc, cảnh báo, thắng/thua
function GameTick.processTick(session)
	if session.status ~= GameTick.STATUS.ACTIVE then
		return nil
	end
	local effects = Scenarios.aggregate(session.scenarios)
	local before = CityEngine.compute(session, session.population, effects)
	session.population = CityEngine.migrate(session.population, before.C, before.J, session.happiness, effects.leaveRate)
	local d = CityEngine.compute(session, session.population, effects)

	session.month = session.month + 1
	session.budget = Util.clamp(session.budget + d.net, Config.BUDGET_CLAMP[1], Config.BUDGET_CLAMP[2])
	session.happiness = d.H
	session.employment = d.E
	session.employed = d.emp
	session.gdp = d.R

	local kept, finishedScenarios = Scenarios.advance(session.scenarios)
	session.scenarios = kept
	session.crises = CityEngine.crises(session, d)
	session.prosperityScore = GameTick.prosperityScore(session)

	if session.budget < Config.FAIL_BUDGET then
		session.status = GameTick.STATUS.FAILED
	elseif session.month >= session.maxMonths then
		session.status = GameTick.STATUS.ENDED
	end

	table.insert(session.history, {
		month = session.month,
		budget = Util.roundTo(session.budget, 2),
		gdp = Util.roundTo(d.R, 2),
		happiness = Util.roundTo(d.H, 2),
		employment = Util.roundTo(d.E, 1),
		population = session.population,
	})

	return {
		month = session.month,
		revenue = d.R,
		taxIn = d.taxIn,
		maintenance = d.M,
		budgetDelta = d.net,
		population = session.population,
		finishedScenarios = finishedScenarios,
		status = session.status,
	}
end

-- tóm tắt gọn cho giáo viên xem / lưu vào lớp.
-- withHistory: kèm lịch sử từng tháng (xuất CSV, chi tiết học sinh)
function GameTick.summary(session, withHistory)
	local history = nil
	if withHistory then
		history = {}
		for _, h in ipairs(session.history or {}) do
			table.insert(history, {
				month = h.month,
				budget = Util.roundTo(h.budget or 0, 0),
				gdp = Util.roundTo(h.gdp or 0, 0),
				happiness = Util.roundTo(h.happiness or 0, 1),
				employment = Util.roundTo(h.employment or 0, 1),
				population = h.population,
			})
		end
	end
	return {
		history = history,
		sessionId = session.id,
		month = session.month,
		maxMonths = session.maxMonths,
		status = session.status,
		budget = Util.roundTo(session.budget, 0),
		gdp = Util.roundTo(session.gdp or 0, 0),
		happiness = Util.roundTo(session.happiness, 1),
		employment = Util.roundTo(session.employment or 0, 1),
		population = session.population,
		prosperityScore = session.prosperityScore,
	}
end

return GameTick
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Tên các remote + whitelist action client được gọi.

local Net = {}

Net.FOLDER = "EconCityRemotes"
Net.STATE_EVENT = "State" -- server gửi xuống: snapshot trạng thái
Net.NOTICE_EVENT = "Notice" -- server gửi xuống: toast
Net.REQUEST = "Request" -- client gọi lên: RemoteFunction(action, payload)

Net.ACTIONS = {
	getState = true,
	build = true, -- { kind, index }
	buildRoad = true, -- { path = { index... } }
	demolish = true, -- { index }
	setTax = true, -- { tax }
	togglePause = true,
	newGame = true,
	tickNow = true, -- chỉ Studio
	demoBuild = true, -- nút "Bot xây mẫu", chỉ Studio
	getLeaderboard = true,
	joinClass = true,
	leaveClass = true,
	getMyClasses = true,
	createClass = true,
	getTeacherClasses = true,
	getClassRoster = true,
	assignScenario = true,
	openClassRoom = true,
	enterClassRoom = true,
	clientReady = true, -- client dựng xong UI thì mới bắt đầu tính lượt
	exportClassCsv = true,
	getStudentDetail = true,
	listScenarios = true,
	createScenario = true,
	deleteScenario = true,
	closeClassRoom = true,
	adminGetState = true,
	adminAddTeacher = true,
	adminRemoveTeacher = true,
	adminBan = true,
	adminUnban = true,
	adminDeleteUserData = true,
}

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Scenarios</string><ProtectedString name="Source"><![CDATA[-- Sự kiện giáo viên gán cho lớp + gộp hiệu ứng các sự kiện đang chạy (docs/luat-choi-moi.md mục 8).
-- 4 sự kiện có sẵn đã chạy thử: điểm bot giảm 8-28%, không bot nào phá sản

local Scenarios = {}

Scenarios.CATALOG = {
	{
		id = "recession",
		name = "Suy thoái kinh tế",
		kind = "recession",
		severity = 6,
		durationMonths = 4,
		description = "Người dân thắt lưng buộc bụng: doanh thu của mọi cửa hàng, nhà máy, văn phòng chỉ còn 70%.",
		effects = { revenueMultiplier = 0.7 },
	},
	{
		id = "supply",
		name = "Đứt gãy chuỗi cung ứng",
		kind = "supply",
		severity = 5,
		durationMonths = 4,
		description = "Nhà máy chỉ giao được một nửa số hàng: shop thiếu hàng để bán.",
		effects = { goodsMultiplier = 0.5 },
	},
	{
		id = "pandemic",
		name = "Đại dịch",
		kind = "pandemic",
		severity = 8,
		durationMonths = 6,
		description = "Dịch bệnh lan rộng: mỗi tháng 2% dân rời thành phố, hạnh phúc giảm 10 điểm.",
		effects = { leaveRate = 0.02, happinessPenalty = -10 },
	},
	{
		id = "prices",
		name = "Bão giá vật liệu",
		kind = "prices",
		severity = 5,
		durationMonths = 5,
		description = "Giá vật liệu tăng vọt: xây mới đắt gấp 1,5 lần, chi phí bảo trì tăng 30%.",
		effects = { priceMultiplier = 1.5, maintenanceMultiplier = 1.3 },
	},
}

local byId = {}
for _, s in ipairs(Scenarios.CATALOG) do
	byId[s.id] = s
end

function Scenarios.get(id)
	return byId[id]
end

-- nhiều sự kiện cùng chạy thì gộp: max lấy lớn nhất, sum cộng dồn, product nhân
Scenarios.EFFECT_RULES = {
	revenueMultiplier = { rule = "product", default = 1 },
	maintenanceMultiplier = { rule = "product", default = 1 },
	priceMultiplier = { rule = "product", default = 1 },
	goodsMultiplier = { rule = "product", default = 1 },
	happinessPenalty = { rule = "sum", default = 0 },
	leaveRate = { rule = "max", default = 0 },
}

-- kịch bản giáo viên tự tạo: cùng 6 hiệu ứng, kẹp trong khoảng an toàn
Scenarios.CUSTOM_EFFECTS = {
	{ key = "revenueMultiplier", label = "Hệ số doanh thu", min = 0.5, max = 1, step = 0.05, default = 1, kind = "multiplier" },
	{ key = "maintenanceMultiplier", label = "Hệ số chi phí bảo trì", min = 1, max = 2, step = 0.1, default = 1, kind = "multiplier" },
	{ key = "priceMultiplier", label = "Hệ số giá xây", min = 1, max = 2, step = 0.1, default = 1, kind = "multiplier" },
	{ key = "goodsMultiplier", label = "Hệ số hàng hoá cho shop", min = 0.2, max = 1, step = 0.1, default = 1, kind = "multiplier" },
	{ key = "happinessPenalty", label = "Thay đổi hạnh phúc (điểm)", min = -30, max = 0, step = 1, default = 0, kind = "number" },
	{ key = "leaveRate", label = "Dân bỏ đi mỗi tháng", min = 0, max = 0.05, step = 0.005, default = 0, kind = "percent" },
}

local function clampStep(value, field)
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return field.default
	end
	value = math.max(field.min, math.min(field.max, value))
	local steps = math.floor((value - field.min) / field.step + 0.5)
	return math.floor((field.min + steps * field.step) * 10000 + 0.5) / 10000
end

-- chuẩn hoá kịch bản client gửi lên. tên/mô tả thì server lọc riêng
function Scenarios.sanitizeCustom(input)
	if type(input) ~= "table" then
		return nil, "Dữ liệu kịch bản không hợp lệ"
	end
	local severity = tonumber(input.severity) or 5
	local duration = tonumber(input.durationMonths) or 3
	local effects = {}
	local any = false
	local rawEffects = type(input.effects) == "table" and input.effects or {}
	for _, field in ipairs(Scenarios.CUSTOM_EFFECTS) do
		local v = clampStep(rawEffects[field.key], field)
		if v ~= field.default then
			effects[field.key] = v
			any = true
		end
	end
	if not any then
		return nil, "Kịch bản cần ít nhất một hiệu ứng"
	end
	return {
		severity = math.max(1, math.min(10, math.floor(severity + 0.5))),
		durationMonths = math.max(1, math.min(12, math.floor(duration + 0.5))),
		effects = effects,
	}
end

-- activeList: mảng { id = "recession", monthsActive = n, ... } trong session.
-- key không có trong EFFECT_RULES thì bỏ qua, nên kịch bản tự tạo lưu từ luật cũ không có tác dụng
function Scenarios.aggregate(activeList)
	local out = {}
	for key, spec in pairs(Scenarios.EFFECT_RULES) do
		out[key] = spec.default
	end
	for _, active in ipairs(activeList or {}) do
		local def = byId[active.id]
		local effects = (def and def.effects) or active.effects or {}
		for key, value in pairs(effects) do
			local spec = Scenarios.EFFECT_RULES[key]
			if spec and type(value) == "number" then
				if spec.rule == "max" then
					out[key] = math.max(out[key], value)
				elseif spec.rule == "sum" then
					out[key] = out[key] + value
				elseif spec.rule == "product" then
					out[key] = out[key] * value
				end
			end
		end
	end
	return out
end

-- tăng monthsActive, bỏ sự kiện hết hạn. Trả về (còn chạy, vừa kết thúc)
function Scenarios.advance(activeList)
	local kept, finished = {}, {}
	for _, active in ipairs(activeList or {}) do
		active.monthsActive = (active.monthsActive or 0) + 1
		local def = byId[active.id]
		local duration = (def and def.durationMonths) or active.durationMonths or 1
		if active.monthsActive >= duration then
			table.insert(finished, active)
		else
			table.insert(kept, active)
		end
	end
	return kept, finished
end

function Scenarios.monthsLeft(active)
	local def = byId[active.id]
	local duration = (def and def.durationMonths) or active.durationMonths or 1
	return math.max(0, duration - (active.monthsActive or 0))
end

return Scenarios
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Hàm tiện ích thuần, không dùng Roblox API. server, client, test dùng chung.
-- chỉ viết cú pháp chung Lua/Luau để test chạy được ngoài Studio

local Util = {}

function Util.clamp(x, lo, hi)
	if x ~= x then
		return lo -- NaN
	end
	if x < lo then
		return lo
	end
	if x > hi then
		return hi
	end
	return x
end

-- giống Math.round của JS: .5 làm tròn về phía +vô cực
function Util.round(x)
	return math.floor(x + 0.5)
end

function Util.roundTo(x, decimals)
	local m = 10 ^ decimals
	return math.floor(x * m + 0.5) / m
end

function Util.deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in pairs(value) do
		out[k] = Util.deepCopy(v)
	end
	return out
end

function Util.isFiniteNumber(x)
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

-- phân cách nghìn, 12345.6 thành "12,346"
function Util.formatInt(n)
	local negative = n < 0
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	if negative then
		return "-" .. formatted
	end
	return formatted
end

-- "$12.3k", "-$6,837"
function Util.formatMoney(n)
	local sign = ""
	if n < 0 then
		sign = "-"
	end
	local a = math.abs(n)
	if a >= 1000000 then
		return sign .. "$" .. string.format("%.2fM", a / 1000000)
	elseif a >= 100000 then
		return sign .. "$" .. string.format("%.0fk", a / 1000)
	elseif a >= 10000 then
		return sign .. "$" .. string.format("%.1fk", a / 1000)
	end
	return sign .. "$" .. Util.formatInt(a)
end

-- "$10,000", "-$6,838": ngân sách hiện đủ số như bản web
function Util.formatMoneyFull(n)
	local sign = n < 0 and "-" or ""
	return sign .. "$" .. Util.formatInt(math.abs(n))
end

-- "$0k", "$102k", "$1.25M": GDP hiện theo nghìn như bản web
function Util.formatMoneyK(n)
	local sign = n < 0 and "-" or ""
	local a = math.abs(n)
	if a >= 1000000 then
		return sign .. "$" .. string.format("%.2fM", a / 1000000)
	end
	return sign .. "$" .. string.format("%.0fk", a / 1000)
end

-- cắt theo số ký tự UTF-8, không cắt đôi chữ có dấu
function Util.utf8Truncate(text, maxChars)
	if utf8.len(text) == nil then
		return nil
	end
	if utf8.len(text) <= maxChars then
		return text
	end
	return text:sub(1, utf8.offset(text, maxChars + 1) - 1)
end

-- làm sạch text người dùng nhập. Cắt theo byte trước tiên, rồi check UTF-8, gộp + trim khoảng trắng.
-- rỗng hoặc hỏng thì nil
function Util.cleanUserText(text, maxChars, maxBytes)
	if type(text) ~= "string" then
		return nil
	end
	maxBytes = maxBytes or 200
	if #text > maxBytes then
		text = text:sub(1, maxBytes)
		-- lỡ cắt giữa ký tự nhiều byte thì bỏ vài byte cuối
		local guard = 0
		while utf8.len(text) == nil and #text > 0 and guard < 4 do
			text = text:sub(1, -2)
			guard = guard + 1
		end
	end
	if utf8.len(text) == nil then
		return nil
	end
	text = text:gsub("[%c]", " "):gsub("%s+", " ")
	text = text:match("^%s*(.-)%s*$")
	if text == nil or #text == 0 then
		return nil
	end
	return Util.utf8Truncate(text, maxChars)
end

function Util.formatPercent(x, decimals)
	return string.format("%." .. tostring(decimals or 0) .. "f%%", x * 100)
end

function Util.indexOf(list, value)
	for i, v in ipairs(list) do
		if v == value then
			return i
		end
	end
	return nil
end

-- random có seed, để lần vẽ nào thành phố cũng ra giống nhau
function Util.seededRandom(seed)
	local state = seed % 2147483647
	if state <= 0 then
		state = state + 2147483646
	end
	return function()
		state = (state * 16807) % 2147483647
		return (state - 1) / 2147483646
	end
end

return Util
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000028"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000012"><Properties><string name="Name">EconCityServer</string></Properties><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">AdminService</string><ProtectedString name="Source"><![CDATA[-- Bảng Quản trị, chỉ owner dùng: thêm/bớt GV (publish cho mọi server), ban/unban (BanAsync, cả experience),
-- xoá data theo yêu cầu Right to be Forgotten.
-- Kho Config.DATASTORE.admin:
--   "teachers" = { ["<userId>"] = { name, addedAt, addedBy } }
--   "bans"     = { ["<userId>"] = { name, reason, days, at } }   (chỉ để hiện list)
--   "log"      = { { at, by, action, target } ... }               (30 dòng gần nhất)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("EconCity")

local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local AdminService = {}
AdminService.__index = AdminService

local STORE = Config.DATASTORE.admin

-- deps: persistence, sessions, leaderboard, isOwner(userId), setExtraTeachers(map), now,
-- getUserIdFromName / getNameFromUserId, banUser(userId, seconds, reason) / unbanUser(userId) (Players:BanAsync/UnbanAsync),
-- isInServer(userId), publish(message) tuỳ chọn
function AdminService.new(deps)
	local self = setmetatable({}, AdminService)
	for k, v in pairs(deps) do
		self[k] = v
	end
	self.now = deps.now or os.time
	return self
end

-- load list GV owner thêm rồi đẩy sang Roles
function AdminService:refresh()
	local ok, teachers = self.persistence:get(STORE, "teachers")
	if ok and self.setExtraTeachers then
		self.setExtraTeachers(type(teachers) == "table" and teachers or {})
	end
	return ok
end

function AdminService:onMessage(message)
	if type(message) == "table" and message.kind == "teachersChanged" then
		self:refresh()
	end
end

function AdminService:_log(byId, action, target)
	self.persistence:update(STORE, "log", function(old)
		local log = type(old) == "table" and old or {}
		table.insert(log, 1, { at = self.now(), by = byId, action = action, target = target })
		while #log > 30 do
			table.remove(log)
		end
		return log
	end)
end

-- input: username hoặc UserId dạng chuỗi số. Trả (userId, name) hoặc (nil, err)
function AdminService:_resolve(input)
	if type(input) == "number" then
		input = tostring(math.floor(input))
	end
	if type(input) ~= "string" then
		return nil, "Hãy nhập tên đăng nhập hoặc UserId"
	end
	input = input:gsub("^%s+", ""):gsub("%s+$", ""):gsub("^@", "")
	if #input == 0 or #input > 40 then
		return nil, "Hãy nhập tên đăng nhập hoặc UserId"
	end
	if input:match("^%d+$") then
		local userId = tonumber(input)
		local name = nil
		if self.getNameFromUserId then
			local ok, result = pcall(self.getNameFromUserId, userId)
			if ok and type(result) == "string" then
				name = result
			end
		end
		return userId, name or ("#" .. input)
	end
	if not input:match("^[%w_]+$") then
		return nil, "Tên đăng nhập chỉ gồm chữ, số và dấu _"
	end
	if not self.getUserIdFromName then
		return nil, "Không tra được tên đăng nhập ở môi trường này"
	end
	local ok, userId = pcall(self.getUserIdFromName, input)
	if not ok or type(userId) ~= "number" then
		return nil, "Không tìm thấy người dùng Roblox tên \"" .. input .. "\""
	end
	return userId, input
end

local function sortedList(map)
	local list = {}
	for key, value in pairs(type(map) == "table" and map or {}) do
		local row = Util.deepCopy(value)
		row.userId = tonumber(key) or key
		table.insert(list, row)
	end
	table.sort(list, function(a, b)
		return (a.at or a.addedAt or 0) > (b.at or b.addedAt or 0)
	end)
	return list
end

function AdminService:getState(ownerId)
	if not self.isOwner(ownerId) then
		return false, "Chỉ chủ game mới dùng được bảng quản trị"
	end
	local ok1, teachers = self.persistence:get(STORE, "teachers")
	local ok2, bans = self.persistence:get(STORE, "bans")
	local ok3, log = self.persistence:get(STORE, "log")
	if not (ok1 and ok2 and ok3) then
		return false, "Không tải được dữ liệu quản trị"
	end
	return true, {
		teachers = sortedList(teachers),
		bans = sortedList(bans),
		log = type(log) == "table" and log or {},
		persistence = self.persistence.mode,
	}
end

function AdminService:_teachersChanged()
	self:refresh()
	if self.publish then
		self.publish({ kind = "teachersChanged" })
	end
end

function AdminService:addTeacher(ownerId, input)
	if not self.isOwner(ownerId) then
		return false, "Chỉ chủ game mới thêm được giáo viên"
	end
	local userId, nameOrErr = self:_resolve(input)
	if not userId then
		return false, nameOrErr
	end
	local ok = self.persistence:update(STORE, "teachers", function(old)
		local map = type(old) == "table" and old or {}
		map[tostring(userId)] = { name = nameOrErr, addedAt = self.now(), addedBy = ownerId }
		return map
	end)
	if not ok then
		return false, "Lỗi lưu trữ, hãy thử lại"
	end
	self:_log(ownerId, "addTeacher", nameOrErr .. " (" .. userId .. ")")
	self:_teachersChanged()
	return true, { userId = userId, name = nameOrErr }
end

function AdminService:removeTeacher(ownerId, userId)
	if not self.isOwner(ownerId) then
		return false, "Chỉ chủ game mới bớt được giáo viên"
	end
	userId = tonumber(userId)
	if not userId then
		return false, "UserId không hợp lệ"
	end
	local removed = false
	local ok = self.persistence:update(STORE, "teachers", function(old)
		removed = false
		if type(old) ~= "table" or not old[tostring(userId)] then
			return nil
		end
		old[tostring(userId)] = nil
		removed = true
		return old
	end)
	if not ok then
		return false, "Lỗi lưu trữ, hãy thử lại"
	end
	if not removed then
		return false, "Người này không có trong danh sách giáo viên"
	end
	self:_log(ownerId, "removeTeacher", tostring(userId))
	self:_teachersChanged()
	return true
end

-- days 0/nil = cấm vĩnh viễn
function AdminService:ban(ownerId, input, days, reason)
	if not self.isOwner(ownerId) then
		return false, "Chỉ chủ game mới cấm được người chơi"
	end
	local userId, nameOrErr = self:_resolve(input)
	if not userId then
		return false, nameOrErr
	end
	if userId == ownerId then
		return false, "Không thể tự cấm chính mình"
	end
	days = math.floor(tonumber(days) or 0)
	if days < 0 or days > 3650 then
		return false, "Số ngày không hợp lệ"
	end
	reason = Util.cleanUserText(reason, 100, 300) or "Vi phạm nội quy lớp học"
	if not self.banUser then
		return false, "Chức năng cấm chỉ chạy khi game đã publish"
	end
	local ok, err = pcall(self.banUser, userId, days > 0 and days * 86400 or -1, reason)
	if not ok then
		return false, "Roblox từ chối lệnh cấm: " .. tostring(err)
	end
	self.persistence:update(STORE, "bans", function(old)
		local map = type(old) == "table" and old or {}
		map[tostring(userId)] = { name = nameOrErr, reason = reason, days = days, at = self.now() }
		return map
	end)
	self:_log(ownerId, "ban", nameOrErr .. " (" .. userId .. ")")
	return true, { userId = userId, name = nameOrErr }
end

function AdminService:unban(ownerId, userId)
	if not self.isOwner(ownerId) then
		return false, "Chỉ chủ game mới bỏ cấm được"
	end
	userId = tonumber(userId)
	if not userId then
		return false, "UserId không hợp lệ"
	end
	if not self.unbanUser then
		return false, "Chức năng này chỉ chạy khi game đã publish"
	end
	local ok, err = pcall(self.unbanUser, userId)
	if not ok then
		return false, "Roblox từ chối lệnh bỏ cấm: " .. tostring(err)
	end
	self.persistence:update(STORE, "bans", function(old)
		if type(old) ~= "table" or not old[tostring(userId)] then
			return nil
		end
		old[tostring(userId)] = nil
		return old
	end)
	self:_log(ownerId, "unban", tostring(userId))
	return true
end

-- xoá hết data của 1 UserId (Roblox gửi yêu cầu Right to be Forgotten qua tin nhắn)
function AdminService:deleteUserData(ownerId, input)
	if not self.isOwner(ownerId) then
		return false, "Chỉ chủ game mới xoá được dữ liệu"
	end
	local userId, nameOrErr = self:_resolve(input)
	if not userId then
		return false, nameOrErr
	end
	if self.isInServer and self.isInServer(userId) then
		return false, "Người này đang ở trong server, hãy xoá sau khi họ rời game"
	end
	local key = "u_" .. tostring(userId)
	local okRead, profile = self.persistence:get(Config.DATASTORE.profiles, key)
	if not okRead then
		return false, "Không đọc được dữ liệu, hãy thử lại"
	end
	if type(profile) == "table" and type(profile.lock) == "table"
		and (self.now() - (tonumber(profile.lock.at) or 0)) < Config.SESSION_LOCK_STALE_SECONDS then
		return false, "Người này đang chơi ở server khác, thử lại sau vài phút"
	end
	local report = { profile = profile ~= nil, classesLeft = 0, classesDeleted = 0 }
	local classes = type(profile) == "table" and type(profile.classes) == "table" and profile.classes or {}
	local teaching = type(profile) == "table" and type(profile.teaching) == "table" and profile.teaching or {}

	-- 1. rút khỏi các lớp đã vào
	for _, code in ipairs(classes) do
		if type(code) == "string" then
			self.persistence:update(Config.DATASTORE.classes, "c_" .. code, function(old)
				if type(old) ~= "table" or not old.members or not old.members[tostring(userId)] then
					return nil
				end
				old.members[tostring(userId)] = nil
				return old
			end)
			report.classesLeft = report.classesLeft + 1
		end
	end
	-- 2. lớp người này dạy có tên họ trong đó, xoá luôn hồ sơ lớp
	for _, code in ipairs(teaching) do
		if type(code) == "string" then
			local okGet, record = self.persistence:get(Config.DATASTORE.classes, "c_" .. code)
			if okGet and type(record) == "table" and record.teacherId == userId then
				self.persistence:remove(Config.DATASTORE.classes, "c_" .. code)
				report.classesDeleted = report.classesDeleted + 1
			end
		end
	end
	self.persistence:liveRemove(Config.DATASTORE.classLiveMap, "u_" .. tostring(userId))
	-- 3. BXH, kịch bản tự tạo, list quản trị
	if self.leaderboard then
		self.leaderboard:removeUser(userId, classes)
	end
	self.persistence:remove(Config.DATASTORE.scenarios, "t_" .. tostring(userId))
	-- log quản trị: bỏ mọi dòng dính tới người này
	self.persistence:update(STORE, "log", function(old)
		if type(old) ~= "table" then
			return nil
		end
		local kept = {}
		for _, row in ipairs(old) do
			if not tostring(row.target or ""):find(tostring(userId), 1, true) and row.by ~= userId then
				table.insert(kept, row)
			end
		end
		return kept
	end)
	for _, listKey in ipairs({ "teachers", "bans" }) do
		self.persistence:update(STORE, listKey, function(old)
			if type(old) ~= "table" or not old[tostring(userId)] then
				return nil
			end
			old[tostring(userId)] = nil
			return old
		end)
	end
	-- 4. profile xoá cuối: bước trước lỗi thì chạy lại vẫn còn list lớp để dọn
	local okRemove = self.persistence:remove(Config.DATASTORE.profiles, key)
	if not okRemove then
		return false, "Xoá hồ sơ thất bại, hãy chạy lại lệnh"
	end
	self:_log(ownerId, "deleteUserData", "(đã ẩn)")
	self:_teachersChanged()
	return true, report
end

return AdminService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">ClassroomService</string><ProtectedString name="Source"><![CDATA[-- Lớp học và mọi thứ GV làm với lớp: tiến độ HS, gán kịch bản, CSV, phòng học riêng.
-- Lớp: Config.DATASTORE.classes, key "c_<MÃ>":
--   { code, name, teacherId, teacherName, createdAt, nextSeq,
--     members = { ["<userId>"] = { name, joinedAt, summary } },
--     room = { accessCode, privateServerId, openedAt } | nil,
--     scenarioLog = { { seq, scenarioId, def?, at, by } ... } (mới nhất trước) }
-- Kịch bản tự tạo: Config.DATASTORE.scenarios, key "t_<teacherId>":
--   { nextId, list = { { id, name, description, severity, durationMonths, effects, createdAt } } }
-- Tiến độ sống: MemoryStore key "u_<userId>" (2 phút không refresh là hết hạn) + bộ nhớ server.
-- members[...].summary chỉ ghi lúc HS rời game / xong ván, tránh ghi dồn vào 1 key.
-- HS vắng lúc gán kịch bản thì nhận khi vào lại (profile.scenarioSync[mã lớp] = seq cuối đã nhận)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("EconCity")

local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local GameTick = require(Shared:WaitForChild("GameTick"))
local Scenarios = require(Shared:WaitForChild("Scenarios"))
local CityEngine = require(Shared:WaitForChild("CityEngine"))

local ClassroomService = {}
ClassroomService.__index = ClassroomService

local MAX_NAME_CHARS = 40
local MAX_DESCRIPTION_CHARS = 120
local MAX_SCENARIO_LOG = 20

-- deps: persistence, sessions, isTeacher(userId), now, random. Tuỳ chọn: publish(message) (MessagingService),
-- notify(userId, text), reserveServer() trả (accessCode, privateServerId), teleportToRoom(userId, accessCode).
-- currentPrivateServerId: "" nếu server thường
-- filterText(text, userId): bắt buộc cho chữ người chơi nhập mà người khác thấy
function ClassroomService.new(deps)
	local self = setmetatable({}, ClassroomService)
	self.persistence = deps.persistence
	self.sessions = deps.sessions
	self.isTeacher = deps.isTeacher or function()
		return false
	end
	self.now = deps.now or os.time
	self.random = deps.random or math.random
	self.publish = deps.publish
	self.notify = deps.notify
	self.reserveServer = deps.reserveServer
	self.teleportToRoom = deps.teleportToRoom
	self.currentPrivateServerId = deps.currentPrivateServerId or ""
	self.filterText = deps.filterText
	self.liveSummaries = {} -- [userId] = detail của người chơi trong server này
	self.pendingWrites = 0 -- số lần ghi tóm tắt lớp đang chạy, server chờ trước khi tắt
	return self
end

local function classKey(code)
	return "c_" .. code
end

local function scenarioStoreKey(teacherId)
	return "t_" .. tostring(teacherId)
end

local function liveKey(userId)
	return "u_" .. tostring(userId)
end
ClassroomService.liveKey = liveKey

-- history nén: mỗi tháng 1 mảng { tháng, ngân sách, doanh thu, hạnh phúc, % việc làm, dân số }, nhỏ đi ~2 lần
-- v = 2 là luật xây thành phố. Bản cũ cột 5 là lạm phát, đừng đọc thành việc làm
local PACK_VERSION = 2
local function packHistory(history)
	local out = {}
	for _, h in ipairs(history or {}) do
		table.insert(out, { h.month, h.budget, h.gdp, h.happiness, h.employment, h.population })
	end
	return out
end

local function unpackHistory(packed, current)
	local out = {}
	for _, row in ipairs(packed or {}) do
		if type(row) == "table" then
			if type(row[1]) == "number" then
				table.insert(out, { month = row[1], budget = row[2], gdp = row[3], happiness = row[4], employment = current and row[5] or nil, population = row[6] })
			else
				table.insert(out, row) -- dạng cũ
			end
		end
	end
	return out
end

local DETAIL_FIELDS = { "sessionId", "month", "maxMonths", "status", "budget", "gdp", "happiness", "employment", "population", "tax", "prosperityScore", "updatedAt", "finishedGame", "finishedAt" }

-- full: thêm city + sự kiện (bản sống). Không full: chỉ số liệu + history (bản lưu trong lớp)
local function packDetail(detail, full)
	local out = { h = packHistory(detail.history), v = PACK_VERSION }
	for _, key in ipairs(DETAIL_FIELDS) do
		out[key] = detail[key]
	end
	if full then
		out.city = detail.city
		out.scenarios = detail.scenarios
	end
	return out
end

local function unpackDetail(packed)
	if type(packed) ~= "table" then
		return nil
	end
	local out = {}
	for k, v in pairs(packed) do
		out[k] = v
	end
	out.history = packed.history or unpackHistory(packed.h, packed.v == PACK_VERSION)
	out.h = nil
	return out
end
ClassroomService.packDetail = packDetail
ClassroomService.unpackDetail = unpackDetail

local function normalizeCode(code)
	if type(code) ~= "string" or #code > 40 then
		return nil
	end
	code = string.upper((code:gsub("%s+", "")))
	if #code < 3 or #code > 12 or code:find("[^%w]") then
		return nil
	end
	return code
end
ClassroomService.normalizeCode = normalizeCode

-- cắt theo ký tự, không theo byte, không thì vỡ chữ có dấu (DataStore từ chối UTF-8 hỏng)
local function trimName(name)
	return Util.cleanUserText(name, MAX_NAME_CHARS, Config.MAX_TEXT_BYTES)
end
ClassroomService.trimName = trimName

local function countMembers(record)
	local count = 0
	for _ in pairs(record.members or {}) do
		count = count + 1
	end
	return count
end

local function contains(list, value)
	for _, v in ipairs(list or {}) do
		if v == value then
			return true
		end
	end
	return false
end

function ClassroomService:_generateCode()
	local alphabet = Config.CLASS_CODE_ALPHABET
	local chars = {}
	for i = 1, Config.CLASS_CODE_LENGTH do
		local idx = math.floor(self.random() * #alphabet) + 1
		chars[i] = alphabet:sub(idx, idx)
	end
	return table.concat(chars)
end

-- lọc qua TextService, lỗi thì nil
function ClassroomService:_filter(text, userId)
	if not self.filterText then
		return text
	end
	local ok, filtered = pcall(self.filterText, text, userId)
	if ok and type(filtered) == "string" and #filtered > 0 then
		return filtered
	end
	return nil
end

function ClassroomService:getClass(code)
	code = normalizeCode(code)
	if not code then
		return nil
	end
	local ok, record = self.persistence:get(Config.DATASTORE.classes, classKey(code))
	if ok and type(record) == "table" then
		return record
	end
	return nil
end

function ClassroomService:_isMemberRecord(record, userId)
	return (record.members or {})[tostring(userId)] ~= nil
end

function ClassroomService:_inThisRoom(record)
	return record.room ~= nil and self.currentPrivateServerId ~= ""
		and record.room.privateServerId == self.currentPrivateServerId
end

-- Giáo viên

function ClassroomService:createClass(teacherId, teacherName, className)
	if not self.isTeacher(teacherId) then
		return false, "Chỉ giáo viên mới tạo được lớp"
	end
	local profile = self.sessions:getProfile(teacherId)
	if not profile then
		return false, "Dữ liệu chưa tải xong, thử lại sau giây lát"
	end
	className = trimName(className)
	if not className then
		return false, "Hãy nhập tên lớp"
	end
	if #profile.teaching >= Config.MAX_CLASSES_PER_TEACHER then
		return false, "Đã đạt số lớp tối đa (" .. Config.MAX_CLASSES_PER_TEACHER .. ")"
	end
	-- tên lớp hiện cho HS nên phải lọc. Lọc lỗi thì dùng "Lớp <mã>"
	local filteredName = self:_filter(className, teacherId)
	for _ = 1, 8 do
		local code = self:_generateCode()
		local finalName = filteredName or ("Lớp " .. code)
		local created = nil
		local ok = self.persistence:update(Config.DATASTORE.classes, classKey(code), function(old)
			created = nil
			if old ~= nil then
				return nil -- trùng mã, thử mã khác
			end
			created = {
				code = code,
				name = finalName,
				teacherId = teacherId,
				teacherName = teacherName,
				createdAt = self.now(),
				nextSeq = 1,
				members = {},
				scenarioLog = {},
			}
			return created
		end)
		if ok and created then
			table.insert(profile.teaching, 1, code)
			self.sessions:requestSave(teacherId, false)
			return true, { code = code, name = finalName, renamed = filteredName == nil }
		end
		if not ok then
			return false, "Lỗi lưu trữ, hãy thử lại"
		end
	end
	return false, "Không tạo được mã lớp, hãy thử lại"
end

function ClassroomService:getTeacherClasses(teacherId)
	local profile = self.sessions:getProfile(teacherId)
	if not profile then
		return false, "Dữ liệu chưa tải xong, thử lại sau giây lát"
	end
	local out = {}
	for _, code in ipairs(profile.teaching) do
		local record = self:getClass(code)
		if record and record.teacherId == teacherId then
			table.insert(out, {
				code = record.code,
				name = record.name,
				memberCount = countMembers(record),
				roomOpen = record.room ~= nil,
				inRoom = self:_inThisRoom(record),
			})
		end
	end
	return true, out
end

function ClassroomService:_assertOwner(teacherId, code)
	local record = self:getClass(code)
	if not record then
		return nil, "Không tìm thấy lớp"
	end
	if record.teacherId ~= teacherId then
		return nil, "Bạn không phải giáo viên của lớp này"
	end
	return record
end

-- lấy theo thứ tự: server này, MemoryStore (server khác), bản lưu trong lớp
function ClassroomService:_memberProgress(record, userId, member)
	local detail = self.liveSummaries[userId]
	local inThisServer = self.sessions:getProfile(userId) ~= nil
	if not detail then
		local ok, live = self.persistence:liveGet(Config.DATASTORE.classLiveMap, liveKey(userId))
		if ok and type(live) == "table" then
			detail = unpackDetail(live)
		end
	end
	detail = detail or unpackDetail(member.summary)
	local online = inThisServer
	if not online and type(detail) == "table" and tonumber(detail.updatedAt) then
		online = (self.now() - detail.updatedAt) <= Config.ONLINE_WINDOW_SECONDS
	end
	return detail, online
end

local function shortSummary(detail)
	if type(detail) ~= "table" then
		return nil
	end
	return {
		month = detail.month,
		maxMonths = detail.maxMonths,
		status = detail.status,
		budget = detail.budget,
		gdp = detail.gdp,
		happiness = detail.happiness,
		prosperityScore = detail.prosperityScore,
		updatedAt = detail.updatedAt,
	}
end

function ClassroomService:_scenarioName(entry)
	if entry.def and entry.def.name then
		return entry.def.name
	end
	local def = Scenarios.get(entry.scenarioId)
	return def and def.name or tostring(entry.scenarioId)
end

-- roster + tiến độ. Online lấy bản sống, offline lấy bản lưu gần nhất
function ClassroomService:getRoster(teacherId, code)
	local record, err = self:_assertOwner(teacherId, code)
	if not record then
		return false, err
	end
	local rows = {}
	for userIdText, member in pairs(record.members or {}) do
		local userId = tonumber(userIdText) or userIdText
		local detail, online = self:_memberProgress(record, userId, member)
		table.insert(rows, {
			userId = userId,
			name = member.name,
			online = online,
			summary = shortSummary(detail),
		})
	end
	table.sort(rows, function(a, b)
		return tostring(a.name) < tostring(b.name)
	end)
	local log = {}
	for i, entry in ipairs(record.scenarioLog or {}) do
		if i > 5 then
			break
		end
		table.insert(log, { name = self:_scenarioName(entry), at = entry.at })
	end
	return true, {
		code = record.code,
		name = record.name,
		members = rows,
		roomOpen = record.room ~= nil,
		inRoom = self:_inThisRoom(record),
		scenarioLog = log,
	}
end

-- history từng tháng, công trình, sự kiện đang chạy
function ClassroomService:getStudentDetail(teacherId, code, studentId)
	local record, err = self:_assertOwner(teacherId, code)
	if not record then
		return false, err
	end
	studentId = tonumber(studentId)
	local member = studentId and (record.members or {})[tostring(studentId)]
	if not member then
		return false, "Học sinh không thuộc lớp này"
	end
	local detail, online = self:_memberProgress(record, studentId, member)
	return true, {
		userId = studentId,
		name = member.name,
		joinedAt = member.joinedAt,
		online = online,
		detail = detail,
	}
end

local function csvField(value)
	local s = tostring(value == nil and "" or value)
	if s:find('[,"\r\n]') then
		s = '"' .. s:gsub('"', '""') .. '"'
	end
	return s
end

-- mỗi dòng = 1 HS x 1 tháng của ván gần nhất
function ClassroomService:exportClassCsv(teacherId, code)
	local record, err = self:_assertOwner(teacherId, code)
	if not record then
		return false, err
	end
	local lines = {
		"student_name,user_id,session_status,month,budget,revenue,happiness,employment_pct,population,prosperity_score",
	}
	local members = {}
	for userIdText, member in pairs(record.members or {}) do
		table.insert(members, { id = tonumber(userIdText) or userIdText, member = member })
	end
	table.sort(members, function(a, b)
		return tostring(a.member.name) < tostring(b.member.name)
	end)
	local rows = 0
	for _, m in ipairs(members) do
		local detail = self:_memberProgress(record, m.id, m.member)
		local name = csvField(m.member.name)
		if type(detail) == "table" and type(detail.history) == "table" and #detail.history > 0 then
			for _, h in ipairs(detail.history) do
				table.insert(lines, table.concat({
					name,
					tostring(m.id),
					csvField(detail.status),
					tostring(h.month),
					tostring(h.budget),
					tostring(h.gdp),
					tostring(h.happiness),
					h.employment and string.format("%.1f", h.employment) or "",
					tostring(h.population or ""),
					h.month == detail.month and tostring(detail.prosperityScore or "") or "",
				}, ","))
				rows = rows + 1
			end
		else
			table.insert(lines, table.concat({ name, tostring(m.id), "NO_DATA", "0", "", "", "", "", "", "" }, ","))
			rows = rows + 1
		end
	end
	return true, { csv = table.concat(lines, "\n"), rows = rows, code = record.code, name = record.name }
end

-- Kịch bản

function ClassroomService:_loadCustomScenarios(teacherId)
	local ok, data = self.persistence:get(Config.DATASTORE.scenarios, scenarioStoreKey(teacherId))
	if not ok then
		return nil
	end
	if type(data) ~= "table" or type(data.list) ~= "table" then
		return { nextId = 1, list = {} }
	end
	return data
end

function ClassroomService:listScenarios(teacherId)
	if not self.isTeacher(teacherId) then
		return false, "Chỉ dành cho giáo viên"
	end
	local catalog = {}
	for _, s in ipairs(Scenarios.CATALOG) do
		table.insert(catalog, {
			id = s.id,
			name = s.name,
			description = s.description,
			severity = s.severity,
			durationMonths = s.durationMonths,
		})
	end
	local data = self:_loadCustomScenarios(teacherId)
	if not data then
		return false, "Không tải được kịch bản tuỳ chỉnh"
	end
	return true, { catalog = catalog, custom = data.list, max = Config.MAX_CUSTOM_SCENARIOS }
end

-- payload: { name, description, severity, durationMonths, effects }
function ClassroomService:createScenario(teacherId, payload)
	if not self.isTeacher(teacherId) then
		return false, "Chỉ giáo viên mới tạo được kịch bản"
	end
	if type(payload) ~= "table" then
		return false, "Dữ liệu không hợp lệ"
	end
	local name = trimName(payload.name)
	if not name then
		return false, "Hãy đặt tên cho kịch bản"
	end
	local description = Util.cleanUserText(payload.description, MAX_DESCRIPTION_CHARS, 400) or ""
	local clean, err = Scenarios.sanitizeCustom(payload)
	if not clean then
		return false, err
	end
	-- tên/mô tả hiện cho HS, lọc trước khi lưu
	local filteredName = self:_filter(name, teacherId)
	if not filteredName then
		return false, "Chưa kiểm duyệt được tên kịch bản, hãy thử lại sau"
	end
	local filteredDescription = ""
	if description ~= "" then
		filteredDescription = self:_filter(description, teacherId)
		if not filteredDescription then
			return false, "Chưa kiểm duyệt được mô tả, hãy thử lại sau"
		end
	end
	local created, reason = nil, nil
	local ok = self.persistence:update(Config.DATASTORE.scenarios, scenarioStoreKey(teacherId), function(old)
		created, reason = nil, nil
		local data = (type(old) == "table" and type(old.list) == "table") and old or { nextId = 1, list = {} }
		if #data.list >= Config.MAX_CUSTOM_SCENARIOS then
			reason = "Đã đạt số kịch bản tối đa (" .. Config.MAX_CUSTOM_SCENARIOS .. ")"
			return nil
		end
		local n = tonumber(data.nextId) or (#data.list + 1)
		data.nextId = n + 1
		created = {
			id = "c_" .. tostring(teacherId) .. "_" .. tostring(n),
			name = filteredName,
			description = filteredDescription,
			severity = clean.severity,
			durationMonths = clean.durationMonths,
			effects = clean.effects,
			createdAt = self.now(),
		}
		table.insert(data.list, created)
		return data
	end)
	if not ok then
		return false, "Lỗi lưu trữ, hãy thử lại"
	end
	if not created then
		return false, reason or "Không tạo được kịch bản"
	end
	return true, created
end

function ClassroomService:deleteScenario(teacherId, scenarioId)
	if not self.isTeacher(teacherId) then
		return false, "Chỉ dành cho giáo viên"
	end
	if type(scenarioId) ~= "string" then
		return false, "Kịch bản không hợp lệ"
	end
	local removed = false
	local ok = self.persistence:update(Config.DATASTORE.scenarios, scenarioStoreKey(teacherId), function(old)
		removed = false
		if type(old) ~= "table" or type(old.list) ~= "table" then
			return nil
		end
		for i = #old.list, 1, -1 do
			if old.list[i].id == scenarioId then
				table.remove(old.list, i)
				removed = true
			end
		end
		if not removed then
			return nil
		end
		return old
	end)
	if not ok then
		return false, "Lỗi lưu trữ, hãy thử lại"
	end
	if not removed then
		return false, "Không tìm thấy kịch bản"
	end
	return true
end

-- áp sự kiện lớp vào hồ sơ đang nạp nếu chưa nhận. true = đã thêm vào phiên
function ClassroomService:_applyEntry(userId, profile, code, entry, silent)
	if not contains(profile.classes, code) then
		return false
	end
	profile.scenarioSync = profile.scenarioSync or {}
	local synced = tonumber(profile.scenarioSync[code]) or 0
	if (tonumber(entry.seq) or 0) <= synced then
		return false -- nhận rồi, server khác phát lại thì bỏ qua
	end
	profile.scenarioSync[code] = entry.seq
	local session = profile.session
	if not session or GameTick.isFinished(session) then
		return false
	end
	local added = GameTick.addScenario(session, entry.scenarioId, { classCode = code, assignedBy = entry.by }, entry.def)
	if added and self.notify and not silent then
		self.notify(userId, "Giáo viên vừa gán sự kiện: " .. self:_scenarioName(entry))
	end
	return added and true or false
end

-- chỉ HS của lớp đang ở server này
function ClassroomService:applyEntryLocally(code, entry)
	local applied = 0
	for userId, profile in pairs(self.sessions.profiles) do
		-- đang teleport sang phòng riêng: hồ sơ đã lưu cuối, nhận bù ở server mới
		if not profile.teleporting and self:_applyEntry(userId, profile, code, entry, false) then
			applied = applied + 1
			self.sessions:requestSave(userId, false)
		end
	end
	return applied
end

function ClassroomService:assignScenario(teacherId, code, scenarioId)
	local record, err = self:_assertOwner(teacherId, code)
	if not record then
		return false, err
	end
	if type(scenarioId) ~= "string" then
		return false, "Kịch bản không tồn tại"
	end
	local def = nil
	if not Scenarios.get(scenarioId) then
		local data = self:_loadCustomScenarios(teacherId)
		if not data then
			return false, "Không tải được kịch bản tuỳ chỉnh"
		end
		for _, s in ipairs(data.list) do
			if s.id == scenarioId then
				def = {
					name = s.name,
					description = s.description,
					severity = s.severity,
					durationMonths = s.durationMonths,
					effects = s.effects,
				}
			end
		end
		if not def then
			return false, "Kịch bản không tồn tại"
		end
	end
	-- ghi log lớp trước (HS vắng nhận sau), rồi mới áp cho người đang chơi
	local entry = nil
	local ok = self.persistence:update(Config.DATASTORE.classes, classKey(record.code), function(old)
		entry = nil
		if type(old) ~= "table" then
			return nil
		end
		old.scenarioLog = old.scenarioLog or {}
		local seq = tonumber(old.nextSeq) or 1
		for _, e in ipairs(old.scenarioLog) do
			seq = math.max(seq, (tonumber(e.seq) or 0) + 1)
		end
		old.nextSeq = seq + 1
		entry = { seq = seq, scenarioId = scenarioId, def = def, at = self.now(), by = teacherId }
		table.insert(old.scenarioLog, 1, entry)
		while #old.scenarioLog > MAX_SCENARIO_LOG do
			table.remove(old.scenarioLog)
		end
		return old
	end)
	if not ok or not entry then
		return false, "Lỗi lưu trữ, hãy thử lại"
	end
	local appliedHere = self:applyEntryLocally(record.code, entry)
	local broadcast = false
	if self.publish then
		-- chỉ gửi mã lớp + seq cho luôn < 1 KB, server nhận tự đọc entry từ hồ sơ lớp
		broadcast = self.publish({ kind = "assignScenario", code = record.code, seq = entry.seq }) and true or false
	end
	return true, {
		appliedHere = appliedHere,
		memberCount = countMembers(record),
		broadcast = broadcast,
		name = self:_scenarioName(entry),
	}
end

-- HS vừa vào game: nhận sự kiện gán lúc vắng, chỉ trong 7 ngày gần nhất (SCENARIO_SYNC_MAX_AGE)
function ClassroomService:syncPendingScenarios(userId, profile)
	if not profile or not profile.session then
		return 0
	end
	local applied = 0
	local now = self.now()
	for _, code in ipairs(profile.classes or {}) do
		local record = self:getClass(code)
		if record and self:_isMemberRecord(record, userId) then
			local log = record.scenarioLog or {}
			-- log mới nhất đứng đầu nên duyệt ngược, cũ tới mới
			for i = #log, 1, -1 do
				local entry = log[i]
				if type(entry) == "table" and tonumber(entry.seq) then
					if (now - (tonumber(entry.at) or 0)) <= Config.SCENARIO_SYNC_MAX_AGE then
						if self:_applyEntry(userId, profile, code, entry, true) then
							applied = applied + 1
						end
					else
						-- quá cũ: đánh dấu đã nhận, không áp nữa
						profile.scenarioSync = profile.scenarioSync or {}
						if (tonumber(profile.scenarioSync[code]) or 0) < entry.seq then
							profile.scenarioSync[code] = entry.seq
						end
					end
				end
			end
		end
	end
	if applied > 0 and self.notify then
		self.notify(userId, "Trong lúc bạn vắng mặt, giáo viên đã gán " .. applied .. " sự kiện mới.")
	end
	return applied
end

-- message từ server khác (MessagingService)
function ClassroomService:onMessage(message)
	if type(message) ~= "table" then
		return
	end
	local code = normalizeCode(message.code)
	if not code then
		return
	end
	if message.kind == "assignScenario" and tonumber(message.seq) and not message.entry then
		-- server này không có HS lớp đó thì khỏi đọc DataStore
		local anyMember = false
		for _, profile in pairs(self.sessions.profiles) do
			if contains(profile.classes, code) and not profile.teleporting then
				anyMember = true
				break
			end
		end
		if not anyMember then
			return
		end
		local record = self:getClass(code)
		if not record then
			return
		end
		for _, entry in ipairs(record.scenarioLog or {}) do
			if tonumber(entry.seq) == tonumber(message.seq) then
				self:applyEntryLocally(code, entry)
				return
			end
		end
	elseif message.kind == "assignScenario" and type(message.entry) == "table" then
		-- dạng cũ: server bản cũ gửi kèm nguyên sự kiện
		local entry = message.entry
		if type(entry.scenarioId) ~= "string" or not tonumber(entry.seq) then
			return
		end
		if not Scenarios.get(entry.scenarioId) then
			if type(entry.def) ~= "table" then
				return
			end
			-- data từ server khác vẫn sanitize lại
			local clean = Scenarios.sanitizeCustom(entry.def)
			if not clean then
				return
			end
			entry.def = {
				name = Util.cleanUserText(entry.def.name, MAX_NAME_CHARS, Config.MAX_TEXT_BYTES) or "Sự kiện của giáo viên",
				description = Util.cleanUserText(entry.def.description, MAX_DESCRIPTION_CHARS, 400) or "",
				severity = clean.severity,
				durationMonths = clean.durationMonths,
				effects = clean.effects,
			}
		end
		self:applyEntryLocally(code, entry)
	elseif message.kind == "roomOpened" then
		self:_notifyMembersHere(code, "Giáo viên đã mở phòng học riêng cho lớp " .. code .. ". Mở mục Lớp học để vào phòng.")
	end
end

function ClassroomService:_notifyMembersHere(code, text)
	if not self.notify then
		return
	end
	for userId, profile in pairs(self.sessions.profiles) do
		if contains(profile.classes, code) then
			self.notify(userId, text)
		end
	end
end

-- Phòng học riêng

-- reserved server cho lớp. Đã có phòng thì dùng lại
function ClassroomService:openRoom(teacherId, code)
	local record, err = self:_assertOwner(teacherId, code)
	if not record then
		return false, err
	end
	if record.room and record.room.accessCode then
		return true, { code = record.code, reused = true }
	end
	if not self.reserveServer then
		return false, "Phòng học riêng chỉ chạy khi game đã publish"
	end
	local okReserve, accessCode, privateServerId = pcall(self.reserveServer)
	if not okReserve or type(accessCode) ~= "string" then
		return false, "Phòng học riêng chỉ chạy khi game đã publish, trong Studio thì không"
	end
	local saved = false
	local ok = self.persistence:update(Config.DATASTORE.classes, classKey(record.code), function(old)
		saved = false
		if type(old) ~= "table" then
			return nil
		end
		if old.room and old.room.accessCode then
			saved = true -- server khác vừa mở trước, giữ phòng đó
			return nil
		end
		old.room = { accessCode = accessCode, privateServerId = privateServerId, openedAt = self.now() }
		saved = true
		return old
	end)
	if not ok or not saved then
		return false, "Không lưu được phòng học, hãy thử lại"
	end
	self:_notifyMembersHere(record.code, "Giáo viên đã mở phòng học riêng cho lớp " .. record.code .. ". Mở mục Lớp học để vào phòng.")
	if self.publish then
		self.publish({ kind = "roomOpened", code = record.code })
	end
	return true, { code = record.code, reused = false }
end

function ClassroomService:closeRoom(teacherId, code)
	local record, err = self:_assertOwner(teacherId, code)
	if not record then
		return false, err
	end
	local ok = self.persistence:update(Config.DATASTORE.classes, classKey(record.code), function(old)
		if type(old) ~= "table" then
			return nil
		end
		old.room = nil
		return old
	end)
	if not ok then
		return false, "Lỗi lưu trữ, hãy thử lại"
	end
	return true
end

function ClassroomService:enterRoom(userId, code)
	local record = self:getClass(code)
	if not record then
		return false, "Không tìm thấy lớp"
	end
	local isMember = record.teacherId == userId or self:_isMemberRecord(record, userId)
	if not isMember then
		return false, "Bạn chưa tham gia lớp này"
	end
	if not record.room or not record.room.accessCode then
		return false, "Lớp chưa mở phòng học riêng"
	end
	if self:_inThisRoom(record) then
		return false, "Bạn đang ở trong phòng học riêng của lớp này rồi"
	end
	if not self.teleportToRoom then
		return false, "Phòng học riêng chỉ chạy khi game đã publish"
	end
	local ok, err = pcall(self.teleportToRoom, userId, record.room.accessCode)
	if not ok then
		return false, "Không chuyển được vào phòng: " .. tostring(err)
	end
	return true
end

-- Học sinh

function ClassroomService:joinClass(userId, name, code)
	code = normalizeCode(code)
	if not code then
		return false, "Mã lớp không hợp lệ"
	end
	local profile = self.sessions:getProfile(userId)
	if not profile then
		return false, "Dữ liệu chưa tải xong, thử lại sau giây lát"
	end
	if contains(profile.classes, code) then
		return false, "Bạn đã ở trong lớp này rồi"
	end
	if #profile.classes >= Config.MAX_CLASSES_PER_STUDENT then
		return false, "Bạn đã tham gia tối đa " .. Config.MAX_CLASSES_PER_STUDENT .. " lớp"
	end
	local joined, reason, lastSeq = nil, nil, 0
	local ok = self.persistence:update(Config.DATASTORE.classes, classKey(code), function(old)
		joined, reason, lastSeq = nil, nil, 0
		if type(old) ~= "table" then
			reason = "Không tìm thấy lớp với mã " .. code
			return nil
		end
		if old.teacherId == userId then
			reason = "Bạn là giáo viên của lớp này"
			return nil
		end
		old.members = old.members or {}
		local key = tostring(userId)
		if not old.members[key] then
			if countMembers(old) >= Config.MAX_CLASS_MEMBERS then
				reason = "Lớp đã đủ học sinh"
				return nil
			end
			old.members[key] = { name = name, joinedAt = self.now() }
		end
		for _, e in ipairs(old.scenarioLog or {}) do
			lastSeq = math.max(lastSeq, tonumber(e.seq) or 0)
		end
		joined = { code = old.code, name = old.name, teacherName = old.teacherName }
		return old
	end)
	if not ok then
		return false, "Lỗi lưu trữ, hãy thử lại"
	end
	if not joined then
		return false, reason or "Không tham gia được lớp"
	end
	table.insert(profile.classes, code)
	-- sự kiện gán trước lúc vào lớp thì không áp cho HS mới
	profile.scenarioSync = profile.scenarioSync or {}
	profile.scenarioSync[code] = lastSeq
	self.sessions:requestSave(userId, false)
	self:recordProgress(userId, profile)
	return true, joined
end

function ClassroomService:leaveClass(userId, code)
	code = normalizeCode(code)
	local profile = self.sessions:getProfile(userId)
	if not code or not profile then
		return false, "Mã lớp không hợp lệ"
	end
	if not contains(profile.classes, code) then
		return false, "Bạn không ở trong lớp này"
	end
	local ok = self.persistence:update(Config.DATASTORE.classes, classKey(code), function(old)
		if type(old) ~= "table" or not old.members or not old.members[tostring(userId)] then
			return nil
		end
		old.members[tostring(userId)] = nil
		return old
	end)
	if not ok then
		return false, "Lỗi lưu trữ, hãy thử lại"
	end
	for i = #profile.classes, 1, -1 do
		if profile.classes[i] == code then
			table.remove(profile.classes, i)
		end
	end
	if profile.scenarioSync then
		profile.scenarioSync[code] = nil
	end
	self.sessions:requestSave(userId, false)
	return true
end

function ClassroomService:getMyClasses(userId)
	local profile = self.sessions:getProfile(userId)
	if not profile then
		return false, "Dữ liệu chưa tải xong, thử lại sau giây lát"
	end
	local out = {}
	for _, code in ipairs(profile.classes) do
		local record = self:getClass(code)
		if record then
			table.insert(out, {
				code = record.code,
				name = record.name,
				teacherName = record.teacherName,
				roomOpen = record.room ~= nil,
				inRoom = self:_inThisRoom(record),
			})
		end
	end
	return true, out
end

-- Tiến độ

-- cho bảng tiến độ, getStudentDetail, CSV
function ClassroomService:detailOf(session)
	local detail = GameTick.summary(session, true)
	detail.updatedAt = self.now()
	detail.tax = session.tax
	-- số công trình từng loại + số cái chưa nối đường
	local d = CityEngine.compute(session, session.population or 0)
	local unconnected = 0
	for i, kind in ipairs(session.cells or {}) do
		-- chỉ đếm ô góc (mỗi công trình 1 lần), bỏ đường
		if Config.BUILDINGS[kind] and kind ~= "road" and not d.conn[i] then
			unconnected = unconnected + 1
		end
	end
	detail.city = { counts = d.counts, unconnected = unconnected }
	detail.scenarios = {}
	for _, s in ipairs(session.scenarios or {}) do
		local def = Scenarios.get(s.id)
		table.insert(detail.scenarios, { name = (def and def.name) or s.name or s.id, monthsLeft = Scenarios.monthsLeft(s) })
	end
	return detail
end

-- HS vừa xong ván, ván mới chưa qua tháng nào: vẫn báo kết quả ván cũ, không để "Tháng 0" đè lên
function ClassroomService:detailForProfile(profile, leaving)
	local session = profile.session
	local detail
	if (not session or (session.month or 0) == 0) and type(profile.lastFinished) == "table" then
		detail = Util.deepCopy(profile.lastFinished)
		detail.updatedAt = self.now()
		detail.finishedGame = true
	elseif session then
		detail = self:detailOf(session)
	else
		return nil
	end
	if leaving and detail.status == GameTick.STATUS.ACTIVE then
		detail.status = GameTick.STATUS.PAUSED -- rời game thì phiên tự pause
	end
	return detail
end

-- gọi mỗi lượt cho mọi người chơi trong server, kể cả đang pause (để biết ai online)
function ClassroomService:recordProgress(userId, profile)
	if not profile then
		return
	end
	local detail = self:detailForProfile(profile, false)
	if not detail then
		return
	end
	self.liveSummaries[userId] = detail
	if #(profile.classes or {}) > 0 then
		self.persistence:liveSet(Config.DATASTORE.classLiveMap, liveKey(userId), packDetail(detail, true), Config.LIVE_SUMMARY_TTL)
	end
end

-- ghi summary vào hồ sơ lớp, chỉ lúc xong ván / rời game
function ClassroomService:persistProgress(userId, profile, leaving)
	if not profile then
		return
	end
	local detail = self:detailForProfile(profile, leaving)
	if not detail then
		return
	end
	local stored = packDetail(detail, false)
	local classes = { table.unpack(profile.classes or {}) }
	self.pendingWrites = self.pendingWrites + 1
	local ok, err = pcall(function()
		for _, code in ipairs(classes) do
			self.persistence:update(Config.DATASTORE.classes, classKey(code), function(old)
				if type(old) ~= "table" or not old.members then
					return nil
				end
				local member = old.members[tostring(userId)]
				if not member then
					return nil
				end
				member.summary = stored
				return old
			end)
		end
	end)
	self.pendingWrites = self.pendingWrites - 1
	if not ok then
		print("[EconCity] Lỗi lưu tiến độ lớp: " .. tostring(err))
	end
end

-- rời server: xoá bản sống để roster lấy bản lưu, hiện offline ngay
function ClassroomService:forget(userId)
	self.liveSummaries[userId] = nil
	self.persistence:liveRemove(Config.DATASTORE.classLiveMap, liveKey(userId))
end

return ClassroomService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[-- BXH toàn cầu + theo lớp, tính theo "điểm thịnh vượng". Mỗi người chỉ giữ điểm cao nhất (1 dòng/người).
-- OrderedDataStore chỉ lưu số nguyên nên điểm x100.
-- cache kết quả đọc LEADERBOARD_CACHE_SECONDS giây cho khỏi vượt quota DataStore

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("EconCity")

local Config = require(Shared:WaitForChild("Config"))

local LeaderboardService = {}
LeaderboardService.__index = LeaderboardService

local SCALE = 100
local NAME_RETRY_SECONDS = 300

-- deps: persistence, resolveName(userId), getClass(code) (record hoặc nil),
--   resolveNames({userId...}) trả { [userId] = tên } (tuỳ chọn, tra gộp 1 lần), clock (os.clock, để hết hạn cache)
function LeaderboardService.new(deps)
	local self = setmetatable({}, LeaderboardService)
	self.persistence = deps.persistence
	self.resolveNames = deps.resolveNames
	self.resolveName = deps.resolveName
	self.getClass = deps.getClass
	self.clock = deps.clock or os.clock
	self.names = {}
	self.nameFailedAt = {} -- [userId] = lúc tra tên lỗi, để không retry liên tục
	self.lastSubmitted = {} -- [storeName|userId] = điểm đã ghi ok, tránh ghi thừa
	self.cache = {} -- [storeName] = { at, entries }
	return self
end

local function classStore(code)
	return Config.DATASTORE.leaderboardClassPrefix .. code
end
LeaderboardService.classStore = classStore

local function validUser(userId)
	-- Player1, Player2... trong Studio có UserId <= 0, không đưa lên bảng
	return type(userId) == "number" and userId > 0
end

function LeaderboardService:rememberName(userId, name)
	if name then
		self.names[userId] = name
	end
end

function LeaderboardService:_submitTo(storeName, userId, score)
	local cacheKey = storeName .. "|" .. tostring(userId)
	local last = self.lastSubmitted[cacheKey]
	if last and score <= last then
		return
	end
	local ok = self.persistence:orderedSetMax(storeName, tostring(userId), score * SCALE)
	if ok then
		self.lastSubmitted[cacheKey] = score
	end
end

-- chỉ ghi nếu cao hơn điểm đã có
function LeaderboardService:submit(userId, name, score, classCodes)
	if not validUser(userId) or type(score) ~= "number" or score <= 0 then
		return
	end
	self:rememberName(userId, name)
	self:_submitTo(Config.DATASTORE.leaderboardGlobal, userId, score)
	for _, code in ipairs(classCodes or {}) do
		self:_submitTo(classStore(code), userId, score)
	end
end

-- dùng khi xoá data theo yêu cầu. Xoá cả ở bảng luật cũ (LEGACY_LEADERBOARDS) dù giờ không ghi nữa
function LeaderboardService:removeUser(userId, classCodes)
	local id = tostring(userId)
	self.persistence:orderedRemove(Config.DATASTORE.leaderboardGlobal, id)
	for _, code in ipairs(classCodes or {}) do
		self.persistence:orderedRemove(classStore(code), id)
	end
	for _, legacy in ipairs(Config.LEGACY_LEADERBOARDS) do
		self.persistence:orderedRemove(legacy.global, id)
		for _, code in ipairs(classCodes or {}) do
			self.persistence:orderedRemove(legacy.classPrefix .. code, id)
		end
	end
	for key in pairs(self.lastSubmitted) do
		if key:sub(-#tostring(userId) - 1) == "|" .. tostring(userId) then
			self.lastSubmitted[key] = nil
		end
	end
	self.cache = {}
	self.names[userId] = nil
end

function LeaderboardService:_nameOf(userId)
	local cached = self.names[userId]
	if cached then
		return cached
	end
	local fallback = "Người chơi " .. tostring(userId)
	local failedAt = self.nameFailedAt[userId]
	if not self.resolveName or (failedAt and self.clock() - failedAt < NAME_RETRY_SECONDS) then
		return fallback
	end
	local ok, name = pcall(self.resolveName, userId)
	if ok and type(name) == "string" then
		self.names[userId] = name
		return name
	end
	self.nameFailedAt[userId] = self.clock()
	return fallback
end

function LeaderboardService:_entries(storeName)
	local cached = self.cache[storeName]
	if cached and self.clock() - cached.at < Config.LEADERBOARD_CACHE_SECONDS then
		return true, cached.entries
	end
	local ok, entries = self.persistence:orderedTop(storeName, Config.LEADERBOARD_SIZE)
	if not ok then
		if cached then
			return true, cached.entries -- lỗi mạng: dùng tạm bản cũ
		end
		return false
	end
	self.cache[storeName] = { at = self.clock(), entries = entries }
	return true, entries
end

-- scope "global" | "class". Trả { scope, code, rows = { rank, userId, name, score, isMe } }
function LeaderboardService:top(scope, code, viewerId)
	local storeName
	if scope == "class" then
		if type(code) ~= "string" or code == "" then
			return false, "Chưa chọn lớp"
		end
		if not self.getClass then
			return false, "Chưa xem được bảng xếp hạng lớp"
		end
		local record = self.getClass(code)
		if not record then
			return false, "Không tìm thấy lớp"
		end
		local isMember = record.teacherId == viewerId or (record.members or {})[tostring(viewerId)] ~= nil
		if not isMember then
			return false, "Bạn không thuộc lớp này"
		end
		storeName = classStore(record.code)
		code = record.code
	else
		scope = "global"
		code = nil
		storeName = Config.DATASTORE.leaderboardGlobal
	end
	local ok, entries = self:_entries(storeName)
	if not ok then
		return false, "Không tải được bảng xếp hạng"
	end
	if self.resolveNames then
		local missing = {}
		for _, entry in ipairs(entries) do
			local id = tonumber(entry.key)
			local failedAt = id and self.nameFailedAt[id]
			if id and id > 0 and not self.names[id] and not (failedAt and self.clock() - failedAt < NAME_RETRY_SECONDS) then
				table.insert(missing, id)
			end
		end
		if #missing > 0 then
			local okNames, map = pcall(self.resolveNames, missing)
			if okNames and type(map) == "table" then
				for id, name in pairs(map) do
					self.names[id] = name
				end
			end
			for _, id in ipairs(missing) do
				if not self.names[id] then
					self.nameFailedAt[id] = self.clock()
				end
			end
		end
	end
	local rows = {}
	for i, entry in ipairs(entries) do
		local userId = tonumber(entry.key) or entry.key
		table.insert(rows, {
			rank = i,
			userId = userId,
			name = self:_nameOf(userId),
			score = entry.value / SCALE,
			isMe = userId == viewerId,
		})
	end
	return true, { scope = scope, code = code, rows = rows }
end

return LeaderboardService
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX0000000D"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Entry phía server: nối các service với Roblox (remote, vòng tick, DataStore, MessagingService, teleport, admin)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local MemoryStoreService = game:GetService("MemoryStoreService")
local MessagingService = game:GetService("MessagingService")
local TeleportService = game:GetService("TeleportService")
local TextService = game:GetService("TextService")
local UserService = game:GetService("UserService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("EconCity")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local GameTick = require(Shared:WaitForChild("GameTick"))
local Scenarios = require(Shared:WaitForChild("Scenarios"))

local serverFolder = script.Parent
local Persistence = require(serverFolder:WaitForChild("Persistence"))
local SessionService = require(serverFolder:WaitForChild("SessionService"))
local ClassroomService = require(serverFolder:WaitForChild("ClassroomService"))
local LeaderboardService = require(serverFolder:WaitForChild("LeaderboardService"))
local AdminService = require(serverFolder:WaitForChild("AdminService"))
local Roles = require(serverFolder:WaitForChild("Roles"))
local World = require(serverFolder:WaitForChild("World"))

local IS_STUDIO = RunService:IsStudio()
-- phòng học riêng là reserved server, không có owner. Server riêng mua bằng Robux thì PrivateServerOwnerId ~= 0
local IN_CLASS_ROOM = game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0

World.build()

-- Remotes
local remotes = Instance.new("Folder")
remotes.Name = Net.FOLDER
local stateEvent = Instance.new("RemoteEvent")
stateEvent.Name = Net.STATE_EVENT
stateEvent.Parent = remotes
local noticeEvent = Instance.new("RemoteEvent")
noticeEvent.Name = Net.NOTICE_EVENT
noticeEvent.Parent = remotes
local requestFunction = Instance.new("RemoteFunction")
requestFunction.Name = Net.REQUEST
requestFunction.Parent = remotes
remotes.Parent = ReplicatedStorage

-- Services
local persistence = Persistence.new({
	dataStoreService = DataStoreService,
	memoryStoreService = MemoryStoreService,
	wait = function(seconds)
		task.wait(seconds)
	end,
	log = warn,
	-- chỉ Studio mới được fallback sang bộ nhớ tạm, game thật thì không bao giờ
	allowMemoryFallback = IS_STUDIO,
	-- Studio ghi kho riêng, không lẫn data HS thật
	suffix = IS_STUDIO and Config.STUDIO_STORE_SUFFIX or "",
})

local function notify(userId, text)
	local player = Players:GetPlayerByUserId(userId)
	if player then
		noticeEvent:FireClient(player, text)
	end
end

local sessions -- khai báo trước cho callback dùng
local classroom
local leaderboard
local admin
local pushState

sessions = SessionService.new({
	persistence = persistence,
	now = os.time,
	random = math.random,
	jobId = game.JobId,
	defer = function(fn)
		task.spawn(fn)
	end,
	wait = function(seconds)
		task.wait(seconds)
	end,
	onTick = function(userId, profile, result)
		local finished = GameTick.isFinished(profile.session)
		if finished or sessions.tickCounter % Config.LEADERBOARD_UPDATE_EVERY_TICKS == 0 then
			local score = profile.session.prosperityScore
			local classes = { table.unpack(profile.classes) }
			task.spawn(function()
				leaderboard:submit(userId, profile.name, score, classes)
			end)
		end
		for _, scenario in ipairs(result.finishedScenarios or {}) do
			local def = Scenarios.get(scenario.id)
			notify(userId, "Sự kiện đã kết thúc: " .. ((def and def.name) or scenario.name or tostring(scenario.id)))
		end
	end,
	onSessionFinished = function(userId, profile)
		task.spawn(function()
			classroom:persistProgress(userId, profile)
		end)
		if profile.session.status == GameTick.STATUS.ENDED then
			notify(userId, string.format("Chúc mừng! Bạn đã hoàn thành nhiệm kỳ %d tháng.", Config.GAME_DURATION_MONTHS))
		else
			notify(userId, "Thành phố phá sản. Hãy thử lại với cách xây và mức thuế khác!")
		end
	end,
})

-- đặt mốc tick đầu luôn, người vào sớm nhận snapshot đã có đồng hồ đúng
sessions.nextTickAt = Workspace:GetServerTimeNow() + Config.TICK_SECONDS

local messagingReady = false
local function publish(message)
	if not messagingReady then
		return false
	end
	message.from = game.JobId -- server gửi cũng nhận lại message của chính nó, lúc nhận thì bỏ qua
	local ok = pcall(function()
		MessagingService:PublishAsync(Config.DATASTORE.messagingTopic, message)
	end)
	return ok
end

-- Roblox bắt buộc lọc chữ người chơi nhập trước khi người khác thấy
local function filterText(text, userId)
	local ok, result = pcall(function()
		local filterResult = TextService:FilterStringAsync(text, userId, Enum.TextFilterContext.PublicChat)
		return filterResult:GetNonChatStringForBroadcastAsync()
	end)
	if ok then
		return result
	end
	if IS_STUDIO then
		return text -- Studio có thể không lọc được, chỉ để test
	end
	error(result)
end

classroom = ClassroomService.new({
	persistence = persistence,
	sessions = sessions,
	isTeacher = Roles.isTeacherId,
	now = os.time,
	random = math.random,
	publish = publish,
	notify = notify,
	currentPrivateServerId = game.PrivateServerId,
	reserveServer = function()
		local accessCode, privateServerId = TeleportService:ReserveServerAsync(game.PlaceId)
		return accessCode, privateServerId
	end,
	teleportToRoom = function(userId, accessCode)
		local player = Players:GetPlayerByUserId(userId)
		if not player then
			error("Người chơi không còn trong server")
		end
		-- lưu cuối + nhả lock trước khi teleport để server mới đọc được data mới nhất.
		-- tóm tắt lớp thì ghi 1 lần lúc thật sự rời server này
		sessions:beginTeleport(userId)
		local ok, err = pcall(function()
			local options = Instance.new("TeleportOptions")
			options.ReservedServerAccessCode = accessCode
			TeleportService:TeleportAsync(game.PlaceId, { player }, options)
		end)
		if not ok then
			sessions:teleportFailed(userId)
			if pushState then
				pushState(player, "teleportFailed")
			end
			error(err)
		end
	end,
	filterText = filterText,
})

leaderboard = LeaderboardService.new({
	persistence = persistence,
	clock = os.clock,
	resolveName = function(userId)
		return Players:GetNameFromUserIdAsync(userId)
	end,
	-- display name nhiều người trong 1 lần gọi
	resolveNames = function(userIds)
		local map = {}
		local infos = UserService:GetUserInfosByUserIdsAsync(userIds)
		for _, info in ipairs(infos) do
			map[info.Id] = info.DisplayName
		end
		return map
	end,
	getClass = function(code)
		return classroom:getClass(code)
	end,
})

admin = AdminService.new({
	persistence = persistence,
	sessions = sessions,
	leaderboard = leaderboard,
	now = os.time,
	publish = publish,
	setExtraTeachers = Roles.setExtraTeachers,
	isOwner = function(userId)
		local player = Players:GetPlayerByUserId(userId)
		return player ~= nil and Roles.isOwner(player)
	end,
	isInServer = function(userId)
		return Players:GetPlayerByUserId(userId) ~= nil
	end,
	getUserIdFromName = function(name)
		return Players:GetUserIdFromNameAsync(name)
	end,
	getNameFromUserId = function(userId)
		return Players:GetNameFromUserIdAsync(userId)
	end,
	banUser = function(userId, durationSeconds, reason)
		Players:BanAsync({
			UserIds = { userId },
			ApplyToUniverse = true,
			Duration = durationSeconds,
			DisplayReason = reason,
			PrivateReason = "EconCity admin panel",
			ExcludeAltAccounts = false,
		})
	end,
	unbanUser = function(userId)
		Players:UnbanAsync({ UserIds = { userId }, ApplyToUniverse = true })
	end,
})

task.spawn(function()
	-- list GV owner thêm: load lúc start, refresh mỗi 5 phút
	while true do
		admin:refresh()
		task.wait(300)
	end
end)

if persistence.mode == "datastore" then
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(Config.DATASTORE.messagingTopic, function(packet)
				local data = packet.Data
				if type(data) == "table" and game.JobId ~= "" and data.from == game.JobId then
					return -- đã xử lý tại chỗ lúc gửi
				end
				local okMsg, msgErr = pcall(function()
					classroom:onMessage(packet.Data)
					admin:onMessage(packet.Data)
				end)
				if not okMsg then
					warn("[EconCity] Lỗi xử lý thông điệp: " .. tostring(msgErr))
				end
			end)
		end)
		messagingReady = ok
		if not ok then
			warn("[EconCity] MessagingService không khả dụng: " .. tostring(err))
		end
	end)
end

-- Gửi state
pushState = function(player, reason)
	local ok, err = pcall(function()
		local snap = sessions:snapshot(player.UserId, {
			reason = reason,
			isTeacher = Roles.isTeacher(player),
			isOwner = Roles.isOwner(player),
			isStudio = IS_STUDIO,
			inPrivateRoom = IN_CLASS_ROOM,
		})
		if snap then
			stateEvent:FireClient(player, snap)
		end
	end)
	if not ok then
		warn("[EconCity] Lỗi gửi trạng thái: " .. tostring(err))
	end
end

-- Vào / rời game
local function onPlayerAdded(player)
	local userId = player.UserId
	local profile = sessions:loadPlayer(userId, player.DisplayName)
	leaderboard:rememberName(userId, player.DisplayName)
	if not player.Parent then
		sessions:unloadPlayer(userId) -- rời lúc đang nạp
		return
	end
	-- sự kiện lớp gán lúc vắng
	local okSync, syncErr = pcall(function()
		classroom:syncPendingScenarios(userId, profile)
	end)
	if not okSync then
		warn("[EconCity] Lỗi đồng bộ sự kiện lớp: " .. tostring(syncErr))
	end
	if not player.Parent then
		sessions:unloadPlayer(userId)
		return
	end
	if profile.loadFailed then
		noticeEvent:FireClient(player, "Không tải được dữ liệu đã lưu nên ván này sẽ không được lưu.")
	end
	pushState(player, "init")
end

Players.PlayerAdded:Connect(function(player)
	task.spawn(onPlayerAdded, player)
end)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

local lastRequestAt = {}
local lastActionAt = {}

Players.PlayerRemoving:Connect(function(player)
	local userId = player.UserId
	lastRequestAt[userId] = nil
	lastActionAt[userId] = nil
	-- ghi tóm tắt lớp song song với lần lưu cuối (unloadPlayer gỡ khỏi vòng tick ngay)
	local profile = sessions:getProfile(userId)
	if profile then
		task.spawn(function()
			classroom:persistProgress(userId, profile, true)
		end)
	end
	sessions:unloadPlayer(userId)
	classroom:forget(userId)
	Roles.forget(userId)
end)

-- teleport vào phòng riêng fail sau khi TeleportAsync đã return: chơi tiếp ở đây
TeleportService.TeleportInitFailed:Connect(function(player, result, message)
	if sessions:teleportFailed(player.UserId) then
		notify(player.UserId, "Không vào được phòng học riêng (" .. tostring(message or result) .. "). Bạn tiếp tục chơi ở đây.")
		pushState(player, "teleportFailed")
	end
end)

game:BindToClose(function()
	-- tóm tắt lớp + hồ sơ lưu song song, Roblox cho tối đa 30s
	local started = os.clock()
	for userId, profile in pairs(sessions.profiles) do
		task.spawn(function()
			classroom:persistProgress(userId, profile, true)
		end)
	end
	sessions:saveAll()
	-- chờ hết các lần ghi tóm tắt lớp, kể cả của người vừa rời
	while classroom.pendingWrites > 0 and os.clock() - started < 27 do
		task.wait(0.25)
	end
end)

-- Vòng tick: 1 đồng hồ chung cả server, theo GetServerTimeNow để client đếm ngược khớp
task.spawn(function()
	while true do
		local remaining = sessions.nextTickAt - Workspace:GetServerTimeNow()
		if remaining > 0 then
			task.wait(remaining)
		end
		local okLoop, loopErr = pcall(function()
			sessions.nextTickAt = sessions.nextTickAt + Config.TICK_SECONDS
			-- server treo lâu thì bỏ các lượt đã lỡ, không tick dồn
			local now = Workspace:GetServerTimeNow()
			if sessions.nextTickAt < now then
				sessions.nextTickAt = now + Config.TICK_SECONDS
			end
			local results = sessions:tickAll()
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = sessions:getProfile(player.UserId)
				if profile then
					pushState(player, results[player.UserId] and "tick" or "clock")
					-- tiến độ sống cho GV, cả lúc pause để biết ai online
					task.spawn(function()
						classroom:recordProgress(player.UserId, profile)
					end)
				end
			end
		end)
		if not okLoop then
			warn("[EconCity] Lỗi vòng tick: " .. tostring(loopErr))
			sessions.nextTickAt = Workspace:GetServerTimeNow() + Config.TICK_SECONDS
		end
	end
end)

-- Request từ client
local handlers = {}

local function requireTeacher(player)
	if not Roles.isTeacher(player) then
		return false, "Chỉ dành cho giáo viên"
	end
	return true
end

local function requireOwner(player)
	if not Roles.isOwner(player) then
		return false, "Chỉ chủ game mới dùng được chức năng này"
	end
	return true
end

handlers.getState = function(player)
	return true, sessions:snapshot(player.UserId, {
		isTeacher = Roles.isTeacher(player),
		isOwner = Roles.isOwner(player),
		isStudio = IS_STUDIO,
		inPrivateRoom = IN_CLASS_ROOM,
	})
end

handlers.clientReady = function(player)
	local ok, err = sessions:clientReady(player.UserId)
	if ok then
		pushState(player, "ready")
	end
	return ok, err
end

-- xây / kéo đường / phá / thuế: CityEngine (qua SessionService) validate mọi giá trị client gửi
local function cityAction(action, read)
	return function(player, payload)
		payload = payload or {}
		local a, b = read(payload)
		local ok, data = sessions:act(player.UserId, action, a, b)
		if ok then
			pushState(player, "city")
		end
		return ok, data
	end
end
handlers.build = cityAction("build", function(p)
	return p.kind, p.index
end)
handlers.buildRoad = cityAction("buildRoad", function(p)
	return p.path
end)
handlers.demolish = cityAction("demolish", function(p)
	return p.index
end)
handlers.setTax = cityAction("setTax", function(p)
	return p.tax
end)

handlers.togglePause = function(player)
	local ok, statusOrErr = sessions:togglePause(player.UserId)
	if ok then
		pushState(player, "pause")
		return true, statusOrErr
	end
	return false, statusOrErr
end

handlers.newGame = function(player)
	local ok, err = sessions:newGame(player.UserId)
	if ok then
		pushState(player, "newGame")
	end
	return ok, err
end

handlers.tickNow = function(player)
	if not IS_STUDIO then
		return false, "Chỉ dùng được trong Roblox Studio"
	end
	local result = sessions:tickOne(player.UserId)
	pushState(player, result and "tick" or "clock")
	if not result then
		return false, "Ván đang không chạy"
	end
	return true
end

handlers.demoBuild = function(player)
	if not IS_STUDIO then
		return false, "Chỉ dùng được trong Roblox Studio"
	end
	local ok, data = sessions:demoBuild(player.UserId)
	if ok then
		pushState(player, "city")
	end
	return ok, data
end

handlers.getLeaderboard = function(player, payload)
	payload = payload or {}
	local ok, data = leaderboard:top(payload.scope == "class" and "class" or "global", payload.code, player.UserId)
	if ok then
		local profile = sessions:getProfile(player.UserId)
		data.me = {
			bestScore = profile and profile.bestScore or 0,
			currentScore = profile and profile.session and profile.session.prosperityScore or 0,
			ranked = player.UserId > 0,
		}
	end
	return ok, data
end

handlers.joinClass = function(player, payload)
	local ok, result = classroom:joinClass(player.UserId, player.DisplayName, payload and payload.code)
	if ok then
		pushState(player, "class")
	end
	return ok, result
end

handlers.leaveClass = function(player, payload)
	local ok, result = classroom:leaveClass(player.UserId, payload and payload.code)
	if ok then
		pushState(player, "class")
	end
	return ok, result
end

handlers.getMyClasses = function(player)
	return classroom:getMyClasses(player.UserId)
end

handlers.createClass = function(player, payload)
	local ok, result = classroom:createClass(player.UserId, player.DisplayName, payload and payload.name)
	if ok then
		pushState(player, "class")
	end
	return ok, result
end

handlers.getTeacherClasses = function(player)
	local allowed, err = requireTeacher(player)
	if not allowed then
		return false, err
	end
	return classroom:getTeacherClasses(player.UserId)
end

handlers.getClassRoster = function(player, payload)
	return classroom:getRoster(player.UserId, payload and payload.code)
end

handlers.getStudentDetail = function(player, payload)
	payload = payload or {}
	return classroom:getStudentDetail(player.UserId, payload.code, payload.userId)
end

handlers.exportClassCsv = function(player, payload)
	return classroom:exportClassCsv(player.UserId, payload and payload.code)
end

handlers.assignScenario = function(player, payload)
	payload = payload or {}
	return classroom:assignScenario(player.UserId, payload.code, payload.scenarioId)
end

handlers.listScenarios = function(player)
	return classroom:listScenarios(player.UserId)
end

handlers.createScenario = function(player, payload)
	return classroom:createScenario(player.UserId, payload)
end

handlers.deleteScenario = function(player, payload)
	return classroom:deleteScenario(player.UserId, payload and payload.id)
end

handlers.openClassRoom = function(player, payload)
	return classroom:openRoom(player.UserId, payload and payload.code)
end

handlers.closeClassRoom = function(player, payload)
	return classroom:closeRoom(player.UserId, payload and payload.code)
end

handlers.enterClassRoom = function(player, payload)
	return classroom:enterRoom(player.UserId, payload and payload.code)
end

-- Quản trị, chỉ owner
handlers.adminGetState = function(player)
	local allowed, err = requireOwner(player)
	if not allowed then
		return false, err
	end
	return admin:getState(player.UserId)
end

handlers.adminAddTeacher = function(player, payload)
	local allowed, err = requireOwner(player)
	if not allowed then
		return false, err
	end
	return admin:addTeacher(player.UserId, payload and payload.target)
end

handlers.adminRemoveTeacher = function(player, payload)
	local allowed, err = requireOwner(player)
	if not allowed then
		return false, err
	end
	return admin:removeTeacher(player.UserId, payload and payload.userId)
end

handlers.adminBan = function(player, payload)
	local allowed, err = requireOwner(player)
	if not allowed then
		return false, err
	end
	payload = payload or {}
	return admin:ban(player.UserId, payload.target, payload.days, payload.reason)
end

handlers.adminUnban = function(player, payload)
	local allowed, err = requireOwner(player)
	if not allowed then
		return false, err
	end
	return admin:unban(player.UserId, payload and payload.userId)
end

handlers.adminDeleteUserData = function(player, payload)
	local allowed, err = requireOwner(player)
	if not allowed then
		return false, err
	end
	return admin:deleteUserData(player.UserId, payload and payload.target)
end

requestFunction.OnServerInvoke = function(player, action, payload)
	if type(action) ~= "string" or not Net.ACTIONS[action] or not handlers[action] then
		return { ok = false, error = "Hành động không hợp lệ" }
	end
	if payload ~= nil and type(payload) ~= "table" then
		return { ok = false, error = "Dữ liệu không hợp lệ" }
	end
	local userId = player.UserId
	-- rate limit kiểu token bucket: cho burst vài request (mở bảng gọi 2-3 API cùng lúc), chặn spam liên tục
	local now = os.clock()
	local bucket = lastRequestAt[userId]
	if not bucket then
		bucket = { tokens = Config.REQUEST_BURST, at = now }
		lastRequestAt[userId] = bucket
	end
	bucket.tokens = math.min(Config.REQUEST_BURST, bucket.tokens + (now - bucket.at) * Config.REQUEST_REFILL_PER_SECOND)
	bucket.at = now
	if bucket.tokens < 1 then
		return { ok = false, error = "Bạn thao tác quá nhanh" }
	end
	bucket.tokens = bucket.tokens - 1
	if not sessions:getProfile(userId) then
		return { ok = false, error = "Đang tải dữ liệu, hãy thử lại sau giây lát" }
	end
	-- cooldown riêng cho action tốn tài nguyên (DataStore, lọc chữ, teleport).
	-- đánh dấu trước khi xử lý, không thì request gửi cùng lúc lách được cooldown
	local cooldown = Config.ACTION_COOLDOWNS[action]
	local previous = nil
	if cooldown then
		local marks = lastActionAt[userId] or {}
		lastActionAt[userId] = marks
		if marks["busy:" .. action] then
			return { ok = false, error = "Đang xử lý yêu cầu trước, hãy đợi" }
		end
		local last = marks[action]
		if last and now - last < cooldown then
			return { ok = false, error = string.format("Hãy đợi %d giây rồi thử lại", math.ceil(cooldown - (now - last))) }
		end
		previous = last
		marks[action] = now
		marks["busy:" .. action] = true
	end
	local success, ok, data = pcall(handlers[action], player, payload)
	local marks = lastActionAt[userId]
	if cooldown and marks then
		marks["busy:" .. action] = nil
		-- fail (gõ sai tên, lỗi mạng) thì cho thử lại ngay. Riêng joinClass vẫn tính cooldown, chống dò mã
		if (not success or not ok) and action ~= "joinClass" then
			marks[action] = previous
		end
	end
	if not success then
		warn("[EconCity] Lỗi xử lý " .. action .. ": " .. tostring(ok))
		return { ok = false, error = "Server gặp lỗi, thử lại sau" }
	end
	if ok then
		return { ok = true, data = data }
	end
	return { ok = false, error = data or "Không thực hiện được" }
end

print(string.format(
	"[EconCity] Server v%s sẵn sàng, lưu trữ: %s%s, tick %ds",
	Config.VERSION,
	persistence.mode,
	persistence.degraded and " (đang lỗi, thử lại từng lệnh)" or "",
	Config.TICK_SECONDS
))
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Persistence</string><ProtectedString name="Source"><![CDATA[-- Bọc DataStore / OrderedDataStore / MemoryStore. Hàm nào cũng có thể yield, chỉ gọi từ server.
-- Game thật: luôn dùng DataStore, probe lúc start lỗi cũng vậy. Lệnh nào lỗi thì báo người đó, không mất data cả server.
-- Studio chưa publish / chưa bật API access: dùng bộ nhớ tạm.
-- Studio có API thì tên kho thêm hậu tố (mặc định "_Studio") cho khỏi lẫn data thật

local Persistence = {}
Persistence.__index = Persistence

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in pairs(value) do
		out[k] = deepCopy(v)
	end
	return out
end

-- options: dataStoreService/memoryStoreService (nil thì chạy bộ nhớ), wait (task.wait), log,
-- forceMemory (test), allowMemoryFallback (chỉ Studio), suffix (hậu tố tên kho)
function Persistence.new(options)
	options = options or {}
	local self = setmetatable({}, Persistence)
	self._dss = options.dataStoreService
	self._mss = options.memoryStoreService
	self._wait = options.wait or function() end
	self._log = options.log or print
	self._suffix = options.suffix or ""
	self._stores = {}
	self._ordered = {}
	self._maps = {}
	self._memory = {} -- [storeName][key] = value
	self._memoryOrdered = {} -- [storeName][key] = number
	self._memoryLive = {} -- [mapName][key] = value
	self.mode = "memory"
	self.liveMode = "memory"
	self.degraded = false -- DataStore lỗi lúc start, vẫn retry từng lệnh

	if not options.forceMemory and self._dss then
		local lastErr
		local ok = false
		for attempt = 1, 4 do
			ok, lastErr = pcall(function()
				self._dss:GetDataStore("EconCity_Probe" .. self._suffix):GetAsync("probe")
			end)
			if ok then
				break
			end
			if options.allowMemoryFallback then
				break -- Studio: khỏi retry, sang bộ nhớ tạm luôn
			end
			self._wait(attempt * 2)
		end
		if ok then
			self.mode = "datastore"
		elseif options.allowMemoryFallback then
			self._log("[EconCity] (Studio) DataStore không khả dụng, dùng bộ nhớ tạm: " .. tostring(lastErr))
		else
			self.mode = "datastore"
			self.degraded = true
			self._log("[EconCity] DataStore đang lỗi lúc khởi động, sẽ thử lại cho từng lệnh: " .. tostring(lastErr))
		end
	end
	if self.mode == "datastore" and self._mss then
		local ok = pcall(function()
			self._mss:GetHashMap("EconCity_Probe" .. self._suffix)
		end)
		if ok then
			self.liveMode = "memorystore"
		end
	end
	return self
end

function Persistence:_retry(fn)
	local lastErr
	for attempt = 1, 3 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		if attempt < 3 then
			self._wait(attempt)
		end
	end
	self._log("[EconCity] Lỗi lưu trữ: " .. tostring(lastErr))
	return false, lastErr
end

function Persistence:_store(name)
	local full = name .. self._suffix
	local store = self._stores[full]
	if not store then
		store = self._dss:GetDataStore(full)
		self._stores[full] = store
	end
	return store
end

function Persistence:_orderedStore(name)
	local full = name .. self._suffix
	local store = self._ordered[full]
	if not store then
		store = self._dss:GetOrderedDataStore(full)
		self._ordered[full] = store
	end
	return store
end

function Persistence:_map(name)
	local full = name .. self._suffix
	local map = self._maps[full]
	if not map then
		map = self._mss:GetHashMap(full)
		self._maps[full] = map
	end
	return map
end

-- DataStore thường

function Persistence:get(storeName, key)
	if self.mode == "memory" then
		local bucket = self._memory[storeName]
		return true, bucket and deepCopy(bucket[key]) or nil
	end
	return self:_retry(function()
		return (self:_store(storeName):GetAsync(key))
	end)
end

function Persistence:set(storeName, key, value)
	if self.mode == "memory" then
		self._memory[storeName] = self._memory[storeName] or {}
		self._memory[storeName][key] = deepCopy(value)
		return true
	end
	return self:_retry(function()
		self:_store(storeName):SetAsync(key, value)
	end)
end

-- transform(old) trả giá trị mới, nil = không ghi. Atomic giữa các server.
-- transform có thể chạy nhiều lần: biến ngoài nào nó ghi thì phải reset ở đầu transform
function Persistence:update(storeName, key, transform)
	if self.mode == "memory" then
		self._memory[storeName] = self._memory[storeName] or {}
		local newValue = transform(deepCopy(self._memory[storeName][key]))
		if newValue ~= nil then
			self._memory[storeName][key] = deepCopy(newValue)
		end
		return true, deepCopy(newValue)
	end
	return self:_retry(function()
		return (self:_store(storeName):UpdateAsync(key, function(old)
			return transform(old)
		end))
	end)
end

function Persistence:remove(storeName, key)
	if self.mode == "memory" then
		if self._memory[storeName] then
			self._memory[storeName][key] = nil
		end
		return true
	end
	return self:_retry(function()
		self:_store(storeName):RemoveAsync(key)
	end)
end

-- OrderedDataStore, chỉ lưu số nguyên

-- chỉ ghi nếu lớn hơn giá trị cũ. true = lệnh ok, kể cả khi không cần ghi
function Persistence:orderedSetMax(storeName, key, value)
	value = math.floor(value + 0.5)
	if self.mode == "memory" then
		self._memoryOrdered[storeName] = self._memoryOrdered[storeName] or {}
		local old = self._memoryOrdered[storeName][key]
		if old == nil or value > old then
			self._memoryOrdered[storeName][key] = value
		end
		return true
	end
	local ok = self:_retry(function()
		self:_orderedStore(storeName):UpdateAsync(key, function(old)
			if old == nil or value > old then
				return value
			end
			return nil
		end)
	end)
	return ok
end

function Persistence:orderedRemove(storeName, key)
	if self.mode == "memory" then
		if self._memoryOrdered[storeName] then
			self._memoryOrdered[storeName][key] = nil
		end
		return true
	end
	return self:_retry(function()
		self:_orderedStore(storeName):RemoveAsync(key)
	end)
end

-- mảng { key = string, value = number }, giảm dần
function Persistence:orderedTop(storeName, count)
	if self.mode == "memory" then
		local list = {}
		for k, v in pairs(self._memoryOrdered[storeName] or {}) do
			table.insert(list, { key = k, value = v })
		end
		table.sort(list, function(a, b)
			if a.value == b.value then
				return a.key < b.key
			end
			return a.value > b.value
		end)
		while #list > count do
			table.remove(list)
		end
		return true, list
	end
	return self:_retry(function()
		local pages = self:_orderedStore(storeName):GetSortedAsync(false, count)
		local out = {}
		for _, entry in ipairs(pages:GetCurrentPage()) do
			table.insert(out, { key = entry.key, value = entry.value })
		end
		return out
	end)
end

-- data "sống" đọc/ghi liên tục (MemoryStore HashMap)

function Persistence:liveSet(mapName, key, value, ttlSeconds)
	if self.liveMode == "memory" then
		self._memoryLive[mapName] = self._memoryLive[mapName] or {}
		self._memoryLive[mapName][key] = deepCopy(value)
		return true
	end
	local ok, err = pcall(function()
		self:_map(mapName):SetAsync(key, value, ttlSeconds or 3600)
	end)
	return ok, err
end

function Persistence:liveGet(mapName, key)
	if self.liveMode == "memory" then
		local bucket = self._memoryLive[mapName]
		return true, bucket and deepCopy(bucket[key]) or nil
	end
	local ok, result = pcall(function()
		return (self:_map(mapName):GetAsync(key))
	end)
	return ok, result
end

function Persistence:liveRemove(mapName, key)
	if self.liveMode == "memory" then
		if self._memoryLive[mapName] then
			self._memoryLive[mapName][key] = nil
		end
		return true
	end
	return pcall(function()
		self:_map(mapName):RemoveAsync(key)
	end)
end

return Persistence
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Roles</string><ProtectedString name="Source"><![CDATA[-- Ai là giáo viên / chủ game, theo UserId.
-- GV: owner experience (cũng là admin, mở được bảng Quản trị), có trong TEACHER_USER_IDS/ADMIN_USER_IDS,
-- rank >= TEACHER_GROUP_MIN_RANK trong TEACHER_GROUP_ID, owner thêm ở bảng Quản trị (AdminService),
-- hoặc trong Studio khi STUDIO_EVERYONE_IS_TEACHER = true (chỉ để test)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("EconCity"):WaitForChild("Config"))

local Roles = {}
local cache = {} -- [userId] = { teacher, owner }, chỉ cache khi tra không lỗi
local extraTeachers = {} -- [userId] = true, owner thêm

local function inList(list, userId)
	for _, id in ipairs(list or {}) do
		if id == userId then
			return true
		end
	end
	return false
end

-- (isTeacher, isOwner, reliable). reliable = false khi gọi mạng lỗi, lúc đó không cache
local function compute(player)
	local userId = player.UserId
	local reliable = true
	local owner = false
	if RunService:IsStudio() and Config.STUDIO_EVERYONE_IS_TEACHER then
		return true, true, true
	end
	if inList(Config.ADMIN_USER_IDS, userId) then
		owner = true
	elseif game.CreatorType == Enum.CreatorType.User and game.CreatorId == userId then
		owner = true
	elseif game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(function()
			return player:GetRankInGroup(game.CreatorId)
		end)
		if ok then
			owner = rank >= 255
		else
			reliable = false
		end
	end
	if owner then
		return true, true, true
	end
	if inList(Config.TEACHER_USER_IDS, userId) or extraTeachers[userId] then
		return true, false, reliable
	end
	if Config.TEACHER_GROUP_ID and Config.TEACHER_GROUP_ID > 0 then
		local ok, rank = pcall(function()
			return player:GetRankInGroup(Config.TEACHER_GROUP_ID)
		end)
		if ok then
			if rank >= Config.TEACHER_GROUP_MIN_RANK then
				return true, false, reliable
			end
		else
			reliable = false
		end
	end
	return false, false, reliable
end

local function lookup(player)
	if not player then
		return { teacher = false, owner = false }
	end
	local cached = cache[player.UserId]
	if cached then
		return cached
	end
	local teacher, owner, reliable = compute(player)
	local result = { teacher = teacher, owner = owner }
	if reliable then
		cache[player.UserId] = result
	end
	return result
end

function Roles.isTeacher(player)
	return lookup(player).teacher
end

function Roles.isOwner(player)
	return lookup(player).owner
end

function Roles.isTeacherId(userId)
	local player = Players:GetPlayerByUserId(userId)
	if player then
		return Roles.isTeacher(player)
	end
	-- không ở server này: chỉ check list cố định + list owner thêm
	return inList(Config.TEACHER_USER_IDS, userId) or inList(Config.ADMIN_USER_IDS, userId) or extraTeachers[userId] == true
end

-- map { ["<userId>"] = {...} } hoặc { [userId] = true }
function Roles.setExtraTeachers(map)
	extraTeachers = {}
	for key in pairs(map or {}) do
		local id = tonumber(key)
		if id then
			extraTeachers[id] = true
		end
	end
	cache = {} -- vai trò có thể đã đổi
end

function Roles.forget(userId)
	cache[userId] = nil
end

return Roles
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">SessionService</string><ProtectedString name="Source"><![CDATA[-- Hồ sơ người chơi + phiên đang chạy trong server này. Chỉ tick người đang ở server (hết người là Roblox tắt server).
-- lock = { jobId, at }: server khác đang giữ thì chờ nó lưu xong mới nạp. Bị giành lock thì ngừng ghi, không đè data mới hơn.
-- Mỗi người chỉ 1 lần lưu chạy, yêu cầu lưu lúc đó thì gộp. Rời game/chuyển server: pause ngay, lưu lần cuối, nhả lock.
-- Phiên chỉ tính lượt sau khi client báo ready (máy yếu load chậm khỏi thua oan).
-- không gọi Roblox API trực tiếp, mọi thứ đi qua deps (để test chạy được ngoài Studio)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("EconCity")

local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local GameTick = require(Shared:WaitForChild("GameTick"))
local CityEngine = require(Shared:WaitForChild("CityEngine"))
local DemoBot = require(Shared:WaitForChild("DemoBot"))
local Scenarios = require(Shared:WaitForChild("Scenarios"))

local SessionService = {}
SessionService.__index = SessionService

local PROFILE_VERSION = 2
-- field chỉ có lúc chạy, không lưu DataStore
local RUNTIME_FIELDS = { "loadFailed", "lockLost", "teleporting" }

-- deps: persistence, now (giây), random ([0,1)), defer(fn) (task.spawn), wait (task.wait), jobId (game.JobId),
-- onTick(userId, profile, result) / onSessionFinished(userId, profile) tuỳ chọn
function SessionService.new(deps)
	local self = setmetatable({}, SessionService)
	self.persistence = deps.persistence
	self.now = deps.now or os.time
	self.random = deps.random or math.random
	self.onTick = deps.onTick
	self.onSessionFinished = deps.onSessionFinished
	self.defer = deps.defer or function(fn)
		fn()
	end
	self.wait = deps.wait or function() end
	self.jobId = (deps.jobId and deps.jobId ~= "") and deps.jobId or "local"
	self.profiles = {} -- [userId] = profile đang nạp
	self.saveState = {} -- [userId] = { running, again, final, profile }
	self.lastWriteAt = {} -- [userId] = lần ghi ok gần nhất, dùng để refresh lock
	self.tickCounter = 0
	self.nextTickAt = 0
	return self
end

local function newProfile(userId, name)
	return {
		version = PROFILE_VERSION,
		userId = userId,
		name = name,
		session = nil,
		pastSessions = {},
		classes = {}, -- lớp đã vào (HS)
		teaching = {}, -- lớp đang dạy (GV)
		scenarioSync = {}, -- [mã lớp] = mốc sự kiện lớp đã nhận
		gamesPlayed = 0,
		bestScore = 0,
	}
end

function SessionService:_key(userId)
	return "u_" .. tostring(userId)
end

function SessionService:_newSessionId(userId)
	return string.format("s_%s_%d_%04d", tostring(userId), self.now(), math.floor(self.random() * 10000))
end

function SessionService:_startNewSession(profile)
	profile.session = GameTick.newSession(profile.userId, self:_newSessionId(profile.userId), self.now())
	return profile.session
end

-- data cũ/thiếu field không được làm sập vòng tick.
-- false = phiên luật cũ (nhóm dân + chính sách, không có lưới), cho chơi ván mới
local function normalizeSession(session)
	local size = Config.GRID_SIZE * Config.GRID_SIZE
	if type(session) ~= "table" or type(session.cells) ~= "table" or #session.cells ~= size then
		return false
	end
	CityEngine.sanitizeCells(session.cells)
	session.cells[Config.GATE_INDEX] = "road"
	local tax = session.tax
	if type(tax) ~= "number" or tax ~= math.floor(tax) or tax < 0 or tax > Config.TAX_MAX then
		session.tax = Config.START_TAX
	end
	for _, key in ipairs({ "budget", "population", "employed", "employment", "gdp", "happiness", "prosperityScore" }) do
		if not Util.isFiniteNumber(session[key]) then
			session[key] = 0
		end
	end
	session.population = math.max(0, math.floor(session.population))
	session.scenarios = type(session.scenarios) == "table" and session.scenarios or {}
	session.history = type(session.history) == "table" and session.history or {}
	session.crises = type(session.crises) == "table" and session.crises or {}
	session.month = tonumber(session.month) or 0
	session.maxMonths = tonumber(session.maxMonths) or Config.GAME_DURATION_MONTHS
	return true
end

local function normalizeProfile(profile, userId, name)
	profile.version = PROFILE_VERSION
	profile.userId = userId
	profile.name = name or profile.name
	profile.pastSessions = type(profile.pastSessions) == "table" and profile.pastSessions or {}
	profile.classes = type(profile.classes) == "table" and profile.classes or {}
	profile.teaching = type(profile.teaching) == "table" and profile.teaching or {}
	profile.scenarioSync = type(profile.scenarioSync) == "table" and profile.scenarioSync or {}
	profile.gamesPlayed = tonumber(profile.gamesPlayed) or 0
	profile.bestScore = tonumber(profile.bestScore) or 0
end

-- đọc hồ sơ + giữ lock. Trả (profile, ok)
function SessionService:_acquire(userId, name)
	local key = self:_key(userId)
	for attempt = 1, 6 do
		local loaded, lockedByOther = nil, false
		local force = attempt == 6 -- lần cuối: coi lock cũ là bỏ rơi
		local ok = self.persistence:update(Config.DATASTORE.profiles, key, function(old)
			loaded, lockedByOther = nil, false
			local now = self.now()
			if not force and type(old) == "table" and type(old.lock) == "table" and old.lock.jobId ~= self.jobId
				and (now - (tonumber(old.lock.at) or 0)) < Config.SESSION_LOCK_STALE_SECONDS then
				lockedByOther = true
				return nil
			end
			local profile = type(old) == "table" and old or newProfile(userId, name)
			profile.lock = { jobId = self.jobId, at = now }
			loaded = profile
			return profile
		end)
		if not ok then
			return nil, false
		end
		if loaded then
			return Util.deepCopy(loaded), true
		end
		if not lockedByOther then
			return nil, false
		end
		self.wait(3) -- server cũ còn đang lưu lần cuối
	end
	return nil, false
end

-- tiếp phiên dở hoặc tạo mới. Phiên chờ client (không tính lượt) tới khi gọi clientReady
function SessionService:loadPlayer(userId, name)
	-- vừa rời rồi vào lại: lần lưu cuối còn chạy thì chờ xong mới đọc
	for _ = 1, 100 do
		local st = self.saveState[userId]
		if not st or not st.running then
			break
		end
		self.wait(0.2)
	end
	local profile, ok = self:_acquire(userId, name)
	if not profile then
		profile = newProfile(userId, name)
	end
	normalizeProfile(profile, userId, name)
	profile.loadFailed = not ok or nil

	local session = profile.session
	if not normalizeSession(session) or GameTick.isFinished(session) then
		session = self:_startNewSession(profile)
		session.status = GameTick.STATUS.PAUSED
		session.waitingForClient = true
	elseif session.status == GameTick.STATUS.ACTIVE or session.autoPaused then
		-- đang chạy dở (server cũ sập) hoặc auto pause lúc rời game: chờ client rồi chạy tiếp
		session.status = GameTick.STATUS.PAUSED
		session.autoPaused = false
		session.waitingForClient = true
	end
	self.profiles[userId] = profile
	return profile
end

-- client dựng xong UI
function SessionService:clientReady(userId)
	local profile = self.profiles[userId]
	if not profile or not profile.session then
		return false, "Dữ liệu chưa tải xong, thử lại sau giây lát"
	end
	local session = profile.session
	if session.waitingForClient then
		session.waitingForClient = false
		-- ván dở thì chạy tiếp. Ván mới (tháng 0) chờ người chơi xây xong tự bấm Bắt đầu
		if not GameTick.isFinished(session) and session.month > 0 then
			session.status = GameTick.STATUS.ACTIVE
		end
	end
	return true
end

function SessionService:getProfile(userId)
	return self.profiles[userId]
end

-- UpdateAsync có check lock. final = true thì nhả lock cho server khác nạp ngay
function SessionService:_write(userId, profile, final)
	if profile.loadFailed or profile.lockLost then
		return false
	end
	local copy = Util.deepCopy(profile)
	for _, field in ipairs(RUNTIME_FIELDS) do
		copy[field] = nil
	end
	if copy.session then
		copy.session.waitingForClient = nil
	end
	local lost = false
	local ok = self.persistence:update(Config.DATASTORE.profiles, self:_key(userId), function(old)
		lost = false
		local now = self.now()
		if old == nil then
			-- hồ sơ bị xoá (yêu cầu xoá data) lúc người chơi còn ở đây: không tạo lại
			lost = true
			return nil
		end
		if type(old) == "table" and type(old.lock) == "table" and old.lock.jobId ~= self.jobId
			and (now - (tonumber(old.lock.at) or 0)) < Config.SESSION_LOCK_STALE_SECONDS then
			lost = true -- server khác đang giữ lock, không ghi đè
			return nil
		end
		if final then
			copy.lock = nil
		else
			copy.lock = { jobId = self.jobId, at = now }
		end
		return copy
	end)
	if lost then
		profile.lockLost = true
	elseif ok then
		self.lastWriteAt[userId] = self.now()
	end
	return ok and not lost
end

-- không chặn. Đang có lần lưu chạy thì gộp vào
function SessionService:requestSave(userId, final)
	local profile = self.profiles[userId]
	local st = self.saveState[userId]
	if not st then
		st = { running = false, again = false, final = false }
		self.saveState[userId] = st
	end
	if profile then
		st.profile = profile
	end
	if not st.profile then
		return
	end
	-- đang teleport: đã lưu cuối + nhả lock, ghi nữa là giành lại lock
	if st.profile.teleporting and not final then
		return
	end
	st.final = st.final or final or false
	if st.running then
		st.again = true
		return
	end
	st.running = true
	self.defer(function()
		repeat
			st.again = false
			local ok, err = pcall(function()
				self:_write(userId, st.profile, st.final)
			end)
			if not ok then
				print("[EconCity] Lỗi lưu hồ sơ " .. tostring(userId) .. ": " .. tostring(err))
			end
		until not st.again
		st.running = false
		if st.final then
			self.saveState[userId] = nil
		end
	end)
end

-- chờ lần lưu đang chạy xong, tối đa timeout giây
function SessionService:flush(userId, timeout)
	local waited = 0
	while self.saveState[userId] and self.saveState[userId].running and waited < (timeout or 20) do
		self.wait(0.2)
		waited = waited + 0.2
	end
end

-- tên cũ, cho chỗ gọi đơn giản
function SessionService:save(userId)
	self:requestSave(userId, false)
	return true
end

local function pauseForLeave(session)
	if session and session.status == GameTick.STATUS.ACTIVE then
		session.status = GameTick.STATUS.PAUSED
		session.autoPaused = true
	elseif session and session.waitingForClient then
		session.autoPaused = true
	end
end

-- rời game: gỡ ngay (hết bị tick), pause, lưu cuối, nhả lock. Trả hồ sơ để ghi tóm tắt lớp
function SessionService:unloadPlayer(userId)
	local profile = self.profiles[userId]
	if not profile then
		return nil
	end
	self.profiles[userId] = nil
	pauseForLeave(profile.session)
	if profile.teleporting then
		return profile -- đã lưu cuối trước khi teleport
	end
	local st = self.saveState[userId]
	if st then
		st.profile = profile
	end
	self.saveState[userId] = st
	if not st then
		self.saveState[userId] = { running = false, again = false, final = false, profile = profile }
	end
	self:requestSave(userId, true)
	self:flush(userId, 25)
	return profile
end

-- trước khi teleport (phòng học riêng): pause, lưu cuối, nhả lock
function SessionService:beginTeleport(userId)
	local profile = self.profiles[userId]
	if not profile then
		return false
	end
	pauseForLeave(profile.session)
	self:requestSave(userId, true)
	self:flush(userId, 20)
	profile.teleporting = true
	return true
end

-- teleport lỗi: lấy lại lock, chạy tiếp
function SessionService:teleportFailed(userId)
	local profile = self.profiles[userId]
	if not profile or not profile.teleporting then
		return false
	end
	profile.teleporting = nil
	local session = profile.session
	if session and session.autoPaused and not GameTick.isFinished(session) then
		session.autoPaused = false
		session.status = GameTick.STATUS.ACTIVE
	end
	self:requestSave(userId, false)
	return true
end

-- tắt server: lưu song song mọi hồ sơ (nhả lock), chờ tối đa ~25s
function SessionService:saveAll()
	local ids = {}
	for userId in pairs(self.profiles) do
		table.insert(ids, userId)
	end
	for _, userId in ipairs(ids) do
		local profile = self.profiles[userId]
		if profile then
			pauseForLeave(profile.session)
			self:requestSave(userId, true)
		end
	end
	local waited = 0
	while waited < 25 do
		local busy = false
		for _, st in pairs(self.saveState) do
			if st.running then
				busy = true
			end
		end
		if not busy then
			break
		end
		self.wait(0.25)
		waited = waited + 0.25
	end
end

-- hành động người chơi

-- CityEngine tự validate mọi thứ client gửi (loại, ô, tiền, ván đã xong)
local CITY_ACTIONS = {
	build = CityEngine.build, -- (kind, index)
	buildRoad = CityEngine.buildRoad, -- (path)
	demolish = CityEngine.demolish, -- (index)
	setTax = CityEngine.setTax, -- (tax)
}

function SessionService:act(userId, action, a, b)
	local profile = self.profiles[userId]
	if not profile or not profile.session then
		return false, "Chưa có ván chơi"
	end
	local fn = CITY_ACTIONS[action]
	if not fn then
		return false, "Hành động không hợp lệ"
	end
	return fn(profile.session, a, b)
end

-- nút "Xây mẫu" (chỉ Studio): bot xây tiếp bằng tiền đang có, đúng luật
function SessionService:demoBuild(userId)
	local profile = self.profiles[userId]
	if not profile or not profile.session then
		return false, "Chưa có ván chơi"
	end
	if GameTick.isFinished(profile.session) then
		return false, "Ván đã kết thúc, hãy bắt đầu ván mới"
	end
	return true, { built = DemoBot.act(profile.session, DemoBot.SHOWCASE) }
end

function SessionService:togglePause(userId)
	local profile = self.profiles[userId]
	if not profile or not profile.session then
		return false, "Chưa có ván chơi"
	end
	local session = profile.session
	if GameTick.isFinished(session) then
		-- không cho "hồi sinh" phiên đã xong bằng nút pause
		return false, "Ván đã kết thúc"
	end
	if session.status == GameTick.STATUS.ACTIVE then
		session.status = GameTick.STATUS.PAUSED
	else
		session.status = GameTick.STATUS.ACTIVE
	end
	session.autoPaused = false
	session.waitingForClient = false
	return true, session.status
end

function SessionService:_archive(profile)
	local session = profile.session
	if not session or session.archived then
		return
	end
	session.archived = true
	profile.gamesPlayed = (profile.gamesPlayed or 0) + 1
	profile.bestScore = math.max(profile.bestScore or 0, session.prosperityScore or 0)
	local summary = GameTick.summary(session)
	summary.finishedAt = self.now()
	table.insert(profile.pastSessions, 1, summary)
	-- giữ kết quả ván vừa xong (kèm lịch sử tháng) để GV vẫn xem được khi HS mở ván mới
	profile.lastFinished = GameTick.summary(session, true)
	profile.lastFinished.finishedAt = summary.finishedAt
	while #profile.pastSessions > Config.MAX_PAST_SESSIONS do
		table.remove(profile.pastSessions)
	end
end

-- người chơi đang ở trong game nên chạy ngay
function SessionService:newGame(userId)
	local profile = self.profiles[userId]
	if not profile then
		return false, "Dữ liệu chưa tải xong, thử lại sau giây lát"
	end
	local old = profile.session
	-- ván chưa qua tháng nào thì không vào lịch sử
	if old and not old.archived and old.month > 0 then
		self:_archive(profile)
	end
	self:_startNewSession(profile)
	self:requestSave(userId, false)
	return true
end

function SessionService:addScenario(userId, scenarioId, meta, customDef)
	local profile = self.profiles[userId]
	if not profile or not profile.session then
		return false, "Chưa có ván chơi"
	end
	return GameTick.addScenario(profile.session, scenarioId, meta, customDef)
end

-- Tick

function SessionService:tickOne(userId)
	local profile = self.profiles[userId]
	if not profile or not profile.session or profile.teleporting or profile.lockLost then
		return nil
	end
	local session = profile.session
	local result = GameTick.processTick(session)
	if not result then
		return nil
	end
	if GameTick.isFinished(session) then
		self:_archive(profile)
		if self.onSessionFinished then
			self.onSessionFinished(userId, profile)
		end
	end
	if self.onTick then
		self.onTick(userId, profile, result)
	end
	self:requestSave(userId, false)
	return result
end

-- trả { [userId] = result }
function SessionService:tickAll()
	self.tickCounter = self.tickCounter + 1
	local results = {}
	local ids = {}
	for userId in pairs(self.profiles) do
		table.insert(ids, userId)
	end
	local now = self.now()
	for _, userId in ipairs(ids) do
		local ok, result = pcall(function()
			return self:tickOne(userId)
		end)
		if ok then
			if result then
				results[userId] = result
			elseif now - (self.lastWriteAt[userId] or 0) >= Config.LOCK_REFRESH_SECONDS then
				-- phiên đang pause/đã xong vẫn refresh lock để server khác biết hồ sơ đang dùng
				self:requestSave(userId, false)
			end
		else
			print("[EconCity] Lỗi khi tick người chơi " .. tostring(userId) .. ": " .. tostring(result))
		end
	end
	return results
end

-- snapshot gửi client

function SessionService:snapshot(userId, extra)
	local profile = self.profiles[userId]
	if not profile then
		return nil
	end
	local session = Util.deepCopy(profile.session)
	if session then
		for _, s in ipairs(session.scenarios or {}) do
			local def = Scenarios.get(s.id)
			if def then
				s.name = def.name
				s.description = def.description
				s.severity = def.severity
			end
			s.monthsLeft = Scenarios.monthsLeft(s)
		end
	end
	local snap = {
		session = session,
		nextTickAt = self.nextTickAt,
		tickSeconds = Config.TICK_SECONDS,
		profile = {
			name = profile.name,
			classes = Util.deepCopy(profile.classes),
			teaching = Util.deepCopy(profile.teaching),
			gamesPlayed = profile.gamesPlayed or 0,
			bestScore = profile.bestScore or 0,
			pastSessions = Util.deepCopy(profile.pastSessions),
		},
		persistence = self.persistence.mode,
		saveDisabled = (profile.loadFailed or profile.lockLost) and true or false,
	}
	if extra then
		for k, v in pairs(extra) do
			snap[k] = v
		end
	end
	return snap
end

return SessionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Phố nền quanh khu đất + spawn. Thành phố 12x12 thì client tự dựng (mỗi người thấy thành phố của mình).
-- nhà thấp ở phía camera toàn cảnh (+X, +Z) và sát khu đất để không che, không đổ bóng lên lưới. Càng về -X, -Z càng cao
-- LCG seed cố định nên server nào cũng giống nhau. Nước dùng Terrain, ngoài Roblox (test) thì tấm kính xanh

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("EconCity")
local Config = require(Shared:WaitForChild("Config"))
local CityLayout = require(Shared:WaitForChild("CityLayout"))

local World = {}

local rgb = Color3.fromRGB
local M = Enum.Material

local ASPHALT = rgb(74, 77, 83) -- cùng màu đường đã nối trong thành phố
local CURB = rgb(214, 216, 212)
local MARK = rgb(242, 241, 234)
local GLASS = { rgb(104, 156, 204), rgb(84, 132, 176), rgb(140, 184, 214), rgb(112, 170, 186), rgb(160, 178, 198), rgb(70, 100, 140) }
local WALLS = { rgb(238, 234, 226), rgb(216, 208, 196), rgb(198, 202, 208), rgb(228, 216, 198), rgb(186, 146, 124), rgb(246, 244, 238), rgb(170, 176, 186) }
local RIBBONS = { rgb(84, 124, 168), rgb(64, 86, 112), rgb(112, 154, 182), rgb(96, 140, 150) }
local ACCENTS = { rgb(214, 64, 58), rgb(46, 107, 255), rgb(242, 184, 40), rgb(46, 158, 98), rgb(124, 92, 220) }
local LEAVES = { rgb(86, 160, 72), rgb(104, 176, 82), rgb(70, 138, 66), rgb(122, 182, 90) }
local CARS = { rgb(236, 236, 236), rgb(30, 32, 38), rgb(196, 40, 40), rgb(46, 107, 255), rgb(150, 154, 160), rgb(242, 184, 40), rgb(60, 70, 90) }

local function part(props, className)
	local p = Instance.new(className or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	return p
end

-- trụ đứng: trục Cylinder của Roblox theo X nên xoay 90 độ
local function disc(props, x, y, z, height, diameter)
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.pi / 2)
	return part(props)
end

local seed = 20261022
local function rand()
	seed = (seed * 1103515245 + 12345) % 2147483648
	return seed / 2147483648
end
local function pick(list)
	return list[math.floor(rand() * #list) + 1]
end

-- Lưới phố
local HALF = CityLayout.HALF_EXTENT -- 84: nửa cạnh khu đất của người chơi
local GATE_X = CityLayout.cellCenter(Config.GATE_INDEX)
local ROAD = 16 -- bề rộng mặt đường
local PITCH = 76 -- khoảng cách hai tim đường (khối phố 60 + đường 16)
local RING = HALF + 12 -- 96: tim đường vành đai (mép đường sát vỉa hè quanh khu đất)
local LINES = {} -- tim đường theo một trục: ±96, ±172, ±248, ±324, ±400, ±476, ±552
for k = 0, 6 do
	table.insert(LINES, -(RING + k * PITCH))
	table.insert(LINES, RING + k * PITCH)
end
table.sort(LINES)
local BANDS = {} -- dải đất giữa 2 tim đường liền nhau, rộng 60. Dải giữa rộng 176 là khu đất
for k = 1, #LINES - 1 do
	BANDS[k] = { LINES[k] + ROAD / 2, LINES[k + 1] - ROAD / 2 }
end
local LIMIT = RING + 5 * PITCH + ROAD / 2 -- 484: tường vô hình ở mép ngoài đường ±476
local AVENUE = { GATE_X - 10, GATE_X + 10 } -- đại lộ từ cổng thành phố chạy về phía +Z

-- sông chạy theo X, giữa 2 đường ven sông z = -324 và z = -248
local RIVER = { z0 = -(RING + 3 * PITCH) + ROAD / 2, z1 = -(RING + 2 * PITCH) - ROAD / 2 } -- -316 .. -256
local BRIDGES = {}
for _, k in ipairs({ 0, 2, 4 }) do
	BRIDGES[RING + k * PITCH] = true
	BRIDGES[-(RING + k * PITCH)] = true
end
local LANDMARK = { x = -(RING + PITCH + PITCH / 2), z = -(RING + PITCH + PITCH / 2) } -- (-210, -210)
local GROUND = 2048

local function onRiver(z)
	return z > RIVER.z0 - 0.5 and z < RIVER.z1 + 0.5
end

-- Đồ đường phố
local function tree(parent, x, z, s, y0)
	y0 = y0 or 0.4
	local m = Instance.new("Model")
	m.Name = "StreetTree"
	disc({ Name = "Trunk", Material = M.Wood, Color = rgb(112, 84, 60), Parent = m }, x, y0 + 1.6 * s, z, 3.2 * s, 0.7 * s)
	part({ Name = "Crown", Shape = Enum.PartType.Ball, Size = Vector3.new(4.4 * s, 4.4 * s, 4.4 * s), Position = Vector3.new(x, y0 + 4.4 * s, z), Material = M.Grass, Color = pick(LEAVES), CanCollide = false, Parent = m })
	part({ Name = "Top", Shape = Enum.PartType.Ball, Size = Vector3.new(3 * s, 3 * s, 3 * s), Position = Vector3.new(x + 0.5 * s, y0 + 6 * s, z - 0.3 * s), Material = M.Grass, Color = pick(LEAVES), CanCollide = false, CastShadow = false, Parent = m })
	m.Parent = parent
end

local function lamp(parent, x, z, y0)
	y0 = y0 or 0.4
	disc({ Name = "LampPole", Material = M.Metal, Color = rgb(64, 68, 76), CastShadow = false, Parent = parent }, x, y0 + 3.2, z, 6.4, 0.32)
	part({ Name = "LampHead", Size = Vector3.new(1.3, 0.35, 1.3), Position = Vector3.new(x, y0 + 6.5, z), Material = M.Neon, Color = rgb(255, 244, 214), CastShadow = false, Parent = parent })
end

local function car(parent, x, z, alongX)
	local function size(l, h, w)
		return alongX and Vector3.new(l, h, w) or Vector3.new(w, h, l)
	end
	local m = Instance.new("Model")
	m.Name = "Car"
	part({ Name = "Wheels", Size = size(3.6, 0.8, 2.3), Position = Vector3.new(x, 0.4, z), Material = M.SmoothPlastic, Color = rgb(30, 30, 34), Parent = m })
	part({ Name = "Body", Size = size(4.6, 1.1, 2.2), Position = Vector3.new(x, 1.15, z), Material = M.SmoothPlastic, Color = pick(CARS), Parent = m })
	part({ Name = "Cabin", Size = size(2.6, 0.9, 2), Position = Vector3.new(x, 2.15, z), Material = M.Glass, Color = rgb(44, 54, 70), Reflectance = 0.3, Parent = m })
	m.Parent = parent
end

-- cây/đèn xen kẽ dọc 4 mép vỉa hè của khối phố
local function dressEdges(parent, x0, x1, z0, z1)
	local inset = 1.8
	local edges = {
		{ x0 + inset, z0 + inset, x1 - inset, z0 + inset },
		{ x0 + inset, z1 - inset, x1 - inset, z1 - inset },
		{ x0 + inset, z0 + inset, x0 + inset, z1 - inset },
		{ x1 - inset, z0 + inset, x1 - inset, z1 - inset },
	}
	for e, edge in ipairs(edges) do
		local ax, az, bx, bz = edge[1], edge[2], edge[3], edge[4]
		local len = math.max(math.abs(bx - ax), math.abs(bz - az))
		local n = math.max(2, math.floor(len / 11))
		for k = 1, n - 1 do
			local t = k / n
			local px, pz = ax + (bx - ax) * t, az + (bz - az) * t
			if (k + e) % 2 == 0 then
				lamp(parent, px, pz)
			else
				tree(parent, px, pz, 0.75 + rand() * 0.2)
			end
		end
	end
end

-- Công trình
local function roofTop(m, x, z, w, d, h)
	local r = rand()
	if r < 0.45 then
		part({ Name = "AC", Size = Vector3.new(math.min(5, w * 0.3), 1.8, math.min(4, d * 0.25)), Position = Vector3.new(x - w * 0.2, h + 0.9, z - d * 0.2), Material = M.Metal, Color = rgb(196, 200, 206), Parent = m })
	elseif r < 0.7 then
		disc({ Name = "Tank", Material = M.Metal, Color = rgb(170, 176, 186), Parent = m }, x + w * 0.2, h + 1.6, z - d * 0.2, 3.2, math.min(4, w * 0.3))
	end
end

-- tháp kính: khối đế + thân kính có dải viền, đỉnh là helipad hoặc ăng-ten
local function tower(parent, x, z, w, d, h, detail)
	local m = Instance.new("Model")
	m.Name = "Tower"
	local podium = 8 + math.floor(rand() * 3) * 2
	local wall = pick(WALLS)
	part({ Name = "Podium", Size = Vector3.new(w, podium, d), Position = Vector3.new(x, podium / 2, z), Material = M.Concrete, Color = wall, Parent = m })
	part({ Name = "Storefront", Size = Vector3.new(w + 0.3, podium - 4, d + 0.3), Position = Vector3.new(x, podium / 2 - 0.5, z), Material = M.Glass, Color = rgb(130, 178, 214), Reflectance = 0.2, Parent = m })
	local tw, td = w * 0.76, d * 0.76
	local body = h - podium
	local glass = pick(GLASS)
	part({ Name = "Body", Size = Vector3.new(tw, body, td), Position = Vector3.new(x, podium + body / 2, z), Material = M.Glass, Color = glass, Reflectance = 0.22, Parent = m })
	local step = detail and (h > 110 and 10 or 7) or 14
	for y = podium + step, h - 3, step do
		part({ Name = "Band", Size = Vector3.new(tw + 0.3, detail and 0.7 or 1.2, td + 0.3), Position = Vector3.new(x, y, z), Material = M.SmoothPlastic, Color = rgb(236, 240, 245), CastShadow = false, Parent = m })
	end
	-- cột góc suốt thân, đặt ở góc camera nhìn thấy
	if detail then
		part({ Name = "Fin", Size = Vector3.new(0.8, body, 0.8), Position = Vector3.new(x + tw / 2, podium + body / 2, z + td / 2), Material = M.SmoothPlastic, Color = rgb(236, 240, 245), CastShadow = false, Parent = m })
	end
	part({ Name = "Crown", Size = Vector3.new(tw + 0.6, 2, td + 0.6), Position = Vector3.new(x, h + 1, z), Material = M.SmoothPlastic, Color = glass:Lerp(rgb(255, 255, 255), 0.55), Parent = m })
	if h > 120 and rand() < 0.5 then
		disc({ Name = "Antenna", Material = M.Metal, Color = rgb(220, 222, 226), CastShadow = false, Parent = m }, x, h + 14, z, 24, 0.8)
		part({ Name = "Beacon", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Position = Vector3.new(x, h + 26.5, z), Material = M.Neon, Color = rgb(255, 72, 72), CastShadow = false, Parent = m })
	elseif h > 80 and math.min(tw, td) > 16 then
		disc({ Name = "HelipadRing", Material = M.SmoothPlastic, Color = rgb(242, 184, 40), Parent = m }, x, h + 2.1, z, 0.2, math.min(tw, td) * 0.8)
		disc({ Name = "Helipad", Material = M.Concrete, Color = rgb(70, 74, 82), Parent = m }, x, h + 2.2, z, 0.2, math.min(tw, td) * 0.8 - 1.2)
	else
		roofTop(m, x, z, tw, td, h + 2)
	end
	m.Parent = parent
end

local function midrise(parent, x, z, w, d, h, detail)
	local m = Instance.new("Model")
	m.Name = "Building"
	local wall = pick(WALLS)
	local ribbon = pick(RIBBONS)
	part({ Name = "Body", Size = Vector3.new(w, h, d), Position = Vector3.new(x, h / 2, z), Material = M.Concrete, Color = wall, Parent = m })
	local step = detail and 3.6 or 7.2
	for y = 2.8, h - 2.4, step do
		part({ Name = "Windows", Size = Vector3.new(w + 0.3, detail and 1.9 or 3.6, d + 0.3), Position = Vector3.new(x, y, z), Material = M.Glass, Color = ribbon, Reflectance = 0.15, CastShadow = false, Parent = m })
	end
	part({ Name = "Roof", Size = Vector3.new(w + 0.6, 0.8, d + 0.6), Position = Vector3.new(x, h + 0.4, z), Material = M.SmoothPlastic, Color = wall:Lerp(rgb(40, 40, 40), 0.25), Parent = m })
	if detail then
		roofTop(m, x, z, w, d, h + 0.8)
	end
	m.Parent = parent
end

local function shops(parent, x, z, w, d, h)
	local m = Instance.new("Model")
	m.Name = "Shops"
	local accent = pick(ACCENTS)
	part({ Name = "Body", Size = Vector3.new(w, h, d), Position = Vector3.new(x, h / 2, z), Material = M.Plaster, Color = pick(WALLS), Parent = m })
	part({ Name = "Storefront", Size = Vector3.new(w + 0.3, 3.2, d + 0.3), Position = Vector3.new(x, 2.2, z), Material = M.Glass, Color = rgb(150, 196, 230), Reflectance = 0.25, CastShadow = false, Parent = m })
	part({ Name = "Awning", Size = Vector3.new(w + 1.8, 0.4, d + 1.8), Position = Vector3.new(x, 4.3, z), Material = M.SmoothPlastic, Color = accent, Parent = m })
	part({ Name = "Sign", Size = Vector3.new(w + 0.4, 1.2, d + 0.4), Position = Vector3.new(x, h - 1.2, z), Material = M.SmoothPlastic, Color = accent:Lerp(rgb(255, 255, 255), 0.75), CastShadow = false, Parent = m })
	part({ Name = "Roof", Size = Vector3.new(w + 0.6, 0.6, d + 0.6), Position = Vector3.new(x, h + 0.3, z), Material = M.SmoothPlastic, Color = rgb(120, 124, 132), Parent = m })
	m.Parent = parent
end

-- tháp biểu tượng: 3 tầng nhỏ dần + chóp
local function landmark(parent, x, z)
	local m = Instance.new("Model")
	m.Name = "Landmark"
	part({ Name = "Plaza", Size = Vector3.new(54, 0.3, 54), Position = Vector3.new(x, 0.55, z), Material = M.Granite, Color = rgb(226, 224, 218), Parent = m })
	local tiers = { { 36, 110 }, { 28, 70 }, { 20, 50 } }
	local y = 0.7
	for i, t in ipairs(tiers) do
		local s, h = t[1], t[2]
		part({ Name = "Tier" .. i, Size = Vector3.new(s, h, s), Position = Vector3.new(x, y + h / 2, z), Material = M.Glass, Color = rgb(96, 146, 196), Reflectance = 0.25, Parent = m })
		for yy = y + 8, y + h - 2, 8 do
			part({ Name = "Band", Size = Vector3.new(s + 0.3, 0.6, s + 0.3), Position = Vector3.new(x, yy, z), Material = M.SmoothPlastic, Color = rgb(238, 242, 248), CastShadow = false, Parent = m })
		end
		part({ Name = "Ledge", Size = Vector3.new(s + 1.2, 1.2, s + 1.2), Position = Vector3.new(x, y + h + 0.6, z), Material = M.SmoothPlastic, Color = rgb(230, 234, 240), Parent = m })
		y = y + h + 1.2
	end
	disc({ Name = "Spire", Material = M.Metal, Color = rgb(226, 230, 236), Parent = m }, x, y + 20, z, 40, 2)
	part({ Name = "Beacon", Shape = Enum.PartType.Ball, Size = Vector3.new(2.6, 2.6, 2.6), Position = Vector3.new(x, y + 41, z), Material = M.Neon, Color = rgb(255, 72, 72), CastShadow = false, Parent = m })
	m.Parent = parent
end

local function park(parent, x0, x1, z0, z1)
	local m = Instance.new("Model")
	m.Name = "Park"
	local w, d = x1 - x0, z1 - z0
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	part({ Name = "Lawn", Size = Vector3.new(w - 4, 0.5, d - 4), Position = Vector3.new(cx, 0.45, cz), Material = M.Grass, Color = rgb(112, 178, 86), Parent = m })
	part({ Name = "PathX", Size = Vector3.new(w - 4, 0.1, 3.2), Position = Vector3.new(cx, 0.72, cz), Material = M.Pavement, Color = rgb(226, 222, 210), Parent = m })
	part({ Name = "PathZ", Size = Vector3.new(3.2, 0.1, d - 4), Position = Vector3.new(cx, 0.72, cz), Material = M.Pavement, Color = rgb(226, 222, 210), Parent = m })
	disc({ Name = "Basin", Material = M.Concrete, Color = rgb(224, 226, 230), Parent = m }, cx, 1.1, cz, 1, 14)
	disc({ Name = "Water", Material = M.Glass, Color = rgb(80, 170, 220), Transparency = 0.15, Reflectance = 0.3, Parent = m }, cx, 1.62, cz, 0.1, 12.4)
	disc({ Name = "Jet", Material = M.Glass, Color = rgb(200, 236, 255), Transparency = 0.3, CastShadow = false, Parent = m }, cx, 3, cz, 4, 1.4)
	local count = math.floor(w * d / 260)
	for _ = 1, count do
		local px = x0 + 5 + rand() * (w - 10)
		local pz = z0 + 5 + rand() * (d - 10)
		if math.abs(px - cx) > 4 and math.abs(pz - cz) > 4 and (px - cx) ^ 2 + (pz - cz) ^ 2 > 120 then
			tree(m, px, pz, 0.9 + rand() * 0.6, 0.7)
		end
	end
	m.Parent = parent
end

-- kiểu nhà + chiều cao theo vị trí lô. s > 0 là phía camera toàn cảnh
local function plan(lx, lz)
	local dist = math.max(math.abs(lx), math.abs(lz))
	local s = (lx + lz) / 2
	local r = rand()
	if dist < 170 then
		-- vòng sát khu đất: thấp để không che, không đổ bóng lên lưới
		if s > 60 then
			return r < 0.5 and "shops" or "mid", 8 + rand() * 6
		end
		return r < 0.3 and "shops" or "mid", 12 + rand() * 16
	end
	local reach = math.clamp((dist - 170) / 300, 0, 1)
	if s > 90 then
		return "mid", 10 + rand() * (10 + 18 * reach)
	end
	local depth = math.clamp(-s / 300, 0, 1)
	if r < 0.3 + 0.5 * depth then
		return "tower", 45 + (40 + 120 * math.max(depth, reach * 0.6)) * (0.55 + rand() * 0.6)
	end
	return "mid", 18 + rand() * (20 + 30 * reach)
end

-- khối phố [x0, x1] x [z0, z1]: nền vỉa hè rồi chia lô
local function block(parent, x0, x1, z0, z1)
	local w, d = x1 - x0, z1 - z0
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	local dist = math.max(math.abs(cx), math.abs(cz))
	local near = dist < 170
	local detail = dist < 330
	part({ Name = "Sidewalk", Size = Vector3.new(w, 0.4, d), Position = Vector3.new(cx, 0.2, cz), Material = M.Pavement, Color = CURB, Parent = parent })
	if near then
		dressEdges(parent, x0, x1, z0, z1)
	end
	local lotSize = detail and 30 or 60
	local nx = math.max(1, math.floor(w / lotSize + 0.5))
	local nz = math.max(1, math.floor(d / lotSize + 0.5))
	local lw, ld = w / nx, d / nz
	local margin = near and 8 or 6
	for i = 1, nx do
		for j = 1, nz do
			local lx, lz = x0 + lw * (i - 0.5), z0 + ld * (j - 0.5)
			local bw, bd = lw - margin - rand() * 4, ld - margin - rand() * 4
			local kind, h = plan(lx, lz)
			if kind == "tower" then
				bw, bd = math.min(bw, 30 + rand() * 8), math.min(bd, 30 + rand() * 8)
				tower(parent, lx, lz, bw, bd, h, detail or h > 130)
			elseif kind == "shops" then
				shops(parent, lx, lz, bw, bd, h)
			else
				bw, bd = math.min(bw, 46), math.min(bd, 46)
				midrise(parent, lx, lz, bw, bd, h, detail)
			end
		end
	end
end

-- mặt đường, vạch kẻ, cầu
local function streets(parent)
	local south = GROUND / 2 - RIVER.z1
	local north = RIVER.z0 + GROUND / 2
	part({ Name = "Asphalt", Size = Vector3.new(GROUND, 2, south), Position = Vector3.new(0, -1, RIVER.z1 + south / 2), Material = M.Asphalt, Color = ASPHALT, Parent = parent })
	part({ Name = "AsphaltFar", Size = Vector3.new(GROUND, 2, north), Position = Vector3.new(0, -1, RIVER.z0 - north / 2), Material = M.Asphalt, Color = ASPHALT, Parent = parent })

	local marks = Instance.new("Folder")
	marks.Name = "RoadMarks"
	marks.Parent = parent
	local function line(x, z, sx, sz)
		part({ Name = "Mark", Size = Vector3.new(sx, 0.05, sz), Position = Vector3.new(x, 0.025, z), Material = M.SmoothPlastic, Color = MARK, CanCollide = false, CanQuery = false, CastShadow = false, Parent = marks })
	end
	-- vạch tim đường, từng đoạn giữa 2 ngã tư
	for _, L in ipairs(LINES) do
		for _, band in ipairs(BANDS) do
			local a, b = band[1], band[2]
			local mid, len = (a + b) / 2, b - a
			-- đường chạy theo X (z = L)
			line(mid, L, len, 0.45)
			-- đường chạy theo Z (x = L): bỏ đoạn qua sông nếu không có cầu
			if not (onRiver(mid) and not BRIDGES[L]) then
				line(L, mid, 0.45, len)
			end
		end
	end
	-- vạch tim đại lộ
	line(GATE_X, (RING + ROAD / 2 + LINES[#LINES]) / 2, 0.45, LINES[#LINES] - RING - ROAD / 2)
	-- vạch sang đường quanh các ngã tư gần khu đất
	local nearLines = { -(RING + PITCH), -RING, RING, RING + PITCH }
	for _, ix in ipairs(nearLines) do
		for _, iz in ipairs(nearLines) do
			for _, side in ipairs({ -1, 1 }) do
				for k = -2, 2 do
					line(ix + side * (ROAD / 2 + 3), iz + k * 3, 4, 1.4)
					line(ix + k * 3, iz + side * (ROAD / 2 + 3), 1.4, 4)
				end
			end
		end
	end
	local len = RIVER.z1 - RIVER.z0
	local zc = (RIVER.z0 + RIVER.z1) / 2
	for x in pairs(BRIDGES) do
		local bridge = Instance.new("Model")
		bridge.Name = "Bridge"
		part({ Name = "Deck", Size = Vector3.new(ROAD + 4, 1.6, len + 2), Position = Vector3.new(x, -0.8, zc), Material = M.Concrete, Color = rgb(200, 202, 206), Parent = bridge })
		part({ Name = "Road", Size = Vector3.new(ROAD, 0.1, len + 2), Position = Vector3.new(x, 0.05, zc), Material = M.Asphalt, Color = ASPHALT, Parent = bridge })
		for _, side in ipairs({ -1, 1 }) do
			part({ Name = "Rail", Size = Vector3.new(0.6, 1.6, len + 2), Position = Vector3.new(x + side * (ROAD / 2 + 1.7), 0.8, zc), Material = M.Metal, Color = rgb(46, 107, 255), Parent = bridge })
		end
		for k = 1, 3 do
			part({ Name = "Pier", Size = Vector3.new(ROAD, 12, 3), Position = Vector3.new(x, -7.6, RIVER.z0 + len * k / 4), Material = M.Concrete, Color = rgb(182, 184, 190), Parent = bridge })
		end
		bridge.Parent = parent
	end
end

-- sông: kè 2 bờ + lan can, đáy, nước (Terrain nếu có)
local function river(parent)
	local len = RIVER.z1 - RIVER.z0
	local zc = (RIVER.z0 + RIVER.z1) / 2
	-- lan can ngắt chỗ có cầu
	local gaps = {}
	for x in pairs(BRIDGES) do
		table.insert(gaps, x)
	end
	table.sort(gaps)
	local spans, from = {}, -GROUND / 2
	for _, x in ipairs(gaps) do
		table.insert(spans, { from, x - ROAD / 2 - 2.2 })
		from = x + ROAD / 2 + 2.2
	end
	table.insert(spans, { from, GROUND / 2 })
	for _, z in ipairs({ RIVER.z0, RIVER.z1 }) do
		local inward = z == RIVER.z0 and 1 or -1
		part({ Name = "Embankment", Size = Vector3.new(GROUND, 15, 2), Position = Vector3.new(0, -7.5, z + inward), Material = M.Concrete, Color = rgb(190, 192, 196), Parent = parent })
		for _, span in ipairs(spans) do
			local a, b = span[1], span[2]
			part({ Name = "Railing", Size = Vector3.new(b - a, 1.2, 0.3), Position = Vector3.new((a + b) / 2, 0.6, z + inward * 1.6), Material = M.Metal, Color = rgb(90, 96, 108), CastShadow = false, Parent = parent })
		end
	end
	part({ Name = "RiverBed", Size = Vector3.new(GROUND, 2, len), Position = Vector3.new(0, -15, zc), Material = M.Slate, Color = rgb(72, 84, 88), Parent = parent })
	local ok = false
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		ok = pcall(function()
			terrain.WaterColor = rgb(48, 136, 180)
			terrain.WaterTransparency = 0.45
			terrain.WaterReflectance = 0.7
			terrain.WaterWaveSize = 0.08
			terrain.WaterWaveSpeed = 6
			-- voxel terrain chia mốc ở y = -6, -2, 2... nên mặt nước nằm quanh y = -2
			terrain:FillBlock(CFrame.new(0, -8, zc), Vector3.new(GROUND, 12, len - 4), M.Water)
		end)
	end
	if not ok then
		part({ Name = "Water", Size = Vector3.new(GROUND, 1, len - 4), Position = Vector3.new(0, -2.5, zc), Material = M.Glass, Color = rgb(48, 136, 180), Transparency = 0.2, Reflectance = 0.3, CanCollide = false, Parent = parent })
	end
end

-- đèn trên vỉa hè quanh khu đất. Vỉa hè do client vẽ, mặt trên y = 0.5
local function plotLamps(parent)
	local edge = HALF + 3
	for t = -HALF + 6, HALF - 6, 24 do
		for _, p in ipairs({ { t, -edge }, { t, edge }, { -edge, t }, { edge, t } }) do
			if not (p[2] == edge and math.abs(p[1] - GATE_X) < 12) then
				lamp(parent, p[1], p[2], 0.5)
			end
		end
	end
end

-- xe đỗ dọc các làn gần khu đất
local function traffic(parent)
	local cars = Instance.new("Folder")
	cars.Name = "Traffic"
	cars.Parent = parent
	local function clear(x, z)
		for _, L in ipairs(LINES) do
			if math.abs(x - L) < ROAD / 2 + 6 and math.abs(z - L) < ROAD / 2 + 6 then
				return false
			end
		end
		if math.abs(x - GATE_X) < 14 and math.abs(z - (RING + 8)) < 16 then
			return false -- chừa chỗ spawn
		end
		return true
	end
	local function crossing(v)
		for _, L in ipairs(LINES) do
			if math.abs(v - L) < ROAD / 2 + 6 then
				return true
			end
		end
		return false
	end
	local near = { -(RING + 2 * PITCH), -(RING + PITCH), -RING, RING, RING + PITCH, RING + 2 * PITCH }
	for _, L in ipairs(near) do
		for _ = 1, 4 do
			local lane = rand() < 0.5 and -4 or 4
			local t = -260 + rand() * 520
			if not crossing(t) and clear(t, L) then
				car(cars, t, L + lane, true)
			end
			t = -260 + rand() * 520
			if not crossing(t) and not onRiver(t) and clear(L, t) then
				car(cars, L + lane, t, false)
			end
		end
	end
	for _ = 1, 6 do
		local z = RING + ROAD + rand() * 300
		if not crossing(z) then
			car(cars, GATE_X + (rand() < 0.5 and -4 or 4), z, false)
		end
	end
end

local function cityscape(folder)
	local city = Instance.new("Folder")
	city.Name = "Cityscape"
	streets(city)
	river(city)
	for _, bx in ipairs(BANDS) do
		for _, bz in ipairs(BANDS) do
			local centerX = bx[1] < 0 and bx[2] > 0
			local centerZ = bz[1] < 0 and bz[2] > 0
			local cx, cz = (bx[1] + bx[2]) / 2, (bz[1] + bz[2]) / 2
			if (centerX and centerZ) or onRiver(cz) then
				-- khu đất của người chơi / lòng sông: để trống
			elseif cx == LANDMARK.x and cz == LANDMARK.z then
				part({ Name = "Sidewalk", Size = Vector3.new(bx[2] - bx[1], 0.4, bz[2] - bz[1]), Position = Vector3.new(cx, 0.2, cz), Material = M.Pavement, Color = CURB, Parent = city })
				landmark(city, cx, cz)
			elseif (cx == -cz and math.abs(cx) == RING + PITCH / 2) or rand() < 0.05 then
				-- 2 công viên ở 2 góc chéo sát khu đất + vài cái rải rác
				part({ Name = "Sidewalk", Size = Vector3.new(bx[2] - bx[1], 0.4, bz[2] - bz[1]), Position = Vector3.new(cx, 0.2, cz), Material = M.Pavement, Color = CURB, Parent = city })
				park(city, bx[1], bx[2], bz[1], bz[2])
				if math.max(math.abs(cx), math.abs(cz)) < 170 then
					dressEdges(city, bx[1], bx[2], bz[1], bz[2])
				end
			elseif centerX and bz[1] > 0 then
				-- dải phía +Z bị đại lộ dẫn vào cổng chia đôi
				block(city, bx[1], AVENUE[1], bz[1], bz[2])
				block(city, AVENUE[2], bx[2], bz[1], bz[2])
			else
				block(city, bx[1], bx[2], bz[1], bz[2])
			end
		end
	end
	plotLamps(city)
	traffic(city)
	pcall(function()
		local terrain = Workspace:FindFirstChildOfClass("Terrain")
		if terrain then
			local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
			clouds.Cover = 0.45
			clouds.Density = 0.55
			clouds.Color = rgb(255, 255, 255)
			clouds.Parent = terrain
		end
	end)
	city.Parent = folder
end

function World.build()
	if Workspace:FindFirstChild("EconCityWorld") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "EconCityWorld"

	local ok, err = pcall(cityscape, folder)
	if not ok then
		warn("[EconCity] Không dựng được khung cảnh đô thị: " .. tostring(err))
		part({ Name = "Ground", Size = Vector3.new(1000, 2, 1000), Position = Vector3.new(0, -1, 0), Material = M.Asphalt, Color = ASPHALT, Parent = folder })
	end

	local spawnPos = CityLayout.SPAWN
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "CitySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	-- trên đường vành đai trước cổng, cùng màu mặt đường cho khỏi lộ ở góc nhìn toàn cảnh
	spawn.Size = Vector3.new(10, 0.2, 10)
	spawn.Position = Vector3.new(spawnPos.x, spawnPos.y + 0.1, spawnPos.z)
	spawn.Material = M.Asphalt
	spawn.Color = ASPHALT
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = folder

	-- tường vô hình, không cho nhân vật ra khỏi lưới phố
	local half, height, thick = LIMIT, 300, 4
	local walls = {
		{ Vector3.new(0, height / 2, half + thick / 2), Vector3.new(half * 2 + thick * 2, height, thick) },
		{ Vector3.new(0, height / 2, -half - thick / 2), Vector3.new(half * 2 + thick * 2, height, thick) },
		{ Vector3.new(half + thick / 2, height / 2, 0), Vector3.new(thick, height, half * 2) },
		{ Vector3.new(-half - thick / 2, height / 2, 0), Vector3.new(thick, height, half * 2) },
	}
	for i, w in ipairs(walls) do
		part({
			Name = "Boundary" .. i,
			Position = w[1],
			Size = w[2],
			Transparency = 1,
			CanCollide = true,
			CastShadow = false,
			Parent = folder,
		})
	end

	folder.Parent = Workspace
end

return World
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000002B"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000029"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000024"><Properties><string name="Name">EconCityClient</string></Properties><Item class="Folder" referent="RBX00000018"><Properties><string name="Name">City</string></Properties><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">BuildController</string><ProtectedString name="Source"><![CDATA[-- Xây/phá trên thành phố 3D bằng công cụ đang chọn, không có công cụ thì bấm ô để xem thông tin.
-- Đường: giữ và kéo theo hàng/cột. Tay cầm: D-pad dời ô, A xây/phá, B bỏ công cụ. 2x2: ô bấm là góc trên-trái.
-- Server kiểm tra lại hết (CityEngine), ở đây chỉ để hiện trước.

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("EconCity")
local Config = require(Shared:WaitForChild("Config"))
local CityLayout = require(Shared:WaitForChild("CityLayout"))
local CityEngine = require(Shared:WaitForChild("CityEngine"))
local Util = require(Shared:WaitForChild("Util"))

local N = Config.GRID_SIZE

local BuildController = {}
BuildController.__index = BuildController

-- deps: renderer (CityRenderer), getSession(), isOverview(): bool (false = đang đi dạo),
--   request(action, payload): { ok, data, error } (gọi trong task riêng), toast(text, kind), inspect(index),
--   pointerOverUi(position): bool, isGamepad(): bool, onToolChanged(tool) tuỳ chọn
function BuildController.new(deps)
	local self = setmetatable({}, BuildController)
	self.deps = deps
	self.renderer = deps.renderer
	self.tool = nil
	self.path = nil
	self.dragInput = nil
	self.hover = nil
	self.cursor = Config.GATE_INDEX - N -- ô ngay trên cổng
	self:_connect()
	return self
end

-- đoán trước để tô màu: "ok" | "warn" (được nhưng chưa nối đường về cổng) | "bad"
function BuildController:preview(index)
	local session = self.deps.getSession()
	if not session or not index or not session.cells or not self.tool then
		return "bad"
	end
	if session.status == "ENDED" or session.status == "FAILED" then
		return "bad"
	end
	local cells = session.cells
	if self.tool == "demolish" then
		local anchor = CityEngine.anchorOf(cells, index)
		return (cells[anchor] ~= Config.EMPTY and anchor ~= Config.GATE_INDEX) and "ok" or "bad"
	end
	local fp = CityEngine.footprint(index, Config.BUILDINGS[self.tool].size)
	if not fp or session.budget < CityEngine.priceOf(session, self.tool) then
		return "bad"
	end
	for _, c in ipairs(fp) do
		if cells[c] ~= Config.EMPTY then
			return "bad"
		end
	end
	-- có ô đường đã nối cổng nằm sát vùng xây không
	local conn = CityEngine.connectivity(cells)
	for _, c in ipairs(fp) do
		for _, j in ipairs(CityEngine.neighbours(c)) do
			if cells[j] == "road" and conn[j] then
				return "ok"
			end
		end
	end
	return "warn"
end

-- index = nil để ẩn. Phá dỡ thì tô cả công trình sẽ bị phá
function BuildController:showGhost(index)
	if not index or not self.tool then
		self.renderer:setGhost(nil)
		return
	end
	local anchor, size = index, Config.BUILDINGS[self.tool] and Config.BUILDINGS[self.tool].size or 1
	local session = self.deps.getSession()
	if self.tool == "demolish" and session and session.cells then
		anchor = CityEngine.anchorOf(session.cells, index)
		local def = Config.BUILDINGS[session.cells[anchor]]
		size = def and def.size or 1
	end
	self.renderer:setGhost(anchor, self:preview(index), size)
end

function BuildController:setTool(tool)
	if tool == self.tool then
		tool = nil -- bấm lại công cụ đang chọn = bỏ chọn
	end
	self.tool = tool
	self.path = nil
	self.dragInput = nil
	self.renderer:setPath(nil)
	if tool and self.deps.isGamepad and self.deps.isGamepad() then
		-- bỏ chọn nút UI để D-pad điều khiển ô trên bản đồ
		pcall(function()
			GuiService.SelectedObject = nil
		end)
		self:showGhost(self.cursor)
	else
		self:showGhost(nil)
	end
	if self.deps.onToolChanged then
		self.deps.onToolChanged(tool)
	end
end

local function send(self, action, payload, okText)
	task.spawn(function()
		local response = self.deps.request(action, payload)
		if not response.ok then
			self.deps.toast(response.error or "Không thực hiện được", "error")
		elseif okText then
			self.deps.toast(okText(response.data or {}))
		end
	end)
end

function BuildController:apply(index)
	local tool = self.tool
	if not tool then
		self.deps.inspect(index)
	elseif tool == "demolish" then
		send(self, "demolish", { index = index }, function(data)
			return "Đã phá dỡ, hoàn " .. Util.formatMoneyFull(data.refund or 0)
		end)
	elseif tool == "road" then
		send(self, "buildRoad", { path = { index } })
	else
		local unconnected = self:preview(index) == "warn"
		send(self, "build", { kind = tool, index = index }, unconnected and function()
			return "Chưa nối đường về CỔNG nên công trình này chưa hoạt động. Hãy kéo đường tới nó."
		end or nil)
	end
end

-- chỉ nhận ô cùng hàng/cột với ô cuối, tự lấp ô ở giữa
function BuildController.extendPath(path, j)
	local last = path[#path]
	for _, i in ipairs(path) do
		if i == j then
			return
		end
	end
	local lx, ly = CityLayout.cellXY(last)
	local jx, jy = CityLayout.cellXY(j)
	if lx ~= jx and ly ~= jy then
		return
	end
	local step = (lx == jx) and (jy > ly and N or -N) or (jx > lx and 1 or -1)
	local k = last + step
	while #path < Config.MAX_ROAD_PATH do
		local seen = false
		for _, i in ipairs(path) do
			if i == k then
				seen = true
			end
		end
		if not seen then
			table.insert(path, k)
		end
		if k == j then
			break
		end
		k = k + step
	end
end

function BuildController:cellAtScreen(position)
	local cam = Workspace.CurrentCamera
	if not cam then
		return nil
	end
	local ray = cam:ScreenPointToRay(position.X, position.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { self.renderer.folder }
	local result = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
	if not result then
		return nil
	end
	return CityLayout.cellAt(result.Position.X, result.Position.Z)
end

function BuildController:_finishDrag()
	local path = self.path
	self.path = nil
	self.dragInput = nil
	self.renderer:setPath(nil)
	if path and #path > 0 then
		send(self, "buildRoad", { path = path })
	end
end

local function isPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local GAMEPAD_MOVES = {
	[Enum.KeyCode.DPadUp] = { 0, -1 },
	[Enum.KeyCode.DPadDown] = { 0, 1 },
	[Enum.KeyCode.DPadLeft] = { -1, 0 },
	[Enum.KeyCode.DPadRight] = { 1, 0 },
}

function BuildController:_connect()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		-- tay cầm, chỉ khi không có nút UI nào đang được chọn
		local move = GAMEPAD_MOVES[input.KeyCode]
		local guiSelected = false
		pcall(function()
			guiSelected = GuiService.SelectedObject ~= nil
		end)
		if self.tool and not guiSelected and (move or input.KeyCode == Enum.KeyCode.ButtonA or input.KeyCode == Enum.KeyCode.ButtonB) then
			if move then
				local x, y = CityLayout.cellXY(self.cursor)
				x = math.clamp(x + move[1], 1, N)
				y = math.clamp(y + move[2], 1, N)
				self.cursor = (y - 1) * N + x
				self:showGhost(self.cursor)
			elseif input.KeyCode == Enum.KeyCode.ButtonA then
				self:apply(self.cursor)
			else
				self:setTool(nil)
			end
			return
		end
		if not isPointer(input) or self.deps.pointerOverUi(input.Position) then
			return
		end
		-- đi dạo trên cảm ứng: vuốt là xoay camera nên chỉ xây khi chạm nhẹ
		if input.UserInputType == Enum.UserInputType.Touch and not self.deps.isOverview() then
			self.tap = { input = input, x = input.Position.X, y = input.Position.Y } -- xử lý lúc nhấc tay
			return
		end
		local index = self:cellAtScreen(input.Position)
		if not index then
			return
		end
		if self.tool == "road" then
			self.path = { index }
			self.dragInput = input
			self.renderer:setGhost(nil)
			self.renderer:setPath(self.path)
		else
			self:apply(index)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not self.tool then
			return
		end
		local dragging = self.path ~= nil
		local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
		if dragging then
			local follow = (isMouse and self.dragInput.UserInputType == Enum.UserInputType.MouseButton1) or input == self.dragInput
			if not follow then
				return
			end
			-- nhả chuột ngoài cửa sổ có thể không có InputEnded
			if isMouse and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
				self:_finishDrag()
				return
			end
			local index = self:cellAtScreen(input.Position)
			if index then
				BuildController.extendPath(self.path, index)
				self.renderer:setPath(self.path)
			end
		elseif isMouse then
			local index = self:cellAtScreen(input.Position)
			if index ~= self.hover then
				self.hover = index
				self:showGhost(index)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local tap = self.tap
		if tap and input == tap.input then
			self.tap = nil
			if math.abs(input.Position.X - tap.x) + math.abs(input.Position.Y - tap.y) < 16 then
				local index = self:cellAtScreen(input.Position)
				if index then
					self:apply(index)
				end
			end
			return
		end
		if not self.path then
			return
		end
		if input == self.dragInput or (self.dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
			self:_finishDrag()
		end
	end)
end

return BuildController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[-- Camera nhìn chéo cố định xuống cả thành phố (có zoom), hoặc chế độ đi dạo dùng camera mặc định theo nhân vật.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local CameraController = {}
CameraController.__index = CameraController

local DIRECTION = Vector3.new(1, 1.15, 1).Unit
-- điện thoại màn thấp: nhìn dốc hơn cho lọt cả thành phố
local DIRECTION_TOUCH = Vector3.new(1, 1.6, 1).Unit
local STUDS_PER_ZOOM = 9

function CameraController.new(focus)
	local self = setmetatable({}, CameraController)
	local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	self.focus = focus or Vector3.new(0, 0, 0)
	self.currentFocus = self.focus
	self.direction = touch and DIRECTION_TOUCH or DIRECTION
	-- zoom mặc định: đủ gần để thấy rõ nhà mà vẫn thấy hết lưới 12x12
	self.minZoom = touch and 12 or 9
	self.maxZoom = touch and 36 or 30
	self.zoom = touch and 25 or 22
	self.currentZoom = self.zoom
	self.mode = "overview"
	self._connections = {}

	table.insert(self._connections, UserInputService.InputChanged:Connect(function(input, processed)
		if processed or self.mode ~= "overview" then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			self:zoomBy(-input.Position.Z * 2)
		end
	end))
	local pinchStartZoom = self.zoom
	table.insert(self._connections, UserInputService.TouchPinch:Connect(function(_, scale, _, state, processed)
		if processed or self.mode ~= "overview" then
			return
		end
		if state == Enum.UserInputState.Begin then
			pinchStartZoom = self.zoom
		elseif state == Enum.UserInputState.Change and scale > 0 then
			-- scale tính từ lúc bắt đầu chụm. Chụm vào (scale < 1) thì lùi xa, mở ra thì lại gần
			self.zoom = math.clamp(pinchStartZoom / scale, self.minZoom, self.maxZoom)
		end
	end))
	-- phải chạy sau camera script mặc định của Roblox
	RunService:BindToRenderStep("EconCityCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		self:_update(dt)
	end)
	self:setMode("overview")
	return self
end

-- dời điểm nhìn (vd. né bảng Xây dựng bên phải), _update tự lerp tới
function CameraController:setFocus(focus)
	self.focus = focus
end

function CameraController:zoomBy(delta)
	self.zoom = math.clamp(self.zoom + delta, self.minZoom, self.maxZoom)
end

function CameraController:_update(dt)
	if self.mode ~= "overview" then
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	local alpha = math.clamp(dt * 8, 0, 1)
	self.currentZoom = self.currentZoom + (self.zoom - self.currentZoom) * alpha
	self.currentFocus = self.currentFocus + (self.focus - self.currentFocus) * alpha
	local distance = self.currentZoom * STUDS_PER_ZOOM
	local position = self.currentFocus + self.direction * distance
	camera.CFrame = CFrame.lookAt(position, self.currentFocus)
	camera.Focus = CFrame.new(self.currentFocus) -- cho LOD / ánh sáng quanh chỗ nhìn
	camera.FieldOfView = 50
end

function CameraController:setMode(mode)
	self.mode = mode
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if mode == "overview" then
		camera.CameraType = Enum.CameraType.Scriptable
	else
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = 70
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end
end

function CameraController:toggleMode()
	self:setMode(self.mode == "overview" and "walk" or "overview")
	return self.mode
end

return CameraController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">CityRenderer</string><ProtectedString name="Source"><![CDATA[-- Dựng và cập nhật thành phố 3D ở client, mỗi người chơi thấy thành phố của mình. Địa hình xung quanh là server dựng.
-- Công trình 2x2: 1 model giữa 4 ô, dựng ở ô góc, 3 ô phụ ("+góc") không có model.
-- BuildController raycast vào folder này rồi đổi điểm trúng ra số ô (CityLayout.cellAt).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("EconCity")
local Config = require(Shared:WaitForChild("Config"))
local CityLayout = require(Shared:WaitForChild("CityLayout"))
local CityEngine = require(Shared:WaitForChild("CityEngine"))
local CitySpecs = require(script.Parent:WaitForChild("CitySpecs"))

local CityRenderer = {}
CityRenderer.__index = CityRenderer

local N = Config.GRID_SIZE
local CELL = CityLayout.CELL
local GRID_TOP = 0.2 -- mặt trên của tấm lưới
local MORPH_TIME = 1.6
local BOARD = Color3.fromRGB(128, 186, 98) -- cỏ khu đất
local BOARD_LINE = Color3.fromRGB(158, 206, 128) -- vạch chia ô
local FRAME = Color3.fromRGB(206, 208, 204) -- vỉa hè quanh khu đất
local INK = Color3.fromRGB(27, 31, 36)
local STAMP = Color3.fromRGB(229, 72, 77) -- chỉ dùng cho dấu "!"
local ROAD_ON = Color3.fromRGB(74, 77, 83)
local ROAD_OFF = Color3.fromRGB(166, 170, 176) -- chưa nối về cổng: nhạt + gạch sọc

local function landColor(kind)
	local c = Config.BUILDINGS[kind].color
	return Color3.fromRGB(c[1], c[2], c[3])
end
-- màu đất pha nửa trắng, vẫn nhận ra loại đất mà đỡ chói
local function lotColor(kind)
	return Color3.new(1, 1, 1):Lerp(landColor(kind), 0.5)
end
local GHOST = {
	ok = Color3.fromRGB(80, 230, 120),
	warn = Color3.fromRGB(250, 204, 21),
	bad = Color3.fromRGB(240, 80, 70),
}
-- { dx, dz, bit } sang ô bên cạnh
local SIDES = { { 0, -1, 1 }, { 0, 1, 2 }, { -1, 0, 4 }, { 1, 0, 8 } }

local function newPart(props, className)
	local p = Instance.new(className or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	return p
end

local LOT_TOP = GRID_TOP + 0.12 -- công trình đứng trên nền lát của ô

-- tâm vùng size x size, góc trên-trái ở ô index, mở về +cột/+hàng giống CityEngine.footprint
local function footprintCenter(index, size)
	local cx, cz = CityLayout.cellCenter(index)
	local offset = (size - 1) * CELL / 2
	return cx + offset, cz + offset
end

-- spec.label: SurfaceGui trên một mặt của part
local function addLabel(part, s)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Label"
	gui.Face = Enum.NormalId[s.labelFace or "Back"]
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.2
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.BuilderSansExtraBold
	text.TextScaled = true
	text.Text = s.label
	text.TextColor3 = s.labelColor or Color3.new(1, 1, 1)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.14, 0)
	pad.PaddingBottom = UDim.new(0.14, 0)
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.05, 0)
	pad.Parent = text
	text.Parent = gui
	gui.Parent = part
end

-- công trình tâm (cx, cz), nền ở baseY, xoay facing độ. animate thì mọc từ mặt đất lên theo tween info
local function specPart(model, s, cx, cz, baseY, facing, animate, info)
	local size, cframe = CitySpecs.place(s, cx, cz, baseY, facing)
	local seedSize, seedCFrame
	if animate then
		seedSize, seedCFrame = CitySpecs.seed(s, cx, cz, baseY, facing)
	end
	local props = {
		Name = s.name,
		Size = animate and seedSize or size,
		CFrame = animate and seedCFrame or cframe,
		Material = s.material,
		Color = s.color,
		Transparency = s.transparency or 0,
		Reflectance = s.reflectance or 0,
		CastShadow = not s.noShadow,
	}
	if s.noCollide then
		props.CanCollide = false
		props.CanQuery = false
	end
	local part
	if s.shape == "Wedge" then
		part = newPart(props, "WedgePart")
	else
		props.Shape = (s.shape == "Cylinder" and Enum.PartType.Cylinder) or (s.shape == "Ball" and Enum.PartType.Ball) or Enum.PartType.Block
		part = newPart(props)
	end
	if s.effect == "smoke" then
		local smoke = Instance.new("Smoke")
		smoke.Color = Color3.fromRGB(236, 236, 240)
		smoke.Opacity = 0.12
		smoke.RiseVelocity = 3
		smoke.Size = 2.5
		smoke.Parent = part
	end
	if s.label then
		addLabel(part, s)
	end
	part.Parent = model
	if animate then
		TweenService:Create(part, info, { Size = size, CFrame = cframe }):Play()
	end
	return part
end

-- lô (hoặc mặt đường) + các part của công trình. Trả về part nền và độ cao đỉnh tính từ mặt lô
local function addParts(model, kind, index, cx, cz, animate, facing)
	local span = Config.BUILDINGS[kind].size * CELL
	local base
	if kind == "road" then
		base = newPart({ Name = "Road", Size = Vector3.new(CELL, 0.15, CELL), Position = Vector3.new(cx, GRID_TOP + 0.075, cz), Material = Enum.Material.Asphalt, Color = ROAD_OFF, Parent = model })
	else
		base = newPart({ Name = "Lot", Size = Vector3.new(span - 0.6, 0.12, span - 0.6), Position = Vector3.new(cx, GRID_TOP + 0.06, cz), Material = Enum.Material.Pavement, Color = lotColor(kind), Parent = model })
		-- viền màu đất đậm quanh lô
		for _, side in ipairs(SIDES) do
			local alongX = side[1] == 0
			newPart({
				Name = "LotEdge",
				Size = alongX and Vector3.new(span - 0.6, 0.14, 0.5) or Vector3.new(0.5, 0.14, span - 0.6),
				Position = Vector3.new(cx + side[1] * (span / 2 - 0.55), GRID_TOP + 0.07, cz + side[2] * (span / 2 - 0.55)),
				Material = Enum.Material.SmoothPlastic,
				Color = landColor(kind),
				CanQuery = false,
				CastShadow = false,
				Parent = model,
			})
		end
	end
	local info = TweenInfo.new(animate and MORPH_TIME or 0, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local top = 0
	for _, s in ipairs(CitySpecs.forKind(kind, index)) do
		specPart(model, s, cx, cz, LOT_TOP, facing, animate, info)
		top = math.max(top, s.pos[2] + s.size[2])
	end
	return base, top
end

-- hướng mặt tiền (độ) của công trình góc ở ô i: quay ra ô đường kề, ưu tiên +Z, +X, -X rồi -Z
-- vì camera tổng quan nhìn từ phía +X, +Z. Không kề đường thì giữ +Z
local FACINGS = { { 0, 1, 0 }, { 1, 0, 90 }, { -1, 0, -90 }, { 0, -1, 180 } }
local function facingFor(cells, i, size)
	local col, row = CityLayout.cellXY(i)
	for _, f in ipairs(FACINGS) do
		for k = 0, size - 1 do
			local c, r
			if f[1] ~= 0 then
				c, r = f[1] > 0 and col + size or col - 1, row + k
			else
				c, r = col + k, f[2] > 0 and row + size or row - 1
			end
			if c >= 1 and c <= N and r >= 1 and r <= N and cells[(r - 1) * N + c] == "road" then
				return f[3]
			end
		end
	end
	return 0
end

function CityRenderer.new()
	local self = setmetatable({}, CityRenderer)
	local old = Workspace:FindFirstChild("EconCityClientCity")
	if old then
		old:Destroy()
	end
	self.folder = Instance.new("Folder")
	self.folder.Name = "EconCityClientCity"
	self.cells = {} -- [i] = { kind, model, connected, marker }
	self:_buildStatic()
	self.folder.Parent = Workspace
	return self
end

function CityRenderer:_buildStatic()
	local size = CELL * N
	newPart({
		Name = "Grid",
		-- kéo dày xuống dưới vì địa hình xung quanh thấp hơn khu đất 2 stud
		Size = Vector3.new(size + 4, GRID_TOP + 2.4, size + 4),
		Position = Vector3.new(CityLayout.ORIGIN.x, (GRID_TOP - 2.4) / 2, CityLayout.ORIGIN.z),
		Material = Enum.Material.Grass,
		Color = BOARD,
		Parent = self.folder,
	})
	-- vỉa hè quanh khu đất, chừa chỗ cổng ở mép +Z
	local gx, gz = CityLayout.cellCenter(Config.GATE_INDEX)
	local function frame(x0, x1, z0, z1)
		newPart({
			Name = "BoardFrame",
			Size = Vector3.new(x1 - x0, 2.9, z1 - z0),
			Position = Vector3.new(CityLayout.ORIGIN.x + (x0 + x1) / 2, 0.5 - 1.45, CityLayout.ORIGIN.z + (z0 + z1) / 2),
			Material = Enum.Material.Concrete,
			Color = FRAME,
			CanQuery = false,
			Parent = self.folder,
		})
	end
	local outer, inner = size / 2 + 4, size / 2 + 2
	frame(-outer, outer, -outer, -inner)
	frame(-outer, -inner, -inner, inner)
	frame(inner, outer, -inner, inner)
	frame(-outer, gx - CELL / 2, inner, outer)
	frame(gx + CELL / 2, outer, inner, outer)
	-- vạch chia ô, không chặn raycast
	local lines = Instance.new("Folder")
	lines.Name = "GridLines"
	lines.Parent = self.folder
	for k = 0, N do
		local offset = -size / 2 + k * CELL
		for _, horizontal in ipairs({ true, false }) do
			newPart({
				Name = "Line",
				Size = horizontal and Vector3.new(size, 0.02, 0.15) or Vector3.new(0.15, 0.02, size),
				Position = horizontal and Vector3.new(CityLayout.ORIGIN.x, GRID_TOP + 0.01, CityLayout.ORIGIN.z + offset)
					or Vector3.new(CityLayout.ORIGIN.x + offset, GRID_TOP + 0.01, CityLayout.ORIGIN.z),
				Material = Enum.Material.SmoothPlastic,
				Color = BOARD_LINE,
				Transparency = 0.35,
				CanCollide = false,
				CanQuery = false,
				CastShadow = false,
				Parent = lines,
			})
		end
	end

	-- cổng + đoạn đường dẫn ngoài lưới (mọi đường phải nối về đây). Vành đai, đại lộ bên ngoài là server dựng,
	-- ở đây chỉ nối từ cổng ra tới đó
	local edge = gz + CELL / 2
	local gate = Instance.new("Model")
	gate.Name = "Gate"
	newPart({ Name = "Highway", Size = Vector3.new(CELL, 2.4, 4), Position = Vector3.new(gx, 0.15 - 1.2, edge + 2), Material = Enum.Material.Asphalt, Color = ROAD_ON, Parent = gate })
	for _, side in ipairs({ -1, 1 }) do
		newPart({ Name = "Pillar", Size = Vector3.new(1.4, 9, 1.4), Position = Vector3.new(gx + side * 6.6, 4.5, edge + 1), Material = Enum.Material.Concrete, Color = Color3.fromRGB(240, 238, 232), Parent = gate })
		newPart({ Name = "PillarCap", Size = Vector3.new(2, 0.6, 2), Position = Vector3.new(gx + side * 6.6, 0.3, edge + 1), Material = Enum.Material.Concrete, Color = Color3.fromRGB(206, 208, 204), Parent = gate })
	end
	local beam = newPart({ Name = "Beam", Size = Vector3.new(15, 1.6, 1.6), Position = Vector3.new(gx, 9.6, edge + 1), Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(46, 107, 255), Parent = gate })
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Label"
	billboard.Size = UDim2.fromOffset(72, 24)
	billboard.StudsOffset = Vector3.new(0, 1.8, 0)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 600
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 0
	text.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	text.TextColor3 = Color3.fromRGB(24, 34, 52)
	text.Font = Enum.Font.BuilderSansExtraBold
	text.TextSize = 13
	text.Size = UDim2.fromScale(1, 1)
	text.Text = "CỔNG"
	text.Parent = billboard
	local tagCorner = Instance.new("UICorner")
	tagCorner.CornerRadius = UDim.new(1, 0)
	tagCorner.Parent = text
	local tagStroke = Instance.new("UIStroke")
	tagStroke.Color = Color3.fromRGB(11, 18, 32)
	tagStroke.Thickness = 1.5
	tagStroke.Transparency = 0.8
	tagStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	tagStroke.Parent = text
	billboard.Parent = beam
	gate.Parent = self.folder

	-- ô xem trước + đoạn đường đang kéo
	self.ghost = newPart({ Name = "Ghost", Size = Vector3.new(CELL - 1, 0.8, CELL - 1), Material = Enum.Material.Neon, Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false, Parent = self.folder })
	self.pathParts = {}
	for k = 1, Config.MAX_ROAD_PATH do
		self.pathParts[k] = newPart({ Name = "PathPreview", Size = Vector3.new(CELL - 2, 0.6, CELL - 2), Material = Enum.Material.Neon, Color = GHOST.ok, Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false, Parent = self.folder })
	end
end

-- dấu "!" trên công trình chưa nối đường
local function marker(parent)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Unconnected"
	billboard.Size = UDim2.fromOffset(22, 22)
	billboard.StudsOffset = Vector3.new(0, 5, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 500
	local text = Instance.new("TextLabel")
	text.BackgroundColor3 = STAMP
	text.TextColor3 = Color3.fromRGB(255, 255, 255)
	text.Font = Enum.Font.BuilderSansExtraBold
	text.TextSize = 15
	text.Size = UDim2.fromScale(1, 1)
	text.Text = "!"
	text.Parent = billboard
	local markCorner = Instance.new("UICorner")
	markCorner.CornerRadius = UDim.new(1, 0)
	markCorner.Parent = text
	local markStroke = Instance.new("UIStroke")
	markStroke.Color = Color3.fromRGB(255, 255, 255)
	markStroke.Thickness = 2
	markStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	markStroke.Parent = text
	billboard.Parent = parent
	return billboard
end

-- sọc trên lô chưa nối đường. Thanh chạy dọc X nhưng camera nhìn chéo nên trông như gạch chéo
local function hatch(parent, cx, cz, top, span)
	local folder = Instance.new("Folder")
	folder.Name = "Hatch"
	local count = math.floor((span - 4) / 2.5) + 1 -- 1 ô: 5 thanh, 2x2: 10 thanh
	for k = 0, count - 1 do
		newPart({
			Name = "HatchBar",
			Size = Vector3.new(span - 1, 0.04, 0.7),
			Position = Vector3.new(cx, top, cz + (k - (count - 1) / 2) * 2.5),
			Material = Enum.Material.SmoothPlastic,
			Color = INK,
			Transparency = 0.45,
			CanCollide = false,
			CanQuery = false,
			CastShadow = false,
			Parent = folder,
		})
	end
	folder.Parent = parent
	return folder
end

-- vạch, vỉa hè, đèn của ô đường theo mask (bit trong SIDES), xem CitySpecs.road
function CityRenderer:_drawRoadMarks(entry, cx, cz, mask, index)
	if entry.marks then
		entry.marks:Destroy()
	end
	local marks = Instance.new("Folder")
	marks.Name = "Marks"
	local arms = {}
	for _, side in ipairs(SIDES) do
		if mask % (side[3] * 2) >= side[3] then
			table.insert(arms, { side[1], side[2] })
		end
	end
	for _, s in ipairs(CitySpecs.road(arms, index)) do
		specPart(marks, s, cx, cz, GRID_TOP + 0.15, 0, false)
	end
	marks.Parent = entry.model
	entry.marks = marks
	entry.mask = mask
end

-- ô trống và ô phụ "+góc" không có model
function CityRenderer:_buildCell(i, kind, animate, facing)
	local entry = self.cells[i]
	if entry and entry.model then
		local oldModel = entry.model
		if animate then
			for _, part in ipairs(oldModel:GetChildren()) do
				if part:IsA("BasePart") then
					TweenService:Create(part, TweenInfo.new(MORPH_TIME * 0.5), { Transparency = 1 }):Play()
				end
			end
			task.delay(MORPH_TIME * 0.5, function()
				oldModel:Destroy()
			end)
		else
			oldModel:Destroy()
		end
	end
	entry = { kind = kind, connected = nil, facing = facing or 0 }
	self.cells[i] = entry
	local def = Config.BUILDINGS[kind]
	if not def then
		return entry
	end
	entry.span = def.size * CELL
	entry.cx, entry.cz = footprintCenter(i, def.size)
	local model = Instance.new("Model")
	model.Name = "Cell_" .. i
	model:SetAttribute("Cell", i)
	model:SetAttribute("Kind", kind)
	local base = addParts(model, kind, i, entry.cx, entry.cz, animate, entry.facing)
	if kind == "road" then
		entry.road = base
	else
		entry.lot = base -- dấu "!" gắn vào lô
	end
	model.Parent = self.folder
	entry.model = model
	return entry
end

-- model mẫu quanh gốc toạ độ cho khung xem 3D ở thẻ thông tin. Trả về model, cạnh lô (stud), độ cao đỉnh
function CityRenderer.previewModel(kind)
	local model = Instance.new("Model")
	model.Name = "Preview_" .. kind
	local _, top = addParts(model, kind, 1, 0, 0, false, 0)
	return model, Config.BUILDINGS[kind].size * CELL, top
end

-- animate = false lúc dựng lần đầu hoặc ván mới
function CityRenderer:update(session, animate)
	if not session or type(session.cells) ~= "table" then
		return
	end
	local cells = session.cells
	local conn = CityEngine.connectivity(cells)
	for i = 1, N * N do
		local kind = cells[i] or Config.EMPTY
		local entry = self.cells[i]
		local def = Config.BUILDINGS[kind]
		local facing = (def and kind ~= "road") and facingFor(cells, i, def.size) or 0
		if not entry or entry.kind ~= kind then
			entry = self:_buildCell(i, kind, animate, facing)
		elseif entry.model and not entry.road and entry.facing ~= facing then
			-- có đường mới kề bên thì quay mặt ra đường, dựng lại luôn, không animate
			entry = self:_buildCell(i, kind, false, facing)
		end
		if entry.model then
			local connected = conn[i] == true
			if entry.road then
				-- ô cổng có thêm nhánh +Z ra đường dẫn ngoài lưới
				local col, row = CityLayout.cellXY(i)
				local mask = i == Config.GATE_INDEX and 2 or 0
				for _, side in ipairs(SIDES) do
					local c, r = col + side[1], row + side[2]
					if c >= 1 and c <= N and r >= 1 and r <= N and cells[(r - 1) * N + c] == "road" then
						mask = mask + side[3]
					end
				end
				if entry.mask ~= mask then
					local cx, cz = CityLayout.cellCenter(i)
					self:_drawRoadMarks(entry, cx, cz, mask, i)
				end
			end
			if entry.connected ~= connected then
				entry.connected = connected
				if entry.road then
					entry.road.Color = connected and ROAD_ON or ROAD_OFF
				end
				if not connected and not entry.hatch then
					-- công viên: sọc nằm trên bãi cỏ, lô khác: sát mặt lô, dưới chân nhà
					local onLawn = Config.BUILDINGS[kind].kind == "park"
					entry.hatch = hatch(entry.model, entry.cx, entry.cz, GRID_TOP + (onLawn and 0.46 or kind == "road" and 0.19 or 0.16), entry.span)
				elseif connected and entry.hatch then
					entry.hatch:Destroy()
					entry.hatch = nil
				end
				if entry.lot and not connected and not entry.marker then
					entry.marker = marker(entry.lot)
				elseif connected and entry.marker then
					entry.marker:Destroy()
					entry.marker = nil
				end
			end
		end
	end
end

-- vùng size x size góc ở ô index (theo chuột hoặc con trỏ tay cầm). state: "ok" | "warn" | "bad", index = nil để ẩn
function CityRenderer:setGhost(index, state, size)
	if not index then
		self.ghost.Transparency = 1
		return
	end
	size = size or 1
	local cx, cz = footprintCenter(index, size)
	self.ghost.Size = Vector3.new(size * CELL - 1, 0.8, size * CELL - 1)
	self.ghost.Position = Vector3.new(cx, GRID_TOP + 0.4, cz)
	self.ghost.Color = GHOST[state] or GHOST.bad
	self.ghost.Transparency = 0.55
end

-- path = list ô đang kéo, nil để ẩn
function CityRenderer:setPath(path)
	for k, part in ipairs(self.pathParts) do
		local i = path and path[k]
		if i then
			local cx, cz = CityLayout.cellCenter(i)
			part.Position = Vector3.new(cx, GRID_TOP + 0.3, cz)
			part.Transparency = 0.45
		else
			part.Transparency = 1
		end
	end
end

return CityRenderer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">CitySpecs</string><ProtectedString name="Source"><![CDATA[-- Bản vẽ khối cho từng loại công trình. Hàm thuần, trả list spec, toạ độ tính từ tâm công trình.
-- spec: name, shape, size {x,y,z}, pos {x,y,z}, color, material; tuỳ chọn: rot (độ, quanh trục đứng), transparency,
-- reflectance, noShadow, noCollide, effect ("smoke"), label, labelColor, labelFace (tên mặt Roblox, "Back" = +Z, "Right" = +X).
-- pos y = đáy khối so với mặt lô. Cylinder: x = z = đường kính. Wedge: cao ở đầu +Z (trục riêng, trước khi xoay rot).
-- Mặt tiền là +Z, renderer xoay cả công trình ra phía ô đường kề. 1x1 nằm trong ±6.2, 2x2 trong ±13.2 (ô 14 stud).

local CitySpecs = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("EconCity"):WaitForChild("Config"))

local FLOOR = 3
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local M = Enum.Material

local PLASTIC = M.SmoothPlastic
local PLASTER = M.Plaster
local BRICK = M.Brick
local CONCRETE = M.Concrete
local GLASSMAT = M.Glass
local METAL = M.Metal
local TILES = M.ClayRoofTiles
local SHINGLES = M.RoofShingles
local WOODMAT = M.WoodPlanks
local GRASSMAT = M.Grass
local PAVE = M.Pavement

local WALLS = { rgb(247, 241, 230), rgb(242, 236, 222), rgb(236, 240, 244), rgb(248, 233, 214), rgb(232, 236, 228) }
local GLASS = rgb(150, 196, 230)
local GLASS_DARK = rgb(86, 128, 168)
local FRAME = rgb(250, 250, 248)
local WOOD = rgb(128, 90, 60)
local DECK = rgb(186, 146, 104)
local TRUNK = rgb(112, 82, 58)
local STONE = rgb(214, 210, 200)
local PAVING = rgb(226, 223, 214)
local LAWN = rgb(124, 186, 96)
local ASPHALT = rgb(84, 88, 96)
local DARK = rgb(62, 66, 74)
local STEEL = rgb(200, 204, 210)
local BRICK_RED = rgb(190, 108, 82)
local SIDEWALK = rgb(214, 216, 210)
local WATER = rgb(90, 170, 230)
local LEAVES = { rgb(86, 164, 74), rgb(104, 178, 84), rgb(70, 142, 68), rgb(124, 186, 78), rgb(94, 156, 92) }
local FLOWERS = { rgb(244, 114, 146), rgb(250, 204, 72), rgb(255, 255, 255), rgb(196, 120, 230), rgb(250, 140, 70) }
local CARS = { rgb(230, 70, 70), rgb(70, 130, 230), rgb(250, 250, 250), rgb(250, 196, 60), rgb(60, 60, 70), rgb(80, 190, 150), rgb(160, 164, 172) }
local CLOTHES = { rgb(46, 107, 255), rgb(208, 52, 52), rgb(60, 157, 74), rgb(242, 184, 40), rgb(124, 92, 220), rgb(240, 138, 36), rgb(250, 250, 250) }
local SKIN = { rgb(255, 214, 170), rgb(224, 172, 128), rgb(176, 120, 84), rgb(250, 226, 196) }
local PANTS = rgb(52, 60, 84)

-- mặt: 1 = +Z (tiền), 2 = +X, 3 = -Z (sau), 4 = -X
local FACE = { { 0, 1 }, { 1, 0 }, { 0, -1 }, { -1, 0 } }
local LABEL_FACE = { "Back", "Right", "Front", "Left" }

-- màu đất của loại công trình (mái, biển... dùng màu này để nhìn xa vẫn biết loại đất). t < 1 pha trắng, dark > 0 làm sẫm
local function land(kind, t, dark)
	local c = Config.BUILDINGS[kind].color
	local col = rgb(c[1], c[2], c[3])
	if t and t < 1 then
		col = WHITE:Lerp(col, t)
	end
	if dark and dark > 0 then
		col = col:Lerp(BLACK, dark)
	end
	return col
end

local function spec(name, shape, sx, sy, sz, px, py, pz, color, material, extra)
	local s = {
		name = name,
		shape = shape,
		size = { sx, sy, sz },
		pos = { px, py, pz },
		color = color,
		material = material or PLASTIC,
	}
	for k, v in pairs(extra or {}) do
		s[k] = v
	end
	return s
end

local function add(out, s)
	table.insert(out, s)
	return s
end

-- 0..1 theo index ô, để nhà cùng loại không giống hệt nhau
local function variant(index)
	return (index * 7919) % 97 / 97
end

local function pick(list, v)
	return list[math.floor(v * #list) % #list + 1]
end

local function box(out, name, w, h, d, x, y, z, color, material, extra)
	return add(out, spec(name, "Block", w, h, d, x, y, z, color, material, extra))
end

local function cyl(out, name, dia, h, x, y, z, color, material, extra)
	return add(out, spec(name, "Cylinder", dia, h, dia, x, y, z, color, material, extra))
end

local function ball(out, name, dia, x, y, z, color, material, extra)
	return add(out, spec(name, "Ball", dia, dia, dia, x, y, z, color, material, extra))
end

-- vạch sơn, mảng phẳng sát đất: không collide, không đổ bóng
local function flat(out, name, w, d, x, y, z, color, material, extra)
	local e = { noShadow = true, noCollide = true }
	for k, v in pairs(extra or {}) do
		e[k] = v
	end
	return box(out, name, w, 0.05, d, x, y, z, color, material or PLASTIC, e)
end

-- mái 2 dốc trên khối w x d, nóc chạy theo axis "x" hoặc "z"
local function gable(out, name, w, d, h, x, y, z, color, axis, material)
	material = material or TILES
	if axis == "z" then
		add(out, spec(name .. "L", "Wedge", d, h, w / 2, x - w / 4, y, z, color, material, { rot = 90 }))
		add(out, spec(name .. "R", "Wedge", d, h, w / 2, x + w / 4, y, z, color, material, { rot = -90 }))
	else
		add(out, spec(name .. "B", "Wedge", w, h, d / 2, x, y, z - d / 4, color, material))
		add(out, spec(name .. "F", "Wedge", w, h, d / 2, x, y, z + d / 4, color, material, { rot = 180 }))
	end
end

-- mái răng cưa: n dốc dọc trục X, mặt đứng mỗi răng (phía +X) là dải kính
local function sawtooth(out, name, w, d, h, x, y, z, n, colorA, colorB)
	local step = w / n
	for k = 1, n do
		local px = x - w / 2 + step * (k - 0.5)
		add(out, spec(name .. k, "Wedge", d, h, step, px, y, z, k % 2 == 0 and colorB or colorA, METAL, { rot = 90 }))
		box(out, name .. "Light" .. k, 0.12, h * 0.75, d - 0.8, px + step / 2 + 0.02, y + 0.1, z, GLASS_DARK, GLASSMAT, { reflectance = 0.2, noShadow = true })
	end
end

-- điểm trên mặt face của khối w x d tâm (x, z): t dọc mặt, off nhô ra ngoài
local function onFace(face, x, z, w, d, t, off)
	local dir = FACE[face]
	if dir[1] == 0 then
		return x + t, z + dir[2] * (d / 2 + off)
	end
	return x + dir[1] * (w / 2 + off), z + t
end

-- a dọc mặt, b cao, c dày
local function faceSize(face, a, b, c)
	if FACE[face][1] == 0 then
		return a, b, c
	end
	return c, b, a
end

local function faceLength(face, w, d)
	return FACE[face][1] == 0 and w or d
end

-- tấm áp lên mặt face (cửa, biển, ô kính): rộng pw, cao ph, dày thick, đáy ở y
local function panel(out, name, face, w, d, x, z, t, y, pw, ph, color, material, off, thick, extra)
	thick = thick or 0.14
	local px, pz = onFace(face, x, z, w, d, t, (off or 0) + thick / 2)
	local sx, sy, sz = faceSize(face, pw, ph, thick)
	local e = { noShadow = true }
	for k, v in pairs(extra or {}) do
		e[k] = v
	end
	return box(out, name, sx, sy, sz, px, y, pz, color, material or PLASTIC, e)
end

local function sign(out, name, text, face, w, d, x, z, t, y, pw, ph, bg, fg, off)
	return panel(out, name, face, w, d, x, z, t, y, pw, ph, bg, PLASTIC, off or 0, 0.3, { label = text, labelColor = fg or WHITE, labelFace = LABEL_FACE[face] })
end

-- cửa sổ 4 mặt, tầng đầu từ y0. counts = số cửa mỗi tầng {tiền, +X, sau, -X}
-- opts: ww, wh (cỡ kính), floorH, sill (tính từ sàn), glass, frame (false = bỏ khung), shutter (màu chớp),
-- positions[face] = {t...} nếu muốn đặt tay, skip(face, f, k) trả true để bỏ ô đó
local function windowsAll(out, name, w, d, x, z, y0, floors, counts, opts)
	opts = opts or {}
	local ww, wh = opts.ww or 1.2, opts.wh or 1.4
	local fh = opts.floorH or FLOOR
	local glass = opts.glass or GLASS
	local frame = opts.frame
	if frame == nil then
		frame = FRAME
	end
	for f = 0, floors - 1 do
		local y = y0 + f * fh + (opts.sill or 0.8)
		for face = 1, 4 do
			local ts = opts.positions and opts.positions[face]
			local n = ts and #ts or (counts[face] or 0)
			local length = faceLength(face, w, d)
			for k = 1, n do
				if not (opts.skip and opts.skip(face, f, k)) then
					local t = ts and ts[k] or (-length / 2 + length * (k - 0.5) / n)
					local id = name .. face .. "_" .. f .. "_" .. k
					if frame then
						panel(out, id .. "F", face, w, d, x, z, t, y - 0.17, ww + 0.34, wh + 0.34, frame, PLASTIC, 0, 0.1)
					end
					panel(out, id, face, w, d, x, z, t, y, ww, wh, glass, GLASSMAT, frame and 0.06 or 0, 0.1, { reflectance = 0.25 })
					if opts.shutter then
						for _, sgn in ipairs({ -1, 1 }) do
							panel(out, id .. "S" .. sgn, face, w, d, x, z, t + sgn * (ww / 2 + 0.42), y - 0.05, 0.42, wh + 0.1, opts.shutter, PLASTIC, 0, 0.1)
						end
					end
				end
			end
		end
	end
end

-- mỗi tầng 1 dải kính quanh 4 mặt (1 khối bọc ngoài thân nhà)
local function ribbons(out, name, w, d, x, z, y0, floors, h, color, fh, extra)
	fh = fh or FLOOR
	local e = { reflectance = 0.22, noShadow = true }
	for k, v in pairs(extra or {}) do
		e[k] = v
	end
	for f = 0, floors - 1 do
		box(out, name .. f, w + 0.24, h, d + 0.24, x, y0 + f * fh + (fh - h) / 2, z, color, GLASSMAT, e)
	end
end

-- thanh đứng chia kính, n thanh mỗi mặt
local function mullions(out, name, w, d, x, z, y0, height, n, color)
	for face = 1, 4 do
		local length = faceLength(face, w, d)
		for k = 1, n do
			local t = -length / 2 + length * k / (n + 1)
			panel(out, name .. face .. k, face, w, d, x, z, t, y0, 0.24, height, color or FRAME, PLASTIC, 0.12, 0.2)
		end
	end
end

local function door(out, name, face, w, d, x, z, t, color, wide, high)
	wide, high = wide or 1.2, high or 2.2
	panel(out, name .. "Frame", face, w, d, x, z, t, 0, wide + 0.36, high + 0.18, FRAME, PLASTIC, 0, 0.1)
	panel(out, name, face, w, d, x, z, t, 0, wide, high, color or WOOD, (color == GLASS_DARK or color == GLASS) and GLASSMAT or WOODMAT, 0.06, 0.1)
end

local function tree(out, name, x, z, scale, y, v)
	scale = scale or 1
	y = y or 0
	v = v or ((x * 13 + z * 7) % 10) / 10
	cyl(out, name .. "Trunk", 0.6 * scale, 2.6 * scale, x, y, z, TRUNK, WOODMAT)
	ball(out, name .. "Crown", 4 * scale, x, y + 1.9 * scale, z, pick(LEAVES, v), GRASSMAT)
	ball(out, name .. "Top", 2.8 * scale, x + 0.5 * scale, y + 3.8 * scale, z - 0.3 * scale, pick(LEAVES, v + 0.3), GRASSMAT)
end

-- cây thông
local function pine(out, name, x, z, scale, y)
	scale = scale or 1
	y = y or 0
	cyl(out, name .. "Trunk", 0.5 * scale, 1.6 * scale, x, y, z, TRUNK, WOODMAT)
	cyl(out, name .. "Low", 3 * scale, 1.4 * scale, x, y + 1.4 * scale, z, rgb(58, 128, 72), GRASSMAT)
	cyl(out, name .. "Mid", 2.2 * scale, 1.3 * scale, x, y + 2.6 * scale, z, rgb(66, 140, 78), GRASSMAT)
	cyl(out, name .. "Top", 1.3 * scale, 1.2 * scale, x, y + 3.7 * scale, z, rgb(76, 152, 84), GRASSMAT)
end

local function bush(out, name, x, z, scale, y)
	scale = scale or 1
	ball(out, name, 1.6 * scale, x, y or 0, z, pick(LEAVES, (x * 3 + z) % 1), GRASSMAT)
end

-- bồn cây bê tông
local function planter(out, name, x, z, size, y)
	y = y or 0
	box(out, name, size, 0.7, size, x, y, z, STONE, CONCRETE)
	ball(out, name .. "Bush", size * 0.95, x, y + 0.35, z, pick(LEAVES, (x + z * 2) % 1), GRASSMAT)
end

-- hàng rào cây xén
local function hedge(out, name, w, d, x, z, y)
	box(out, name, w, 0.9, d, x, y or 0, z, rgb(72, 140, 70), GRASSMAT)
end

-- luống hoa, dọc trục X
local function flowers(out, name, x, z, w, d, y)
	y = y or 0
	box(out, name .. "Bed", w, 0.35, d, x, y, z, rgb(122, 92, 66), M.Ground)
	local n = math.max(2, math.floor(w / 0.8))
	for k = 1, n do
		local px = x - w / 2 + w * (k - 0.5) / n
		ball(out, name .. k, 0.7, px, y + 0.25, z + ((k % 2 == 0) and d * 0.2 or -d * 0.2), FLOWERS[(k % #FLOWERS) + 1], PLASTIC, { noShadow = true })
	end
end

-- rào gỗ từ (x0, z0) tới (x1, z1), chỉ đi thẳng theo X hoặc Z
local function fence(out, name, x0, z0, x1, z1, y, color, step)
	y = y or 0
	color = color or WHITE
	step = step or 1.3
	local alongX = z0 == z1
	local length = alongX and math.abs(x1 - x0) or math.abs(z1 - z0)
	local n = math.max(1, math.floor(length / step + 0.5))
	for k = 0, n do
		local t = k / n
		box(out, name .. "Post" .. k, 0.22, 1.1, 0.22, x0 + (x1 - x0) * t, y, z0 + (z1 - z0) * t, color, WOODMAT, { noShadow = true })
	end
	for r, ry in ipairs({ 0.3, 0.75 }) do
		box(out, name .. "Rail" .. r, alongX and length or 0.12, 0.16, alongX and 0.12 or length, (x0 + x1) / 2, y + ry, (z0 + z1) / 2, color, WOODMAT, { noShadow = true })
	end
end

local function car(out, name, x, z, color, alongX, y)
	y = y or 0
	local function s(a, c)
		if alongX then
			return a, c
		end
		return c, a
	end
	local wx, wz = s(0.75, 1.9)
	local fx, fz = s(1.15, 0)
	box(out, name .. "WheelF", wx, 0.75, wz, x + fx, y, z + fz, DARK, PLASTIC)
	box(out, name .. "WheelB", wx, 0.75, wz, x - fx, y, z - fz, DARK, PLASTIC)
	local bx, bz = s(3.6, 1.8)
	box(out, name .. "Body", bx, 0.8, bz, x, y + 0.35, z, color, PLASTIC)
	local cx, cz = s(2, 1.6)
	box(out, name .. "Cabin", cx, 0.62, cz, x, y + 1.15, z, GLASS_DARK, GLASSMAT, { reflectance = 0.25, noShadow = true })
	local rx, rz = s(1.8, 1.65)
	box(out, name .. "Roof", rx, 0.14, rz, x, y + 1.77, z, color, PLASTIC)
end

local function person(out, name, x, z, v, y)
	y = y or 0
	box(out, name .. "Legs", 0.55, 0.85, 0.32, x, y, z, PANTS, PLASTIC, { noShadow = true })
	box(out, name .. "Shirt", 0.72, 0.85, 0.4, x, y + 0.85, z, pick(CLOTHES, v), PLASTIC, { noShadow = true })
	ball(out, name .. "Head", 0.56, x, y + 1.7, z, pick(SKIN, v * 1.7), PLASTIC, { noShadow = true })
end

-- tựa lưng ở phía -Z nếu alongX, không thì -X
local function bench(out, name, x, z, alongX, y)
	y = y or 0
	box(out, name, alongX and 2.4 or 0.8, 0.55, alongX and 0.8 or 2.4, x, y, z, WOOD, WOODMAT)
	box(out, name .. "Back", alongX and 2.4 or 0.16, 0.7, alongX and 0.16 or 2.4, x - (alongX and 0 or 0.34), y + 0.55, z - (alongX and 0.34 or 0), WOOD, WOODMAT, { noShadow = true })
end

local function lamp(out, name, x, z, y, height)
	y = y or 0
	height = height or 4.2
	cyl(out, name .. "Pole", 0.24, height, x, y, z, rgb(70, 74, 82), METAL, { noShadow = true })
	ball(out, name .. "Light", 0.7, x, y + height - 0.1, z, rgb(255, 240, 200), M.Neon, { noShadow = true })
end

-- cục nóng điều hoà
local function acUnit(out, name, x, y, z)
	box(out, name, 1.6, 0.9, 1.2, x, y, z, STEEL, METAL)
	cyl(out, name .. "Fan", 0.8, 0.06, x, y + 0.9, z, DARK, METAL, { noShadow = true })
end

local function solar(out, name, x, y, z, w, d)
	box(out, name .. "Stand", w * 0.8, 0.3, d * 0.6, x, y, z, STEEL, METAL)
	box(out, name, w, 0.12, d, x, y + 0.3, z, rgb(38, 58, 108), GLASSMAT, { reflectance = 0.3 })
end

-- mái hiên sọc nhô ra +Z, z là mép sát tường
local function awning(out, name, w, x, y, z, color, n)
	n = n or 6
	local step = w / n
	for k = 1, n do
		add(out, spec(name .. k, "Wedge", step, 0.9, 2.2, x - w / 2 + step * (k - 0.5), y, z + 1.1, k % 2 == 1 and color or WHITE, PLASTIC, { rot = 180, noShadow = true }))
	end
end

local function umbrella(out, name, x, z, color, y)
	y = y or 0
	cyl(out, name .. "Pole", 0.16, 2.6, x, y, z, WHITE, METAL, { noShadow = true })
	cyl(out, name, 3, 0.25, x, y + 2.5, z, color, PLASTIC)
	ball(out, name .. "Top", 0.4, x, y + 2.7, z, color, PLASTIC, { noShadow = true })
end

-- bàn + 2 ghế
local function tableSet(out, name, x, z, y)
	y = y or 0
	cyl(out, name, 1.3, 1, x, y, z, WHITE, PLASTIC)
	box(out, name .. "ChairA", 0.6, 0.9, 0.6, x - 1, y, z, DARK, METAL)
	box(out, name .. "ChairB", 0.6, 0.9, 0.6, x + 1, y, z, DARK, METAL)
end

-- cờ đỏ sao vàng
local function flagpole(out, name, x, z, height, y)
	y = y or 0
	cyl(out, name .. "Pole", 0.28, height, x, y, z, WHITE, METAL, { noShadow = true })
	box(out, name .. "Flag", 2.6, 1.6, 0.12, x + 1.4, y + height - 1.8, z, rgb(218, 37, 29), PLASTIC, { noShadow = true })
	box(out, name .. "Star", 0.7, 0.7, 0.16, x + 1.4, y + height - 1.35, z, rgb(255, 222, 0), PLASTIC, { noShadow = true })
end

local function fountain(out, name, x, z, dia, y)
	y = y or 0
	cyl(out, name .. "Basin", dia, 0.7, x, y, z, STONE, M.Cobblestone)
	cyl(out, name .. "Water", dia - 0.7, 0.74, x, y, z, WATER, GLASSMAT, { transparency = 0.1, reflectance = 0.35 })
	cyl(out, name .. "Column", dia * 0.16, 1.6, x, y + 0.7, z, STONE, CONCRETE)
	cyl(out, name .. "Bowl", dia * 0.42, 0.3, x, y + 2.2, z, STONE, CONCRETE)
	cyl(out, name .. "Jet", dia * 0.08, 1.4, x, y + 2.5, z, rgb(214, 238, 255), GLASSMAT, { transparency = 0.35, noShadow = true })
	ball(out, name .. "Spray", dia * 0.22, x, y + 3.6, z, rgb(214, 238, 255), GLASSMAT, { transparency = 0.45, noShadow = true })
end

-- xe tải dọc trục Z, đầu xe phía +Z
local function truck(out, name, x, z, cabColor, y, length)
	y = y or 0
	length = length or 5.5
	box(out, name .. "Wheels", 2.5, 0.8, length + 1.4, x, y, z + 0.6, DARK, PLASTIC)
	box(out, name .. "Box", 2.5, 2.8, length, x, y + 0.6, z - 0.2, WHITE, METAL)
	box(out, name .. "Cab", 2.4, 2.2, 1.9, x, y + 0.6, z + length / 2 + 0.8, cabColor, PLASTIC)
	box(out, name .. "Windshield", 2.1, 0.8, 0.1, x, y + 1.9, z + length / 2 + 1.76, GLASS_DARK, GLASSMAT, { noShadow = true })
end

local BUILDERS = {}

-- nhà 2 tầng có ga-ra
BUILDERS.house = function(v)
	local out = {}
	local wall = pick(WALLS, v)
	local roof = land("house", 1, 0.3)
	box(out, "lawn", 12.4, 0.1, 12.4, 0, 0, 0, LAWN, GRASSMAT)
	local bx, bz, bw, bd = -1.6, -1.6, 7.2, 6.4
	box(out, "plinth", bw + 0.2, 0.6, bd + 0.2, bx, 0, bz, STONE, M.Slate)
	box(out, "body", bw, 2 * FLOOR, bd, bx, 0, bz, wall, PLASTER)
	box(out, "trim", bw + 0.16, 0.25, bd + 0.16, bx, FLOOR - 0.1, bz, FRAME, PLASTIC, { noShadow = true })
	gable(out, "roof", bw + 1, bd + 1, 2.8, bx, 2 * FLOOR, bz, roof, "x")
	windowsAll(out, "win", bw, bd, bx, bz, 0, 2, { 2, 2, 2, 2 }, {
		skip = function(face, f, k)
			return f == 0 and ((face == 1 and k == 2) or face == 2)
		end,
	})
	door(out, "door", 1, bw, bd, bx, bz, 1.8, rgb(150, 74, 56), 1.2, 2.3)
	box(out, "doorRoof", 2, 0.22, 1.1, bx + 1.8, 2.65, bz + bd / 2 + 0.55, roof, PLASTIC)
	box(out, "step", 1.7, 0.3, 0.8, bx + 1.8, 0, bz + bd / 2 + 0.4, STONE, CONCRETE)
	box(out, "path", 1.2, 0.14, 3.8, bx + 1.8, 0, 4.3, STONE, PAVE)
	box(out, "chimney", 1, 3.6, 1, bx - 2.4, 2 * FLOOR, bz - 2, BRICK_RED, BRICK)
	box(out, "chimneyCap", 1.3, 0.3, 1.3, bx - 2.4, 2 * FLOOR + 3.6, bz - 2, DARK, CONCRETE)
	-- ga-ra mái bằng bên phải
	box(out, "garage", 3.6, 2.9, 5.2, 4.2, 0, -2.2, wall, PLASTER)
	box(out, "garageRoof", 3.9, 0.3, 5.6, 4.2, 2.9, -2.2, roof, PLASTIC)
	box(out, "garageDoor", 2.8, 2.3, 0.12, 4.2, 0, 0.46, STEEL, METAL, { noShadow = true })
	for k = 1, 2 do
		box(out, "garageLine" .. k, 2.8, 0.08, 0.16, 4.2, 0.75 * k, 0.48, rgb(160, 164, 172), PLASTIC, { noShadow = true })
	end
	box(out, "driveway", 3.2, 0.14, 5.8, 4.2, 0, 3.3, PAVING, PAVE)
	if v > 0.3 then
		car(out, "car", 4.2, 3.4, pick(CARS, v), false, 0.14)
	end
	flowers(out, "flowers", bx - 1.4, bz + bd / 2 + 0.7, 3.4, 0.8, 0.1)
	fence(out, "fence", -6, 5.95, -0.6, 5.95, 0.1)
	tree(out, "tree", -4.4, 4, 0.8, 0.1, v)
	cyl(out, "mailPost", 0.18, 1.1, 1.3, 0.1, 5.7, WOOD, WOODMAT, { noShadow = true })
	box(out, "mailbox", 0.5, 0.45, 0.8, 1.3, 1.2, 5.7, rgb(46, 107, 255), PLASTIC, { noShadow = true })
	bush(out, "bushA", -5.4, -5.5, 0.8, 0.1)
	bush(out, "bushB", 1.4, -5.6, 0.7, 0.1)
	return out
end

-- nhà 1 tầng có hiên
BUILDERS.house_small = function(v)
	local out = {}
	local wall = pick(WALLS, v + 0.4)
	local roof = land("house", 1, 0.4)
	box(out, "lawn", 12.4, 0.1, 12.4, 0, 0, 0, LAWN, GRASSMAT)
	local bx, bz, bw, bd = -1.2, -1.6, 6.4, 5.2
	box(out, "plinth", bw + 0.2, 0.5, bd + 0.2, bx, 0, bz, STONE, M.Slate)
	box(out, "cottage", bw, 3.4, bd, bx, 0, bz, wall, PLASTER)
	gable(out, "roof", bw + 0.9, bd + 1.2, 2.6, bx, 3.4, bz, roof, "x", SHINGLES)
	windowsAll(out, "win", bw, bd, bx, bz, 0, 1, { 2, 1, 2, 1 }, { shutter = rgb(78, 116, 98), sill = 0.9, ww = 1, positions = { [1] = { -2, 2 } } })
	for k, t in ipairs({ -2, 2 }) do
		box(out, "flowerBox" .. k, 1.4, 0.35, 0.45, bx + t, 0.5, bz + bd / 2 + 0.25, WOOD, WOODMAT)
		ball(out, "flowerA" .. k, 0.6, bx + t - 0.35, 0.75, bz + bd / 2 + 0.25, FLOWERS[k], PLASTIC, { noShadow = true })
		ball(out, "flowerB" .. k, 0.6, bx + t + 0.35, 0.75, bz + bd / 2 + 0.25, FLOWERS[k + 2], PLASTIC, { noShadow = true })
	end
	door(out, "door", 1, bw, bd, bx, bz, 0, rgb(60, 110, 150), 1.1, 2.2)
	-- hiên gỗ
	box(out, "porch", 4.6, 0.3, 2, bx, 0, bz + bd / 2 + 1, DECK, WOODMAT)
	for k, px in ipairs({ bx - 2.1, bx + 2.1 }) do
		cyl(out, "porchPost" .. k, 0.3, 2.6, px, 0.3, bz + bd / 2 + 1.8, WHITE, WOODMAT)
	end
	box(out, "porchRoof", 5, 0.25, 2.3, bx, 2.9, bz + bd / 2 + 1.05, roof, PLASTIC)
	for k, sz in ipairs({ 3.7, 4.6, 5.4 }) do
		cyl(out, "stone" .. k, 1, 0.14, bx, 0.1, sz, STONE, M.Slate)
	end
	fence(out, "fenceL", -6, 5.95, -2.2, 5.95, 0.1)
	fence(out, "fenceR", -0.2, 5.95, 6, 5.95, 0.1)
	-- kho vườn
	box(out, "shed", 2.6, 2.2, 2.4, 4.2, 0.1, -4.4, rgb(150, 110, 80), WOODMAT)
	add(out, spec("shedRoof", "Wedge", 3, 0.8, 2.8, 4.2, 2.3, -4.4, roof, SHINGLES))
	box(out, "shedDoor", 1, 1.7, 0.1, 4.2, 0.1, -3.15, rgb(120, 86, 62), WOODMAT, { noShadow = true })
	tree(out, "tree", 4.2, 2.6, 0.9, 0.1, v)
	bush(out, "bush", 4.8, -1.2, 1, 0.1)
	flowers(out, "flowers", -4.2, 5.1, 3, 0.7, 0.1)
	return out
end

-- chung cư 2x2, 2 khối xếp chữ L
BUILDERS.apartment = function(v)
	local out = {}
	local floors = 6 + math.floor(v * 3)
	local h = floors * FLOOR
	local wall = pick(WALLS, v + 0.2)
	local accent = land("house", 1, 0.1)
	box(out, "court", 26.2, 0.1, 26.2, 0, 0, 0, PAVING, PAVE)
	-- khối A dọc phía sau
	local ax, az, aw, ad = -1.5, -8.5, 22, 7.6
	box(out, "slabA", aw, h, ad, ax, 0, az, wall, PLASTER)
	ribbons(out, "winA", aw, ad, ax, az, 0, floors, 1.5, GLASS)
	box(out, "roofA", aw + 0.4, 0.8, ad + 0.4, ax, h, az, accent, PLASTIC)
	for f = 1, floors - 1 do
		for k = 0, 3 do
			local px = -9.4 + k * 5.2
			box(out, "balA" .. f .. k, 3.6, 0.25, 1.3, px, f * FLOOR - 0.05, az + ad / 2 + 0.65, FRAME, PLASTIC)
			box(out, "railA" .. f .. k, 3.6, 0.9, 0.1, px, f * FLOOR + 0.2, az + ad / 2 + 1.25, rgb(200, 226, 240), GLASSMAT, { transparency = 0.35, noShadow = true })
		end
	end
	for k, px in ipairs({ ax - aw / 2 + 0.6, ax + aw / 2 - 0.6 }) do
		box(out, "stripeA" .. k, 1.2, h, 0.3, px, 0, az + ad / 2 + 0.15, accent, PLASTIC, { noShadow = true })
	end
	box(out, "entrance", 3.4, 2.4, 0.12, -1.5, 0, az + ad / 2 + 0.1, GLASS_DARK, GLASSMAT, { noShadow = true })
	box(out, "canopy", 4.4, 0.3, 2, -1.5, 2.55, az + ad / 2 + 1, accent, PLASTIC)
	box(out, "nameSign", 7, 1.4, 0.3, ax, h + 0.8, az + ad / 2 - 0.4, accent, PLASTIC, { label = "CHUNG CƯ", labelColor = WHITE, labelFace = "Back", noShadow = true })
	cyl(out, "tank", 2.4, 2, 6, h + 0.8, -10.4, STEEL, METAL)
	box(out, "liftRoom", 2.8, 2.2, 2.8, -9, h + 0.8, -10, wall, CONCRETE)
	for k = 0, 2 do
		solar(out, "solarA" .. k, -3 + k * 3.2, h + 0.8, -10.4, 2.8, 1.6)
	end
	-- khối B dọc bên trái
	local fb = floors - 2
	local hb = fb * FLOOR
	local bx, bz, bw, bd = -8.8, 4.2, 7.5, 12.4
	box(out, "slabB", bw, hb, bd, bx, 0, bz, wall, PLASTER)
	ribbons(out, "winB", bw, bd, bx, bz, 0, fb, 1.5, GLASS)
	box(out, "roofB", bw + 0.4, 0.8, bd + 0.4, bx, hb, bz, accent, PLASTIC)
	for f = 1, fb - 1 do
		for k = 0, 2 do
			local pz = bz - 4.4 + k * 4.4
			box(out, "balB" .. f .. k, 1.3, 0.25, 3.4, bx + bw / 2 + 0.65, f * FLOOR - 0.05, pz, FRAME, PLASTIC)
			box(out, "railB" .. f .. k, 0.1, 0.9, 3.4, bx + bw / 2 + 1.25, f * FLOOR + 0.2, pz, rgb(200, 226, 240), GLASSMAT, { transparency = 0.35, noShadow = true })
		end
	end
	box(out, "stripeB", 0.3, hb, 1.2, bx + bw / 2 + 0.15, 0, bz + bd / 2 - 0.6, accent, PLASTIC, { noShadow = true })
	acUnit(out, "acB", bx, hb + 0.8, bz + 3)
	-- sân trong
	box(out, "lawn", 7, 0.12, 5.6, 1.4, 0.1, 1.2, LAWN, GRASSMAT)
	tree(out, "treeA", -0.6, 0.8, 1, 0.22, v)
	tree(out, "treeB", 3.4, 2.2, 0.85, 0.22, v + 0.3)
	bench(out, "bench", 1.4, 4.6, true, 0.1)
	box(out, "playground", 6, 0.15, 6, 8.6, 0.1, 2.6, rgb(240, 120, 80), M.Rubber)
	box(out, "slideTower", 1.4, 1.8, 1.4, 6.8, 0.25, 1, rgb(250, 196, 60), PLASTIC)
	add(out, spec("slide", "Wedge", 1, 1.8, 2.6, 6.8, 0.25, 3, rgb(80, 160, 230), PLASTIC, { rot = 180 }))
	for k, px in ipairs({ 9.4, 11.4 }) do
		cyl(out, "swingPost" .. k, 0.2, 2.6, px, 0.25, 4.4, rgb(250, 196, 60), METAL, { noShadow = true })
	end
	box(out, "swingBar", 2.2, 0.2, 0.2, 10.4, 2.75, 4.4, rgb(250, 196, 60), METAL, { noShadow = true })
	box(out, "swingSeat", 0.8, 0.12, 0.5, 10.4, 1, 4.4, rgb(208, 52, 52), PLASTIC, { noShadow = true })
	person(out, "kidA", 8.4, 4.8, v, 0.25)
	person(out, "kidB", 5.2, 4.6, v + 0.5, 0.1)
	-- bãi đỗ xe phía trước
	box(out, "parking", 16.8, 0.12, 3.9, 4.2, 0.1, 10.9, ASPHALT, M.Asphalt)
	for k = 0, 5 do
		flat(out, "bay" .. k, 0.2, 3.4, -3.3 + k * 3, 0.22, 10.9, WHITE)
	end
	for k, slot in ipairs({ 0, 1, 3, 4 }) do
		car(out, "car" .. k, -1.8 + slot * 3, 10.9, pick(CARS, v + k * 0.21), false, 0.22)
	end
	tree(out, "treeC", -2.8, 7.4, 0.9, 0.1, v + 0.6)
	tree(out, "treeD", 11.2, 7.4, 0.9, 0.1, v + 0.8)
	lamp(out, "lampA", 0.2, 7.6, 0.1)
	lamp(out, "lampB", 8.2, 7.6, 0.1)
	return out
end

-- cửa hàng 2 tầng
BUILDERS.shop = function(v)
	local out = {}
	local wall = pick(WALLS, v + 0.6)
	local red = land("shop", 1)
	local w, d, x, z = 11, 8, 0, -2
	local fz = z + d / 2
	box(out, "forecourt", 12.4, 0.1, 4.1, 0, 0, 4.1, PAVING, PAVE)
	box(out, "base", w + 0.2, 0.5, d + 0.2, x, 0, z, rgb(110, 114, 122), CONCRETE)
	box(out, "store", w, 8.5, d, x, 0, z, wall, PLASTER)
	-- tủ kính trưng bày
	box(out, "bayBase", 7.6, 0.6, 1.1, -1.5, 0, fz + 0.55, DARK, CONCRETE)
	box(out, "bayTop", 7.6, 0.35, 1.1, -1.5, 3.2, fz + 0.55, red, PLASTIC)
	local goods = { rgb(250, 204, 72), rgb(70, 130, 230), rgb(244, 114, 146), rgb(120, 200, 140) }
	for k = 1, 4 do
		box(out, "goods" .. k, 1.2, 0.8 + (k % 2) * 0.6, 0.6, -6.3 + k * 1.9, 0.6, fz + 0.45, goods[k], PLASTIC, { noShadow = true })
	end
	box(out, "bayGlass", 7.4, 2.6, 0.1, -1.5, 0.6, fz + 1.05, rgb(196, 226, 244), GLASSMAT, { transparency = 0.45, reflectance = 0.2, noShadow = true })
	for k = -1, 1, 2 do
		box(out, "bayMullion" .. k, 0.16, 2.6, 0.16, -1.5 + k * 1.25, 0.6, fz + 1.05, DARK, METAL, { noShadow = true })
	end
	door(out, "door", 1, w, d, x, z, 3.9, GLASS_DARK, 1.4, 2.6)
	awning(out, "awning", 11, 0, 3.55, fz, red, 7)
	sign(out, "sign", "SHOP", 1, w, d, x, z, 0, 4.6, 9, 1.3, red, WHITE)
	windowsAll(out, "winUp", w, d, x, z, 5.35, 1, { 3, 2, 3, 2 })
	windowsAll(out, "winSide", w, d, x, z, 0.2, 1, { 0, 2, 0, 0 }, { wh = 1.8 })
	box(out, "cornice", w + 0.4, 0.5, d + 0.4, x, 8.5, z, land("shop", 1, 0.25), PLASTIC)
	box(out, "blade", 0.25, 2.2, 1.4, w / 2 + 0.15, 3.6, fz - 0.9, rgb(250, 196, 60), PLASTIC, { label = "SALE", labelColor = red, labelFace = "Right", noShadow = true })
	acUnit(out, "acA", -3, 9, -3.8)
	acUnit(out, "acB", 0.4, 9, -3.8)
	planter(out, "planterA", -5.2, 3.9, 1.2, 0.1)
	planter(out, "planterB", 5.3, 4.6, 1.2, 0.1)
	bench(out, "bench", -2.8, 5.2, true, 0.1)
	person(out, "shopperA", 1.6, 4.4, v, 0.1)
	person(out, "shopperB", -0.4, 5.3, v + 0.4, 0.1)
	return out
end

-- quán cà phê
BUILDERS.cafe = function(v)
	local out = {}
	local red = land("shop", 1)
	local bx, bz, bw, bd = -1.8, -2.9, 8, 6.6
	box(out, "cafe", bw, 4.4, bd, bx, 0, bz, rgb(176, 98, 74), BRICK)
	gable(out, "roof", bw + 0.6, bd + 0.6, 1.8, bx, 4.4, bz, land("shop", 1, 0.35), "x", SHINGLES)
	panel(out, "windowFrame", 1, bw, bd, bx, bz, -1.4, 0.5, 4.6, 2.5, FRAME, PLASTIC, 0, 0.1)
	panel(out, "window", 1, bw, bd, bx, bz, -1.4, 0.65, 4.3, 2.2, GLASS, GLASSMAT, 0.06, 0.1, { reflectance = 0.25 })
	door(out, "door", 1, bw, bd, bx, bz, 2.6, GLASS_DARK, 1.2, 2.3)
	awning(out, "awning", bw, bx, 2.75, bz + bd / 2, red, 5)
	sign(out, "sign", "CÀ PHÊ", 1, bw, bd, bx, bz, 0, 3.7, 5, 0.7, rgb(250, 240, 220), land("shop", 1, 0.3))
	windowsAll(out, "winSide", bw, bd, bx, bz, 0.2, 1, { 0, 2, 2, 1 }, { wh = 1.6 })
	cyl(out, "flue", 0.5, 1.6, bx - 2.6, 5.2, bz - 1.6, STEEL, METAL)
	-- sàn gỗ ngoài trời
	box(out, "deck", 11.6, 0.2, 5.2, 0, 0, 3.4, DECK, WOODMAT)
	hedge(out, "hedgeL", 2.6, 0.6, -4.5, 5.7, 0.2)
	hedge(out, "hedgeR", 2.6, 0.6, 4.5, 5.7, 0.2)
	for k, p in ipairs({ { -3.6, 4 }, { 0.4, 4.1 }, { 3.9, 2.6 } }) do
		tableSet(out, "table" .. k, p[1], p[2], 0.2)
		umbrella(out, "umbrella" .. k, p[1], p[2], k % 2 == 1 and red or WHITE, 0.2)
	end
	person(out, "guestA", -2.2, 2.2, v, 0.2)
	person(out, "guestB", 2.5, 4.9, v + 0.5, 0.2)
	-- biển hình cốc
	cyl(out, "cupPole", 0.3, 4.6, 5, 0, -4.8, DARK, METAL)
	cyl(out, "saucer", 2.2, 0.15, 5, 4.55, -4.8, WHITE, PLASTIC)
	cyl(out, "cup", 1.6, 1.3, 5, 4.7, -4.8, WHITE, PLASTIC)
	cyl(out, "coffee", 1.35, 0.06, 5, 6, -4.8, rgb(96, 60, 40), PLASTIC, { noShadow = true })
	box(out, "cupHandle", 0.3, 0.8, 0.3, 6, 5, -4.8, WHITE, PLASTIC)
	return out
end

-- siêu thị 2x2
BUILDERS.supermarket = function(v)
	local out = {}
	local red = land("shop", 1)
	local sx, sz, sw, sd = 0, -6.6, 24, 12.5
	box(out, "store", sw, 7, sd, sx, 0, sz, pick(WALLS, v), PLASTER)
	box(out, "base", sw + 0.2, 0.6, sd + 0.2, sx, 0, sz, rgb(110, 114, 122), CONCRETE)
	box(out, "band", sw + 0.3, 1.2, sd + 0.3, sx, 5.6, sz, red, PLASTIC)
	box(out, "parapet", sw + 0.4, 0.4, sd + 0.4, sx, 7, sz, land("shop", 1, 0.3), PLASTIC)
	panel(out, "frontFrame", 1, sw, sd, sx, sz, -4, 0.3, 10.4, 4, DARK, METAL, 0, 0.1)
	panel(out, "front", 1, sw, sd, sx, sz, -4, 0.5, 10, 3.6, GLASS, GLASSMAT, 0.06, 0.1, { reflectance = 0.25 })
	for k = -2, 2 do
		panel(out, "frontMullion" .. k, 1, sw, sd, sx, sz, -4 + k * 2, 0.5, 0.18, 3.6, DARK, METAL, 0.12, 0.12)
	end
	sign(out, "sign", "SIÊU THỊ", 1, sw, sd, sx, sz, 4.5, 4.4, 9, 2.4, WHITE, red, 0.15)
	box(out, "canopy", 12, 0.35, 3, -4, 4.4, 1.15, red, PLASTIC)
	for k, px in ipairs({ -9.5, 1.5 }) do
		cyl(out, "canopyPost" .. k, 0.35, 4.4, px, 0, 2.3, WHITE, METAL)
	end
	windowsAll(out, "winSide", sw, sd, sx, sz, 2.2, 1, { 0, 3, 0, 3 }, { ww = 2.4, wh = 1.6, frame = DARK })
	-- chỗ để xe đẩy
	box(out, "cartRail", 3.6, 0.9, 0.12, 6.6, 0, 0.4, STEEL, METAL, { noShadow = true })
	for k = 0, 2 do
		box(out, "cart" .. k, 0.9, 0.8, 1.3, 5.6 + k * 1, 0.1, 1.2, rgb(208, 52, 52), METAL, { noShadow = true })
	end
	for k = 0, 3 do
		acUnit(out, "ac" .. k, -9 + k * 5, 7.4, -9.5)
	end
	for k = 0, 1 do
		box(out, "skylight" .. k, 3, 0.6, 2, -2 + k * 7, 7.4, -5.2, rgb(200, 226, 240), GLASSMAT, { reflectance = 0.3 })
	end
	-- vỉa hè trước cửa + bãi đỗ xe
	box(out, "walk", 26.2, 0.14, 2.6, 0, 0, 0.9, PAVING, PAVE)
	box(out, "parking", 26.2, 0.12, 10.8, 0, 0, 7.7, ASPHALT, M.Asphalt)
	for row, rz in ipairs({ 5, 11 }) do
		for k = 0, 7 do
			flat(out, "bay" .. row .. k, 0.2, 3.6, -12 + k * 3, 0.12, rz, WHITE)
		end
		for k, slot in ipairs(row == 1 and { 0, 1, 3, 5 } or { 1, 2, 4 }) do
			car(out, "car" .. row .. k, -10.5 + slot * 3, rz, pick(CARS, v + slot * 0.17 + row * 0.3), false, 0.12)
		end
		box(out, "island" .. row, 2.6, 0.3, 3.6, 11.4, 0.12, rz, LAWN, GRASSMAT)
		tree(out, "islandTree" .. row, 11.4, rz, 0.85, 0.42, v + row * 0.3)
	end
	flat(out, "aisleArrow", 0.4, 2, -1, 0.12, 8, WHITE)
	lamp(out, "lampA", -6, 8, 0.12, 5)
	lamp(out, "lampB", 6, 8, 0.12, 5)
	person(out, "shopperA", 3.6, 2.4, v, 0.14)
	person(out, "shopperB", -7, 1.6, v + 0.3, 0.14)
	box(out, "shopperCart", 0.9, 0.8, 1.3, 3.6, 0.14, 3.4, rgb(208, 52, 52), METAL, { noShadow = true })
	return out
end

-- nhà máy
BUILDERS.factory = function(v)
	local out = {}
	local purple = land("factory", 1)
	local hx, hz, hw, hd = -1.6, -1.8, 8.8, 8.4
	box(out, "apron", 12.4, 0.1, 3.8, 0, 0, 4.3, rgb(200, 202, 204), CONCRETE)
	box(out, "hall", hw, 5.2, hd, hx, 0, hz, rgb(220, 222, 228), METAL)
	box(out, "hallBase", hw + 0.2, 1.2, hd + 0.2, hx, 0, hz, rgb(170, 172, 176), CONCRETE)
	ribbons(out, "hallWin", hw, hd, hx, hz, 3.4, 1, 0.9, GLASS_DARK, 1.2)
	sawtooth(out, "roof", hw, hd, 2, hx, 5.2, hz, 3, purple, land("factory", 1, 0.2))
	for k, t in ipairs({ -2.4, 1.2 }) do
		panel(out, "doorFrame" .. k, 1, hw, hd, hx, hz, t, 0, 3.2, 3.4, DARK, METAL, 0, 0.1)
		panel(out, "rollDoor" .. k, 1, hw, hd, hx, hz, t, 0, 2.8, 3.1, STEEL, METAL, 0.06, 0.1)
		panel(out, "doorLine" .. k, 1, hw, hd, hx, hz, t, 1.6, 2.8, 0.1, rgb(150, 154, 162), PLASTIC, 0.12, 0.08)
	end
	-- nhà văn phòng bên phải
	local ox, oz, ow, od = 4.5, -0.1, 3, 5
	box(out, "office", ow, 6, od, ox, 0, oz, rgb(246, 246, 244), PLASTER)
	windowsAll(out, "officeWin", ow, od, ox, oz, 0, 2, { 1, 2, 0, 0 }, { ww = 1.4, wh = 1.3, frame = purple })
	box(out, "officeRoof", ow + 0.3, 0.4, od + 0.3, ox, 6, oz, purple, PLASTIC)
	box(out, "officeSign", 3.2, 0.9, 0.25, ox, 6.4, oz + od / 2 - 0.2, purple, PLASTIC, { label = "NHÀ MÁY", labelColor = WHITE, labelFace = "Back", noShadow = true })
	-- ống khói
	cyl(out, "chimney", 2, 15, 4.4, 0, -4.6, rgb(200, 196, 190), BRICK)
	cyl(out, "chimneyBandA", 2.15, 0.9, 4.4, 10.5, -4.6, purple, PLASTIC)
	cyl(out, "chimneyBandB", 2.15, 0.9, 4.4, 12.6, -4.6, WHITE, PLASTIC)
	cyl(out, "chimneyTop", 2.4, 0.7, 4.4, 15, -4.6, DARK, METAL, { effect = "smoke" })
	-- bồn, hàng, xe nâng
	cyl(out, "tank", 2.6, 3.2, -4.6, 0.1, 4.4, rgb(226, 228, 232), METAL)
	ball(out, "tankDome", 2.6, -4.6, 2, 4.4, rgb(226, 228, 232), METAL)
	box(out, "pipe", 0.4, 0.4, 1.8, -4.6, 2.4, 2.4, purple, METAL)
	box(out, "pallet", 1.8, 0.25, 1.8, 0.6, 0.1, 4.6, WOOD, WOODMAT)
	box(out, "crateA", 1.6, 1.3, 1.6, 0.6, 0.35, 4.6, rgb(196, 150, 96), WOODMAT)
	box(out, "crateB", 1.2, 1, 1.2, 0.7, 1.65, 4.5, rgb(176, 132, 84), WOODMAT)
	box(out, "forklift", 1.2, 1, 1.8, 3.4, 0.35, 4.4, rgb(242, 184, 40), PLASTIC)
	box(out, "forkliftWheels", 1.3, 0.5, 1.4, 3.4, 0.1, 4.4, DARK, PLASTIC)
	box(out, "forkliftRoof", 1.2, 0.15, 1.1, 3.4, 2.4, 4.5, DARK, METAL)
	box(out, "forkliftMast", 1, 2.3, 0.15, 3.4, 0.1, 3.4, DARK, METAL)
	person(out, "worker", 2, 3.2, v, 0.1)
	return out
end

-- xưởng nhỏ
BUILDERS.workshop = function(v)
	local out = {}
	local purple = land("factory", 1)
	local hx, hz, hw, hd = -1.6, -2.3, 8.4, 7.4
	box(out, "apron", 12.4, 0.1, 4.8, 0, 0, 3.8, rgb(200, 202, 204), CONCRETE)
	box(out, "shed", hw, 4.2, hd, hx, 0, hz, rgb(222, 220, 226), METAL)
	box(out, "shedBase", hw + 0.2, 1, hd + 0.2, hx, 0, hz, rgb(170, 172, 176), CONCRETE)
	sawtooth(out, "roof", hw, hd, 1.6, hx, 4.2, hz, 2, purple, land("factory", 1, 0.2))
	panel(out, "doorFrame", 1, hw, hd, hx, hz, -1.6, 0, 3.4, 3.2, DARK, METAL, 0, 0.1)
	panel(out, "rollDoor", 1, hw, hd, hx, hz, -1.6, 0, 3, 2.9, STEEL, METAL, 0.06, 0.1)
	door(out, "sideDoor", 1, hw, hd, hx, hz, 2.4, rgb(90, 96, 110), 1.1, 2.2)
	sign(out, "sign", "XƯỞNG", 1, hw, hd, hx, hz, 2.4, 2.7, 2.6, 0.8, purple, WHITE)
	windowsAll(out, "win", hw, hd, hx, hz, 0.6, 1, { 0, 2, 2, 2 }, { wh = 1.2, frame = purple })
	cyl(out, "chimney", 1.2, 7.5, 4.6, 0, -4.8, rgb(200, 196, 190), BRICK)
	cyl(out, "chimneyTop", 1.4, 0.5, 4.6, 7.5, -4.8, DARK, METAL, { effect = "smoke" })
	for k, p in ipairs({ { -5.2, 2.4 }, { -4.2, 2.6 }, { -5, 3.5 } }) do
		cyl(out, "barrel" .. k, 0.9, 1.2, p[1], 0.1, p[2], rgb(46, 107, 255), METAL)
	end
	box(out, "crateA", 1.4, 1.2, 1.4, -1.6, 0.1, 3.6, rgb(196, 150, 96), WOODMAT)
	box(out, "crateB", 1, 0.9, 1, -1.5, 1.3, 3.6, rgb(176, 132, 84), WOODMAT)
	box(out, "workbench", 2.2, 1, 0.8, 1.2, 0.1, 2.2, WOOD, WOODMAT)
	truck(out, "van", 4.5, 2.6, purple, 0.1, 3)
	person(out, "worker", 0.2, 3.6, v, 0.1)
	return out
end

-- khu nhà máy 2x2
BUILDERS.plant = function(v)
	local out = {}
	local purple = land("factory", 1)
	local hx, hz, hw, hd = -3.3, -7, 18.6, 11.6
	box(out, "yard", 26.2, 0.1, 13, 0, 0, 6.4, rgb(200, 202, 204), CONCRETE)
	box(out, "hall", hw, 7.5, hd, hx, 0, hz, rgb(220, 222, 228), METAL)
	box(out, "hallBase", hw + 0.2, 1.4, hd + 0.2, hx, 0, hz, rgb(170, 172, 176), CONCRETE)
	ribbons(out, "hallWin", hw, hd, hx, hz, 5, 1, 1.2, GLASS_DARK, 1.6)
	sawtooth(out, "roof", hw, hd, 2.4, hx, 7.5, hz, 4, purple, land("factory", 1, 0.2))
	for k, t in ipairs({ -6, -1, 4 }) do
		panel(out, "doorFrame" .. k, 1, hw, hd, hx, hz, t, 0, 3.8, 4.3, DARK, METAL, 0, 0.1)
		panel(out, "rollDoor" .. k, 1, hw, hd, hx, hz, t, 0, 3.4, 4, STEEL, METAL, 0.06, 0.1)
	end
	-- nhà văn phòng 3 tầng
	local ox, oz, ow, od = 9.7, -2.9, 6.2, 6.2
	box(out, "office", ow, 9, od, ox, 0, oz, rgb(246, 246, 244), PLASTER)
	ribbons(out, "officeWin", ow, od, ox, oz, 0, 3, 1.6, GLASS)
	box(out, "officeRoof", ow + 0.3, 0.5, od + 0.3, ox, 9, oz, purple, PLASTIC)
	box(out, "officeSign", 5.4, 1.2, 0.3, ox, 9.5, oz + od / 2 - 0.3, purple, PLASTIC, { label = "NHÀ MÁY", labelColor = WHITE, labelFace = "Back", noShadow = true })
	door(out, "officeDoor", 1, ow, od, ox, oz, 0, GLASS_DARK, 1.8, 2.3)
	-- ống khói
	for k, p in ipairs({ { 8.4, -10.4, 22 }, { 11.6, -9, 18 } }) do
		cyl(out, "chimney" .. k, 2.6, p[3], p[1], 0, p[2], rgb(200, 196, 190), BRICK)
		cyl(out, "chimneyBand" .. k, 2.8, 1.2, p[1], p[3] - 3, p[2], purple, PLASTIC)
		cyl(out, "chimneyTop" .. k, 3, 0.8, p[1], p[3], p[2], DARK, METAL, { effect = "smoke" })
	end
	-- bồn chứa nối ống vào xưởng
	local front = hz + hd / 2
	for k, p in ipairs({ { -9, 6, 5, 5.5 }, { -3.5, 7.6, 4, 4.5 } }) do
		cyl(out, "tank" .. k, p[3], p[4], p[1], 0.1, p[2], rgb(226, 228, 232), METAL)
		ball(out, "tankDome" .. k, p[3], p[1], 0.1 + p[4] - p[3] / 2, p[2], rgb(226, 228, 232), METAL)
		cyl(out, "tankBand" .. k, p[3] + 0.1, 0.5, p[1], 0.1 + p[4] * 0.6, p[2], purple, PLASTIC)
		local back = p[2] - p[3] / 2
		box(out, "pipe" .. k, 0.5, 0.5, back - front, p[1], 3.6, (back + front) / 2, rgb(170, 172, 180), METAL)
	end
	box(out, "pipeRack", 6, 0.5, 0.5, -6.25, 3.6, 0.6, rgb(170, 172, 180), METAL)
	-- công-te-nơ, xe tải
	local containers = { rgb(46, 107, 255), rgb(208, 52, 52), rgb(60, 157, 74) }
	for k = 1, 3 do
		box(out, "container" .. k, 5.6, 2.4, 2.4, 3.4, k == 3 and 2.5 or 0.1, k == 3 and 5.9 or 4.7 + (k - 1) * 2.5, containers[k], METAL)
	end
	truck(out, "truck", 10.4, 6.6, purple, 0.1, 5.5)
	-- hàng rào phía trước, chừa cổng
	fence(out, "fenceL", -13, 12.9, 4, 12.9, 0.1, rgb(150, 154, 162), 2)
	fence(out, "fenceR", 8.4, 12.9, 13, 12.9, 0.1, rgb(150, 154, 162), 2)
	person(out, "workerA", 0, 2.2, v, 0.1)
	person(out, "workerB", 6.8, 9.8, v + 0.5, 0.1)
	return out
end

-- văn phòng, tháp đặt trên sảnh
BUILDERS.office = function(v)
	local out = {}
	local floors = 6 + math.floor(v * 4)
	local blue = land("office", 1)
	box(out, "plaza", 12.4, 0.1, 12.4, 0, 0, 0, PAVING, PAVE)
	local px, pz, pw, pd = -0.5, -1.6, 9, 8.4
	box(out, "lobby", pw, 4, pd, px, 0, pz, FRAME, CONCRETE)
	box(out, "lobbyGlass", pw + 0.2, 3, pd + 0.2, px, 0.2, pz, rgb(150, 200, 226), GLASSMAT, { reflectance = 0.25, noShadow = true })
	box(out, "lobbyCap", pw + 0.4, 0.6, pd + 0.4, px, 3.6, pz, FRAME, CONCRETE)
	local tx, tz, tw, td = -1, -2.2, 7, 7
	local ty = 4.2
	local th = floors * FLOOR
	box(out, "tower", tw, th, td, tx, ty, tz, FRAME, CONCRETE)
	ribbons(out, "win", tw, td, tx, tz, ty, floors, 2.2, land("office", 0.55))
	mullions(out, "mull", tw, td, tx, tz, ty, th, 2, FRAME)
	box(out, "fin", 0.6, th + 1, 0.6, tx + tw / 2, ty, tz + td / 2, blue, PLASTIC)
	local top = ty + th
	box(out, "crownGlass", 5.4, 2.4, 5.4, tx, top, tz, land("office", 0.8), GLASSMAT, { reflectance = 0.25 })
	box(out, "crownBand", 7.4, 0.6, 7.4, tx, top - 0.3, tz, blue, PLASTIC)
	box(out, "roofGarden", 5.8, 0.25, 5.8, tx, top + 2.4, tz, LAWN, GRASSMAT)
	bush(out, "roofBushA", tx - 1.6, tz - 1.4, 1, top + 2.6)
	bush(out, "roofBushB", tx + 1.4, tz + 1.2, 0.9, top + 2.6)
	cyl(out, "antenna", 0.3, 5, tx + 2, top + 2.6, tz - 2, WHITE, METAL, { noShadow = true })
	ball(out, "beacon", 0.6, tx + 2, top + 7.4, tz - 2, rgb(255, 80, 80), M.Neon, { noShadow = true })
	box(out, "sign", 5, 0.9, 0.25, px, 4.2, pz + pd / 2 - 0.35, blue, PLASTIC, { label = "VĂN PHÒNG", labelColor = WHITE, labelFace = "Back", noShadow = true })
	box(out, "canopy", 3.6, 0.25, 1.8, px, 3, pz + pd / 2 + 0.9, blue, PLASTIC)
	cyl(out, "revolvingDoor", 1.7, 2.5, px, 0, pz + pd / 2 + 0.2, rgb(150, 200, 226), GLASSMAT, { transparency = 0.2, reflectance = 0.3 })
	planter(out, "planterA", -5.2, 4.7, 1.4, 0.1)
	tree(out, "treeA", -5.2, 4.7, 0.6, 0.8, v)
	planter(out, "planterB", 4.6, 4.9, 1.4, 0.1)
	tree(out, "treeB", 4.6, 4.9, 0.6, 0.8, v + 0.4)
	bench(out, "bench", 1.6, 5.4, true, 0.1)
	person(out, "workerA", -2.4, 4.4, v, 0.1)
	person(out, "workerB", 2.8, 3.8, v + 0.6, 0.1)
	return out
end

-- văn phòng nhỏ 3-4 tầng
BUILDERS.office_small = function(v)
	local out = {}
	local floors = 3 + math.floor(v * 2)
	local blue = land("office", 1)
	local bx, bz, bw, bd = -0.8, -1.9, 8.4, 7.8
	local h = floors * FLOOR
	box(out, "plaza", 12.4, 0.1, 4, 0, 0, 4.2, PAVING, PAVE)
	box(out, "block", bw, h, bd, bx, 0, bz, rgb(176, 108, 86), BRICK)
	windowsAll(out, "win", bw, bd, bx, bz, 0, floors, { 3, 2, 3, 2 }, {
		ww = 1.5,
		wh = 1.6,
		frame = rgb(56, 60, 68),
		glass = land("office", 0.55),
		skip = function(face, f, k)
			return face == 1 and f == 0 and k == 2
		end,
	})
	door(out, "door", 1, bw, bd, bx, bz, 0, GLASS_DARK, 1.6, 2.3)
	box(out, "canopy", 3.6, 0.6, 1.8, bx, 2.5, bz + bd / 2 + 0.9, blue, PLASTIC, { label = "VĂN PHÒNG", labelColor = WHITE, labelFace = "Back" })
	box(out, "stripe", 0.9, h + 0.6, 0.9, bx + bw / 2, 0, bz + bd / 2, blue, PLASTIC)
	box(out, "cornice", bw + 0.4, 0.6, bd + 0.4, bx, h, bz, rgb(70, 74, 82), CONCRETE)
	solar(out, "solarA", bx - 1.8, h + 0.6, bz - 1, 3, 1.8)
	solar(out, "solarB", bx + 1.6, h + 0.6, bz - 1, 3, 1.8)
	acUnit(out, "ac", bx, h + 0.6, bz + 2.2)
	tree(out, "tree", 4.6, 4.6, 0.8, 0.1, v)
	car(out, "car", -3.4, 4.9, pick(CARS, v + 0.3), true, 0.1)
	for k = 0, 2 do
		box(out, "bikeRack" .. k, 0.12, 0.8, 1, 1.4 + k * 0.6, 0.1, 4.6, DARK, METAL, { noShadow = true })
	end
	person(out, "worker", 0.6, 3.4, v, 0.1)
	return out
end

-- tháp văn phòng 2x2
BUILDERS.tower = function(v)
	local out = {}
	local floors = 14 + math.floor(v * 4)
	local blue = land("office", 1)
	box(out, "plaza", 26.2, 0.1, 26.2, 0, 0, 0, PAVING, PAVE)
	-- khối đế
	box(out, "podium", 24, 5, 16, 0, 0, -4, FRAME, CONCRETE)
	box(out, "podiumGlass", 24.2, 3.6, 16.2, 0, 0.4, -4, rgb(150, 200, 226), GLASSMAT, { reflectance = 0.25, noShadow = true })
	box(out, "podiumCap", 24.4, 0.8, 16.4, 0, 4.6, -4, FRAME, CONCRETE)
	box(out, "podiumGarden", 7, 0.25, 5, 7.6, 5.4, 0.6, LAWN, GRASSMAT)
	bush(out, "podiumBushA", 6, 0.2, 1.2, 5.6)
	bush(out, "podiumBushB", 9.2, 1.4, 1, 5.6)
	local tx, tz, tw, td = -3, -5.8, 12.5, 12
	local ty = 5.4
	local th = floors * FLOOR
	box(out, "tower", tw, th, td, tx, ty, tz, FRAME, CONCRETE)
	ribbons(out, "win", tw, td, tx, tz, ty, floors, 2.2, land("office", 0.5))
	mullions(out, "mull", tw, td, tx, tz, ty, th, 3, FRAME)
	for k, c in ipairs({ { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } }) do
		box(out, "fin" .. k, 0.7, th + 1.2, 0.7, tx + c[1] * tw / 2, ty, tz + c[2] * td / 2, blue, PLASTIC)
	end
	local top = ty + th
	box(out, "setback", 9, 6, 9, tx, top, tz, land("office", 0.7), GLASSMAT, { reflectance = 0.25 })
	mullions(out, "setMull", 9, 9, tx, tz, top, 6, 2, FRAME)
	box(out, "crownBand", 9.6, 0.8, 9.6, tx, top + 6, tz, blue, PLASTIC)
	box(out, "crown", 6, 3, 6, tx, top + 6.8, tz, FRAME, CONCRETE)
	cyl(out, "spire", 0.6, 10, tx, top + 9.8, tz, WHITE, METAL, { noShadow = true })
	ball(out, "beacon", 0.9, tx, top + 19.6, tz, rgb(255, 80, 80), M.Neon, { noShadow = true })
	box(out, "sign", 12, 1.6, 0.3, 0, 5.4, 3.7, blue, PLASTIC, { label = "ECON TOWER", labelColor = WHITE, labelFace = "Back", noShadow = true })
	box(out, "canopy", 8, 0.4, 3, -3, 3.4, 5.5, blue, PLASTIC)
	for k, px in ipairs({ -6.6, 0.6 }) do
		cyl(out, "canopyPost" .. k, 0.4, 3.4, px, 0, 6.6, WHITE, METAL)
	end
	cyl(out, "revolvingDoor", 2.2, 2.8, -3, 0, 4.1, rgb(150, 200, 226), GLASSMAT, { transparency = 0.2, reflectance = 0.3 })
	-- quảng trường
	fountain(out, "fountain", 6, 8.8, 5.4, 0.1)
	for k, p in ipairs({ { -10, 9 }, { -4.5, 11.6 }, { 11.4, 11.6 } }) do
		cyl(out, "treeRing" .. k, 2.6, 0.5, p[1], 0.1, p[2], STONE, CONCRETE)
		tree(out, "tree" .. k, p[1], p[2], 0.9, 0.6, v + k * 0.3)
	end
	bench(out, "benchA", 1, 10.6, true, 0.1)
	bench(out, "benchB", 11.6, 6.4, false, 0.1)
	local flags = { blue, rgb(208, 52, 52), rgb(60, 157, 74) }
	for k = 0, 2 do
		local fx = 9.6 + k * 1.4
		cyl(out, "flagPole" .. k, 0.2, 7, fx, 0.1, 4.6, WHITE, METAL, { noShadow = true })
		box(out, "flag" .. k, 0.1, 1, 1.6, fx, 5.9, 5.45, flags[k + 1], PLASTIC, { noShadow = true })
	end
	lamp(out, "lampA", -8, 6.6, 0.1, 5)
	lamp(out, "lampB", 3, 12.4, 0.1, 5)
	person(out, "walkerA", -1, 8, v, 0.1)
	person(out, "walkerB", 3.4, 7, v + 0.3, 0.1)
	person(out, "walkerC", -7, 11, v + 0.6, 0.1)
	return out
end

-- bệnh viện 4 tầng
BUILDERS.hospital = function(v)
	local out = {}
	local accent = land("hospital", 1)
	local h = 4 * FLOOR
	local mx, mz, mw, md = 0, -2.4, 11.6, 7.6
	local front = mz + md / 2
	box(out, "plaza", 12.4, 0.1, 4.6, 0, 0, 3.9, PAVING, PAVE)
	box(out, "main", mw, h, md, mx, 0, mz, rgb(246, 248, 250), PLASTER)
	ribbons(out, "win", mw, md, mx, mz, 0, 4, 1.4, rgb(176, 214, 236))
	box(out, "stripe", 1.6, h, 0.3, mx - mw / 2 + 0.8, 0, front + 0.15, accent, PLASTIC, { noShadow = true })
	box(out, "parapet", mw + 0.3, 0.8, md + 0.3, mx, h, mz, accent, PLASTIC)
	box(out, "sign", 7, 1.2, 0.3, 0.6, h + 0.8, front - 0.3, accent, PLASTIC, { label = "BỆNH VIỆN", labelColor = WHITE, labelFace = "Back", noShadow = true })
	-- chữ thập trên mặt tiền
	box(out, "crossBoard", 3, 3, 0.25, 3.8, 6.6, front + 0.25, WHITE, PLASTIC, { noShadow = true })
	box(out, "crossV", 0.9, 2.4, 0.2, 3.8, 6.9, front + 0.45, accent, PLASTIC, { noShadow = true })
	box(out, "crossH", 2.4, 0.9, 0.2, 3.8, 7.65, front + 0.45, accent, PLASTIC, { noShadow = true })
	-- sân đỗ trực thăng
	cyl(out, "helipad", 6, 0.2, -1.5, h + 0.8, -2.8, rgb(90, 94, 102), CONCRETE)
	cyl(out, "helipadRing", 5.2, 0.05, -1.5, h + 1, -2.8, WHITE, PLASTIC, { noShadow = true })
	cyl(out, "helipadInner", 4.6, 0.06, -1.5, h + 1, -2.8, rgb(90, 94, 102), CONCRETE, { noShadow = true })
	box(out, "heliH1", 0.5, 0.08, 2.6, -2.5, h + 1, -2.8, WHITE, PLASTIC, { noShadow = true })
	box(out, "heliH2", 0.5, 0.08, 2.6, -0.5, h + 1, -2.8, WHITE, PLASTIC, { noShadow = true })
	box(out, "heliH3", 1.8, 0.08, 0.5, -1.5, h + 1, -2.8, WHITE, PLASTIC, { noShadow = true })
	acUnit(out, "acA", 3.6, h + 0.8, -4.4)
	acUnit(out, "acB", 3.6, h + 0.8, -2.2)
	-- lối vào cấp cứu
	box(out, "canopy", 5, 0.6, 2.8, -2.4, 3, front + 1.4, accent, PLASTIC, { label = "CẤP CỨU", labelColor = WHITE, labelFace = "Back" })
	for k, px in ipairs({ -4.6, -0.2 }) do
		cyl(out, "canopyPost" .. k, 0.3, 3, px, 0, front + 2.5, WHITE, METAL)
	end
	box(out, "entrance", 3, 2.4, 0.12, -2.4, 0, front + 0.06, GLASS_DARK, GLASSMAT, { noShadow = true })
	-- xe cứu thương
	box(out, "ambulanceWheels", 1.95, 0.7, 3.2, 3.6, 0.1, 4, DARK, PLASTIC)
	box(out, "ambulance", 1.9, 1.7, 3.8, 3.6, 0.5, 4, WHITE, PLASTIC)
	box(out, "ambulanceStripe", 1.95, 0.35, 3.85, 3.6, 1.1, 4, accent, PLASTIC, { noShadow = true })
	box(out, "ambulanceGlass", 1.6, 0.6, 0.1, 3.6, 1.4, 5.92, GLASS_DARK, GLASSMAT, { noShadow = true })
	box(out, "ambulanceCrossV", 0.1, 0.8, 0.3, 4.58, 1.5, 3.4, accent, PLASTIC, { noShadow = true })
	box(out, "ambulanceCrossH", 0.1, 0.3, 0.8, 4.58, 1.75, 3.4, accent, PLASTIC, { noShadow = true })
	ball(out, "sirenBlue", 0.4, 3.2, 2.2, 5.2, rgb(70, 140, 255), M.Neon, { noShadow = true })
	ball(out, "sirenRed", 0.4, 4, 2.2, 5.2, rgb(255, 70, 70), M.Neon, { noShadow = true })
	-- vườn
	tree(out, "tree", -5.1, 4.8, 0.7, 0.1, v)
	bench(out, "bench", -2.6, 5.4, true, 0.1)
	person(out, "doctor", -0.6, 4.2, 0.9, 0.1)
	person(out, "visitor", -2.8, 4.6, v, 0.1)
	return out
end

-- trạm y tế
BUILDERS.clinic = function(v)
	local out = {}
	local accent = land("hospital", 1)
	local h = 2 * FLOOR
	local bx, bz, bw, bd = -1, -2.6, 8.4, 6.4
	box(out, "plaza", 12.4, 0.1, 5.6, 0, 0, 3.4, PAVING, PAVE)
	box(out, "clinic", bw, h, bd, bx, 0, bz, rgb(246, 248, 250), PLASTER)
	windowsAll(out, "win", bw, bd, bx, bz, 0, 2, { 3, 2, 3, 2 }, {
		frame = land("hospital", 0.35),
		skip = function(face, f, k)
			return face == 1 and f == 0 and k == 2
		end,
	})
	box(out, "trim", bw + 0.3, 0.6, bd + 0.3, bx, h, bz, accent, PLASTIC)
	box(out, "crossV", 0.8, 2.6, 0.4, bx, h + 0.6, bz + bd / 2 - 0.6, accent, PLASTIC)
	box(out, "crossH", 2.6, 0.8, 0.4, bx, h + 1.5, bz + bd / 2 - 0.6, accent, PLASTIC)
	door(out, "door", 1, bw, bd, bx, bz, 0, GLASS_DARK, 1.6, 2.3)
	box(out, "canopy", 3.8, 0.6, 1.6, bx, 2.55, bz + bd / 2 + 0.8, accent, PLASTIC, { label = "TRẠM Y TẾ", labelColor = WHITE, labelFace = "Back" })
	box(out, "step", 2, 0.3, 0.8, bx, 0.1, bz + bd / 2 + 0.4, STONE, CONCRETE)
	add(out, spec("ramp", "Wedge", 1.2, 0.4, 2.6, bx + 2.1, 0.1, bz + bd / 2 + 1.3, STONE, CONCRETE, { rot = 180 }))
	bench(out, "bench", 3.8, 4.6, true, 0.1)
	tree(out, "tree", -4.6, 4.4, 0.8, 0.1, v)
	flowers(out, "flowers", 1.4, 5.4, 2.6, 0.8, 0.1)
	acUnit(out, "ac", bx - 2, h + 0.6, bz - 1.4)
	person(out, "nurse", 2.6, 2.8, 0.9, 0.1)
	person(out, "patient", 3.2, 5.6, v, 0.1)
	return out
end

-- trường học 2 tầng
BUILDERS.school = function(v)
	local out = {}
	local orange = land("school", 1)
	local fh = 3.3
	local h = 2 * fh + 0.4
	local bx, bz, bw, bd = 0, -3.2, 12, 5.6
	local front = bz + bd / 2
	box(out, "yard", 12.4, 0.1, 6.6, 0, 0, 2.9, rgb(206, 208, 210), PAVE)
	box(out, "school", bw, h, bd, bx, 0, bz, rgb(206, 120, 88), BRICK)
	box(out, "plinth", bw + 0.2, 0.5, bd + 0.2, bx, 0, bz, STONE, CONCRETE)
	box(out, "floorTrim", bw + 0.16, 0.25, bd + 0.16, bx, fh + 0.2, bz, FRAME, PLASTIC, { noShadow = true })
	gable(out, "roof", bw + 0.4, bd + 1, 2.2, bx, h, bz, land("school", 1, 0.2), "x")
	windowsAll(out, "win", bw, bd, bx, bz, 0.4, 2, { 4, 1, 4, 1 }, {
		ww = 1,
		wh = 1.6,
		floorH = fh,
		glass = rgb(220, 236, 248),
		skip = function(face, f, k)
			return face == 1 and f == 0 and (k == 2 or k == 3)
		end,
	})
	door(out, "door", 1, bw, bd, bx, bz, 0, WOOD, 1.8, 2.5)
	box(out, "porch", 3.6, 0.6, 1.8, bx, 3, front + 0.9, orange, PLASTIC, { label = "TRƯỜNG HỌC", labelColor = WHITE, labelFace = "Back" })
	for k, px in ipairs({ -1.5, 1.5 }) do
		cyl(out, "column" .. k, 0.4, 3, px, 0, front + 1.5, WHITE, CONCRETE)
	end
	box(out, "steps", 3, 0.3, 1.4, bx, 0, front + 0.7, STONE, CONCRETE)
	-- tháp đồng hồ trên nóc
	box(out, "clockTower", 1.8, 3.6, 1.8, bx, h, bz, rgb(246, 240, 228), PLASTER)
	box(out, "clockFrame", 1.4, 1.4, 0.12, bx, h + 1.9, bz + 0.96, DARK, PLASTIC, { noShadow = true })
	box(out, "clockFace", 1.2, 1.2, 0.12, bx, h + 2, bz + 1.02, WHITE, PLASTIC, { noShadow = true })
	box(out, "clockHandA", 0.1, 0.5, 0.06, bx, h + 2.6, bz + 1.1, DARK, PLASTIC, { noShadow = true })
	box(out, "clockHandB", 0.4, 0.1, 0.06, bx + 0.2, h + 2.55, bz + 1.1, DARK, PLASTIC, { noShadow = true })
	gable(out, "clockRoof", 2.2, 2.2, 1.2, bx, h + 3.6, bz, land("school", 1, 0.2), "x")
	-- sân bóng rổ
	box(out, "court", 6.2, 0.12, 4.4, 2.8, 0.1, 3.4, land("school", 0.6), M.Rubber)
	flat(out, "courtLine", 0.15, 4.4, 2.8, 0.22, 3.4, WHITE)
	cyl(out, "courtCircle", 1.6, 0.06, 2.8, 0.2, 3.4, WHITE, PLASTIC, { noShadow = true, noCollide = true })
	cyl(out, "courtCircleIn", 1.3, 0.07, 2.8, 0.2, 3.4, land("school", 0.6), M.Rubber, { noShadow = true, noCollide = true })
	cyl(out, "hoopPole", 0.25, 3.2, 6, 0.1, 3.4, DARK, METAL, { noShadow = true })
	box(out, "backboard", 0.15, 1.1, 1.7, 5.75, 2.8, 3.4, WHITE, PLASTIC)
	box(out, "rim", 0.6, 0.08, 0.6, 5.35, 2.95, 3.4, rgb(240, 120, 40), METAL, { noShadow = true })
	flagpole(out, "flag", -5.5, 5.4, 7, 0.1)
	tree(out, "tree", -3.8, 2.4, 0.8, 0.1, v)
	person(out, "kidA", 1.2, 2.6, v, 0.1)
	person(out, "kidB", 4, 4.6, v + 0.3, 0.1)
	person(out, "kidC", -1.8, 4.8, v + 0.6, 0.1)
	return out
end

-- trường lớn 2x2
BUILDERS.school_big = function(v)
	local out = {}
	local orange = land("school", 1)
	local brick = rgb(206, 120, 88)
	local fh = 3.3
	local mx, mz, mw, md = 0, -9.6, 25.6, 6.6
	local mh = 3 * fh
	local front = mz + md / 2
	box(out, "yard", 26.2, 0.1, 19.4, 0, 0, 3.5, rgb(206, 208, 210), PAVE)
	box(out, "main", mw, mh, md, mx, 0, mz, brick, BRICK)
	box(out, "mainPlinth", mw + 0.2, 0.5, md + 0.2, mx, 0, mz, STONE, CONCRETE)
	gable(out, "roofMain", mw + 0.8, md + 1, 2.6, mx, mh, mz, land("school", 1, 0.2), "x")
	windowsAll(out, "winMain", mw, md, mx, mz, 0.4, 3, { 8, 0, 0, 0 }, {
		ww = 1.1,
		wh = 1.6,
		floorH = fh,
		glass = rgb(220, 236, 248),
		skip = function(face, f, k)
			return f == 0 and k == 6
		end,
	})
	windowsAll(out, "winMainBack", mw, md, mx, mz, 0.4, 3, { 0, 2, 6, 2 }, { wh = 1.6, floorH = fh, frame = false, glass = rgb(200, 222, 240) })
	door(out, "door", 1, mw, md, mx, mz, 4.8, WOOD, 2.2, 2.6)
	box(out, "porch", 4.6, 0.7, 2, 4.8, 3.1, front + 1, orange, PLASTIC, { label = "TRƯỜNG HỌC", labelColor = WHITE, labelFace = "Back" })
	for k, px in ipairs({ 3, 6.6 }) do
		cyl(out, "column" .. k, 0.4, 3.1, px, 0, front + 1.7, WHITE, CONCRETE)
	end
	box(out, "clockTower", 2.4, 4.2, 2.4, mx, mh, mz, rgb(246, 240, 228), PLASTER)
	box(out, "clockFrame", 1.8, 1.8, 0.12, mx, mh + 2.1, mz + 1.26, DARK, PLASTIC, { noShadow = true })
	box(out, "clockFace", 1.5, 1.5, 0.12, mx, mh + 2.25, mz + 1.32, WHITE, PLASTIC, { noShadow = true })
	box(out, "clockHand", 0.12, 0.6, 0.06, mx, mh + 3, mz + 1.4, DARK, PLASTIC, { noShadow = true })
	gable(out, "clockRoof", 2.8, 2.8, 1.4, mx, mh + 4.2, mz, land("school", 1, 0.2), "x")
	-- cánh nhà bên trái
	local wx, wz, ww, wd = -9.3, -0.8, 6.6, 11.2
	box(out, "wing", ww, 2 * fh, wd, wx, 0, wz, brick, BRICK)
	gable(out, "roofWing", ww + 0.8, wd + 0.6, 2.2, wx, 2 * fh, wz, land("school", 1, 0.3), "z")
	windowsAll(out, "winWing", ww, wd, wx, wz, 0.4, 2, { 2, 4, 0, 0 }, { ww = 1.1, wh = 1.6, floorH = fh, glass = rgb(220, 236, 248) })
	-- sân bóng + đường chạy
	local fx, fz = 4.4, 3.2
	box(out, "track", 16.4, 0.12, 14, fx, 0.1, fz, rgb(214, 96, 72), M.Rubber)
	box(out, "field", 13.6, 0.14, 11.2, fx, 0.12, fz, rgb(112, 178, 92), GRASSMAT)
	flat(out, "midLine", 0.2, 11.2, fx, 0.27, fz, WHITE)
	cyl(out, "centerCircle", 3.2, 0.05, fx, 0.26, fz, WHITE, PLASTIC, { noShadow = true, noCollide = true })
	cyl(out, "centerCircleIn", 2.8, 0.06, fx, 0.26, fz, rgb(112, 178, 92), GRASSMAT, { noShadow = true, noCollide = true })
	for k, gx in ipairs({ fx - 6.4, fx + 6.4 }) do
		box(out, "goal" .. k, 0.3, 1.6, 3, gx, 0.26, fz, WHITE, METAL)
	end
	-- khán đài
	for k = 0, 2 do
		box(out, "bleacher" .. k, 10, 0.5 + k * 0.5, 2.2 - k * 0.7, fx, 0.1, 11.6 + k * 0.35, k % 2 == 0 and rgb(200, 204, 210) or land("school", 0.6), CONCRETE)
	end
	person(out, "fanA", fx - 2, 11.2, v, 0.6)
	person(out, "fanB", fx + 1.5, 11.6, v + 0.4, 1.1)
	person(out, "playerA", fx - 2.6, 2, v + 0.2, 0.26)
	person(out, "playerB", fx + 2.4, 4.6, v + 0.7, 0.26)
	-- xe buýt trường
	box(out, "busWheels", 7.6, 0.8, 2.3, -8.4, 0.1, 9.6, DARK, PLASTIC)
	box(out, "bus", 7.6, 2.4, 2.4, -8.4, 0.6, 9.6, rgb(250, 196, 40), PLASTIC)
	box(out, "busWindows", 6.4, 0.8, 2.5, -8.6, 1.9, 9.6, GLASS_DARK, GLASSMAT, { noShadow = true })
	box(out, "busStripe", 7.7, 0.2, 2.5, -8.4, 1.3, 9.6, DARK, PLASTIC, { noShadow = true })
	flagpole(out, "flag", -12, 12.2, 9, 0.1)
	tree(out, "treeA", -11.4, 6.4, 0.9, 0.1, v)
	tree(out, "treeB", 11.2, -4.6, 0.9, 0.1, v + 0.5)
	return out
end

