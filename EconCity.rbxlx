	return out
end

-- công viên lớn 2x2
BUILDERS.park_big = function(v)
	local out = {}
	local green = land("park", 1, 0.25)
	box(out, "lawn", 26.4, 0.3, 26.4, 0, 0, 0, rgb(116, 184, 92), GRASSMAT)
	box(out, "pathX", 26.4, 0.06, 2, 0, 0.3, 0, STONE, PAVE, { noShadow = true })
	box(out, "pathZ", 2, 0.06, 26.4, 0, 0.3, 0, STONE, PAVE, { noShadow = true })
	cyl(out, "plaza", 8.4, 0.08, 0, 0.3, 0, STONE, PAVE, { noShadow = true })
	fountain(out, "fountain", 0, 0, 5.2, 0.38)
	for k, p in ipairs({ { 3.4, 3.4 }, { -3.4, 3.4 }, { 3.4, -3.4 }, { -3.4, -3.4 } }) do
		flowers(out, "flowers" .. k, p[1], p[2], 2.6, 0.9, 0.3)
	end
	-- hồ
	cyl(out, "lakeEdge", 10.5, 0.3, -6.6, 0.3, -6.6, rgb(222, 206, 160), M.Sand)
	cyl(out, "lake", 9.4, 0.32, -6.6, 0.3, -6.6, WATER, GLASSMAT, { transparency = 0.1, reflectance = 0.35 })
	box(out, "bridge", 1.8, 0.4, 9.6, -6.6, 0.6, -6.6, DECK, WOODMAT)
	for k, s in ipairs({ -1, 1 }) do
		box(out, "bridgeRail" .. k, 0.15, 0.7, 9.6, -6.6 + s * 0.85, 1, -6.6, WOOD, WOODMAT, { noShadow = true })
	end
	for k, p in ipairs({ { -9, -5.2 }, { -4.4, -8.8 } }) do
		ball(out, "duck" .. k, 0.6, p[1], 0.55, p[2], WHITE, PLASTIC, { noShadow = true })
		ball(out, "duckHead" .. k, 0.35, p[1] + 0.3, 0.95, p[2], WHITE, PLASTIC, { noShadow = true })
		box(out, "duckBeak" .. k, 0.2, 0.1, 0.12, p[1] + 0.52, 1.05, p[2], rgb(250, 170, 40), PLASTIC, { noShadow = true })
	end
	-- chòi nghỉ
	local gx, gz = 7, -7
	cyl(out, "gazeboFloor", 5, 0.4, gx, 0.3, gz, DECK, WOODMAT)
	for k, c in ipairs({ { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } }) do
		cyl(out, "gazeboPost" .. k, 0.3, 2.8, gx + c[1] * 1.6, 0.7, gz + c[2] * 1.6, WHITE, WOODMAT)
	end
	cyl(out, "gazeboRoofA", 5.8, 0.4, gx, 3.5, gz, green, PLASTIC)
	cyl(out, "gazeboRoofB", 4, 0.5, gx, 3.9, gz, green, PLASTIC)
	cyl(out, "gazeboRoofC", 2.2, 0.5, gx, 4.4, gz, green, PLASTIC)
	ball(out, "gazeboTop", 0.6, gx, 4.8, gz, WHITE, PLASTIC)
	-- sân chơi
	local px, pz = 7.5, 7.5
	box(out, "playground", 7, 0.2, 7, px, 0.3, pz, rgb(240, 120, 80), M.Rubber)
	box(out, "slideTower", 1.6, 2.2, 1.6, px - 2, 0.5, pz - 2, rgb(250, 196, 60), PLASTIC)
	box(out, "slideRoof", 2, 0.3, 2, px - 2, 3.4, pz - 2, rgb(46, 107, 255), PLASTIC)
	for k, c in ipairs({ { 1, 1 }, { -1, -1 } }) do
		cyl(out, "slidePost" .. k, 0.18, 1, px - 2 + c[1] * 0.8, 2.7, pz - 2 + c[2] * 0.8, rgb(250, 196, 60), METAL, { noShadow = true })
	end
	add(out, spec("slide", "Wedge", 1, 2.2, 3, px - 2, 0.5, pz + 0.3, rgb(80, 160, 230), PLASTIC, { rot = 180 }))
	for k, sx in ipairs({ px + 1, px + 3.4 }) do
		cyl(out, "swingPost" .. k, 0.22, 2.8, sx, 0.5, pz - 1.6, rgb(250, 196, 60), METAL, { noShadow = true })
	end
	box(out, "swingBar", 2.6, 0.22, 0.22, px + 2.2, 3.2, pz - 1.6, rgb(250, 196, 60), METAL, { noShadow = true })
	for k, sx in ipairs({ px + 1.6, px + 2.8 }) do
		box(out, "swingSeat" .. k, 0.7, 0.12, 0.5, sx, 1.2, pz - 1.6, rgb(208, 52, 52), PLASTIC, { noShadow = true })
		box(out, "swingRope" .. k, 0.06, 2, 0.06, sx, 1.3, pz - 1.6, DARK, PLASTIC, { noShadow = true })
	end
	box(out, "sandbox", 2.8, 0.4, 2.8, px + 2, 0.5, pz + 2, WOOD, WOODMAT)
	box(out, "sand", 2.4, 0.42, 2.4, px + 2, 0.5, pz + 2, rgb(236, 214, 160), M.Sand)
	person(out, "kidA", px - 0.4, pz + 1, v, 0.5)
	person(out, "kidB", px + 2.2, pz - 0.6, v + 0.4, 0.5)
	-- khu dã ngoại
	for k, p in ipairs({ { -8.6, 6.4 }, { -5, 9.4 } }) do
		box(out, "picnicTop" .. k, 2.6, 0.2, 1.4, p[1], 1.1, p[2], DECK, WOODMAT)
		box(out, "picnicLeg" .. k, 2.2, 0.8, 0.3, p[1], 0.3, p[2], WOOD, WOODMAT)
		box(out, "picnicSeatA" .. k, 2.6, 0.2, 0.5, p[1], 0.7, p[2] - 1, DECK, WOODMAT)
		box(out, "picnicSeatB" .. k, 2.6, 0.2, 0.5, p[1], 0.7, p[2] + 1, DECK, WOODMAT)
	end
	box(out, "blanket", 2.4, 0.06, 2, -9.4, 0.3, 10.4, rgb(208, 52, 52), PLASTIC, { noShadow = true })
	person(out, "picnicA", -8.6, 4.8, v + 0.2, 0.3)
	person(out, "picnicB", -5, 11, v + 0.7, 0.3)
	-- cây quanh rìa
	local trees = { { -3, -11, 1 }, { 3.2, -11, 1 }, { 11, -2.8, 1.1 }, { 11, 3.2, 1 }, { 3, 11, 1.1 }, { -3.2, 11, 1 }, { -11, 2.8, 1.1 }, { -11.2, -11.2, 0.9 }, { 11.2, 11.2, 0.9 } }
	for k, p in ipairs(trees) do
		if k % 3 == 0 then
			pine(out, "tree" .. k, p[1], p[2], p[3], 0.3)
		else
			tree(out, "tree" .. k, p[1], p[2], p[3], 0.3, v + k * 0.13)
		end
	end
	hedge(out, "hedgeL", 10.6, 0.8, -7.4, 12.7, 0.3)
	hedge(out, "hedgeR", 10.6, 0.8, 7.4, 12.7, 0.3)
	for k, p in ipairs({ { 2.6, 5.4, false }, { 2.6, -5.4, false }, { 5.4, -2.4, true }, { -5.4, 2.4, true } }) do
		bench(out, "bench" .. k, p[1], p[2], p[3], 0.3)
	end
	for k, p in ipairs({ { 2, -2 }, { -2, 2 }, { 2, 9 }, { -9.4, -1.8 } }) do
		lamp(out, "lamp" .. k, p[1], p[2], 0.3)
	end
	person(out, "walkerA", 1.6, -6, v + 0.9, 0.3)
	person(out, "walkerB", -1.4, 7.4, v + 0.1, 0.3)
	return out
end

-- Ô đường. arms = list {dx, dz} các phía có đường nối sang. Toạ độ tính từ tâm ô, y tính từ mặt đường.
local SW = 2.4 -- bề rộng vỉa hè
local CURB_H = 0.18

local function trafficLight(out, name, x, z, facing)
	cyl(out, name .. "Pole", 0.2, 3.4, x, 0, z, DARK, METAL, { noShadow = true })
	box(out, name .. "Head", 0.5, 1.4, 0.5, x, 3.2, z, DARK, METAL, { noShadow = true })
	local ox, oz = facing[1] * 0.27, facing[2] * 0.27
	ball(out, name .. "Red", 0.32, x + ox, 4.1, z + oz, rgb(255, 70, 60), M.Neon, { noShadow = true })
	ball(out, name .. "Amber", 0.32, x + ox, 3.7, z + oz, rgb(255, 196, 60), M.Neon, { noShadow = true, transparency = 0.5 })
	ball(out, name .. "Green", 0.32, x + ox, 3.3, z + oz, rgb(80, 230, 120), M.Neon, { noShadow = true, transparency = 0.5 })
end

function CitySpecs.road(arms, index)
	local out = {}
	local half = 7
	local inner = half - SW / 2
	local has, count = {}, 0
	for _, a in ipairs(arms) do
		has[a[1] .. "," .. a[2]] = true
		count = count + 1
	end
	local function arm(dx, dz)
		return has[dx .. "," .. dz] == true
	end
	-- vỉa hè
	for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		box(out, "SidewalkCorner", SW, CURB_H, SW, c[1] * inner, 0, c[2] * inner, SIDEWALK, PAVE)
	end
	local len = 2 * half - 2 * SW
	for _, d in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
		if not arm(d[1], d[2]) then
			if d[1] == 0 then
				box(out, "Sidewalk", len, CURB_H, SW, 0, 0, d[2] * inner, SIDEWALK, PAVE)
			else
				box(out, "Sidewalk", SW, CURB_H, len, d[1] * inner, 0, 0, SIDEWALK, PAVE)
			end
		end
	end
	-- vạch kẻ
	if count >= 3 then
		for _, a in ipairs(arms) do
			for k = -2, 2 do
				if a[1] == 0 then
					flat(out, "Crosswalk", 1, 2, k * 1.8, 0.01, a[2] * inner, WHITE)
				else
					flat(out, "Crosswalk", 2, 1, a[1] * inner, 0.01, k * 1.8, WHITE)
				end
			end
		end
		-- đèn giao thông ở hai góc chéo
		trafficLight(out, "TrafficA", -inner, -inner, { 1, 1 })
		trafficLight(out, "TrafficB", inner, inner, { -1, -1 })
	elseif count == 0 then
		flat(out, "Dot", 1, 1, 0, 0.01, 0, WHITE)
	else
		for _, a in ipairs(arms) do
			for _, dist in ipairs({ 1.9, 5.1 }) do
				if a[1] == 0 then
					flat(out, "Mark", 0.4, 1.8, 0, 0.01, a[2] * dist, WHITE)
				else
					flat(out, "Mark", 1.8, 0.4, a[1] * dist, 0.01, 0, WHITE)
				end
			end
		end
	end
	-- đèn đường và cây vỉa hè
	local side = (index or 0) % 2 == 0 and 1 or -1
	if count == 2 and arm(0, -1) and arm(0, 1) then
		lamp(out, "StreetLamp", side * inner, 0, CURB_H, 4.6)
		tree(out, "StreetTree", -side * inner, 0, 0.55, CURB_H)
	elseif count == 2 and arm(-1, 0) and arm(1, 0) then
		lamp(out, "StreetLamp", 0, side * inner, CURB_H, 4.6)
		tree(out, "StreetTree", 0, -side * inner, 0.55, CURB_H)
	elseif count == 2 then
		-- khúc cua: đèn ở góc ngoài
		local ox, oz = 0, 0
		for _, a in ipairs(arms) do
			ox, oz = ox - a[1], oz - a[2]
		end
		lamp(out, "StreetLamp", ox * inner, oz * inner, CURB_H, 4.6)
	elseif count == 1 then
		-- đường cụt: cây trên vỉa hè đối diện nhánh
		local a = arms[1]
		tree(out, "StreetTree", -a[1] * inner, -a[2] * inner, 0.55, CURB_H)
	end
	return out
end

local function yaw(s)
	return CFrame.Angles(0, math.rad(s.rot or 0), 0)
end

-- tâm khối trong world: công trình tâm (cx, cz), mặt lô ở baseY, xoay facing độ
local function worldCenter(s, cx, cz, baseY, facing, dy)
	local turn = math.rad(facing or 0)
	local c, sn = math.cos(turn), math.sin(turn)
	local px, pz = s.pos[1], s.pos[3]
	return Vector3.new(cx + px * c + pz * sn, baseY + s.pos[2] + dy, cz - px * sn + pz * c), CFrame.Angles(0, turn, 0)
end

-- Size + CFrame cho part
function CitySpecs.place(s, cx, cz, baseY, facing)
	local sx, sy, sz = s.size[1], s.size[2], s.size[3]
	local center, turn = worldCenter(s, cx, cz, baseY, facing, sy / 2)
	if s.shape == "Cylinder" then
		return Vector3.new(sy, sx, sz), CFrame.new(center) * turn * yaw(s) * CFrame.Angles(0, 0, math.pi / 2)
	end
	return Vector3.new(sx, sy, sz), CFrame.new(center) * turn * yaw(s)
end

-- dạng lúc bắt đầu mọc lên: dẹt sát đất
function CitySpecs.seed(s, cx, cz, baseY, facing)
	local sx, sz = s.size[1], s.size[3]
	local center, turn = worldCenter(s, cx, cz, baseY, facing, 0.05)
	if s.shape == "Cylinder" then
		return Vector3.new(0.1, sx, sz), CFrame.new(center) * turn * yaw(s) * CFrame.Angles(0, 0, math.pi / 2)
	elseif s.shape == "Ball" then
		return Vector3.new(0.2, 0.2, 0.2), CFrame.new(center)
	end
	return Vector3.new(sx, 0.1, sz), CFrame.new(center) * turn * yaw(s)
end

-- list spec cho một loại công trình. Đường thì dùng CitySpecs.road
function CitySpecs.forKind(kind, index)
	local builder = BUILDERS[kind]
	if not builder then
		return {}
	end
	return builder(variant(index or 1))
end

return CitySpecs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Mood</string><ProtectedString name="Source"><![CDATA[-- Đổi trời/ánh sáng theo hạnh phúc thành phố, chỉ local ở client này.
-- >= 65 HAPPY, 50-64 NEUTRAL, < 50 CRISIS. FAILED luôn là CRISIS, PAUSED thì ngả xám thêm.

local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Mood = {}
Mood.__index = Mood

local PRESETS = {
	HAPPY = {
		lighting = { ClockTime = 14, Brightness = 3, OutdoorAmbient = Color3.fromRGB(150, 145, 135), Ambient = Color3.fromRGB(90, 88, 84) },
		atmosphere = { Density = 0.25, Haze = 0, Glare = 0.2, Color = Color3.fromRGB(205, 220, 240), Decay = Color3.fromRGB(120, 140, 170) },
		correction = { Brightness = 0.03, Contrast = 0.08, Saturation = 0.12, TintColor = Color3.fromRGB(255, 248, 236) },
	},
	NEUTRAL = {
		lighting = { ClockTime = 16.4, Brightness = 2, OutdoorAmbient = Color3.fromRGB(128, 124, 116), Ambient = Color3.fromRGB(80, 78, 74) },
		atmosphere = { Density = 0.36, Haze = 1.4, Glare = 0, Color = Color3.fromRGB(210, 200, 170), Decay = Color3.fromRGB(150, 130, 100) },
		correction = { Brightness = 0, Contrast = 0.04, Saturation = -0.05, TintColor = Color3.fromRGB(250, 244, 228) },
	},
	CRISIS = {
		lighting = { ClockTime = 17.6, Brightness = 1.1, OutdoorAmbient = Color3.fromRGB(96, 98, 106), Ambient = Color3.fromRGB(62, 64, 70) },
		atmosphere = { Density = 0.5, Haze = 3, Glare = 0, Color = Color3.fromRGB(150, 152, 160), Decay = Color3.fromRGB(90, 92, 100) },
		correction = { Brightness = -0.04, Contrast = 0.02, Saturation = -0.3, TintColor = Color3.fromRGB(214, 218, 228) },
	},
}

function Mood.new(renderer)
	local self = setmetatable({}, Mood)
	self.renderer = renderer
	self.current = nil
	self.paused = nil

	self.atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if not self.atmosphere then
		self.atmosphere = Instance.new("Atmosphere")
		self.atmosphere.Parent = Lighting
	end
	self.correction = Lighting:FindFirstChild("EconCityMood")
	if not self.correction then
		self.correction = Instance.new("ColorCorrectionEffect")
		self.correction.Name = "EconCityMood"
		self.correction.Parent = Lighting
	end
	self.pauseEffect = Lighting:FindFirstChild("EconCityPause")
	if not self.pauseEffect then
		self.pauseEffect = Instance.new("ColorCorrectionEffect")
		self.pauseEffect.Name = "EconCityPause"
		self.pauseEffect.Parent = Lighting
	end
	Lighting.GlobalShadows = true
	self.lightHaze = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	return self
end

function Mood.presetFor(happiness, status)
	if status == "FAILED" then
		return "CRISIS"
	end
	if happiness >= 65 then
		return "HAPPY"
	elseif happiness >= 50 then
		return "NEUTRAL"
	end
	return "CRISIS"
end

function Mood:apply(happiness, status, instant)
	local key = Mood.presetFor(happiness, status)
	local duration = instant and 0 or 2.5
	if key ~= self.current then
		self.current = key
		local preset = PRESETS[key]
		local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		TweenService:Create(Lighting, info, preset.lighting):Play()
		local atmosphere = preset.atmosphere
		if self.lightHaze then
			-- màn hình nhỏ: bớt sương cho đỡ che công trình
			local copy = {}
			for k, v in pairs(atmosphere) do
				copy[k] = v
			end
			atmosphere = copy
			atmosphere.Density = atmosphere.Density * 0.6
			atmosphere.Haze = atmosphere.Haze * 0.5
		end
		TweenService:Create(self.atmosphere, info, atmosphere):Play()
		TweenService:Create(self.correction, info, preset.correction):Play()
	end
	local paused = status == "PAUSED"
	if paused ~= self.paused then
		self.paused = paused
		TweenService:Create(self.pauseEffect, TweenInfo.new(instant and 0 or 0.4), { Saturation = paused and -0.35 or 0 }):Play()
	end
end

return Mood
]]></ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX00000019"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- entry phía client: dựng UI, thành phố 3D, camera, nối với server

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local root = script.Parent
local State = require(root:WaitForChild("State"))
local UIFolder = root:WaitForChild("UI")
local CityFolder = root:WaitForChild("City")

local Theme = require(UIFolder:WaitForChild("Theme"))
local C = require(UIFolder:WaitForChild("Components"))
local Hud = require(UIFolder:WaitForChild("Hud"))
local BuildPanel = require(UIFolder:WaitForChild("BuildPanel"))
local Overlays = require(UIFolder:WaitForChild("Overlays"))
local Modals = require(UIFolder:WaitForChild("Modals"))
local ClassPanel = require(UIFolder:WaitForChild("ClassPanel"))
local CityRenderer = require(CityFolder:WaitForChild("CityRenderer"))
local Mood = require(CityFolder:WaitForChild("Mood"))
local CameraController = require(CityFolder:WaitForChild("CameraController"))
local BuildController = require(CityFolder:WaitForChild("BuildController"))

local CityLayout = require(ReplicatedStorage:WaitForChild("EconCity"):WaitForChild("CityLayout"))
local Config = require(ReplicatedStorage:WaitForChild("EconCity"):WaitForChild("Config"))
local CityEngine = require(ReplicatedStorage:WaitForChild("EconCity"):WaitForChild("CityEngine"))
local Util = require(ReplicatedStorage:WaitForChild("EconCity"):WaitForChild("Util"))

-- UI mặc định này che bảng Xây dựng
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- ScreenGui ------------------------------------------------------------------------
local function makeScreenGui(name, order)
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.IgnoreGuiInset = false
	gui.DisplayOrder = order
	gui.Parent = playerGui
	return gui
end
local gui = makeScreenGui("EconCityUI", 1)
local modalGui = makeScreenGui("EconCityModals", 10)
local toastGui = makeScreenGui("EconCityToasts", 20) -- toast luôn nằm trên cùng

local camTouch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled

local scales = {}
for _, g in ipairs({ gui, modalGui, toastGui }) do
	local s = Instance.new("UIScale")
	s.Parent = g
	table.insert(scales, s)
end
-- UI dựng theo khung 1366x768 rồi scale theo màn hình.
-- điện thoại không scale dưới 0.72 (chữ không đọc nổi), thay vào đó chuyển layout compact
local layout = { compact = false, designW = 1366, designH = 768 }
local layoutListeners = {}
local function rescale()
	local size = gui.AbsoluteSize -- đã trừ topbar Roblox
	if size.X <= 0 or size.Y <= 0 then
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		size = camera.ViewportSize
	end
	local scale = math.min(size.X / 1366, size.Y / 768)
	scale = math.clamp(scale, camTouch and 0.72 or 0.6, 1.15)
	for _, s in ipairs(scales) do
		s.Scale = scale
	end
	layout.designW = size.X / scale
	layout.designH = size.Y / scale
	layout.compact = layout.designW < 1250 or layout.designH < 700
	for _, fn in ipairs(layoutListeners) do
		local ok, err = pcall(fn, layout)
		if not ok then
			warn("[EconCity] Lỗi bố cục: " .. tostring(err))
		end
	end
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)

-- Thế giới 3D -----------------------------------------------------------------------
local renderer = CityRenderer.new()
local mood = Mood.new(renderer)
local CITY_CENTER = Vector3.new(CityLayout.ORIGIN.x, 0, CityLayout.ORIGIN.z)
-- bảng Xây dựng che bên phải nên dời điểm nhìn sang phải, thành phố nằm giữa phần trống.
-- với góc camera này (1, 0, -1) trên mặt đất là bên phải màn hình
local PANEL_FOCUS_SHIFT = Vector3.new(12, 0, -12)
local PHONE_FOCUS_SHIFT = Vector3.new(-6, 0, -6)
local camera = CameraController.new(CITY_CENTER)

-- Giao diện -----------------------------------------------------------------------------
local toasts = Overlays.toasts(toastGui)

local function request(action, payload)
	local response = State.request(action, payload)
	return response
end

local function requestOrToast(action, payload)
	local response = request(action, payload)
	if not response.ok then
		toasts.show(response.error or "Không thực hiện được", "error")
	end
	return response
end

local historyModal, leaderboardModal, classModal, buildPanel, builder, approvalStamp, detail
local positionCamBox

local panelVisible = true
if camTouch and Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize.X < 1000 then
	panelVisible = false
end

local function startNewGame()
	local response = requestOrToast("newGame")
	if response.ok then
		toasts.show("Ván mới: xây nhà, chỗ làm, dịch vụ rồi bấm BẮT ĐẦU.", "good")
	end
end

local hud = Hud.new(gui, {
	onTogglePause = function()
		local s = State.session()
		local starting = s ~= nil and s.status == "PAUSED" and s.month == 0
		local response = requestOrToast("togglePause")
		if response.ok and starting then
			approvalStamp.show("Thành phố mở cửa!", string.format("Bắt đầu nhiệm kỳ %d tháng", s.maxMonths or 24))
		end
	end,
	onNewGame = startNewGame,
	onHistory = function()
		historyModal.open()
	end,
	onLeaderboard = function()
		leaderboardModal.open()
	end,
	onClass = function()
		classModal.open()
	end,
	onTickNow = function()
		requestOrToast("tickNow")
	end,
	onTogglePanel = function()
		panelVisible = not panelVisible
		buildPanel.setVisible(panelVisible)
		hud.setPanelVisible(panelVisible)
		positionCamBox()
	end,
})

buildPanel = BuildPanel.new(gui, {
	onSelectTool = function(tool)
		builder:setTool(tool)
	end,
	onInfo = function(id)
		detail.openVariant(id, State.snapshot)
	end,
	onSetTax = function(tax)
		local response = requestOrToast("setTax", { tax = tax })
		return response.ok, response.error
	end,
	onDemoBuild = function()
		local response = requestOrToast("demoBuild")
		if not response.ok then
			return
		end
		local built = response.data and response.data.built or 0
		if built > 0 then
			local s = State.session()
			local hint = (s and s.month == 0) and " Bấm BẮT ĐẦU để xem thành phố chạy." or " Vài tháng sau bấm lại để bot xây tiếp."
			toasts.show(string.format("Bot đã xây %d công trình: đường nối cổng, nhà, chỗ làm, dịch vụ.%s", built, hint), "good")
		else
			toasts.show("Bot chưa xây thêm được: không đủ tiền (bot giữ lại 2 tháng bảo trì) hoặc hết chỗ.")
		end
	end,
})
buildPanel.setVisible(panelVisible)

local cityBar = Overlays.cityBar(gui)
approvalStamp = Overlays.stamp(gui)
local events = Overlays.eventsColumn(gui)
detail = Overlays.detailPanel(gui, {
	previewModel = CityRenderer.previewModel,
	onChoose = function(id)
		if builder.tool ~= id then
			builder:setTool(id)
		end
	end,
	onDemolish = function(index)
		task.spawn(function()
			local response = requestOrToast("demolish", { index = index })
			if response.ok then
				toasts.show("Đã phá dỡ, hoàn " .. Util.formatMoneyFull(response.data and response.data.refund or 0))
			end
		end)
	end,
})
local endScreen = Overlays.endScreen(gui, {
	onNewGame = startNewGame,
	onHistory = function()
		historyModal.open()
	end,
})

local getSnapshot = function()
	return State.snapshot
end
leaderboardModal = Modals.leaderboard(modalGui, { request = request, getSnapshot = getSnapshot })
historyModal = Modals.history(modalGui, { getSnapshot = getSnapshot })
classModal = ClassPanel.new(modalGui, { request = request, getSnapshot = getSnapshot, toast = toasts.show })

-- chế độ toàn cảnh thì tắt điều khiển nhân vật: WASD không kéo nhân vật chạy ra ngoài khung hình,
-- joystick trên điện thoại cũng không che UI
local characterControls = nil
local cameraMode = "overview"
local function applyControlMode()
	if characterControls then
		pcall(function()
			if cameraMode == "overview" then
				characterControls:Disable()
			else
				characterControls:Enable()
			end
		end)
	end
end
task.spawn(function()
	local ok, controls = pcall(function()
		local scripts = player:WaitForChild("PlayerScripts", 10)
		local module = scripts and scripts:WaitForChild("PlayerModule", 10)
		return module and require(module):GetControls()
	end)
	if ok and controls then
		-- phải chờ có character, tắt sớm Roblox báo "Player:Move called..."
		if not player.Character then
			player.CharacterAdded:Wait()
		end
		characterControls = controls
		applyControlMode()
	end
end)

-- nút camera
local camBox = C.new("Frame", {
	Name = "CameraControls",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(104, 150),
	Position = UDim2.new(1, -12, 1, -12),
	AnchorPoint = Vector2.new(1, 1),
	Parent = gui,
})
C.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom).Parent = camBox
local zoomIn = C.button({ Name = "ZoomIn", Text = "+", Font = Theme.FontDisplay, TextSize = 22, Variant = "white", Size = UDim2.fromOffset(42, 42), Radius = 21, LayoutOrder = 1, Parent = camBox }, function()
	camera:zoomBy(-2)
end)
local zoomOut = C.button({ Name = "ZoomOut", Text = "−", Font = Theme.FontDisplay, TextSize = 22, Variant = "white", Size = UDim2.fromOffset(42, 42), Radius = 21, LayoutOrder = 2, Parent = camBox }, function()
	camera:zoomBy(2)
end)
local walkButton
walkButton = C.button({ Name = "Walk", Text = "Đi dạo", TextSize = 12, Variant = "white", Size = UDim2.fromOffset(104, 40), Radius = 20, LayoutOrder = 3, Parent = camBox }, function()
	local mode = camera:toggleMode()
	cameraMode = mode
	applyControlMode()
	walkButton.Text = mode == "overview" and "Đi dạo" or "Toàn cảnh"
	zoomIn.Visible = mode == "overview"
	zoomOut.Visible = mode == "overview"
	toasts.show(mode == "overview" and "Chế độ toàn cảnh" or "Chế độ đi dạo: dùng WASD hoặc cần điều khiển để đi. Muốn xây thì chọn mẫu rồi bấm vào ô.")
end)

-- không cho nút camera đè bảng Xây dựng, thanh chỉ số, joystick, nút nhảy
positionCamBox = function()
	local panelHeight = math.min(BuildPanel.FULL_HEIGHT, layout.designH - (BuildPanel.TOP + 12))
	local roomBelowPanel = layout.designH >= BuildPanel.TOP + panelHeight + 12 + 150 + 12
	local besidePanel = panelVisible and not roomBelowPanel
	if camTouch then
		-- điện thoại: giữa cạnh phải, góc dưới phải là nút nhảy lúc đi dạo
		camBox.AnchorPoint = Vector2.new(1, 0.5)
		camBox.Position = UDim2.new(1, panelVisible and -(BuildPanel.WIDTH + 24) or -12, 0.62, 0)
	else
		camBox.AnchorPoint = Vector2.new(1, 1)
		camBox.Position = UDim2.new(1, besidePanel and -(BuildPanel.WIDTH + 24) or -12, 1, -12)
	end
	if camTouch then
		-- dời điểm nhìn ra xa cho sa bàn nằm dưới khung tên và hàng nút
		camera:setFocus(CITY_CENTER + PHONE_FOCUS_SHIFT)
	else
		camera:setFocus(panelVisible and CITY_CENTER + PANEL_FOCUS_SHIFT or CITY_CENTER)
	end
end

if camTouch then
	local top = { UDim2.new(0.5, 0, 0, 96), Vector2.new(0.5, 0) }
	detail.positions.placed = top
	detail.positions.catalog = top
else
	-- thẻ mẫu (nút "i") sát trái bảng Xây dựng, ngang đầu bảng
	detail.positions.catalog = { UDim2.new(1, -(BuildPanel.WIDTH + 24), 0, BuildPanel.TOP), Vector2.new(1, 0) }
end

table.insert(layoutListeners, function(l)
	-- màn hẹp: chữ tối thiểu 13 (khoảng 9px ở UIScale 0.72), layout gọn lại cho sa bàn rộng hơn
	C.setTextFloor(l.compact and 13 or 0)
	hud.setCompact(l.compact)
	cityBar.setCompact(l.compact)
	events.setCompact(l.compact)
	buildPanel.setMaxHeight(l.designH - (BuildPanel.TOP + 12))
	C.fitModals(l.designW, l.designH)
	positionCamBox()
end)
rescale()

-- chat mặc định ở góc trên trái, đè bảng chỉ số. game học tập nên ẩn luôn (Roblox cũng bắt kiểm tra tuổi mới cho chat)
-- muốn bật lại: Config.SHOW_CHAT_WINDOW = true
if not Config.SHOW_CHAT_WINDOW then
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)
	end)
	pcall(function()
		local TextChatService = game:GetService("TextChatService")
		local window = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
		if window then
			window.Enabled = false
		end
		local inputBar = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")
		if inputBar then
			inputBar.Enabled = false
		end
	end)
end

-- Cập nhật theo trạng thái -------------------------------------------------------------
local firstRender = true
local lastSessionId = nil
local readySent = false

-- server chỉ bắt đầu tính lượt sau clientReady, máy yếu tải chậm không bị mất lượt
local function sendClientReady()
	for _ = 1, 10 do
		local response = request("clientReady")
		if response.ok then
			return
		end
		task.wait(1)
	end
end

State.subscribe(function(snap, previous)
	local s = snap.session
	if not s then
		return
	end
	hud.update(snap)
	local d = CityEngine.compute(s, s.population or 0)
	hud.setNet(d.net, d.C, d.J)
	buildPanel.update(snap)
	cityBar.update(snap)
	events.update(snap)
	detail.update(snap)
	endScreen.update(snap)
	historyModal.refreshIfOpen(snap.reason)

	local sameSession = lastSessionId == s.id
	local animate = not firstRender and sameSession
	if not sameSession and builder then
		builder:setTool(nil) -- ván mới thì bỏ tool đang chọn
	end
	renderer:update(s, animate)
	mood:apply(s.happiness, s.status, firstRender)
	lastSessionId = s.id
	firstRender = false
	if not readySent then
		readySent = true
		task.spawn(sendClientReady)
	end

	-- toast các khủng hoảng mới xuất hiện ở tháng này
	if previous and previous.session and sameSession and snap.reason == "tick" then
		local before = {}
		for _, key in ipairs(previous.session.crises or {}) do
			before[key] = true
		end
		for _, key in ipairs(s.crises or {}) do
			if not before[key] then
				toasts.show(Config.CRISIS_LABELS[key] or key, "error")
			end
		end
	end
end)

State.stateEvent.OnClientEvent:Connect(State.set)
State.noticeEvent.OnClientEvent:Connect(function(text)
	toasts.show(tostring(text))
end)

-- tự lấy state lần đầu, phòng khi gói "init" tới trước lúc script chạy xong
task.spawn(function()
	-- server có thể phải chờ server cũ nhả lock hồ sơ (tới khoảng 20s), nên chờ đủ lâu rồi mới báo lỗi
	for _ = 1, 45 do
		if State.snapshot then
			return
		end
		local response = request("getState")
		if response.ok and response.data and response.data.session then
			State.set(response.data)
			return
		end
		task.wait(1)
	end
	if not State.snapshot then
		toasts.show("Không kết nối được máy chủ trò chơi. Hãy thử vào lại.", "error")
	end
end)

-- Đồng hồ đếm ngược ---------------------------------------------------------------------
local accumulator = 0
RunService.Heartbeat:Connect(function(dt)
	local snap = State.snapshot
	accumulator = accumulator + dt
	if accumulator >= 0.2 then
		accumulator = 0
		hud.updateCountdown(snap, State.serverNow())
	end
end)

-- Xây dựng trên bản đồ ----------------------------------------------------------------------
-- có UI của game dưới con trỏ thì chặn click xuyên xuống thành phố
local function pointerOverUi(position)
	local ok, objects = pcall(function()
		return playerGui:GetGuiObjectsAtPosition(position.X, position.Y)
	end)
	if not ok then
		return false
	end
	for _, object in ipairs(objects) do
		local ours = object:IsDescendantOf(gui) or object:IsDescendantOf(modalGui) or object:IsDescendantOf(toastGui)
		-- đồ trang trí (pháo giấy, viền phá sản...) không chặn click
		local decor = object:GetAttribute("Decor") == true
		if ours and not decor and object.Visible and (object:IsA("GuiButton") or object.BackgroundTransparency < 0.95) then
			return true
		end
	end
	return false
end

builder = BuildController.new({
	renderer = renderer,
	getSession = State.session,
	isOverview = function()
		return cameraMode == "overview"
	end,
	request = request,
	toast = toasts.show,
	inspect = function(index)
		detail.open(index, State.snapshot)
	end,
	pointerOverUi = pointerOverUi,
	onToolChanged = function(tool)
		buildPanel.setTool(tool)
	end,
	isGamepad = C.isGamepadMode,
})

print("[EconCity] Client sẵn sàng: " .. Theme.StatusText.ACTIVE)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- snapshot state phía client, và hàm gọi server

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage:WaitForChild("EconCity"):WaitForChild("Net"))

local State = {}
State.snapshot = nil
State.previous = nil

local listeners = {}
local remotes = ReplicatedStorage:WaitForChild(Net.FOLDER)
local requestFunction = remotes:WaitForChild(Net.REQUEST)
State.stateEvent = remotes:WaitForChild(Net.STATE_EVENT)
State.noticeEvent = remotes:WaitForChild(Net.NOTICE_EVENT)

function State.subscribe(fn)
	table.insert(listeners, fn)
	if State.snapshot then
		task.spawn(fn, State.snapshot, nil)
	end
	return function()
		for i, f in ipairs(listeners) do
			if f == fn then
				table.remove(listeners, i)
				break
			end
		end
	end
end

function State.set(snapshot)
	if type(snapshot) ~= "table" then
		return
	end
	State.previous = State.snapshot
	State.snapshot = snapshot
	for _, fn in ipairs(listeners) do
		local ok, err = pcall(fn, snapshot, State.previous)
		if not ok then
			warn("[EconCity] Lỗi cập nhật giao diện: " .. tostring(err))
		end
	end
end

function State.session()
	return State.snapshot and State.snapshot.session
end

function State.serverNow()
	return Workspace:GetServerTimeNow()
end

-- trả về { ok, data, error }
-- timeout mặc định 30s, không thì nút bấm treo mãi khi server chậm
function State.request(action, payload, timeout)
	timeout = timeout or 30
	local done, result = false, nil
	task.spawn(function()
		local ok, response = pcall(function()
			return requestFunction:InvokeServer(action, payload)
		end)
		if not ok then
			result = { ok = false, error = "Mất kết nối tới máy chủ" }
		elseif type(response) ~= "table" then
			result = { ok = false, error = "Máy chủ không phản hồi" }
		else
			result = response
		end
		done = true
	end)
	local waited = 0
	while not done and waited < timeout do
		task.wait(0.1)
		waited = waited + 0.1
	end
	if not done then
		return { ok = false, error = "Máy chủ phản hồi quá lâu, hãy thử lại" }
	end
	return result
end

return State
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000023"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">BuildPanel</string><ProtectedString name="Source"><![CDATA[-- bảng Xây dựng bên phải: chọn loại đất/mẫu, thuế, bảng tính hạnh phúc (docs/luat-choi-moi.md mục 4)
-- số dự kiến tính luôn ở client bằng CityEngine, số thật vẫn do server tính mỗi tháng

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("EconCity")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local CityEngine = require(Shared:WaitForChild("CityEngine"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local C = require(script.Parent:WaitForChild("Components"))
local Icons = require(script.Parent:WaitForChild("Icons"))
local Colors = Theme.Colors

local BuildPanel = {}

local WIDTH = 340
local FULL_HEIGHT = 580
local TOP = 80 -- cách mép trên, chừa chỗ cho thanh điều khiển
local HEADER = 56
local CHIP_H = 36
local ROW_H = 54
local TAX_SEND_DELAY = 0.5 -- giây, ngừng kéo slider lâu vậy mới gửi thuế

-- số thập phân dùng dấu phẩy
local function fmt(x, decimals)
	return (string.format("%." .. decimals .. "f", x):gsub("%.", ","))
end

local function soft(c)
	return c:Lerp(Color3.new(1, 1, 1), 0.86)
end

-- số liệu chính, hiện cuối dòng mẫu
local function keyStat(def)
	if def.cap then
		return string.format("%d chỗ ở", def.cap)
	elseif def.rev then
		return string.format("%d việc × %s", def.jobs, Util.formatMoneyFull(def.rev))
	elseif def.pts then
		return string.format("+%d dịch vụ", def.pts)
	end
	return "kéo từ CỔNG"
end

-- công trình 2x2 thì chia thành 4 ô nhỏ
local function swatch(parent, id, size)
	local def = Config.BUILDINGS[id]
	local frame = C.new("Frame", {
		Name = "Swatch",
		BackgroundColor3 = def and Theme.land(id) or Colors.panel,
		BorderSizePixel = 0,
		Size = size,
		Position = UDim2.new(0, 9, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = parent,
	})
	C.corner(10).Parent = frame
	if not def then
		C.stroke(Colors.strokeStrong, 1.5).Parent = frame -- phá dỡ: ô trắng viền
	elseif def.size > 1 then
		C.new("Frame", { Name = "Split", BackgroundColor3 = Colors.panel, BorderSizePixel = 0, Size = UDim2.new(0, 2, 1, 0), Position = UDim2.new(0.5, -1, 0, 0), Parent = frame })
		C.new("Frame", { Name = "Split", BackgroundColor3 = Colors.panel, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 0.5, -1), Parent = frame })
	end
	C.label({ Name = "Code", Text = def and def.code or "PD", Font = Theme.FontDisplay, TextSize = 13, Color = def and Theme.landInk(id) or Colors.text, XAlign = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = frame })
	return frame
end

local function sectionHeader(parent, title, order)
	local head = C.new("Frame", { Name = "Head", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = order or 0, Parent = parent })
	C.label({ Name = "Heading", Text = title, Font = Theme.FontDisplay, TextSize = 15, Size = UDim2.new(0.62, 0, 1, 0), Parent = head })
	return head
end

-- ctx: { onSelectTool(tool), onInfo(id), onSetTax(tax) -> (ok, errorText), onDemoBuild() }
-- callback chạy trong thread riêng, yield được
function BuildPanel.new(gui, ctx)
	local obj = { tool = nil, category = "house" }
	local finished = false

	local panel = C.panel({
		Name = "BuildPanel",
		Size = UDim2.fromOffset(WIDTH, FULL_HEIGHT),
		Position = UDim2.new(1, -12, 0, TOP),
		AnchorPoint = Vector2.new(1, 0),
		Radius = Theme.Radius.xl,
		Parent = gui,
	})
	obj.frame = panel

	-- header: tiêu đề + pill tool đang chọn
	local header = C.new("Frame", { Name = "Header", BackgroundTransparency = 1, Size = UDim2.new(1, -32, 0, 34), Position = UDim2.fromOffset(16, 12), Parent = panel })
	Icons.badge("grid", { Size = 30, IconSize = 15, Color = Colors.accent, Soft = Colors.accentSoft, Square = true, Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = header })
	C.label({ Name = "PanelTitle", Text = "Xây dựng", Font = Theme.FontDisplay, TextSize = 18, Size = UDim2.new(0, 120, 1, 0), Position = UDim2.fromOffset(40, 0), Parent = header })
	local toolLabel = C.pill({ Name = "ToolLabel", Text = "", TextSize = 11, Color = Colors.accentSoft, TextColor = Colors.accent, Height = 24, Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = header })
	toolLabel.Visible = false

	local content = C.new("ScrollingFrame", {
		Name = "Content",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -16, 0, FULL_HEIGHT - HEADER - 10),
		Position = UDim2.fromOffset(16, HEADER),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Colors.strokeStrong,
		Parent = panel,
	})
	C.selectable(content)
	C.list(Enum.FillDirection.Vertical, 10).Parent = content
	C.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = content })
	local inner = UDim2.new(1, 0, 0, 0)

	-- chỉ hiện trong Studio: bot xây thành phố mẫu theo đúng luật, để xem game chạy ra sao
	local demoButton = C.button({
		Name = "DemoBuild",
		Text = "Bot xây mẫu (Studio)",
		Variant = "violet",
		TextSize = 12,
		Size = UDim2.new(1, 0, 0, 36),
		PadLeft = 24,
		LayoutOrder = 0,
		Parent = content,
	}, function()
		if not finished then
			ctx.onDemoBuild()
		end
	end)
	Icons.draw("bot", { Size = 16, Color = Colors.onAccent, Position = UDim2.new(0, -12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = demoButton })
	demoButton.Visible = false

	-- Loại đất + mẫu của loại đang mở ----------------------------------------
	local renderTools
	local chips = C.new("Frame", { Name = "Categories", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, CHIP_H + 4), LayoutOrder = 1, Parent = content })
	local chipGrid = Instance.new("UIGridLayout")
	local count = #Config.CATEGORY_ORDER + 1
	chipGrid.CellSize = UDim2.new(1 / count, -4, 0, CHIP_H)
	chipGrid.CellPadding = UDim2.fromOffset(4, 0)
	chipGrid.SortOrder = Enum.SortOrder.LayoutOrder
	chipGrid.VerticalAlignment = Enum.VerticalAlignment.Center
	chipGrid.Parent = chips
	local chipButtons = {}
	local function onChip(cat)
		if finished then
			return
		end
		if cat == "demolish" then
			ctx.onSelectTool("demolish")
			return
		end
		local current = obj.tool and Config.BUILDINGS[obj.tool]
		obj.category = cat
		-- bấm lại loại đang chọn thì bỏ chọn, loại khác thì mở ra và chọn sẵn mẫu chuẩn
		ctx.onSelectTool((current and current.kind == cat) and obj.tool or cat)
		renderTools(obj.session)
	end
	for order, cat in ipairs(Config.CATEGORY_ORDER) do
		local info = Config.CATEGORIES[cat]
		local chip = C.button({ Name = "Cat_" .. cat, Text = info.code, Font = Theme.FontDisplay, TextSize = 13, Color = Theme.land(cat), TextColor = Theme.landInk(cat), Size = UDim2.fromOffset(32, CHIP_H), Radius = 10, LayoutOrder = order, Parent = chips }, function()
			onChip(cat)
		end)
		C.stroke(Colors.text, 2.5, 1).Parent = chip
		chipButtons[cat] = chip
	end
	chipButtons.demolish = C.button({ Name = "Tool_demolish", Text = "PD", Font = Theme.FontDisplay, TextSize = 13, Variant = "white", Size = UDim2.fromOffset(32, CHIP_H), Radius = 10, LayoutOrder = count, Parent = chips }, function()
		onChip("demolish")
	end)
	local zoneLabel = C.label({ Name = "Zone", Text = "", Font = Theme.FontBold, TextSize = 12, Color = Colors.textDim, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 2, Parent = content })

	local variants = C.new("Frame", { Name = "Variants", BackgroundTransparency = 1, Size = inner, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = content })
	C.list(Enum.FillDirection.Vertical, 6).Parent = variants
	local rows = {}
	local order = 0
	for _, cat in ipairs(Config.CATEGORY_ORDER) do
		for _, id in ipairs(Config.VARIANTS[cat]) do
			order = order + 1
			local def = Config.BUILDINGS[id]
			local row = C.button({ Name = "Tool_" .. id, Text = "", Variant = "white", Lip = false, Size = UDim2.new(1, 0, 0, ROW_H), Radius = 14, LayoutOrder = order, Parent = variants }, function()
				if not finished then
					ctx.onSelectTool(id)
				end
			end)
			swatch(row, id, UDim2.fromOffset(38, 38))
			C.label({ Name = "Title", Text = def.label .. (def.size > 1 and string.format(" %dx%d", def.size, def.size) or ""), Font = Theme.FontBold, TextSize = 14, Truncate = true, Size = UDim2.new(1, -100, 0, 18), Position = UDim2.fromOffset(56, 8), Parent = row })
			C.label({ Name = "Price", Text = "", Font = Theme.FontBold, TextSize = 12, Color = Colors.textDim, Size = UDim2.new(0.4, -24, 0, 16), Position = UDim2.fromOffset(56, 28), Parent = row })
			C.label({ Name = "Stat", Text = keyStat(def), Font = Theme.FontMedium, TextSize = 12, Color = Colors.textDim, XAlign = Enum.TextXAlignment.Right, Truncate = true, Size = UDim2.new(0.6, -50, 0, 16), Position = UDim2.new(0.4, 6, 0, 28), Parent = row })
			-- nút "i" mở thẻ thông tin mẫu, ván kết thúc rồi vẫn xem được
			C.button({ Name = "Info_" .. id, Text = "i", Font = Theme.FontDisplay, TextSize = 14, Variant = "secondary", Lip = false, Size = UDim2.fromOffset(28, 28), Radius = 14, Position = UDim2.new(1, -36, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = row }, function()
				ctx.onInfo(id)
			end)
			rows[id] = row
		end
	end
	-- chú thích gạch sọc = lô chưa nối đường
	local hatchRow = C.new("Frame", { Name = "HatchLegend", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 4, Parent = content })
	local hatchSwatch = C.new("Frame", { BackgroundColor3 = Theme.land("house"), BorderSizePixel = 0, ClipsDescendants = true, Size = UDim2.fromOffset(32, 24), Position = UDim2.new(0, 2, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = hatchRow })
	C.corner(8).Parent = hatchSwatch
	for k = 0, 3 do
		C.new("Frame", { BackgroundColor3 = Colors.text, BackgroundTransparency = 0.55, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 2), Position = UDim2.fromOffset(0, 4 + k * 5), Parent = hatchSwatch })
	end
	C.label({ Text = "Gạch sọc + dấu ! đỏ: chưa nối đường về CỔNG", TextSize = 12, Color = Colors.textDim, Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(42, 0), Parent = hatchRow })
	C.label({
		Text = "Chọn loại đất và mẫu rồi bấm vào ô (mẫu 2x2 thì ô bấm là góc trên bên trái). Bấm i để xem số liệu. Đường: giữ chuột và kéo từ CỔNG.",
		TextSize = 12,
		Color = Colors.textMuted,
		Wrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = inner,
		LayoutOrder = 5,
		Parent = content,
	})

	-- Thuế, slider 0-50% ----------------------------------------------------------
	local taxCard = C.well({ Name = "TaxCard", Size = inner, AutomaticSize = Enum.AutomaticSize.Y, Radius = 16, LayoutOrder = 7, Parent = content })
	C.padding(12, 14).Parent = taxCard
	C.list(Enum.FillDirection.Vertical, 6).Parent = taxCard
	local taxBlock = C.new("Frame", { Name = "Tax", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 92), LayoutOrder = 1, Parent = taxCard })
	C.label({ Text = "Thuế", Font = Theme.FontDisplay, TextSize = 15, Size = UDim2.new(0.6, 0, 0, 26), Parent = taxBlock })
	local taxValue = C.pill({ Name = "TaxValue", Text = "", Font = Theme.FontDisplay, TextSize = 15, Color = Colors.panel, TextColor = Colors.accent, Height = 26, Position = UDim2.new(1, 0, 0, 0), AnchorPoint = Vector2.new(1, 0), Parent = taxBlock })
	local pendingTax = nil
	local taxToken = 0
	local slider = C.slider({
		min = 0,
		max = Config.TAX_MAX,
		step = 1,
		ticks = 5,
		labelEvery = 10,
		value = Config.START_TAX,
		onChanged = function(v)
			taxValue.Text = string.format("%d%%", v)
			pendingTax = v
			taxToken = taxToken + 1
			local myToken = taxToken
			task.delay(TAX_SEND_DELAY, function()
				if myToken ~= taxToken then
					return -- vẫn đang kéo
				end
				local ok, err = ctx.onSetTax(v)
				if myToken == taxToken then
					pendingTax = nil
				end
				if not ok and err then
					taxValue.Text = err
				end
			end)
		end,
	})
	slider.frame.Position = UDim2.fromOffset(0, 32)
	slider.frame.Parent = taxBlock
	C.label({ Text = "Thấp: dân vui hơn", Font = Theme.FontMedium, TextSize = 11, Color = Colors.good, Size = UDim2.new(0.5, 0, 0, 14), Position = UDim2.fromOffset(0, 76), Parent = taxBlock })
	C.label({ Text = "Cao: dân bỏ đi", Font = Theme.FontMedium, TextSize = 11, Color = Colors.bad, XAlign = Enum.TextXAlignment.Right, Size = UDim2.new(0.5, 0, 0, 14), Position = UDim2.new(0.5, 0, 0, 76), Parent = taxBlock })

	local money = C.label({ Name = "Money", Text = "", Font = Theme.FontMedium, TextSize = 12, Color = Colors.textDim, Wrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 2, Parent = taxCard })

	-- Bảng tính hạnh phúc ---------------------------------------------------------------------
	local why = C.well({ Name = "Why", Size = inner, AutomaticSize = Enum.AutomaticSize.Y, Radius = 16, LayoutOrder = 10, Parent = content })
	C.padding(12, 14).Parent = why
	C.list(Enum.FillDirection.Vertical, 0).Parent = why
	local head = sectionHeader(why, "Bảng tính hạnh phúc", 0)
	head:FindFirstChild("Heading").Name = "WhyTitle"
	local whyValue = C.pill({ Name = "WhyValue", Text = "", Font = Theme.FontDisplay, TextSize = 15, Color = Colors.panel, TextColor = Colors.good, Height = 26, Position = UDim2.new(1, 0, 0, 0), AnchorPoint = Vector2.new(1, 0), Parent = head })
	C.new("Frame", { Name = "Gap", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 6), LayoutOrder = 1, Parent = why })
	local whyRows = {}
	for i = 1, 5 do
		local total = i == 5
		local row = C.new("Frame", { Name = "Row" .. i, BackgroundColor3 = Colors.panel, BackgroundTransparency = total and 0 or 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, total and 30 or 24), LayoutOrder = i * 2, Parent = why })
		if total then
			C.corner(10).Parent = row
			C.new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = row })
		end
		whyRows[i] = {
			frame = row,
			name = C.label({ Text = "", TextSize = 12, Font = total and Theme.FontBold or Theme.FontMedium, Size = UDim2.new(0, 72, 1, 0), Parent = row }),
			formula = C.label({ Text = "", TextSize = 11, Font = Theme.FontMedium, Color = Colors.textMuted, Truncate = true, Size = UDim2.new(1, -124, 1, 0), Position = UDim2.fromOffset(72, 0), Parent = row }),
			value = C.label({ Text = "", TextSize = 12, Font = Theme.FontBold, XAlign = Enum.TextXAlignment.Right, Size = UDim2.new(0, 50, 1, 0), Position = UDim2.new(1, -50, 0, 0), Parent = row }),
			line = C.new("Frame", { Name = "Rule", BackgroundColor3 = Colors.stroke, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), LayoutOrder = i * 2 + 1, Visible = i < 4, Parent = why }),
		}
	end
	local capNote = C.label({ Text = "", TextSize = 11, Color = Colors.textMuted, Wrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 20, Parent = why })
	C.new("UIPadding", { PaddingTop = UDim.new(0, 6), Parent = capNote })

	local function setRow(i, name, formula, value)
		local r = whyRows[i]
		r.frame.Visible = name ~= nil
		r.line.Visible = name ~= nil and i < 4
		r.name.Text = name or ""
		r.formula.Text = formula or ""
		r.value.Text = value or ""
	end

	renderTools = function(session)
		for id, row in pairs(rows) do
			local def = Config.BUILDINGS[id]
			row.Visible = def.kind == obj.category
			local price = session and CityEngine.priceOf(session, id) or def.price
			local short = session ~= nil and session.budget < price
			-- thiếu tiền: hiện số còn thiếu, làm nhạt tên, ô màu đất giữ nguyên
			local priceLabel = row:FindFirstChild("Price")
			priceLabel.Text = short and ("thiếu " .. Util.formatMoneyFull(price - session.budget)) or Util.formatMoneyFull(price)
			priceLabel.TextColor3 = short and Colors.bad or Colors.warn
			row:FindFirstChild("Title").TextColor3 = short and Colors.textMuted or Colors.text
			local selected = obj.tool == id
			C.setButtonColor(row, selected and Colors.accentSoft or Colors.panel)
			local stroke = row:FindFirstChildOfClass("UIStroke")
			stroke.Color = selected and Colors.accent or Colors.stroke
			stroke.Thickness = selected and 2 or 1.5
			C.setEnabled(row, not finished)
		end
		for cat, chip in pairs(chipButtons) do
			-- ô đang mở (hoặc PD khi đang phá dỡ) có viền đậm
			local on = (obj.tool == "demolish") == (cat == "demolish") and (cat == "demolish" or cat == obj.category)
			local stroke = chip:FindFirstChildOfClass("UIStroke")
			stroke.Color = on and Colors.text or (cat == "demolish" and Colors.stroke or Colors.text)
			stroke.Thickness = on and 2.5 or 1.5
			stroke.Transparency = (on or cat == "demolish") and 0 or 1
			C.setEnabled(chip, not finished)
		end
		local info = Config.CATEGORIES[obj.category]
		zoneLabel.Text = string.format("%s - %s, %d mẫu", info.code, info.zone, #Config.VARIANTS[obj.category])
		local def = obj.tool and Config.BUILDINGS[obj.tool]
		if obj.tool == "demolish" then
			toolLabel.Text = "Đang chọn: Phá dỡ"
			toolLabel.BackgroundColor3 = soft(Colors.danger)
			toolLabel.TextColor3 = Colors.bad
		elseif def then
			toolLabel.Text = "Đang chọn: " .. def.label
			toolLabel.BackgroundColor3 = Colors.accentSoft
			toolLabel.TextColor3 = Colors.accent
		else
			toolLabel.Text = ""
		end
		toolLabel.Visible = toolLabel.Text ~= ""
	end

	function obj.setTool(tool)
		obj.tool = tool
		local def = tool and Config.BUILDINGS[tool]
		if def then
			obj.category = def.kind
		end
		renderTools(obj.session)
	end

	function obj.update(snap)
		local s = snap.session
		if not s or type(s.cells) ~= "table" then
			return
		end
		obj.session = s
		finished = s.status == "ENDED" or s.status == "FAILED"
		demoButton.Visible = snap.isStudio == true
		C.setEnabled(demoButton, not finished)
		renderTools(s)
		slider.setEnabled(not finished)
		if not pendingTax then
			slider.set(s.tax, true)
			taxValue.Text = string.format("%d%%", s.tax)
		end
		local t = slider.get()
		slider.setColor(t <= 20 and Colors.success or (t <= 35 and Colors.amber or Colors.danger))

		local d = CityEngine.compute(s, s.population)
		-- số ròng đã có ở thẻ thành phố, ở đây tách thu thuế và bảo trì ra để thấy thuế tác động ra sao
		money.Text = string.format("Mỗi tháng: thu thuế %s, bảo trì %s", Util.formatMoneyFull(d.taxIn), Util.formatMoneyFull(d.M))

		local F = Config.FORMULA
		local A = CityEngine.attraction(s.happiness)
		local target = CityEngine.targetPop(d.C, d.J, s.happiness)
		whyValue.Text = tostring(Util.round(d.H))
		whyValue.TextColor3 = Theme.happinessColor(d.H)
		setRow(1, "Việc làm", string.format("%s × %d", fmt(F.happinessEmploymentWeight, 2), Util.round(d.E)), fmt(d.parts.E, 1))
		setRow(2, "Thuế", string.format("%s × (100 - 2×%d)", fmt(F.happinessTaxWeight, 2), s.tax), fmt(d.parts.T, 1))
		setRow(3, "Dịch vụ", string.format("%s × %d", fmt(F.happinessServiceWeight, 2), Util.round(d.S)), fmt(d.parts.S, 1))
		if d.parts.event ~= 0 then
			setRow(4, "Sự kiện", "", fmt(d.parts.event, 0))
		else
			setRow(4, nil)
		end
		setRow(5, "Muốn đến", string.format("%s × %s việc", fmt(A, 2), Util.formatInt(d.J)), Util.formatInt(target))
		-- bị chặn bởi số chỗ ở thì ghi rõ, không thì phép nhân ở trên nhìn như tính sai
		if target < math.floor(d.J * A) then
			capNote.Text = string.format("Không quá số chỗ ở (%s). Tính theo hạnh phúc tháng trước: %d.", Util.formatInt(d.C), Util.round(s.happiness))
		else
			capNote.Text = string.format("Tính theo hạnh phúc tháng trước (%d), dưới 50 thì không ai đến.", Util.round(s.happiness))
		end
	end

	function obj.setVisible(visible)
		panel.Visible = visible
		if visible then
			C.popIn(panel, 0.96, 0.18)
		end
	end

	-- maxHeight theo đơn vị thiết kế, màn thấp thì nội dung cuộn
	function obj.setMaxHeight(maxHeight)
		local h = math.max(260, math.min(FULL_HEIGHT, maxHeight))
		panel.Size = UDim2.fromOffset(WIDTH, h)
		content.Size = UDim2.new(1, -16, 0, h - HEADER - 10)
	end

	renderTools(nil)
	return obj
end

BuildPanel.WIDTH = WIDTH
BuildPanel.FULL_HEIGHT = FULL_HEIGHT
BuildPanel.TOP = TOP
return BuildPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">ClassPanel</string><ProtectedString name="Source"><![CDATA[-- bảng Lớp học. học sinh vào lớp bằng mã mời, giáo viên quản lý lớp/kịch bản/CSV/phòng riêng,
-- chủ game có thêm trang Quản trị

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("EconCity")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Scenarios = require(Shared:WaitForChild("Scenarios"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local C = require(script.Parent:WaitForChild("Components"))
local Icons = require(script.Parent:WaitForChild("Icons"))
local Colors = Theme.Colors

local ClassPanel = {}

local Z = 53

local function sectionTitle(parent, order, text)
	return C.label({ Text = text, Font = Theme.FontDisplay, TextSize = 15, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = order, ZIndex = Z, Parent = parent })
end

local function note(parent, order, text, color)
	return C.label({
		Text = text,
		TextSize = 12,
		Color = color or Colors.textDim,
		Wrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = order,
		ZIndex = Z,
		Parent = parent,
	})
end

local function card(parent, order)
	local frame = C.well({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Radius = Theme.Radius.lg, LayoutOrder = order, ZIndex = Z, Parent = parent })
	C.padding(12, 14).Parent = frame
	C.list(Enum.FillDirection.Vertical, 6).Parent = frame
	return frame
end

local function listFrame(parent, order, spacing)
	local frame = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, ZIndex = Z, Parent = parent })
	C.list(Enum.FillDirection.Vertical, spacing or 6).Parent = frame
	return frame
end

-- primary: nền xanh chữ trắng, không thì nút trắng viền mảnh
local function btn(parent, order, text, width, onClick, primary)
	return C.button({
		Text = text,
		Size = UDim2.fromOffset(width, 34),
		ZIndex = Z,
		LayoutOrder = order,
		Variant = primary and "primary" or "white",
		Parent = parent,
	}, onClick)
end

local function formatEffect(field, value)
	if field.kind == "percent" then
		return string.format("%s%%", tostring(Util.roundTo(value * 100, 1)))
	elseif field.kind == "multiplier" then
		return string.format("×%.2f", value)
	end
	return tostring(value)
end

-- stepper -/+ bước tuỳ ý, cho form kịch bản tuỳ chỉnh
local function numberStepper(parent, order, label, opts)
	local row = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = order, ZIndex = Z, Parent = parent })
	C.label({ Text = label, TextSize = 12, Size = UDim2.new(1, -170, 1, 0), ZIndex = Z, Parent = row })
	local value = opts.value
	local valueLabel
	local function set(v)
		v = math.clamp(v, opts.min, opts.max)
		v = math.floor(v / opts.step + 0.5) * opts.step
		v = Util.roundTo(v, 4)
		value = v
		valueLabel.Text = opts.format(v)
		valueLabel.TextColor3 = (v ~= opts.default) and Colors.warn or Colors.text
		if opts.onChanged then
			opts.onChanged(v)
		end
	end
	C.button({ Text = "−", Size = UDim2.fromOffset(30, 30), Radius = 15, Lip = false, Position = UDim2.new(1, -166, 0, 0), ZIndex = Z, Parent = row }, function()
		set(value - opts.step)
	end)
	valueLabel = C.label({ Text = "", Font = Theme.FontBold, TextSize = 13, XAlign = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(96, 30), Position = UDim2.new(1, -134, 0, 0), ZIndex = Z, Parent = row })
	C.button({ Text = "+", Size = UDim2.fromOffset(30, 30), Radius = 15, Lip = false, Position = UDim2.new(1, -34, 0, 0), ZIndex = Z, Parent = row }, function()
		set(value + opts.step)
	end)
	set(value)
	return function()
		return value
	end
end

local function multilineBox(parent, order, text)
	local box = C.new("TextBox", {
		Name = "CsvBox",
		BackgroundColor3 = Colors.panelAlt,
		BorderSizePixel = 0,
		Text = text,
		TextColor3 = Colors.text,
		Font = Theme.FontNumber,
		TextSize = 12,
		ClearTextOnFocus = false,
		MultiLine = true,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 40),
		LayoutOrder = order,
		ZIndex = Z,
		Parent = parent,
	})
	C.corner(10).Parent = box
	C.stroke(Colors.stroke, 1.5).Parent = box
	C.padding(8, 10).Parent = box
	return box
end

-- ctx: { request(action, payload), getSnapshot(), toast(text, kind) }
function ClassPanel.new(gui, ctx)
	local modal
	local view = { mode = "home", code = nil, scenarioIndex = 1, lastResult = nil, studentId = nil, scenarioList = nil }
	local busy = false

	local render

	local function go(mode, extra)
		view.mode = mode
		for k, v in pairs(extra or {}) do
			view[k] = v
		end
		render()
	end

	local function run(action, payload, okMessage)
		if busy then
			return nil
		end
		busy = true
		local response = ctx.request(action, payload)
		busy = false
		if response.ok then
			if okMessage then
				ctx.toast(okMessage, "good")
			end
			return response
		end
		ctx.toast(response.error or "Không thực hiện được", "error")
		return nil
	end

	-- load async, nếu trong lúc chờ màn đã vẽ lại thì bỏ kết quả
	local function load(parent, action, payload, onData)
		local loading = note(parent, 0, "Đang tải...")
		task.spawn(function()
			local response = ctx.request(action, payload)
			if not loading.Parent then
				return
			end
			loading:Destroy()
			if not response.ok then
				note(parent, 1, response.error or "Không tải được", Colors.bad)
				return
			end
			onData(response.data)
		end)
	end

	-- Trang chính ------------------------------------------------------------------------
	local function renderHome()
		local snap = ctx.getSnapshot()
		local isTeacher = snap and snap.isTeacher
		local isOwner = snap and snap.isOwner
		modal.setTitle("Lớp học")
		local body = modal.body

		sectionTitle(body, 1, "Tham gia lớp")
		local joinRow = C.row({ Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 2, ZIndex = Z, Parent = body })
		local codeBox = C.textbox({ Placeholder = "Nhập mã mời (VD: QZ7K2M)", Size = UDim2.fromOffset(240, 38), ZIndex = Z, LayoutOrder = 1, Parent = joinRow })
		C.button({ Text = "Tham gia", Variant = "primary", Size = UDim2.fromOffset(110, 38), ZIndex = Z, LayoutOrder = 2, Parent = joinRow }, function()
			local code = codeBox.Text
			if #code:gsub("%s", "") < 3 then
				ctx.toast("Mã lớp cần ít nhất 3 ký tự", "error")
				return
			end
			local response = run("joinClass", { code = code })
			if response then
				ctx.toast("Đã tham gia lớp " .. (response.data and response.data.name or code), "good")
				render()
			end
		end)

		sectionTitle(body, 3, "Lớp của tôi")
		local myList = listFrame(body, 4)
		load(myList, "getMyClasses", nil, function(classes)
			if #classes == 0 then
				note(myList, 1, "Bạn chưa tham gia lớp nào.")
				return
			end
			for i, cls in ipairs(classes) do
				local c = card(myList, i)
				C.label({ Text = string.format("%s  •  Mã %s", cls.name, cls.code), Font = Theme.FontBold, TextSize = 14, Truncate = true, LayoutOrder = 1, ZIndex = Z, Parent = c })
				note(c, 2, "Giáo viên: " .. tostring(cls.teacherName or "?"))
				local actions = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 3, ZIndex = Z, Parent = c })
				if cls.inRoom then
					note(c, 4, "Bạn đang ở trong phòng học riêng của lớp này.", Colors.good)
				elseif cls.roomOpen then
					btn(actions, 1, "Vào phòng học", 130, function()
						run("enterClassRoom", { code = cls.code }, "Đang chuyển vào phòng học...")
					end, true)
				end
				btn(actions, 2, "Rời lớp", 90, function()
					if run("leaveClass", { code = cls.code }, "Đã rời lớp " .. cls.name) then
						render()
					end
				end)
			end
		end)

		if not isTeacher then
			note(body, 9, "Chỉ giáo viên mới tạo được lớp. Nhờ chủ game thêm bạn vào danh sách giáo viên (mục Quản trị).", Colors.textMuted)
			return
		end

		sectionTitle(body, 10, "Lớp tôi dạy")
		local createRow = C.row({ Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 11, ZIndex = Z, Parent = body })
		local nameBox = C.textbox({ Placeholder = "Tên lớp mới (VD: 10A1)", Size = UDim2.fromOffset(240, 38), ZIndex = Z, LayoutOrder = 1, Parent = createRow })
		C.button({ Text = "Tạo lớp mới", Variant = "primary", Size = UDim2.fromOffset(120, 38), ZIndex = Z, LayoutOrder = 2, Parent = createRow }, function()
			local name = nameBox.Text
			if #name:gsub("%s", "") == 0 then
				ctx.toast("Hãy nhập tên lớp", "error")
				return
			end
			local response = run("createClass", { name = name })
			if response then
				local d = response.data
				ctx.toast(string.format("Đã tạo lớp %s. Mã mời: %s", d.name, d.code), "good")
				if d.renamed then
					ctx.toast("Chưa kiểm duyệt được tên lớp nên tạm dùng tên \"" .. d.name .. "\"", "error")
				end
				go("roster", { code = d.code, lastResult = nil, scenarioList = nil })
			end
		end)
		note(body, 12, "Tên lớp hiển thị cho học sinh và được lọc theo quy định của Roblox. Không dùng họ tên thật hoặc tên trường. Mỗi phút tạo được 1 lớp.", Colors.textMuted)

		local teachList = listFrame(body, 13)
		load(teachList, "getTeacherClasses", nil, function(classes)
			if #classes == 0 then
				note(teachList, 1, "Chưa có lớp nào. Tạo lớp để nhận mã mời 6 ký tự cho học sinh.")
				return
			end
			for i, cls in ipairs(classes) do
				local c = card(teachList, i)
				C.label({ Text = string.format("%s  •  MÃ MỜI: %s", cls.name, cls.code), Font = Theme.FontBold, TextSize = 14, Truncate = true, LayoutOrder = 1, ZIndex = Z, Parent = c })
				note(c, 2, string.format("%d học sinh%s", cls.memberCount or 0, cls.roomOpen and " • Phòng học riêng đang mở" or ""))
				btn(c, 3, "Xem tiến độ & gán kịch bản  ›", 240, function()
					go("roster", { code = cls.code, lastResult = nil, scenarioList = nil })
				end)
			end
		end)

		local extra = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 20, ZIndex = Z, Parent = body })
		btn(extra, 1, "Kịch bản tuỳ chỉnh", 180, function()
			go("scenarios")
		end)
		if isOwner then
			btn(extra, 2, "Quản trị", 120, function()
				go("admin")
			end)
		end
	end

	-- kịch bản có sẵn + kịch bản tuỳ chỉnh, mỗi lần mở lớp chỉ tải 1 lần
	local function scenarioChoices()
		local list = {}
		for _, s in ipairs(Scenarios.CATALOG) do
			table.insert(list, { id = s.id, name = s.name, description = s.description, severity = s.severity, durationMonths = s.durationMonths })
		end
		for _, s in ipairs(view.scenarioList or {}) do
			table.insert(list, { id = s.id, name = s.name, description = s.description, severity = s.severity, durationMonths = s.durationMonths, custom = true, effects = s.effects })
		end
		return list
	end

	local function effectsText(effects)
		local parts = {}
		for _, field in ipairs(Scenarios.CUSTOM_EFFECTS) do
			local v = effects and effects[field.key]
			if v ~= nil then
				table.insert(parts, field.label .. " " .. formatEffect(field, v))
			end
		end
		return table.concat(parts, " • ")
	end

	-- Trang tiến độ lớp (giáo viên) ------------------------------------------------------------
	local function renderRoster()
		local body = modal.body
		modal.setTitle("Lớp " .. tostring(view.code))
		local top = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 1, ZIndex = Z, Parent = body })
		btn(top, 1, "‹ Quay lại", 96, function()
			go("home")
		end)
		btn(top, 2, "Tải lại", 76, function()
			view.scenarioList = nil
			render()
		end)
		btn(top, 3, "Xuất CSV", 90, function()
			go("csv")
		end)
		local roomRow = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 2, ZIndex = Z, Parent = body })

		sectionTitle(body, 3, "Gán sự kiện khủng hoảng cho cả lớp")
		local pickerHolder = listFrame(body, 4)
		local function drawPicker()
			for _, child in ipairs(pickerHolder:GetChildren()) do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			local choices = scenarioChoices()
			if view.scenarioIndex > #choices then
				view.scenarioIndex = 1
			end
			local current = choices[view.scenarioIndex]
			local picker = C.row({ Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 1, ZIndex = Z, Parent = pickerHolder })
			C.button({ Text = "‹", Variant = "white", Size = UDim2.fromOffset(34, 34), Radius = 17, ZIndex = Z, LayoutOrder = 1, Parent = picker }, function()
				view.scenarioIndex = (view.scenarioIndex - 2) % #choices + 1
				drawPicker()
			end)
			C.label({
				Text = string.format("%s%s (mức %d/10, %d tháng)  %d/%d", "", current.name .. (current.custom and " (tự tạo)" or ""), current.severity or 5, current.durationMonths or 1, view.scenarioIndex, #choices),
				Font = Theme.FontBold,
				TextSize = 13,
				Truncate = true,
				XAlign = Enum.TextXAlignment.Center,
				Size = UDim2.fromOffset(380, 32),
				ZIndex = Z,
				LayoutOrder = 2,
				Parent = picker,
			})
			C.button({ Text = "›", Variant = "white", Size = UDim2.fromOffset(34, 34), Radius = 17, ZIndex = Z, LayoutOrder = 3, Parent = picker }, function()
				view.scenarioIndex = view.scenarioIndex % #choices + 1
				drawPicker()
			end)
			local desc = current.description ~= "" and current.description or "(không có mô tả)"
			if current.custom then
				desc = desc .. "\nHiệu ứng: " .. effectsText(current.effects)
			end
			note(pickerHolder, 2, desc)
			btn(pickerHolder, 3, "Gán cho lớp", 140, function()
				local response = run("assignScenario", { code = view.code, scenarioId = current.id })
				if response then
					local d = response.data
					view.lastResult = string.format(
						"Đã gán \"%s\". Áp dụng ngay cho %d học sinh đang chơi trong server này%s. Học sinh vắng mặt sẽ nhận sự kiện khi vào game (trong vòng 7 ngày).",
						d.name or current.name,
						d.appliedHere or 0,
						d.broadcast and "; đã gửi tới học sinh ở các server khác" or ""
					)
					render()
				end
			end, true)
			if view.lastResult then
				note(pickerHolder, 4, view.lastResult, Colors.good)
			end
		end
		drawPicker()
		if view.scenarioList == nil then
			task.spawn(function()
				local response = ctx.request("listScenarios")
				if response.ok and pickerHolder.Parent then
					view.scenarioList = response.data.custom or {}
					drawPicker()
				end
			end)
		end

		sectionTitle(body, 7, "Tiến độ học sinh (bấm vào tên để xem chi tiết)")
		local header = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 8, ZIndex = Z, Parent = body })
		local columns = { { "HỌC SINH", 0, 0.34 }, { "TIẾN ĐỘ", 0.34, 0.16 }, { "DOANH THU", 0.5, 0.16 }, { "HẠNH PHÚC", 0.66, 0.16 }, { "TRẠNG THÁI", 0.82, 0.18 } }
		for _, col in ipairs(columns) do
			C.label({ Text = col[1], TextSize = 10, Font = Theme.FontBold, Color = Colors.textMuted, Size = UDim2.new(col[3], 0, 1, 0), Position = UDim2.fromScale(col[2], 0), ZIndex = Z, Parent = header })
		end
		local list = listFrame(body, 9, 4)
		local logHolder = listFrame(body, 10, 4)
		load(list, "getClassRoster", { code = view.code }, function(data)
			-- nút phòng riêng tuỳ phòng đang mở hay đóng
			if data.roomOpen then
				if data.inRoom then
					note(roomRow, 1, "Bạn đang ở phòng học riêng của lớp này.", Colors.good).Size = UDim2.fromOffset(300, 30)
				else
					btn(roomRow, 1, "Vào phòng học riêng", 170, function()
						run("enterClassRoom", { code = view.code }, "Đang chuyển vào phòng học...")
					end, true)
				end
				btn(roomRow, 2, "Đóng phòng", 110, function()
					if run("closeClassRoom", { code = view.code }, "Đã đóng phòng học riêng") then
						render()
					end
				end)
			else
				btn(roomRow, 1, "Mở phòng học riêng", 170, function()
					if run("openClassRoom", { code = view.code }, "Đã mở phòng học riêng. Học sinh bấm \"Vào phòng học\" để vào") then
						render()
					end
				end)
			end
			local members = data.members or {}
			if #members == 0 then
				note(list, 1, "Chưa có học sinh nào tham gia lớp này. Gửi mã mời " .. tostring(view.code) .. " cho học sinh.")
			end
			for i, m in ipairs(members) do
				local r = C.new("TextButton", {
					Text = "",
					AutoButtonColor = false,
					BackgroundColor3 = Colors.panelAlt,
					BackgroundTransparency = 0,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 36),
					LayoutOrder = i,
					ZIndex = Z,
					Parent = list,
				})
				C.corner(10).Parent = r
				C.selectable(r)
				r.Activated:Connect(function()
					go("student", { studentId = m.userId })
				end)
				local s = m.summary
				local statusText, statusColor = "Chưa chơi", Colors.textMuted
				if s then
					statusText = Theme.StatusText[s.status] or s.status
					statusColor = Theme.statusColor(s.status)
				end
				local cells = {
					{ tostring(m.name) .. (m.online and " (đang chơi)" or ""), 0, 0.34, m.online and Colors.good or Colors.text },
					{ s and string.format("Tháng %d/%d", s.month or 0, s.maxMonths or 12) or "Chưa bắt đầu", 0.34, 0.16, Colors.text },
					{ s and Util.formatMoneyK(s.gdp or 0) or "$0k", 0.5, 0.16, Colors.text },
					{ s and tostring(Util.round(s.happiness or 0)) or "-", 0.66, 0.16, s and Theme.happinessColor(s.happiness or 0) or Colors.text },
					{ statusText, 0.82, 0.18, statusColor },
				}
				for _, cell in ipairs(cells) do
					C.label({ Text = cell[1], TextSize = 12, Color = cell[4], Truncate = true, Size = UDim2.new(cell[3], -6, 1, 0), Position = UDim2.new(cell[2], 6, 0, 0), ZIndex = Z, Parent = r })
				end
			end
			note(list, 900, "Tên màu xanh: đang trong game. Còn lại: số liệu lần lưu gần nhất.", Colors.textMuted)
			local log = data.scenarioLog or {}
			if #log > 0 then
				sectionTitle(logHolder, 1, "Sự kiện đã gán gần đây")
				for i, e in ipairs(log) do
					note(logHolder, 1 + i, "• " .. tostring(e.name), Colors.textDim)
				end
			end
		end)
	end

	-- Chi tiết một học sinh ------------------------------------------------------------------
	local function renderStudent()
		local body = modal.body
		modal.setTitle("Chi tiết học sinh")
		local top = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 1, ZIndex = Z, Parent = body })
		btn(top, 1, "‹ Lớp " .. tostring(view.code), 130, function()
			go("roster")
		end)
		local holder = listFrame(body, 2, 6)
		load(holder, "getStudentDetail", { code = view.code, userId = view.studentId }, function(data)
			sectionTitle(holder, 1, string.format("%s (%s)", tostring(data.name), data.online and "đang chơi" or "không online"))
			local d = data.detail
			if type(d) ~= "table" then
				note(holder, 2, "Học sinh này chưa có dữ liệu ván chơi.")
				return
			end
			note(holder, 2, string.format(
				"%s • Tháng %d/%d • Ngân sách %s • Doanh thu %s/tháng • Hạnh phúc %d • Việc làm %s • Dân số %s • Thuế %s • Điểm %s",
				Theme.StatusText[d.status] or tostring(d.status),
				d.month or 0,
				d.maxMonths or 24,
				Util.formatMoneyFull(d.budget or 0),
				Util.formatMoneyK(d.gdp or 0),
				Util.round(d.happiness or 0),
				d.employment and string.format("%d%%", Util.round(d.employment)) or "—",
				Util.formatInt(d.population or 0),
				d.tax and (tostring(d.tax) .. "%") or "—",
				Util.formatInt(d.prosperityScore or 0)
			), Colors.text)
			if type(d.city) == "table" and type(d.city.counts) == "table" then
				local g = card(holder, 3)
				C.label({ Text = "Công trình", Font = Theme.FontBold, TextSize = 13, LayoutOrder = 0, ZIndex = Z, Parent = g })
				local parts = {}
				for _, kind in ipairs(Config.BUILDING_ORDER) do
					local n = d.city.counts[kind]
					if n and n > 0 then
						table.insert(parts, string.format("%s %s: %d", Config.CATEGORIES[kind].code, Config.CATEGORIES[kind].zone, n))
					end
				end
				note(g, 1, #parts > 0 and table.concat(parts, " • ") or "Chưa xây gì.")
				if (d.city.unconnected or 0) > 0 then
					note(g, 2, string.format("%d công trình chưa nối đường (không hoạt động, vẫn tốn bảo trì)", d.city.unconnected), Colors.warn)
				end
			end
			if type(d.scenarios) == "table" and #d.scenarios > 0 then
				local names = {}
				for _, sc in ipairs(d.scenarios) do
					table.insert(names, string.format("%s (còn %d tháng)", tostring(sc.name), sc.monthsLeft or 0))
				end
				note(holder, 5, "Sự kiện đang chạy: " .. table.concat(names, ", "), Colors.warn)
			end
			if type(d.history) == "table" and #d.history > 0 then
				local h = card(holder, 6)
				C.label({ Text = "Từng tháng (tháng • ngân sách • doanh thu • hạnh phúc • việc làm • dân số)", Font = Theme.FontBold, TextSize = 12, Wrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 0, ZIndex = Z, Parent = h })
				for i, row in ipairs(d.history) do
					note(h, i, string.format("T%d • %s • %s • %d • %s • %s", row.month or i, Util.formatMoneyFull(row.budget or 0),
						Util.formatMoneyK(row.gdp or 0), Util.round(row.happiness or 0), row.employment and string.format("%d%%", Util.round(row.employment)) or "—", Util.formatInt(row.population or 0)), Colors.text)
				end
			end
		end)
	end

	-- Xuất CSV ---------------------------------------------------------------------------------
	local function renderCsv()
		local body = modal.body
		modal.setTitle("Xuất CSV lớp " .. tostring(view.code))
		local top = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 1, ZIndex = Z, Parent = body })
		btn(top, 1, "‹ Lớp " .. tostring(view.code), 130, function()
			go("roster")
		end)
		note(body, 2, "Bấm vào ô bên dưới, nhấn Ctrl+A rồi Ctrl+C (Mac: ⌘A, ⌘C) để sao chép, sau đó dán vào Excel hoặc Google Sheets. Mỗi dòng là một học sinh × một tháng của ván gần nhất.")
		local holder = listFrame(body, 3, 8)
		load(holder, "exportClassCsv", { code = view.code }, function(data)
			local lines = {}
			for line in (data.csv .. "\n"):gmatch("([^\n]*)\n") do
				table.insert(lines, line)
			end
			-- chia ra nhiều ô, mỗi ô tối đa chunkSize dòng. text quá lớn thì Roblox render chậm
			local header = lines[1] or ""
			local chunkSize = 150
			local chunks = {}
			for i = 2, #lines, chunkSize do
				local part = { header }
				for j = i, math.min(#lines, i + chunkSize - 1) do
					table.insert(part, lines[j])
				end
				table.insert(chunks, table.concat(part, "\n"))
			end
			if #chunks == 0 then
				chunks = { header }
			end
			note(holder, 1, string.format("%d dòng dữ liệu%s", data.rows or 0, #chunks > 1 and (", chia thành " .. #chunks .. " phần, phần nào cũng có dòng tiêu đề") or ""), Colors.good)
			for i, chunk in ipairs(chunks) do
				if #chunks > 1 then
					note(holder, i * 2, "Phần " .. i .. "/" .. #chunks, Colors.textDim)
				end
				multilineBox(holder, i * 2 + 1, chunk)
			end
		end)
	end

	-- Kịch bản tuỳ chỉnh ----------------------------------------------------------------------
	local function renderScenarios()
		local body = modal.body
		modal.setTitle("Kịch bản tuỳ chỉnh")
		local top = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 1, ZIndex = Z, Parent = body })
		btn(top, 1, "‹ Quay lại", 96, function()
			go("home")
		end)

		sectionTitle(body, 2, "Kịch bản của tôi")
		local list = listFrame(body, 3)
		load(list, "listScenarios", nil, function(data)
			view.scenarioList = data.custom or {}
			if #data.custom == 0 then
				note(list, 1, "Chưa có kịch bản tuỳ chỉnh nào.")
			end
			for i, s in ipairs(data.custom) do
				local c = card(list, i)
				C.label({ Text = string.format("%s (tự tạo, mức %d/10, %d tháng)", s.name, s.severity, s.durationMonths), Font = Theme.FontBold, TextSize = 13, Truncate = true, LayoutOrder = 1, ZIndex = Z, Parent = c })
				if s.description and s.description ~= "" then
					note(c, 2, s.description)
				end
				note(c, 3, effectsText(s.effects), Colors.warn)
				btn(c, 4, "Xoá", 70, function()
					if run("deleteScenario", { id = s.id }, "Đã xoá kịch bản") then
						view.scenarioList = nil
						render()
					end
				end)
			end
			note(list, 99, string.format("Tối đa %d kịch bản. Kịch bản xuất hiện trong mục \"Gán sự kiện\" của mọi lớp bạn dạy (ghi \"tự tạo\").", data.max or Config.MAX_CUSTOM_SCENARIOS), Colors.textMuted)
		end)

		sectionTitle(body, 4, "Tạo kịch bản mới")
		local form = card(body, 5)
		local nameBox = C.textbox({ Placeholder = "Tên kịch bản (VD: Bão lớn miền Trung)", Size = UDim2.new(1, 0, 0, 34), ZIndex = Z, LayoutOrder = 1, Parent = form })
		local descBox = C.textbox({ Placeholder = "Mô tả ngắn cho học sinh (tuỳ chọn)", Size = UDim2.new(1, 0, 0, 34), ZIndex = Z, LayoutOrder = 2, Parent = form })
		local getSeverity = numberStepper(form, 3, "Mức độ nghiêm trọng (1-10)", { min = 1, max = 10, step = 1, value = 5, default = 5, format = tostring })
		local getDuration = numberStepper(form, 4, "Thời gian (tháng)", { min = 1, max = 12, step = 1, value = 3, default = 3, format = function(v)
			return v .. " tháng"
		end })
		local getters = {}
		for i, field in ipairs(Scenarios.CUSTOM_EFFECTS) do
			local f = field
			getters[field.key] = numberStepper(form, 10 + i, field.label, {
				min = field.min,
				max = field.max,
				step = field.step,
				value = field.default,
				default = field.default,
				format = function(v)
					return formatEffect(f, v)
				end,
			})
		end
		note(form, 30, "Tên và mô tả được lọc theo quy định của Roblox trước khi học sinh nhìn thấy. Mỗi phút tạo được 1 kịch bản.", Colors.textMuted)
		btn(form, 31, "Tạo kịch bản", 140, function()
			local effects = {}
			for key, getter in pairs(getters) do
				effects[key] = getter()
			end
			local response = run("createScenario", {
				name = nameBox.Text,
				description = descBox.Text,
				severity = getSeverity(),
				durationMonths = getDuration(),
				effects = effects,
			})
			if response then
				ctx.toast("Đã tạo kịch bản \"" .. tostring(response.data.name) .. "\"", "good")
				view.scenarioList = nil
				render()
			end
		end, true)
	end

	-- Quản trị (chủ game) -------------------------------------------------------------------------
	local function renderAdmin()
		local body = modal.body
		modal.setTitle("Quản trị")
		local top = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 1, ZIndex = Z, Parent = body })
		btn(top, 1, "‹ Quay lại", 96, function()
			go("home")
		end)
		btn(top, 2, "Tải lại", 76, function()
			render()
		end)
		local holder = listFrame(body, 2, 8)
		load(holder, "adminGetState", nil, function(data)
			sectionTitle(holder, 1, "Giáo viên")
			note(holder, 2, "Nhập tên đăng nhập Roblox (không phải tên hiển thị) hoặc UserId. Chủ game và các UserId trong Config luôn là giáo viên.", Colors.textMuted)
			local addRow = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 3, ZIndex = Z, Parent = holder })
			local teacherBox = C.textbox({ Placeholder = "Tên đăng nhập hoặc UserId", Size = UDim2.fromOffset(240, 34), ZIndex = Z, LayoutOrder = 1, Parent = addRow })
			btn(addRow, 2, "Thêm giáo viên", 140, function()
				local response = run("adminAddTeacher", { target = teacherBox.Text })
				if response then
					ctx.toast("Đã thêm giáo viên " .. tostring(response.data.name), "good")
					render()
				end
			end, true)
			local teachers = listFrame(holder, 4, 4)
			if #data.teachers == 0 then
				note(teachers, 1, "Chưa thêm giáo viên nào.")
			end
			for i, t in ipairs(data.teachers) do
				local r = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = i, ZIndex = Z, Parent = teachers })
				C.label({ Text = string.format("%s (UserId %s)", tostring(t.name), tostring(t.userId)), TextSize = 12, Truncate = true, Size = UDim2.fromOffset(360, 30), LayoutOrder = 1, ZIndex = Z, Parent = r })
				btn(r, 2, "Bỏ", 60, function()
					if run("adminRemoveTeacher", { userId = t.userId }, "Đã bỏ quyền giáo viên") then
						render()
					end
				end)
			end

			sectionTitle(holder, 10, "Cấm người chơi")
			local banForm = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 11, ZIndex = Z, Parent = holder })
			local banTarget = C.textbox({ Placeholder = "Tên đăng nhập / UserId", Size = UDim2.fromOffset(180, 34), ZIndex = Z, LayoutOrder = 1, Parent = banForm })
			local banDays = C.textbox({ Placeholder = "Số ngày (0 = vĩnh viễn)", Size = UDim2.fromOffset(170, 34), ZIndex = Z, LayoutOrder = 2, Parent = banForm })
			local banReason = C.textbox({ Placeholder = "Lý do hiển thị cho người bị cấm", Size = UDim2.new(1, 0, 0, 34), ZIndex = Z, LayoutOrder = 12, Parent = holder })
			btn(holder, 13, "Cấm", 90, function()
				local response = run("adminBan", { target = banTarget.Text, days = tonumber(banDays.Text) or 0, reason = banReason.Text })
				if response then
					ctx.toast("Đã cấm " .. tostring(response.data.name), "good")
					render()
				end
			end, true)
			local bans = listFrame(holder, 14, 4)
			for i, b in ipairs(data.bans) do
				local r = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = i, ZIndex = Z, Parent = bans })
				C.label({ Text = string.format("%s • %s • %s", tostring(b.name), (b.days or 0) > 0 and (b.days .. " ngày") or "vĩnh viễn", tostring(b.reason or "")), TextSize = 12, Truncate = true, Size = UDim2.fromOffset(360, 30), LayoutOrder = 1, ZIndex = Z, Parent = r })
				btn(r, 2, "Bỏ cấm", 80, function()
					if run("adminUnban", { userId = b.userId }, "Đã bỏ cấm") then
						render()
					end
				end)
			end

			-- Xoá dữ liệu
			sectionTitle(holder, 20, "Xoá dữ liệu theo yêu cầu (Right to be Forgotten)")
			note(holder, 21, "Khi Roblox gửi tin nhắn yêu cầu xoá dữ liệu kèm UserId, nhập UserId đó rồi bấm Xoá hai lần. Thao tác xoá hồ sơ, rút khỏi lớp, xoá lớp người đó dạy, điểm xếp hạng và kịch bản tuỳ chỉnh. Không hoàn tác được.", Colors.textMuted)
			local delRow = C.row({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 22, ZIndex = Z, Parent = holder })
			local delBox = C.textbox({ Placeholder = "UserId", Size = UDim2.fromOffset(180, 34), ZIndex = Z, LayoutOrder = 1, Parent = delRow })
			local armed = nil
			local delButton
			delButton = btn(delRow, 2, "Xoá toàn bộ dữ liệu", 180, function()
				local target = delBox.Text
				if armed ~= target then
					armed = target
					delButton.Text = "Bấm lần nữa để xác nhận"
					task.delay(5, function()
						if delButton.Parent and armed == target then
							armed = nil
							delButton.Text = "Xoá toàn bộ dữ liệu"
						end
					end)
					return
				end
				armed = nil
				delButton.Text = "Xoá toàn bộ dữ liệu"
				local response = run("adminDeleteUserData", { target = target })
				if response then
					local d = response.data
					ctx.toast(string.format("Đã xoá dữ liệu: hồ sơ %s, rút khỏi %d lớp, xoá %d lớp", d.profile and "có" or "không có", d.classesLeft or 0, d.classesDeleted or 0), "good")
					render()
				end
			end)

			if #data.log > 0 then
				sectionTitle(holder, 30, "Nhật ký gần đây")
				for i, row in ipairs(data.log) do
					if i > 10 then
						break
					end
					note(holder, 30 + i, string.format("%s • %s", tostring(row.action), tostring(row.target or "")), Colors.textDim)
				end
			end
			if data.persistence == "memory" then
				note(holder, 50, "Đang ở chế độ thử (chưa bật DataStore): danh sách chỉ lưu tạm trong server này.", Colors.warn)
			end
		end)
	end

	render = function()
		modal.clear()
		modal.body.CanvasPosition = Vector2.new(0, 0)
		local mode = view.mode
		if mode == "roster" and view.code then
			renderRoster()
		elseif mode == "student" and view.code and view.studentId then
			renderStudent()
		elseif mode == "csv" and view.code then
			renderCsv()
		elseif mode == "scenarios" then
			renderScenarios()
		elseif mode == "admin" then
			renderAdmin()
		else
			renderHome()
		end
	end

	modal = C.modal({ Name = "ClassModal", Title = "Lớp học", Size = UDim2.fromOffset(640, 560), Parent = gui, onOpen = function()
		view.mode = "home"
		render()
	end })
	Icons.badge("people", { Size = 30, IconSize = 16, Color = Colors.people, Soft = Colors.peopleSoft, Square = true, Position = UDim2.fromOffset(22, 14), ZIndex = 52, Parent = modal.card })
	modal.card:FindFirstChild("Title").Position = UDim2.fromOffset(62, 0)
	return modal
end

return ClassPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">Components</string><ProtectedString name="Source"><![CDATA[-- các khối UI dùng lại: thẻ, nhãn, nút, slider, nút +/-, tab, modal, ô nhập. màu/phông lấy từ Theme

local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")

local Theme = require(script.Parent:WaitForChild("Theme"))
local Colors = Theme.Colors

local C = {}

-- Gamepad ------------------------------------------------------
-- chỉ bật Selectable khi đang dùng gamepad. với bàn phím phải tắt,
-- vì phím \ rồi Enter của Roblox từng bấm nhầm nút (vd. nút đi dạo)
local selectables = setmetatable({}, { __mode = "k" })
local gamepadMode = false

local function isGamepadInput(inputType)
	local ok, name = pcall(function()
		return inputType.Name
	end)
	return ok and type(name) == "string" and name:sub(1, 7) == "Gamepad"
end

pcall(function()
	gamepadMode = isGamepadInput(UserInputService:GetLastInputType())
end)

function C.selectable(obj)
	selectables[obj] = true
	obj.Selectable = gamepadMode
	return obj
end

function C.isGamepadMode()
	return gamepadMode
end

function C.setGamepadMode(on)
	gamepadMode = on
	for obj in pairs(selectables) do
		if obj.Parent then
			obj.Selectable = on
		end
	end
	if not on then
		pcall(function()
			GuiService.SelectedObject = nil
		end)
	end
end

pcall(function()
	UserInputService.LastInputTypeChanged:Connect(function(inputType)
		local on = isGamepadInput(inputType)
		if on ~= gamepadMode then
			C.setGamepadMode(on)
		end
	end)
end)

-- chọn sẵn nút khi mở bảng, chỉ khi đang dùng gamepad
function C.focus(obj)
	if gamepadMode and obj then
		pcall(function()
			GuiService.SelectedObject = obj
		end)
	end
end

-- cỡ chữ tối thiểu, tính theo đơn vị thiết kế. màn hẹp đặt 13 (khoảng 9px ở UIScale 0.72)
-- cỡ gốc lưu ở attribute BaseTextSize để trả lại khi màn rộng ra
local textFloor = 0
local texts = setmetatable({}, { __mode = "k" })

local function applyFloor(inst)
	local base = inst:GetAttribute("BaseTextSize") or inst.TextSize
	inst:SetAttribute("BaseTextSize", base)
	inst.TextSize = math.max(base, textFloor)
end

local function trackText(inst)
	texts[inst] = true
	applyFloor(inst)
	return inst
end

function C.setTextFloor(size)
	if size == textFloor then
		return
	end
	textFloor = size
	for inst in pairs(texts) do
		if inst.Parent then
			applyFloor(inst)
		end
	end
end

-- Parent gán sau cùng
function C.new(className, props, children)
	local inst = Instance.new(className)
	local parent = nil
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- radius tính bằng px, mặc định 12
function C.corner(radius)
	return C.new("UICorner", { CornerRadius = UDim.new(0, radius or Theme.Radius.md) })
end

-- bo tròn hẳn 2 đầu (pill / tròn)
function C.round()
	return C.new("UICorner", { CornerRadius = UDim.new(1, 0) })
end

function C.stroke(color, thickness, transparency)
	return C.new("UIStroke", {
		Color = color or Colors.stroke,
		Thickness = thickness or Theme.LineThickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

-- viền mờ để thẻ trắng tách khỏi thành phố phía sau
function C.shadowStroke(thickness, transparency)
	local s = C.stroke(Colors.shadow, thickness or Theme.FrameThickness, transparency or 0.86)
	s.Name = "Shadow"
	return s
end

function C.padding(all, horizontal)
	local v = UDim.new(0, all)
	local h = UDim.new(0, horizontal or all)
	return C.new("UIPadding", { PaddingTop = v, PaddingBottom = v, PaddingLeft = h, PaddingRight = h })
end

function C.list(direction, spacing, hAlign, vAlign)
	return C.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, spacing or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
	})
end

-- UIGradient nhân với màu nền, nền trắng thì ra đúng 2 màu này
-- rotation: 90 trên xuống dưới, 0 trái sang phải, 45 chéo
function C.gradient(from, to, rotation)
	return C.new("UIGradient", {
		Name = "Gradient",
		Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, from), ColorSequenceKeypoint.new(1, to) }),
		Rotation = rotation or 90,
	})
end

-- gờ nổi dưới đáy nút: dải sẫm cao depth px (UIGradient nhân màu nền), chữ dịch lên cho nằm giữa mặt nút
local WHITE = Color3.new(1, 1, 1)
function C.lip(button, depth, shade)
	local h = button.Size.Y.Offset
	if h <= 0 then
		h = 36
	end
	local edge = math.clamp(1 - depth / h, 0.5, 0.96)
	local dark = Color3.new(shade or 0.78, shade or 0.78, (shade or 0.78) + 0.02)
	local g = C.new("UIGradient", {
		Name = "Lip",
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, WHITE),
			ColorSequenceKeypoint.new(edge, WHITE),
			ColorSequenceKeypoint.new(math.min(edge + 0.01, 0.999), dark),
			ColorSequenceKeypoint.new(1, dark),
		}),
	})
	g.Parent = button
	return g
end

function C.panel(props)
	props = props or {}
	local frame = C.new("Frame", {
		Name = props.Name or "Panel",
		BackgroundColor3 = props.Color or Colors.panel,
		BackgroundTransparency = props.Transparency or Theme.PanelTransparency,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.fromOffset(200, 100),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		ZIndex = props.ZIndex or 1,
		-- Active để click vào nền bảng không xuyên xuống thành phố
		Active = props.Active ~= false,
		Parent = props.Parent,
	})
	C.corner(props.Radius or Theme.Radius.lg).Parent = frame
	if props.Stroke ~= false then
		C.shadowStroke(props.StrokeThickness, props.StrokeTransparency).Parent = frame
	end
	return frame
end

-- ô lót nhạt trong thẻ, không có viền bóng
function C.well(props)
	props = props or {}
	local frame = C.new("Frame", {
		Name = props.Name or "Well",
		BackgroundColor3 = props.Color or Colors.panelAlt,
		BackgroundTransparency = props.Transparency or 0,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.new(1, 0, 0, 0),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	C.corner(props.Radius or Theme.Radius.md).Parent = frame
	return frame
end

function C.label(props)
	props = props or {}
	return trackText(C.new("TextLabel", {
		Name = props.Name or "Label",
		BackgroundTransparency = 1,
		Text = props.Text or "",
		TextColor3 = props.Color or Colors.text,
		Font = props.Font or Theme.Font,
		TextSize = props.TextSize or 14,
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Left,
		TextYAlignment = props.YAlign or Enum.TextYAlignment.Center,
		TextWrapped = props.Wrapped or false,
		RichText = props.RichText or false,
		Size = props.Size or UDim2.new(1, 0, 0, (props.TextSize or 14) + 6),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
		LayoutOrder = props.LayoutOrder or 0,
		TextTruncate = props.Truncate and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}))
end

-- tự giãn theo chữ
function C.pill(props)
	local label = C.label({
		Name = props.Name or "Pill",
		Text = props.Text or "",
		Font = props.Font or Theme.FontBold,
		TextSize = props.TextSize or 12,
		Color = props.TextColor or Colors.text,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, props.Height or 24),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		ZIndex = props.ZIndex,
		Parent = props.Parent,
	})
	label.BackgroundTransparency = 0
	label.BackgroundColor3 = props.Color or Colors.panelAlt
	C.round().Parent = label
	C.new("UIPadding", { PaddingLeft = UDim.new(0, props.PadX or 10), PaddingRight = UDim.new(0, props.PadX or 10) }).Parent = label
	return label
end

-- { màu nền, màu chữ }
local VARIANTS = {
	primary = { Colors.accent, Colors.onAccent },
	success = { Colors.success, Colors.onAccent },
	warning = { Colors.amber, Colors.onAccent },
	danger = { Colors.danger, Colors.onAccent },
	violet = { Colors.violet, Colors.onAccent },
	secondary = { Colors.panelAlt, Colors.text },
	white = { Colors.panel, Colors.text },
	ghost = { Colors.panel, Colors.textDim },
}

local function luminance(c)
	return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

-- tween màu hover đang chạy của từng nút, để C.setButtonColor huỷ được (không thì tween đè lên màu mới)
local hoverTweens = setmetatable({}, { __mode = "k" })

-- hover: nút đậm thì sáng lên, nút nhạt thì ngả sang accent
local function hoverOf(base)
	if luminance(base) < 0.75 then
		return base:Lerp(WHITE, 0.12)
	end
	return base:Lerp(Colors.accent, 0.08)
end

-- onClick(button) chạy cho cả chuột, chạm, gamepad
-- props: Variant (key trong VARIANTS) hoặc Color/TextColor, Stroke = true thêm viền, Lip = false bỏ gờ, Radius
function C.button(props, onClick)
	props = props or {}
	local variant = VARIANTS[props.Variant or ""] or (not props.Color and VARIANTS.secondary) or nil
	local base = props.Color or variant[1]
	local textColor = props.TextColor or (variant and variant[2]) or (luminance(base) < 0.6 and Colors.onAccent or Colors.text)
	local size = props.Size or UDim2.fromOffset(120, 36)
	local button = C.new("TextButton", {
		Name = props.Name or "Button",
		AutoButtonColor = false,
		BackgroundColor3 = base,
		BackgroundTransparency = props.Transparency or (props.Variant == "ghost" and 1 or 0),
		BorderSizePixel = 0,
		Text = props.Text or "",
		TextColor3 = textColor,
		Font = props.Font or Theme.FontBold,
		TextSize = props.TextSize or 13,
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Center,
		TextYAlignment = props.YAlign or Enum.TextYAlignment.Center,
		TextWrapped = props.Wrapped or false,
		Size = size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Visible = props.Visible ~= false,
		Parent = props.Parent,
	})
	C.selectable(button)
	trackText(button)
	button:SetAttribute("BaseTransparency", button.BackgroundTransparency)
	local h = size.Y.Offset > 0 and size.Y.Offset or 36
	C.corner(props.Radius or math.min(Theme.Radius.md, math.floor(h / 2))).Parent = button
	-- nút trắng luôn có viền, nút khác phải truyền Stroke = true
	if props.Stroke == true or (props.Stroke ~= false and props.Variant == "white") then
		C.stroke(Colors.stroke, 1.5).Parent = button
	end
	-- gờ: nút đậm sẫm rõ, nút nhạt sẫm nhẹ. nút trong suốt hoặc thấp hơn 24 thì bỏ
	local depth = 0
	if props.Lip ~= false and props.Variant ~= "ghost" and (props.Transparency or 0) < 0.5 and h >= 24 then
		depth = h >= 40 and 4 or 3
		C.lip(button, depth, luminance(base) < 0.75 and 0.76 or 0.9)
	end
	local pad = C.new("UIPadding", {
		Name = "Padding",
		PaddingBottom = UDim.new(0, depth),
		PaddingLeft = UDim.new(0, props.PadLeft or ((props.AutomaticSize and props.AutomaticSize ~= Enum.AutomaticSize.None) and 14 or 0)),
		PaddingRight = UDim.new(0, props.PadRight or ((props.AutomaticSize and props.AutomaticSize ~= Enum.AutomaticSize.None) and 14 or 0)),
	})
	pad.Parent = button

	local press = C.new("UIScale", { Name = "PressScale", Scale = 1, Parent = button })
	local function setPressed(on)
		TweenService:Create(press, TweenInfo.new(on and 0.06 or 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = on and 0.95 or 1 }):Play()
	end
	button.InputBegan:Connect(function(input)
		if button:GetAttribute("Disabled") ~= true and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			setPressed(true)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			setPressed(false)
		end
	end)

	button:SetAttribute("BaseColor", base)
	local ghost = props.Variant == "ghost"
	button.MouseEnter:Connect(function()
		if button:GetAttribute("Disabled") ~= true then
			local now = button:GetAttribute("BaseColor") or base
			local goal = ghost and { BackgroundTransparency = 0, BackgroundColor3 = Colors.panelAlt } or { BackgroundColor3 = hoverOf(now) }
			hoverTweens[button] = TweenService:Create(button, TweenInfo.new(0.12), goal)
			hoverTweens[button]:Play()
		end
	end)
	button.MouseLeave:Connect(function()
		setPressed(false)
		local goal = { BackgroundColor3 = button:GetAttribute("BaseColor") or base }
		if ghost then
			goal.BackgroundTransparency = button:GetAttribute("BaseTransparency") or 1
		end
		hoverTweens[button] = TweenService:Create(button, TweenInfo.new(0.12), goal)
		hoverTweens[button]:Play()
	end)
	if onClick then
		button.Activated:Connect(function()
			if button:GetAttribute("Disabled") ~= true then
				onClick(button)
			end
		end)
	end
	return button
end

-- đổi màu gốc (BaseColor) để hover tính lại đúng, dùng cho tab đang chọn...
function C.setButtonColor(button, color)
	if hoverTweens[button] then
		hoverTweens[button]:Cancel()
		hoverTweens[button] = nil
	end
	button:SetAttribute("BaseColor", color)
	button.BackgroundColor3 = color
end

-- không đụng .Active (nút vẫn phải nuốt click, không cho xuyên xuống thành phố), dùng attribute Disabled
function C.setEnabled(button, enabled)
	button:SetAttribute("Disabled", not enabled)
	button.AutoButtonColor = false
	button.TextTransparency = enabled and 0 or 0.45
	if button:GetAttribute("BaseTransparency") == nil then
		button:SetAttribute("BaseTransparency", button.BackgroundTransparency)
	end
	local baseT = button:GetAttribute("BaseTransparency")
	button.BackgroundTransparency = enabled and baseT or math.max(baseT, 0.45)
end

-- fade cả cụm UI rồi gọi done(). transparency gốc được lưu lại để C.restoreFade(root) trả về như cũ
-- (cho phần tử hiện lại nhiều lần)
local function fadeItems(root)
	local items = { root }
	for _, d in ipairs(root:GetDescendants()) do
		table.insert(items, d)
	end
	return items
end

function C.fadeOut(root, duration, done)
	local info = TweenInfo.new(duration or 0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for _, d in ipairs(fadeItems(root)) do
		if d:IsA("GuiObject") then
			if d:GetAttribute("FadeBg") == nil then
				d:SetAttribute("FadeBg", d.BackgroundTransparency)
			end
			local goal = { BackgroundTransparency = 1 }
			if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
				if d:GetAttribute("FadeText") == nil then
					d:SetAttribute("FadeText", d.TextTransparency)
				end
				goal.TextTransparency = 1
			end
			TweenService:Create(d, info, goal):Play()
		elseif d:IsA("UIStroke") then
			if d:GetAttribute("FadeStroke") == nil then
				d:SetAttribute("FadeStroke", d.Transparency)
			end
			TweenService:Create(d, info, { Transparency = 1 }):Play()
		end
	end
	if done then
		task.delay(duration or 0.35, done)
	end
end

function C.restoreFade(root)
	for _, d in ipairs(fadeItems(root)) do
		local bg, text, stroke = d:GetAttribute("FadeBg"), d:GetAttribute("FadeText"), d:GetAttribute("FadeStroke")
		if bg ~= nil then
			d.BackgroundTransparency = bg
		end
		if text ~= nil then
			d.TextTransparency = text
		end
		if stroke ~= nil then
			d.Transparency = stroke
		end
	end
end

-- hiện ra kiểu pop (scale từ nhỏ lên), dùng cho thẻ, toast, modal
function C.popIn(frame, from, duration)
	local scale = frame:FindFirstChild("PopScale") or C.new("UIScale", { Name = "PopScale", Parent = frame })
	scale.Scale = from or 0.9
	TweenService:Create(scale, TweenInfo.new(duration or 0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- slider. opts: min, max, step, value, onChanged(value)
-- tuỳ chọn: ticks = bước vạch, labelEvery = bước vạch có số, fill = 2 màu gradient cho phần đã chọn
-- trả về { frame, set(value), get() }
function C.slider(opts)
	local minV, maxV, step = opts.min, opts.max, opts.step
	local value = opts.value or minV
	local frame = C.new("Frame", {
		Name = "Slider",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, opts.ticks and 40 or 26),
		LayoutOrder = opts.LayoutOrder or 0,
		Parent = opts.Parent,
	})
	local track = C.new("Frame", {
		Name = "Track",
		BackgroundColor3 = Colors.track,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -22, 0, 8),
		Position = UDim2.new(0, 11, 0, 13),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = frame,
	})
	C.round().Parent = track
	if opts.ticks then
		for v = minV, maxV, opts.ticks do
			local alpha = (v - minV) / (maxV - minV)
			local major = opts.labelEvery and (v - minV) % opts.labelEvery == 0
			if major then
				C.new("Frame", { Name = "Tick", BackgroundColor3 = Colors.strokeStrong, BorderSizePixel = 0, Size = UDim2.fromOffset(2, 5), Position = UDim2.new(alpha, -1, 1, 4), Parent = track })
				C.label({ Text = tostring(v), Font = Theme.FontMedium, TextSize = 10, Color = Colors.textMuted, XAlign = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(24, 12), Position = UDim2.new(alpha, -12, 1, 10), Parent = track })
			end
		end
	end
	local fill = C.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = opts.color or Colors.accent,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 1, 0),
		Parent = track,
	})
	C.round().Parent = fill
	if opts.fill then
		-- gradient gắn lên phần đã chọn nên co giãn theo độ dài fill
		C.new("UIGradient", { Name = "FillGradient", Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, opts.fill[1]), ColorSequenceKeypoint.new(1, opts.fill[2]) }), Parent = fill })
	end
	local knob = C.new("Frame", {
		Name = "Knob",
		BackgroundColor3 = Colors.panel,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(22, 22),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		ZIndex = 3,
		Parent = track,
	})
	C.round().Parent = knob
	local knobRing = C.stroke(opts.color or Colors.accent, 4)
	knobRing.Parent = knob
	-- vùng bắt input to hơn thanh, cho dễ kéo trên điện thoại
	local hit = C.new("TextButton", {
		Name = "Hit",
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 32),
		Position = UDim2.new(0, 0, 0, -3),
		ZIndex = 4,
		Parent = frame,
	})

	C.selectable(hit)
	local obj = { frame = frame }

	local function render()
		local alpha = (maxV > minV) and (value - minV) / (maxV - minV) or 0
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
	end

	function obj.set(v, silent)
		v = math.clamp(v, minV, maxV)
		v = minV + math.floor((v - minV) / step + 0.5) * step
		v = math.clamp(v, minV, maxV)
		local changed = math.abs(v - value) > 1e-9
		value = v
		render()
		if changed and not silent and opts.onChanged then
			opts.onChanged(value)
		end
	end

	function obj.get()
		return value
	end

	function obj.setColor(color)
		knobRing.Color = color
		if not opts.fill then
			fill.BackgroundColor3 = color
		end
	end

	local enabled = true
	local dragInput = nil -- chuột: MouseButton1, chạm: đúng ngón đã chạm vào thanh
	-- touch: chưa biết là kéo thanh (ngang) hay cuộn bảng (dọc) cho tới khi ngón tay di chuyển
	local touchStart = nil
	local touchDecided = false
	local function updateFromX(x)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		obj.set(minV + alpha * (maxV - minV))
	end

	function obj.setEnabled(on)
		enabled = on
		dragInput = nil
		knob.BackgroundTransparency = on and 0 or 0.5
		knobRing.Transparency = on and 0 or 0.6
	end

	-- gamepad: chọn slider rồi LB/RB để giảm/tăng
	UserInputService.InputBegan:Connect(function(input)
		if not enabled or not gamepadMode then
			return
		end
		local selected = nil
		pcall(function()
			selected = GuiService.SelectedObject
		end)
		if selected ~= hit then
			return
		end
		if input.KeyCode == Enum.KeyCode.ButtonL1 then
			obj.set(value - step)
		elseif input.KeyCode == Enum.KeyCode.ButtonR1 then
			obj.set(value + step)
		end
	end)

	hit.InputBegan:Connect(function(input)
		if not enabled then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragInput = input
			updateFromX(input.Position.X)
		elseif input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
			touchStart = input.Position
			touchDecided = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragInput then
			return
		end
		if dragInput.UserInputType == Enum.UserInputType.Touch then
			if input ~= dragInput then
				return
			end
			if not touchDecided and touchStart then
				local dx = math.abs(input.Position.X - touchStart.X)
				local dy = math.abs(input.Position.Y - touchStart.Y)
				if dy > 8 and dy >= dx then
					dragInput = nil -- vuốt dọc thì nhường cho bảng cuộn
					return
				elseif dx > 8 then
					touchDecided = true
				else
					return
				end
			end
			updateFromX(input.Position.X)
		elseif input.UserInputType == Enum.UserInputType.MouseMovement then
			-- nhả chuột ngoài cửa sổ có khi không ra InputEnded, nên check lại nút chuột
			if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
				dragInput = nil
				return
			end
			updateFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if not dragInput then
			return
		end
		if input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
			-- tap không kéo: lấy giá trị tại chỗ chạm
			if dragInput.UserInputType == Enum.UserInputType.Touch and not touchDecided then
				updateFromX(input.Position.X)
			end
			dragInput = nil
		end
	end)

	render()
	return obj
end

-- nút -/+ chỉnh cấp. opts: min, max, value, onChanged(value)
function C.stepper(opts)
	local value = opts.value or opts.min
	local frame = C.new("Frame", {
		Name = "Stepper",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(112, 32),
		LayoutOrder = opts.LayoutOrder or 0,
		Parent = opts.Parent,
	})
	local obj = { frame = frame }
	local valueLabel
	local minus = C.button({ Text = "−", Size = UDim2.fromOffset(32, 32), TextSize = 18, Radius = 16, Parent = frame }, function()
		obj.set(value - 1)
	end)
	minus.Name = "Minus"
	valueLabel = C.label({
		Text = tostring(value),
		Size = UDim2.fromOffset(48, 32),
		Position = UDim2.fromOffset(32, 0),
		XAlign = Enum.TextXAlignment.Center,
		Font = Theme.FontDisplay,
		TextSize = 16,
		Parent = frame,
	})
	local plus = C.button({ Text = "+", Size = UDim2.fromOffset(32, 32), Position = UDim2.fromOffset(80, 0), TextSize = 18, Radius = 16, Parent = frame }, function()
		obj.set(value + 1)
	end)
	plus.Name = "Plus"

	function obj.set(v, silent)
		v = math.clamp(math.floor(v + 0.5), opts.min, opts.max)
		local changed = v ~= value
		value = v
		valueLabel.Text = tostring(value)
		if changed and not silent and opts.onChanged then
			opts.onChanged(value)
		end
	end
	function obj.get()
		return value
	end
	function obj.setEnabled(enabled)
		C.setEnabled(minus, enabled)
		C.setEnabled(plus, enabled)
	end
	return obj
end

-- segmented control. tabs = { { key, text } }, onSelect(key)
function C.tabs(opts)
	local frame = C.new("Frame", {
		Name = "Tabs",
		BackgroundColor3 = Colors.panelAlt,
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.new(1, 0, 0, 38),
		LayoutOrder = opts.LayoutOrder or 0,
		ZIndex = opts.ZIndex or 1,
		Parent = opts.Parent,
	})
	C.corner(Theme.Radius.md).Parent = frame
	C.padding(4).Parent = frame
	local layout = C.list(Enum.FillDirection.Horizontal, 4)
	layout.Parent = frame
	local buttons = {}
	local obj = { frame = frame, selected = nil }
	local count = #opts.tabs
	function obj.select(key, silent)
		obj.selected = key
		for k, b in pairs(buttons) do
			local on = k == key
			C.setButtonColor(b, Colors.panel)
			b.BackgroundTransparency = on and 0 or 1
			b:SetAttribute("BaseTransparency", b.BackgroundTransparency)
			b.TextColor3 = on and Colors.text or Colors.textDim
			local s = b:FindFirstChild("Shadow")
			if s then
				s.Transparency = on and 0.88 or 1
			end
		end
		if not silent and opts.onSelect then
			opts.onSelect(key)
		end
	end
	for i, tab in ipairs(opts.tabs) do
		local b = C.button({
			Name = "Tab_" .. tab.key,
			Text = tab.text,
			Variant = "white",
			Stroke = false,
			Lip = false,
			Size = UDim2.new(1 / count, -4 * (count - 1) / count, 1, 0),
			TextSize = 13,
			Radius = Theme.Radius.sm,
			LayoutOrder = i,
			ZIndex = opts.ZIndex,
			Parent = frame,
		}, function()
			obj.select(tab.key)
		end)
		C.shadowStroke(1, 0.88).Parent = b
		buttons[tab.key] = b
	end
	obj.buttons = buttons
	return obj
end

local modals = {} -- giữ lại để co cho vừa màn nhỏ
local openStack = {} -- modal đang mở, mới nhất ở cuối. nút B gamepad đóng cái trên cùng

pcall(function()
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.ButtonB and #openStack > 0 then
			openStack[#openStack].close()
		end
	end)
end)
local viewDesign = { w = 1366, h = 768 }

local function fitCard(entry)
	local w = math.min(entry.w, viewDesign.w - 24)
	local h = math.min(entry.h, viewDesign.h - 24)
	entry.card.Size = UDim2.fromOffset(w, h)
end

-- kích thước theo đơn vị thiết kế (đã chia UIScale)
function C.fitModals(designWidth, designHeight)
	viewDesign.w, viewDesign.h = designWidth, designHeight
	for _, entry in ipairs(modals) do
		fitCard(entry)
	end
end

function C.closeButton(props, onClick)
	return C.button({
		Name = props.Name or "Close",
		Text = "×",
		Font = Theme.FontBold,
		TextSize = 22,
		Size = UDim2.fromOffset(props.Size or 34, props.Size or 34),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		Radius = math.floor((props.Size or 34) / 2),
		Lip = false,
		ZIndex = props.ZIndex,
		Parent = props.Parent,
	}, onClick)
end

-- trả về { root, body, open(), close(), setTitle() }
function C.modal(opts)
	local root = C.new("Frame", {
		Name = opts.Name or "Modal",
		BackgroundColor3 = Colors.overlay,
		BackgroundTransparency = 0.5,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 50,
		Active = true,
		Parent = opts.Parent,
	})
	local card = C.panel({
		Name = "Card",
		Size = opts.Size or UDim2.fromOffset(560, 440),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Radius = Theme.Radius.xl,
		StrokeTransparency = 0.8,
		ZIndex = 51,
		Parent = root,
	})
	local title = C.label({
		Name = "Title",
		Text = opts.Title or "",
		Font = Theme.FontDisplay,
		TextSize = 21,
		Truncate = true,
		Size = UDim2.new(1, -80, 0, 58),
		Position = UDim2.fromOffset(22, 0),
		ZIndex = 52,
		Parent = card,
	})
	local obj = { root = root, card = card }
	local closeButton = C.closeButton({ Position = UDim2.new(1, -16, 0, 12), AnchorPoint = Vector2.new(1, 0), ZIndex = 52, Parent = card }, function()
		obj.close()
	end)
	C.new("Frame", { Name = "HeaderRule", BackgroundColor3 = Colors.rule, BorderSizePixel = 0, Size = UDim2.new(1, -44, 0, 1), Position = UDim2.fromOffset(22, 58), ZIndex = 52, Parent = card })
	local size = opts.Size or UDim2.fromOffset(560, 440)
	local entry = { card = card, w = size.X.Offset, h = size.Y.Offset }
	table.insert(modals, entry)
	fitCard(entry)
	local body = C.new("ScrollingFrame", {
		Name = "Body",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -28, 1, -74),
		Position = UDim2.fromOffset(14, 66),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Colors.strokeStrong,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 52,
		Parent = card,
	})
	C.selectable(body)
	C.list(Enum.FillDirection.Vertical, 10).Parent = body
	C.padding(4, 8).Parent = body
	obj.body = body
	function obj.open()
		body.CanvasPosition = Vector2.new(0, 0)
		root.Visible = true
		C.popIn(card, 0.94, 0.22)
		table.insert(openStack, obj)
		if opts.onOpen then
			opts.onOpen()
		end
		C.focus(closeButton)
	end
	function obj.close()
		root.Visible = false
		for i = #openStack, 1, -1 do
			if openStack[i] == obj then
				table.remove(openStack, i)
			end
		end
		if gamepadMode then
			pcall(function()
				GuiService.SelectedObject = nil
			end)
		end
		if opts.onClose then
			opts.onClose()
		end
	end
	function obj.setTitle(text)
		title.Text = text
	end
	function obj.clear()
		for _, child in ipairs(body:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end
	return obj
end

function C.textbox(props)
	local box = C.new("TextBox", {
		Name = props.Name or "Input",
		BackgroundColor3 = Colors.panelAlt,
		BorderSizePixel = 0,
		Text = props.Text or "",
		PlaceholderText = props.Placeholder or "",
		PlaceholderColor3 = Colors.textMuted,
		TextColor3 = Colors.text,
		Font = Theme.FontMedium,
		TextSize = props.TextSize or 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Size = props.Size or UDim2.fromOffset(180, 38),
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	C.corner(Theme.Radius.md).Parent = box
	local stroke = C.stroke(Colors.stroke, 1.5)
	stroke.Parent = box
	C.padding(4, 12).Parent = box
	box.Focused:Connect(function()
		stroke.Color = Colors.accent
	end)
	box.FocusLost:Connect(function()
		stroke.Color = Colors.stroke
	end)
	return trackText(box)
end

function C.row(props)
	local frame = C.new("Frame", {
		Name = props.Name or "Row",
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.new(1, 0, 0, 36),
		AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	C.list(Enum.FillDirection.Horizontal, props.Spacing or 8, nil, Enum.VerticalAlignment.Center).Parent = frame
	return frame
end

-- ZIndex cho cả cây con, dùng cho modal nằm trên cùng
function C.setZ(root, z)
	if root:IsA("GuiObject") then
		root.ZIndex = z
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("GuiObject") then
			d.ZIndex = z
		end
	end
end

return C
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- thẻ thành phố góc trên trái (tên, tháng, 4 ô chỉ số) và thanh điều khiển góc trên phải

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Util = require(ReplicatedStorage:WaitForChild("EconCity"):WaitForChild("Util"))
local Config = require(ReplicatedStorage:WaitForChild("EconCity"):WaitForChild("Config"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local C = require(script.Parent:WaitForChild("Components"))
local Icons = require(script.Parent:WaitForChild("Icons"))
local Colors = Theme.Colors

local Hud = {}

local BLOCK_H = 76
local LEFT_W = 186
local TILE_W, TILE_H, TILE_GAP = 112, 60, 6
local BAR_H = 60

local function soft(c)
	return c:Lerp(Color3.new(1, 1, 1), 0.86)
end

-- số nảy lên khi đổi giá trị, để thấy là đã sang tháng mới
local function bump(label)
	local scale = label:FindFirstChild("Bump") or C.new("UIScale", { Name = "Bump", Parent = label })
	scale.Scale = 1.14
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function setValue(label, text, animate)
	if label.Text ~= text then
		label.Text = text
		if animate then
			bump(label)
		end
	end
end

local function statTile(parent, x, spec)
	local tile = C.well({ Name = spec.name, Size = UDim2.fromOffset(TILE_W, TILE_H), Position = UDim2.fromOffset(x, 8), Parent = parent })
	local _, icon = Icons.badge(spec.icon, { Name = "Badge", Size = 22, IconSize = 13, Color = spec.color, Soft = soft(spec.color), Position = UDim2.fromOffset(8, 7), Parent = tile })
	C.label({ Name = "Title", Text = spec.title, Font = Theme.FontBold, TextSize = 11, Color = Colors.textDim, Truncate = true, Size = UDim2.new(1, -38, 0, 22), Position = UDim2.fromOffset(34, 7), Parent = tile })
	local value = C.label({ Name = "Value", Text = "-", Font = Theme.FontDisplay, TextSize = 20, Truncate = true, Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(9, 28), Parent = tile })
	local sub = C.label({ Name = "Sub", Text = "", Font = Theme.FontMedium, TextSize = 11, Color = Colors.textMuted, Truncate = true, Size = UDim2.new(1, -16, 0, 12), Position = UDim2.fromOffset(9, 47), Parent = tile })
	return value, sub, icon, tile
end

-- ctx: { onTogglePause, onNewGame, onHistory, onLeaderboard, onClass, onTickNow, onTogglePanel }
function Hud.new(gui, ctx)
	local obj = {}

	-- Thẻ thành phố ----------------------------------------------------------------------
	local blockW = LEFT_W + TILE_W * 4 + TILE_GAP * 3 + 8
	local stats = C.panel({ Name = "Stats", Size = UDim2.fromOffset(blockW, BLOCK_H), Position = UDim2.fromOffset(12, 10), Radius = Theme.Radius.xl, Parent = gui })
	-- logo: ô xanh gradient, hàng nhà trắng
	local logo = C.new("Frame", { Name = "Logo", BackgroundColor3 = Colors.panel, BorderSizePixel = 0, Size = UDim2.fromOffset(46, 46), Position = UDim2.fromOffset(14, 15), Parent = stats })
	C.corner(14).Parent = logo
	C.gradient(Colors.accent, Colors.violet, 45).Parent = logo
	local skyline = { { 7, 14 }, { 14, 24 }, { 22, 18 }, { 30, 28 } }
	for k, b in ipairs(skyline) do
		local bar = C.new("Frame", { Name = "Tower", BackgroundColor3 = Colors.panel, BackgroundTransparency = k % 2 == 0 and 0 or 0.25, BorderSizePixel = 0, Size = UDim2.fromOffset(7, b[2]), Position = UDim2.fromOffset(b[1], 38 - b[2]), Parent = logo })
		C.corner(2).Parent = bar
	end
	C.label({ Name = "Name", Text = "Econ City", Font = Theme.FontDisplay, TextSize = 20, Size = UDim2.fromOffset(LEFT_W - 76, 24), Position = UDim2.fromOffset(70, 11), Parent = stats })
	obj.month = C.label({ Name = "Month", Text = "Tháng 0 / 24", Font = Theme.FontMedium, TextSize = 12, Color = Colors.textDim, Size = UDim2.fromOffset(LEFT_W - 76, 16), Position = UDim2.fromOffset(70, 35), Parent = stats })
	local monthTrack = C.new("Frame", { Name = "MonthBar", BackgroundColor3 = Colors.track, BorderSizePixel = 0, Size = UDim2.fromOffset(LEFT_W - 82, 6), Position = UDim2.fromOffset(70, 56), Parent = stats })
	C.round().Parent = monthTrack
	obj.monthFill = C.new("Frame", { Name = "Fill", BackgroundColor3 = Colors.panel, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = monthTrack })
	C.round().Parent = obj.monthFill
	C.gradient(Colors.accent, Colors.violet, 0).Parent = obj.monthFill

	local specs = {
		{ name = "Stat_NGÂN SÁCH", title = "Ngân sách", icon = "coin", color = Colors.gold },
		{ name = "Stat_DÂN SỐ", title = "Dân số", icon = "people", color = Colors.people },
		{ name = "Stat_VIỆC LÀM", title = "Việc làm", icon = "briefcase", color = Colors.jobs },
		{ name = "Stat_HẠNH PHÚC", title = "Hạnh phúc", icon = "face", color = Colors.good },
	}
	local x = LEFT_W
	obj.budget, obj.budgetSub = statTile(stats, x, specs[1])
	x = x + TILE_W + TILE_GAP
	obj.population, obj.populationSub = statTile(stats, x, specs[2])
	x = x + TILE_W + TILE_GAP
	obj.employment, obj.employmentSub = statTile(stats, x, specs[3])
	x = x + TILE_W + TILE_GAP
	local happyTile
	obj.happiness, obj.happinessSub, obj.happyIcon, happyTile = statTile(stats, x, specs[4])
	obj.happyBadge = happyTile:FindFirstChild("Badge")
	obj.happinessSub.Text = "≥ 50: dân đến"

	-- nhãn vai trò giáo viên / cảnh báo lưu dữ liệu, học sinh thường không thấy
	obj.modeBadge = C.pill({ Name = "ModeBadge", Text = "", TextSize = 11, Color = Colors.goldSoft, TextColor = Colors.warn, Height = 24, Position = UDim2.fromOffset(14, BLOCK_H + 18), Parent = gui })
	-- màn hẹp thì ẩn các dòng phụ này. riêng thu chi/tháng của ngân sách luôn hiện (phản hồi chính khi chỉnh thuế)
	obj.subs = { obj.populationSub, obj.employmentSub, obj.happinessSub }

	-- Thanh điều khiển ---------------------------------------------------------------------
	local bar = C.panel({
		Name = "Controls",
		Size = UDim2.fromOffset(0, BAR_H),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.new(1, -12, 0, 10),
		AnchorPoint = Vector2.new(1, 0),
		Radius = Theme.Radius.xl,
		Parent = gui,
	})
	C.padding(8).Parent = bar
	C.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center).Parent = bar
	local order = 0
	local function nextOrder()
		order = order + 1
		return order
	end

	-- trạng thái + đếm ngược chung 1 ô
	local statusCell = C.well({ Name = "Status", Size = UDim2.fromOffset(118, 44), LayoutOrder = nextOrder(), Parent = bar })
	obj.statusDot = C.new("Frame", { Name = "Dot", BackgroundColor3 = Colors.good, BorderSizePixel = 0, Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(12, 10), Parent = statusCell })
	C.round().Parent = obj.statusDot
	obj.statusText = C.label({ Name = "StatusText", Text = "Đang tải", Font = Theme.FontBold, TextSize = 12, Truncate = true, Size = UDim2.new(1, -32, 0, 18), Position = UDim2.fromOffset(26, 5), Parent = statusCell })
	obj.countdown = C.label({ Name = "Countdown", Text = "", Font = Theme.FontMedium, TextSize = 11, Color = Colors.textDim, Size = UDim2.new(1, -24, 0, 16), Position = UDim2.fromOffset(12, 23), Parent = statusCell })
	obj.statusCell = statusCell

	obj.pauseButton = C.button({
		Name = "Pause",
		Text = "TẠM DỪNG",
		Variant = "success",
		Font = Theme.FontDisplay,
		TextSize = 15,
		Size = UDim2.fromOffset(136, 44),
		PadLeft = 24,
		LayoutOrder = nextOrder(),
		Parent = bar,
	}, function()
		if obj.finished then
			-- ván vừa kết thúc đúng lúc bấm Tạm dừng thì đừng mở ván mới ngoài ý muốn
			if os.clock() - (obj.finishedAt or 0) < 2 then
				return
			end
			ctx.onNewGame()
		else
			ctx.onTogglePause()
		end
	end)
	local pauseIcon = nil
	local function setPauseIcon(name)
		if pauseIcon and pauseIcon:GetAttribute("IconName") == name then
			return
		end
		if pauseIcon then
			pauseIcon:Destroy()
		end
		pauseIcon = Icons.draw(name, { Size = 18, Color = Colors.onAccent, Position = UDim2.new(0, -12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = obj.pauseButton })
	end

	obj.tickNowButton = C.button({ Name = "TickNow", Text = "Tick ngay", Variant = "secondary", TextSize = 12, Size = UDim2.fromOffset(98, 44), PadLeft = 22, LayoutOrder = nextOrder(), Parent = bar }, ctx.onTickNow)
	Icons.draw("forward", { Size = 14, Color = Colors.accent, Position = UDim2.new(0, -8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = obj.tickNowButton })
	obj.tickNowButton.Visible = false

	C.new("Frame", { Name = "Divider", BackgroundColor3 = Colors.rule, BorderSizePixel = 0, Size = UDim2.fromOffset(1, 32), LayoutOrder = nextOrder(), Parent = bar })

	local navIcons = {}
	local function navButton(name, text, icon, onClick)
		local b = C.button({ Name = name, Text = text, Variant = "ghost", TextColor = Colors.textDim, TextSize = 11, YAlign = Enum.TextYAlignment.Bottom, Size = UDim2.fromOffset(64, 44), Radius = Theme.Radius.md, LayoutOrder = nextOrder(), Parent = bar }, onClick)
		b:FindFirstChild("Padding").PaddingBottom = UDim.new(0, 4)
		navIcons[b] = Icons.draw(icon, { Size = 18, Color = Colors.textDim, Position = UDim2.new(0.5, 0, 0, 4), AnchorPoint = Vector2.new(0.5, 0), Parent = b })
		return b
	end
	obj.historyButton = navButton("History", "Lịch sử", "chart", ctx.onHistory)
	obj.leaderboardButton = navButton("Leaderboard", "Xếp hạng", "podium", ctx.onLeaderboard)
	obj.classButton = navButton("Class", "Lớp học", "people", ctx.onClass)
	obj.panelToggle = navButton("PanelToggle", "Ẩn bảng", "grid", ctx.onTogglePanel)

	local lastMonth = nil
	function obj.update(snap)
		local s = snap.session
		if not s then
			return
		end
		local animate = lastMonth ~= nil and lastMonth ~= s.month
		lastMonth = s.month
		obj.month.Text = string.format("Tháng %d / %d", s.month, s.maxMonths)
		local progress = s.maxMonths > 0 and math.clamp(s.month / s.maxMonths, 0, 1) or 0
		TweenService:Create(obj.monthFill, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromScale(progress, 1) }):Play()
		setValue(obj.budget, Util.formatMoneyFull(s.budget), animate)
		obj.budget.TextColor3 = s.budget < 0 and Colors.bad or Colors.text
		setValue(obj.population, Util.formatInt(s.population or 0), animate)
		local hasPeople = (s.population or 0) > 0
		setValue(obj.employment, hasPeople and string.format("%d%%", Util.round(s.employment or 0)) or "—", animate)
		obj.employment.TextColor3 = (hasPeople and (s.employment or 0) < 80) and Colors.warn or Colors.text
		setValue(obj.happiness, tostring(Util.round(s.happiness)), animate)
		local hColor = Theme.happinessColor(s.happiness)
		obj.happiness.TextColor3 = hColor
		Icons.setColor(obj.happyIcon, hColor)
		obj.happyBadge.BackgroundColor3 = soft(hColor)
		Icons.setMood(obj.happyIcon, s.happiness >= 65 and "happy" or (s.happiness >= 50 and "neutral" or "sad"))

		local finished = s.status == "ENDED" or s.status == "FAILED"
		if finished and not obj.finished then
			obj.finishedAt = os.clock()
		end
		obj.finished = finished
		obj.status = s.status
		obj.notStarted = s.status == "PAUSED" and s.month == 0
		obj.statusText.Text = obj.notStarted and "Chưa chạy" or (Theme.StatusTitle[s.status] or s.status)
		obj.statusDot.BackgroundColor3 = obj.notStarted and Colors.textMuted or Theme.statusColor(s.status)
		obj.renderPauseText()
		obj.tickNowButton.Visible = snap.isStudio == true and not obj.compact
		C.setEnabled(obj.tickNowButton, s.status == "ACTIVE")

		local role = (snap.isOwner and "Chủ game") or (snap.isTeacher and "Giáo viên") or nil
		local parts = { role }
		local color, bg = Colors.textDim, Colors.panel
		if snap.inPrivateRoom then
			table.insert(parts, "Phòng học riêng")
		end
		if snap.saveDisabled then
			table.insert(parts, "Không lưu được tiến độ, hãy thoát ra rồi vào lại game")
			color, bg = Colors.bad, soft(Colors.bad)
		elseif snap.persistence == "memory" then
			table.insert(parts, "Chế độ thử: dữ liệu chỉ lưu tạm trong server này")
			color, bg = Colors.warn, Colors.goldSoft
		end
		obj.modeBadge.Text = table.concat(parts, " | ")
		obj.modeBadge.TextColor3 = color
		obj.modeBadge.BackgroundColor3 = bg
		obj.modeBadge.Visible = #parts > 0
	end

	-- net = thu chi dự kiến mỗi tháng, Main tính bằng CityEngine
	function obj.setNet(net, capacity, jobs)
		obj.budgetSub.Text = string.format("%s%s/th", net >= 0 and "+" or "", Util.formatMoneyFull(net))
		obj.budgetSub.TextColor3 = net >= 0 and Colors.good or Colors.bad
		obj.populationSub.Text = "/ " .. Util.formatInt(capacity) .. " chỗ ở"
		obj.employmentSub.Text = Util.formatInt(jobs) .. " chỗ làm"
	end

	function obj.renderPauseText()
		local text, variantColor, icon
		if obj.finished then
			text, variantColor, icon = "VÁN MỚI", Colors.accent, "play" -- đóng màn hình kết thúc rồi vẫn chơi lại được
		elseif obj.notStarted then
			text, variantColor, icon = "BẮT ĐẦU", Colors.success, "play"
		elseif obj.status == "PAUSED" then
			text, variantColor, icon = "CHẠY TIẾP", Colors.success, "play"
		else
			text, variantColor, icon = "TẠM DỪNG", Colors.amber, "pause"
		end
		obj.pauseButton.Text = text
		if obj.pauseButton:GetAttribute("BaseColor") ~= variantColor then
			C.setButtonColor(obj.pauseButton, variantColor)
		end
		setPauseIcon(icon)
	end

	-- màn hẹp (điện thoại, tablet dọc): ô trạng thái chỉ còn đồng hồ, nhãn nút ngắn lại
	function obj.setCompact(compact)
		obj.compact = compact
		obj.statusText.Visible = not compact
		obj.statusCell.Size = UDim2.fromOffset(compact and 70 or 118, 44)
		obj.countdown.Position = compact and UDim2.fromOffset(8, 14) or UDim2.fromOffset(12, 23)
		obj.countdown.Size = compact and UDim2.new(1, -16, 0, 16) or UDim2.new(1, -24, 0, 16)
		obj.countdown.TextXAlignment = compact and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
		obj.statusDot.Visible = not compact
		obj.leaderboardButton.Text = compact and "Hạng" or "Xếp hạng"
		obj.classButton.Text = compact and "Lớp" or "Lớp học"
		obj.panelToggle.Text = compact and "Xây" or (obj.panelVisible and "Ẩn bảng" or "Xây dựng")
		for _, sub in ipairs(obj.subs) do
			sub.Visible = not compact
		end
		obj.renderPauseText()
		if compact then
			obj.tickNowButton.Visible = false
		end
	end

	-- nút Xây dựng sáng lên khi bảng đang mở
	function obj.setPanelVisible(visible)
		obj.panelVisible = visible
		local b = obj.panelToggle
		b:SetAttribute("BaseTransparency", visible and 0 or 1)
		b.BackgroundTransparency = visible and 0 or 1
		C.setButtonColor(b, visible and Colors.accentSoft or Colors.panel)
		b.TextColor3 = visible and Colors.accent or Colors.textDim
		Icons.setColor(navIcons[b], visible and Colors.accent or Colors.textDim)
		if not obj.compact then
			b.Text = visible and "Ẩn bảng" or "Xây dựng"
		end
	end

	function obj.updateCountdown(snap, serverNow)
		local s = snap and snap.session
		if s and (s.status == "ENDED" or s.status == "FAILED") then
			obj.countdown.Text = "Hết ván"
			return
		end
		if not s or s.status ~= "ACTIVE" then
			obj.countdown.Text = string.format("%ds / tháng", Config.TICK_SECONDS)
			return
		end
		local remaining = math.max(0, math.ceil((snap.nextTickAt or 0) - serverNow))
		obj.countdown.Text = string.format("còn %ds", remaining)
	end

	setPauseIcon("play")
	return obj
end

Hud.BLOCK_H = BLOCK_H
return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">Icons</string><ProtectedString name="Source"><![CDATA[-- icon vẽ bằng Frame/viền/chữ, mỗi cái nằm trong ô vuông size x size.
-- chưa upload ảnh lên Roblox nên không dùng ảnh, emoji thì mỗi máy hiện một kiểu nên cũng bỏ

local Theme = require(script.Parent:WaitForChild("Theme"))
local C = require(script.Parent:WaitForChild("Components"))
local Colors = Theme.Colors

local Icons = {}

local function rect(parent, x, y, w, h, color, radius, props)
	local f = C.new("Frame", {
		Name = props and props.Name or "Shape",
		BackgroundColor3 = color,
		BackgroundTransparency = props and props.Transparency or 0,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(w, h),
		Position = UDim2.fromOffset(x, y),
		AnchorPoint = props and props.AnchorPoint or Vector2.new(0, 0),
		Rotation = props and props.Rotation or 0,
		ZIndex = parent.ZIndex,
		ClipsDescendants = props and props.Clip or false,
		Parent = parent,
	})
	if radius == "full" then
		C.round().Parent = f
	elseif radius and radius > 0 then
		C.corner(radius).Parent = f
	end
	return f
end

local function ring(parent, x, y, d, color, thickness)
	local f = rect(parent, x, y, d, d, color, "full", { Transparency = 1, Name = "Ring" })
	C.stroke(color, thickness).Parent = f
	return f
end

local function glyph(parent, text, color, size, s)
	return C.label({
		Name = "Glyph",
		Text = text,
		Font = Theme.FontDisplay,
		TextSize = size,
		Color = color,
		XAlign = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(s, s),
		ZIndex = parent.ZIndex,
		Parent = parent,
	})
end

-- tam giác trỏ phải ghép từ các cột thấp dần, không dùng xoay vì sẽ bị cắt méo
local function triangle(parent, x0, width, s, color, columns)
	local n = columns or 5
	local cw = width / n
	for k = 0, n - 1 do
		local h = s * 0.62 * (1 - k / n)
		rect(parent, math.floor(x0 + k * cw), math.floor((s - h) / 2), math.ceil(cw) + 1, math.max(2, math.floor(h)), color, 0)
	end
end

local function mouth(icon, mood)
	local old = icon:FindFirstChild("Mouth")
	if old then
		old:Destroy()
	end
	local s = icon:GetAttribute("IconSize") or 20
	local white = Colors.panel
	local t = math.max(1.5, s / 11)
	if mood == "happy" then
		-- miệng cười: nửa dưới vòng tròn
		local clip = rect(icon, math.floor(s * 0.26), math.floor(s * 0.5), math.ceil(s * 0.48), math.ceil(s * 0.3), white, 0, { Name = "Mouth", Transparency = 1, Clip = true })
		ring(clip, 0, -math.floor(s * 0.24), math.ceil(s * 0.48), white, t)
	elseif mood == "sad" then
		local clip = rect(icon, math.floor(s * 0.28), math.floor(s * 0.62), math.ceil(s * 0.44), math.ceil(s * 0.2), white, 0, { Name = "Mouth", Transparency = 1, Clip = true })
		ring(clip, 0, 2, math.ceil(s * 0.44), white, t)
	else
		rect(icon, math.floor(s * 0.3), math.floor(s * 0.64), math.ceil(s * 0.4), math.max(2, math.floor(t)), white, "full", { Name = "Mouth" })
	end
end

local DRAW = {}

DRAW.coin = function(f, s, color)
	rect(f, 0, 0, s, s, color, "full")
	ring(f, math.floor(s * 0.16), math.floor(s * 0.16), math.ceil(s * 0.68), Theme.darken(color, 0.18), 1.5)
	glyph(f, "$", Theme.darken(color, 0.45), math.floor(s * 0.56), s)
end

DRAW.people = function(f, s, color)
	-- người sau nhạt, người trước đậm
	rect(f, math.floor(s * 0.56), math.floor(s * 0.12), math.ceil(s * 0.3), math.ceil(s * 0.3), color, "full", { Transparency = 0.4 })
	rect(f, math.floor(s * 0.48), math.floor(s * 0.48), math.ceil(s * 0.48), math.ceil(s * 0.4), color, math.floor(s * 0.2), { Transparency = 0.4 })
	rect(f, math.floor(s * 0.14), math.floor(s * 0.06), math.ceil(s * 0.38), math.ceil(s * 0.38), color, "full")
	rect(f, math.floor(s * 0.02), math.floor(s * 0.5), math.ceil(s * 0.62), math.ceil(s * 0.44), color, math.floor(s * 0.22))
end

DRAW.briefcase = function(f, s, color)
	local handle = rect(f, math.floor(s * 0.32), math.floor(s * 0.08), math.ceil(s * 0.36), math.ceil(s * 0.28), color, math.max(2, math.floor(s * 0.1)), { Transparency = 1 })
	C.stroke(color, math.max(1.5, s / 10)).Parent = handle
	rect(f, math.floor(s * 0.04), math.floor(s * 0.3), math.ceil(s * 0.92), math.ceil(s * 0.6), color, math.max(2, math.floor(s * 0.16)))
	rect(f, math.floor(s * 0.04), math.floor(s * 0.52), math.ceil(s * 0.92), math.max(1, math.floor(s * 0.08)), Colors.panel, 0, { Transparency = 0.45 })
end

DRAW.face = function(f, s, color, mood)
	rect(f, 0, 0, s, s, color, "full", { Name = "Face" })
	local e = math.max(2, math.floor(s * 0.13))
	rect(f, math.floor(s * 0.3), math.floor(s * 0.3), e, e, Colors.panel, "full")
	rect(f, math.floor(s * 0.57), math.floor(s * 0.3), e, e, Colors.panel, "full")
	f:SetAttribute("Mood", mood or "happy")
	mouth(f, mood or "happy")
end

DRAW.heart = function(f, s, color)
	local d = math.ceil(s * 0.5)
	rect(f, math.floor(s * 0.04), math.floor(s * 0.1), d, d, color, "full")
	rect(f, math.floor(s * 0.46), math.floor(s * 0.1), d, d, color, "full")
	rect(f, math.floor(s * 0.5), math.floor(s * 0.52), math.ceil(s * 0.52), math.ceil(s * 0.52), color, math.max(1, math.floor(s * 0.06)), { Rotation = 45, AnchorPoint = Vector2.new(0.5, 0.5) })
end

DRAW.box = function(f, s, color)
	rect(f, math.floor(s * 0.1), math.floor(s * 0.32), math.ceil(s * 0.8), math.ceil(s * 0.6), color, math.max(2, math.floor(s * 0.1)))
	rect(f, math.floor(s * 0.04), math.floor(s * 0.14), math.ceil(s * 0.92), math.ceil(s * 0.24), Theme.darken(color, 0.12), math.max(2, math.floor(s * 0.08)))
	rect(f, math.floor(s * 0.43), math.floor(s * 0.14), math.ceil(s * 0.14), math.ceil(s * 0.78), Colors.panel, 0, { Transparency = 0.5 })
end

DRAW.clock = function(f, s, color)
	ring(f, 1, 1, s - 2, color, math.max(1.5, s / 10))
	local t = math.max(2, math.floor(s * 0.12))
	rect(f, math.floor(s / 2 - t / 2), math.floor(s * 0.24), t, math.ceil(s * 0.3), color, "full")
	rect(f, math.floor(s / 2 - t / 2), math.floor(s / 2 - t / 2), math.ceil(s * 0.26), t, color, "full")
end

DRAW.chart = function(f, s, color)
	local w = math.ceil(s * 0.24)
	local heights = { 0.42, 0.68, 0.92 }
	for k, hf in ipairs(heights) do
		local h = math.ceil(s * hf)
		rect(f, math.floor(s * (0.04 + (k - 1) * 0.34)), s - h, w, h, color, math.max(1, math.floor(s * 0.08)))
	end
end

DRAW.podium = function(f, s, color)
	local w = math.ceil(s * 0.3)
	local spec = { { 0.02, 0.56, 0.45 }, { 0.35, 0.92, 0 }, { 0.68, 0.4, 0.45 } }
	for _, p in ipairs(spec) do
		local h = math.ceil(s * p[2])
		rect(f, math.floor(s * p[1]), s - h, w, h, color, math.max(1, math.floor(s * 0.08)), { Transparency = p[3] })
	end
end

DRAW.grid = function(f, s, color)
	local d = math.ceil(s * 0.42)
	local r = math.max(2, math.floor(s * 0.12))
	rect(f, 0, 0, d, d, color, r)
	rect(f, s - d, 0, d, d, color, r, { Transparency = 0.45 })
	rect(f, 0, s - d, d, d, color, r, { Transparency = 0.45 })
	rect(f, s - d, s - d, d, d, color, r)
end

DRAW.check = function(f, s, color)
	local t = math.max(2, math.floor(s * 0.16))
	rect(f, math.floor(s * 0.36), math.floor(s * 0.62), math.ceil(s * 0.34), t, color, "full", { Rotation = 45, AnchorPoint = Vector2.new(0.5, 0.5) })
	rect(f, math.floor(s * 0.6), math.floor(s * 0.48), math.ceil(s * 0.6), t, color, "full", { Rotation = -52, AnchorPoint = Vector2.new(0.5, 0.5) })
end

DRAW.play = function(f, s, color)
	triangle(f, s * 0.24, s * 0.6, s, color, 9)
end

DRAW.pause = function(f, s, color)
	local w = math.ceil(s * 0.2)
	local h = math.ceil(s * 0.62)
	local y = math.floor((s - h) / 2)
	rect(f, math.floor(s * 0.24), y, w, h, color, math.max(1, math.floor(w / 3)))
	rect(f, math.floor(s * 0.56), y, w, h, color, math.max(1, math.floor(w / 3)))
end

DRAW.forward = function(f, s, color)
	triangle(f, s * 0.1, s * 0.4, s, color, 4)
	triangle(f, s * 0.5, s * 0.4, s, color, 4)
end

DRAW.alert = function(f, s, color)
	rect(f, 0, 0, s, s, color, "full")
	glyph(f, "!", Colors.panel, math.floor(s * 0.68), s)
end

DRAW.info = function(f, s, color)
	rect(f, 0, 0, s, s, color, "full")
	glyph(f, "i", Colors.panel, math.floor(s * 0.66), s)
end

DRAW.trophy = function(f, s, color)
	rect(f, math.floor(s * 0.2), math.floor(s * 0.06), math.ceil(s * 0.6), math.ceil(s * 0.46), color, math.max(2, math.floor(s * 0.2)))
	rect(f, math.floor(s * 0.44), math.floor(s * 0.48), math.ceil(s * 0.12), math.ceil(s * 0.24), color, 0)
	rect(f, math.floor(s * 0.26), math.floor(s * 0.72), math.ceil(s * 0.48), math.ceil(s * 0.16), color, math.max(1, math.floor(s * 0.06)))
	ring(f, math.floor(s * 0.04), math.floor(s * 0.12), math.ceil(s * 0.3), color, math.max(1.5, s / 14))
	ring(f, math.floor(s * 0.66), math.floor(s * 0.12), math.ceil(s * 0.3), color, math.max(1.5, s / 14))
end

DRAW.bot = function(f, s, color)
	rect(f, math.floor(s * 0.46), 0, math.ceil(s * 0.08), math.ceil(s * 0.2), color, 0)
	rect(f, math.floor(s * 0.4), 0, math.ceil(s * 0.2), math.ceil(s * 0.14), color, "full")
	rect(f, math.floor(s * 0.08), math.floor(s * 0.18), math.ceil(s * 0.84), math.ceil(s * 0.7), color, math.max(2, math.floor(s * 0.2)))
	local e = math.max(2, math.floor(s * 0.16))
	rect(f, math.floor(s * 0.26), math.floor(s * 0.42), e, e, Colors.panel, "full")
	rect(f, math.floor(s * 0.58), math.floor(s * 0.42), e, e, Colors.panel, "full")
end

DRAW.map = function(f, s, color)
	-- bản đồ gấp 3 nếp
	local w = math.ceil(s * 0.3)
	rect(f, math.floor(s * 0.04), math.floor(s * 0.1), w, math.ceil(s * 0.8), color, math.max(1, math.floor(s * 0.06)))
	rect(f, math.floor(s * 0.35), math.floor(s * 0.04), w, math.ceil(s * 0.8), color, math.max(1, math.floor(s * 0.06)), { Transparency = 0.4 })
	rect(f, math.floor(s * 0.66), math.floor(s * 0.1), w, math.ceil(s * 0.8), color, math.max(1, math.floor(s * 0.06)))
end

function Icons.draw(name, props)
	props = props or {}
	local s = props.Size or 20
	local f = C.new("Frame", {
		Name = props.Name or ("Icon_" .. name),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(s, s),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		ZIndex = props.ZIndex or 1,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	f:SetAttribute("IconSize", s)
	f:SetAttribute("IconName", name)
	local fn = DRAW[name]
	if fn then
		fn(f, s, props.Color or Colors.text, props.Mood)
	end
	return f
end

-- icon trên nền tròn nhạt, trả về holder, icon
function Icons.badge(name, props)
	props = props or {}
	local size = props.Size or 32
	local holder = C.new("Frame", {
		Name = props.Name or "Badge",
		BackgroundColor3 = props.Soft or Colors.panelAlt,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(size, size),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		ZIndex = props.ZIndex or 1,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	if props.Square then
		C.corner(math.floor(size * 0.3)).Parent = holder
	else
		C.round().Parent = holder
	end
	local iconSize = props.IconSize or math.floor(size * 0.56)
	local icon = Icons.draw(name, {
		Name = "Icon",
		Size = iconSize,
		Color = props.Color,
		Mood = props.Mood,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = holder.ZIndex,
		Parent = holder,
	})
	return holder, icon
end

-- mood: "happy" | "neutral" | "sad"
function Icons.setMood(icon, mood)
	if icon:GetAttribute("Mood") == mood then
		return
	end
	icon:SetAttribute("Mood", mood)
	mouth(icon, mood)
end

-- giữ nguyên phần trắng
function Icons.setColor(icon, color)
	for _, d in ipairs(icon:GetDescendants()) do
		if d:IsA("Frame") and d.Name ~= "Mouth" and d.BackgroundColor3 ~= Colors.panel then
			d.BackgroundColor3 = color
		elseif d:IsA("UIStroke") and d.Parent and d.Parent.Name == "Ring" and d.Parent.Parent ~= nil and d.Parent.Parent.Name ~= "Mouth" then
			d.Color = color
		end
	end
end

return Icons
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Modals</string><ProtectedString name="Source"><![CDATA[-- modal Bảng xếp hạng và Lịch sử

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Util = require(ReplicatedStorage:WaitForChild("EconCity"):WaitForChild("Util"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local C = require(script.Parent:WaitForChild("Components"))
local Icons = require(script.Parent:WaitForChild("Icons"))
local Colors = Theme.Colors

local Modals = {}

local MEDALS = {
	[1] = { Theme.Colors.gold, Color3.fromRGB(120, 84, 0) },
	[2] = { Color3.fromRGB(196, 204, 216), Color3.fromRGB(70, 80, 96) },
	[3] = { Color3.fromRGB(222, 160, 110), Color3.fromRGB(110, 60, 20) },
}

-- Bảng xếp hạng -----------------------------------------------------------------------
-- ctx: { request(action, payload), getSnapshot() }
function Modals.leaderboard(gui, ctx)
	local scope = "global"
	local classIndex = 1
	local modal
	local loading = false

	local function classCodes()
		local snap = ctx.getSnapshot()
		local codes = {}
		if snap and snap.profile then
			for _, code in ipairs(snap.profile.classes or {}) do
				table.insert(codes, code)
			end
			for _, code in ipairs(snap.profile.teaching or {}) do
				table.insert(codes, code)
			end
		end
		return codes
	end

	-- top 3 có huy hiệu vàng/bạc/đồng
	local function row(parent, order, rank, name, score, highlight)
		local r = C.well({ Color = highlight and Colors.accentSoft or Colors.panelAlt, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = order, ZIndex = 53, Parent = parent })
		if highlight then
			C.stroke(Colors.accent, 1.5, 0.4).Parent = r
		end
		local medal = MEDALS[rank]
		local rankBadge = C.label({
			Name = "Rank",
			Text = "#" .. tostring(rank),
			Font = Theme.FontDisplay,
			TextSize = 13,
			Color = medal and medal[2] or Colors.textDim,
			XAlign = Enum.TextXAlignment.Center,
			Size = UDim2.fromOffset(40, 28),
			Position = UDim2.new(0, 8, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			ZIndex = 54,
			Parent = r,
		})
		rankBadge.BackgroundTransparency = 0
		rankBadge.BackgroundColor3 = medal and medal[1] or Colors.panel
		C.round().Parent = rankBadge
		C.label({ Text = name, Font = highlight and Theme.FontBold or Theme.FontMedium, TextSize = 14, Truncate = true, Size = UDim2.new(1, -170, 1, 0), Position = UDim2.fromOffset(60, 0), ZIndex = 54, Parent = r })
		C.label({ Text = Util.formatInt(score), Font = Theme.FontDisplay, TextSize = 16, XAlign = Enum.TextXAlignment.Right, Color = Colors.accent, Size = UDim2.fromOffset(100, 44), Position = UDim2.new(1, -112, 0, 0), ZIndex = 54, Parent = r })
	end

	local refresh

	local function renderHeader()
		local tabRow = C.row({ Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 0, ZIndex = 53, Parent = modal.body })
		local seg = C.well({ Name = "Segments", Size = UDim2.fromOffset(268, 40), LayoutOrder = 1, ZIndex = 53, Parent = tabRow })
		C.padding(4).Parent = seg
		C.list(Enum.FillDirection.Horizontal, 4).Parent = seg
		local function tab(name, text, key, order)
			local on = scope == key
			local b = C.button({ Name = name, Text = text, Variant = "white", Stroke = false, Lip = false, Transparency = on and 0 or 1, TextColor = on and Colors.text or Colors.textDim, Size = UDim2.fromOffset(128, 32), Radius = Theme.Radius.sm, ZIndex = 54, LayoutOrder = order, Parent = seg }, function()
				scope = key
				task.spawn(refresh)
			end)
			if on then
				C.shadowStroke(1, 0.88).Parent = b
			end
		end
		tab("TabGlobal", "Toàn cầu", "global", 1)
		tab("TabClass", "Lớp của tôi", "class", 2)
		local codes = classCodes()
		if scope == "class" and #codes > 1 then
			if classIndex > #codes then
				classIndex = 1
			end
			C.button({ Text = "Lớp: " .. codes[classIndex] .. "  ›", Variant = "white", Size = UDim2.fromOffset(150, 36), ZIndex = 54, LayoutOrder = 3, Parent = tabRow }, function()
				classIndex = classIndex % #codes + 1
				task.spawn(refresh)
			end)
		end
	end

	local requestToken = 0
	refresh = function()
		requestToken = requestToken + 1
		local myToken = requestToken -- chỉ hiện kết quả của lần bấm mới nhất, bỏ response cũ về trễ
		modal.clear()
		renderHeader()
		local status = C.label({ Text = "Đang tải...", TextSize = 12, Color = Colors.textMuted, LayoutOrder = 1, ZIndex = 53, Parent = modal.body })
		local payload = { scope = scope }
		if scope == "class" then
			local codes = classCodes()
			if #codes == 0 then
				status.Text = "Bạn chưa thuộc lớp nào."
				return
			end
			payload.code = codes[math.min(classIndex, #codes)]
		end
		loading = true
		local response = ctx.request("getLeaderboard", payload)
		loading = false
		if myToken ~= requestToken or not modal.root.Visible then
			return
		end
		if not response.ok then
			status.Text = response.error or "Không tải được bảng xếp hạng"
			status.TextColor3 = Colors.bad
			return
		end
		local data = response.data or {}
		local rows = data.rows or {}
		status.Text = "Điểm = số dân có việc × hạnh phúc / 100 + ngân sách / 100. Mỗi người giữ điểm cao nhất. Bảng cập nhật sau mỗi 2 lượt."
		status.TextWrapped = true
		status.Size = UDim2.new(1, 0, 0, 34)
		local meShown = false
		for i, r in ipairs(rows) do
			row(modal.body, 10 + i, r.rank, r.name, r.score, r.isMe)
			meShown = meShown or r.isMe
		end
		if #rows == 0 then
			C.label({ Text = "Chưa có dữ liệu xếp hạng.", TextSize = 13, Color = Colors.textDim, LayoutOrder = 5, ZIndex = 53, Parent = modal.body })
		end
		-- dòng "Bạn" luôn hiện ở cuối, chưa lọt top cũng hiện
		local me = data.me
		if me and not meShown then
			local text
			if me.ranked == false then
				text = "Bạn (chơi thử trong Studio, không tính xếp hạng)"
			else
				text = "Bạn (chưa vào top " .. tostring(#rows > 0 and #rows or 20) .. ")"
			end
			local best = math.max(me.bestScore or 0, me.currentScore or 0)
			local r = C.well({ Color = Colors.accentSoft, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 100, ZIndex = 53, Parent = modal.body })
			C.stroke(Colors.accent, 1.5, 0.4).Parent = r
			C.label({ Text = text, Font = Theme.FontBold, TextSize = 13, Truncate = true, Size = UDim2.new(1, -130, 1, 0), Position = UDim2.fromOffset(14, 0), ZIndex = 54, Parent = r })
			C.label({ Text = Util.formatInt(best), Font = Theme.FontDisplay, TextSize = 16, XAlign = Enum.TextXAlignment.Right, Color = Colors.accent, Size = UDim2.fromOffset(100, 44), Position = UDim2.new(1, -112, 0, 0), ZIndex = 54, Parent = r })
		end
	end

	modal = C.modal({ Name = "LeaderboardModal", Title = "Bảng xếp hạng", Size = UDim2.fromOffset(560, 500), Parent = gui, onOpen = function()
		scope = "global" -- mở lại luôn về bảng toàn cầu
		task.spawn(refresh)
	end })
	Icons.badge("podium", { Size = 30, IconSize = 15, Color = Colors.gold, Soft = Colors.goldSoft, Square = true, Position = UDim2.fromOffset(22, 14), ZIndex = 52, Parent = modal.card })
	modal.card:FindFirstChild("Title").Position = UDim2.fromOffset(62, 0)
	return modal
end

-- Lịch sử ------------------------------------------------------------------
-- months: số tháng của ván = số cột
local function barChart(parent, order, title, values, formatter, colorFn, months)
	local holder = C.well({ Size = UDim2.new(1, 0, 0, 160), Radius = Theme.Radius.lg, LayoutOrder = order, ZIndex = 53, Parent = parent })
	C.label({ Text = title, Font = Theme.FontDisplay, TextSize = 14, Size = UDim2.new(0.5, 0, 0, 22), Position = UDim2.fromOffset(14, 8), ZIndex = 54, Parent = holder })
	local plot = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -28, 1, -58), Position = UDim2.fromOffset(14, 36), ZIndex = 54, Parent = holder })
	if #values == 0 then
		C.label({ Text = "Chưa có dữ liệu, đợi hết tháng đầu tiên.", TextSize = 12, Color = Colors.textDim, Size = UDim2.fromScale(1, 1), XAlign = Enum.TextXAlignment.Center, ZIndex = 55, Parent = plot })
		return
	end
	local maxV, minV = 0, 0
	for _, v in ipairs(values) do
		maxV = math.max(maxV, v)
		minV = math.min(minV, v)
	end
	local range = maxV - minV
	if range <= 0 then
		range = 1
	end
	local zeroFrac = maxV / range -- trục 0, tính từ trên xuống
	local axis = C.new("Frame", { BackgroundColor3 = Colors.strokeStrong, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromScale(0, zeroFrac), ZIndex = 55, Parent = plot })
	axis.Name = "Axis"
	local n = math.max(12, months or 12, #values)
	local slot = 1 / n
	local labelEvery = n > 12 and 3 or 1
	for i, v in ipairs(values) do
		local h = math.abs(v) / range
		local top = v >= 0 and (zeroFrac - h) or zeroFrac
		local bar = C.new("Frame", {
			BackgroundColor3 = colorFn(v),
			BorderSizePixel = 0,
			Size = UDim2.new(slot * 0.66, 0, h, 0),
			Position = UDim2.new(slot * (i - 1) + slot * 0.17, 0, top, 0),
			ZIndex = 56,
			Parent = plot,
		})
		C.corner(4).Parent = bar
		if i == #values then
			C.stroke(Colors.text, 1.5, 0.75).Parent = bar -- cột mới nhất
		end
		if i == 1 or i % labelEvery == 0 then
			C.label({ Text = "T" .. i, Font = Theme.FontMedium, TextSize = 10, Color = Colors.textMuted, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(slot, 0, 0, 14), Position = UDim2.new(slot * (i - 1), 0, 1, 4), ZIndex = 55, Parent = plot })
		end
	end
	local summary = C.pill({
		Text = "Cao nhất " .. formatter(math.max(table.unpack(values))) .. "   |   Mới nhất " .. formatter(values[#values]),
		Font = Theme.FontBold,
		TextSize = 11,
		Color = Colors.panel,
		TextColor = Colors.textDim,
		Height = 22,
		Position = UDim2.new(1, -12, 0, 8),
		AnchorPoint = Vector2.new(1, 0),
		ZIndex = 54,
		Parent = holder,
	})
	summary.Name = "Summary"
end

local function pastGamesList(parent, order, pastSessions)
	local holder = C.well({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Radius = Theme.Radius.lg, LayoutOrder = order, ZIndex = 53, Parent = parent })
	C.padding(12, 14).Parent = holder
	C.list(Enum.FillDirection.Vertical, 6).Parent = holder
	C.label({ Text = "Các ván đã chơi", Font = Theme.FontDisplay, TextSize = 14, LayoutOrder = 0, ZIndex = 54, Parent = holder })
	if #pastSessions == 0 then
		C.label({ Text = "Chưa có ván nào kết thúc.", TextSize = 12, Color = Colors.textDim, LayoutOrder = 1, ZIndex = 54, Parent = holder })
		return
	end
	for i, p in ipairs(pastSessions) do
		if i > 10 then
			break
		end
		local statusText = (p.status == "ENDED" and "Thắng") or (p.status == "FAILED" and "Thất bại") or "Bỏ dở"
		local color = (p.status == "ENDED" and Colors.good) or (p.status == "FAILED" and Colors.bad) or Colors.textDim
		C.label({
			Text = string.format("%s • tháng %d/%d • ngân sách %s • dân %s • hạnh phúc %d • điểm %s",
				statusText, p.month or 0, p.maxMonths or 24, Util.formatMoneyFull(p.budget or 0), Util.formatInt(p.population or 0),
				Util.round(p.happiness or 0), Util.formatInt(p.prosperityScore or 0)),
			Font = Theme.FontMedium,
			TextSize = 12,
			Color = color,
			Truncate = true,
			LayoutOrder = i,
			ZIndex = 54,
			Parent = holder,
		})
	end
end

-- ctx: { getSnapshot() }
function Modals.history(gui, ctx)
	local modal
	local function render()
		local scroll = modal.body.CanvasPosition
		modal.clear()
		local snap = ctx.getSnapshot()
		local s = snap and snap.session
		local history = (s and s.history) or {}
		local months = (s and s.maxMonths) or 24
		local budgets, revenue, happiness, employment, population = {}, {}, {}, {}, {}
		for _, h in ipairs(history) do
			table.insert(budgets, h.budget)
			table.insert(revenue, h.gdp or 0)
			table.insert(happiness, h.happiness)
			table.insert(employment, h.employment or 0)
			table.insert(population, h.population or 0)
		end
		barChart(modal.body, 1, "Ngân sách", budgets, Util.formatMoneyFull, function(v)
			return v >= 0 and Colors.gold or Colors.bad
		end, months)
		barChart(modal.body, 2, "Doanh thu của doanh nghiệp", revenue, Util.formatMoneyK, function()
			return Colors.jobs
		end, months)
		barChart(modal.body, 3, "Hạnh phúc", happiness, function(v)
			return tostring(Util.round(v))
		end, function(v)
			return Theme.happinessColor(v)
		end, months)
		barChart(modal.body, 4, "Tỉ lệ việc làm", employment, function(v)
			return string.format("%d%%", Util.round(v))
		end, function(v)
			return (v < 80 and Colors.amber) or Colors.success
		end, months)
		barChart(modal.body, 5, "Dân số", population, function(v)
			return Util.formatInt(v)
		end, function()
			return Colors.people
		end, months)
		C.label({
			Text = "Thuế thành phố thu = doanh thu × thuế suất. Thuế cao thu được nhiều hơn mỗi đồng doanh thu, nhưng dân kém vui nên ít người đến làm việc. Xem doanh thu, hạnh phúc và dân số cùng lúc để thấy điều đó.",
			TextSize = 12,
			Color = Colors.textDim,
			Wrapped = true,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			LayoutOrder = 6,
			ZIndex = 53,
			Parent = modal.body,
		})
		pastGamesList(modal.body, 7, (snap and snap.profile and snap.profile.pastSessions) or {})
		modal.body.CanvasPosition = scroll -- giữ chỗ đang cuộn khi vẽ lại mỗi lượt
	end
	modal = C.modal({ Name = "HistoryModal", Title = "Lịch sử thành phố", Size = UDim2.fromOffset(580, 580), Parent = gui, onOpen = render })
	Icons.badge("chart", { Size = 30, IconSize = 15, Color = Colors.accent, Soft = Colors.accentSoft, Square = true, Position = UDim2.fromOffset(22, 14), ZIndex = 52, Parent = modal.card })
	modal.card:FindFirstChild("Title").Position = UDim2.fromOffset(62, 0)
	-- chỉ vẽ lại khi có data mới (tick, ván mới, init), không theo đồng hồ
	function modal.refreshIfOpen(reason)
		if modal.root.Visible and (reason == "tick" or reason == "newGame" or reason == "init") then
			render()
		end
	end
	return modal
end

return Modals
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">Overlays</string><ProtectedString name="Source"><![CDATA[-- các lớp UI nổi trên thành phố: dải thống kê, cột Cách chơi/phiếu sự kiện, toast, thẻ thông tin,
-- băng chúc mừng lúc bắt đầu, màn kết thúc

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("EconCity")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local CityLayout = require(Shared:WaitForChild("CityLayout"))
local CityEngine = require(Shared:WaitForChild("CityEngine"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local C = require(script.Parent:WaitForChild("Components"))
local Icons = require(script.Parent:WaitForChild("Icons"))
local Colors = Theme.Colors

local Overlays = {}

local function soft(c)
	return c:Lerp(Color3.new(1, 1, 1), 0.86)
end

local function clear(frame)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- Dải thống kê góc dưới trái -------------------------------------------------------------
-- chỉ hiện số thẻ thành phố chưa có: người muốn đến, chỗ làm có người, dịch vụ, hàng cho shop
-- màn hẹp thì ẩn cho sa bàn rộng
function Overlays.cityBar(gui)
	local CELL_W = 156
	local bar = C.new("Frame", {
		Name = "CityBar",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 62),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.new(0, 12, 1, -12),
		AnchorPoint = Vector2.new(0, 1),
		Parent = gui,
	})
	C.list(Enum.FillDirection.Horizontal, 8, nil, Enum.VerticalAlignment.Center).Parent = bar

	local cards = {}
	local specs = {
		{ "population", "Muốn đến", "people", Colors.people },
		{ "jobs", "Chỗ làm có người", "briefcase", Colors.jobs },
		{ "service", "Dịch vụ", "heart", Colors.mood },
		{ "goods", "Hàng cho shop", "box", Colors.amber },
	}
	for i, t in ipairs(specs) do
		local card = C.panel({ Name = "Card_" .. t[1], Size = UDim2.fromOffset(CELL_W, 62), Radius = Theme.Radius.lg, LayoutOrder = i, Parent = bar })
		Icons.badge(t[3], { Size = 32, IconSize = 17, Color = t[4], Soft = soft(t[4]), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = card })
		C.label({ Text = t[2], Font = Theme.FontBold, TextSize = 11, Color = Colors.textDim, Truncate = true, Size = UDim2.new(1, -56, 0, 14), Position = UDim2.fromOffset(50, 8), Parent = card })
		local value = C.label({ Name = "Value", Text = "-", Font = Theme.FontDisplay, TextSize = 17, Truncate = true, Size = UDim2.new(1, -56, 0, 20), Position = UDim2.fromOffset(50, 22), Parent = card })
		local sub = C.label({ Name = "Sub", Text = "", Font = Theme.FontMedium, TextSize = 11, Color = Colors.textMuted, Truncate = true, Size = UDim2.new(1, -56, 0, 13), Position = UDim2.fromOffset(50, 42), Parent = card })
		cards[t[1]] = { value = value, sub = sub, frame = card }
	end

	local obj = { frame = bar }
	function obj.setCompact(compact)
		bar.Visible = not compact
	end
	function obj.update(snap)
		local s = snap.session
		if not s or type(s.cells) ~= "table" then
			return
		end
		local d = CityEngine.compute(s, s.population)
		local target = CityEngine.targetPop(d.C, d.J, s.happiness)
		cards.population.value.Text = Util.formatInt(target) .. " người"
		cards.population.sub.Text = "tối đa " .. Util.formatInt(d.C) .. " chỗ ở"
		-- đếm số chỗ làm có người, không dùng %: đặt cạnh "Việc làm 100%" của dân nhìn như mâu thuẫn
		cards.jobs.value.Text = Util.formatInt(d.emp) .. " / " .. Util.formatInt(d.J)
		cards.jobs.sub.Text = "chỗ làm đã có người"
		cards.service.value.Text = s.population > 0 and tostring(Util.round(d.S)) or "—"
		cards.service.sub.Text = "phục vụ " .. Util.formatInt(d.pts * Config.FORMULA.residentsPerPoint) .. " người"
		cards.goods.value.Text = d.slots.shop > 0 and string.format("%d%%", Util.round(d.G * 100)) or "—"
		cards.goods.value.TextColor3 = (d.slots.shop > 0 and d.G < Config.CRISIS.goodsBelow) and Colors.warn or Colors.text
		cards.goods.sub.Text = string.format("%d chỗ CN / %d chỗ TM", d.slots.factory, d.slots.shop)
	end
	return obj
end

-- Cách chơi + phiếu cảnh báo/sự kiện, cột trái ------------------------
function Overlays.eventsColumn(gui)
	local column = C.new("Frame", {
		Name = "EventsColumn",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(300, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.fromOffset(12, 126), -- dưới thẻ thành phố và nhãn vai trò/chế độ thử
		Parent = gui,
	})
	C.list(Enum.FillDirection.Vertical, 8).Parent = column

	-- Cách chơi chỉ hiện ở tháng 0 (đang xây, chưa bấm Bắt đầu), bước nào xong tự đánh dấu
	local guide = C.panel({ Name = "Guide", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Radius = Theme.Radius.xl, LayoutOrder = 0, Parent = column })
	guide.Visible = false
	C.padding(14, 16).Parent = guide
	C.list(Enum.FillDirection.Vertical, 8).Parent = guide
	local head = C.new("Frame", { Name = "Head", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 0, Parent = guide })
	Icons.badge("map", { Size = 30, IconSize = 16, Color = Colors.accent, Soft = Colors.accentSoft, Square = true, Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = head })
	C.label({ Text = "Cách chơi", Font = Theme.FontDisplay, TextSize = 16, Size = UDim2.new(1, -100, 1, 0), Position = UDim2.fromOffset(40, 0), Parent = head })
	local progress = C.pill({ Name = "Progress", Text = "0 / 5", TextSize = 11, Color = Colors.accentSoft, TextColor = Colors.accent, Height = 22, Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = head })
	local STEPS = {
		"Kéo đường từ CỔNG vào lưới",
		"Xây nhà sát đường",
		"Xây chỗ làm: văn phòng, hoặc shop + nhà máy",
		"Thêm công viên, trường hoặc bệnh viện",
		"Bấm BẮT ĐẦU",
	}
	local steps = {}
	for i, text in ipairs(STEPS) do
		local row = C.new("Frame", { Name = "Step" .. i, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 + i, Parent = guide })
		local box = C.new("Frame", { Name = "Box", BackgroundColor3 = Colors.success, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(0, 0), Parent = row })
		C.round().Parent = box
		local boxStroke = C.stroke(Colors.strokeStrong, 2)
		boxStroke.Parent = box
		local number = C.label({ Name = "Number", Text = tostring(i), Font = Theme.FontBold, TextSize = 11, Color = Colors.textDim, XAlign = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = box })
		local check = Icons.draw("check", { Size = 12, Color = Colors.onAccent, Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = box })
		check.Visible = false
		local label = C.label({ Text = text, Font = Theme.FontMedium, TextSize = 13, Wrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -30, 0, 0), Position = UDim2.fromOffset(30, 1), Parent = row })
		steps[i] = { box = box, stroke = boxStroke, label = label, number = number, check = check }
	end
	C.label({ Text = "Lô gạch chéo có dấu ! là chưa nối đường về CỔNG: chưa có dân, chưa có doanh thu, vẫn tốn bảo trì.", TextSize = 12, Color = Colors.textMuted, Wrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 10, Parent = guide })

	local slips = C.new("Frame", { Name = "Slips", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = column })
	C.list(Enum.FillDirection.Vertical, 8).Parent = slips

	local compact = false
	-- màn hẹp thì phiếu chỉ còn tiêu đề
	local function slip(order, color, title, sub)
		local card = C.panel({ Name = "Slip", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Radius = Theme.Radius.lg, LayoutOrder = order, Parent = slips })
		card.BackgroundColor3 = soft(color):Lerp(Colors.panel, 0.4)
		local stroke = card:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = color
			stroke.Transparency = 0.55
		end
		C.padding(10, 12).Parent = card
		Icons.draw("alert", { Size = 22, Color = color, Parent = card })
		C.label({ Text = title, Font = Theme.FontBold, TextSize = 13, Wrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -32, 0, 0), Position = UDim2.fromOffset(32, 2), Parent = card })
		if sub and sub ~= "" and not compact then
			C.label({ Text = sub, TextSize = 12, Color = Colors.textDim, Wrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -32, 0, 0), Position = UDim2.fromOffset(32, 22), Parent = card })
		end
	end

	local obj = { frame = column }
	local lastSnap = nil
	function obj.setCompact(on)
		compact = on
		if lastSnap then
			obj.update(lastSnap)
		end
	end
	function obj.update(snap)
		lastSnap = snap
		local s = snap.session
		if not s then
			return
		end
		guide.Visible = s.month == 0 and s.status ~= "ENDED" and s.status ~= "FAILED" and type(s.cells) == "table"
		if guide.Visible then
			local d = CityEngine.compute(s, 0)
			local roads = 0
			for i, kind in ipairs(s.cells) do
				if kind == "road" and d.conn[i] and i ~= Config.GATE_INDEX then
					roads = roads + 1
				end
			end
			local done = { roads > 0, d.C > 0, d.J > 0, d.pts > 0, false }
			local count = 0
			for i, step in ipairs(steps) do
				if done[i] then
					count = count + 1
				end
				step.box.BackgroundTransparency = done[i] and 0 or 1
				step.stroke.Color = done[i] and Colors.success or Colors.strokeStrong
				step.number.Visible = not done[i]
				step.check.Visible = done[i]
				step.label.TextColor3 = done[i] and Colors.textMuted or Colors.text
			end
			progress.Text = string.format("%d / %d", count, #steps)
		end
		clear(slips)
		for i, key in ipairs(s.crises or {}) do
			local text = Config.CRISIS_LABELS[key] or key
			local title, sub = text:match("^(.-):%s*(.*)$")
			slip(i, Colors.bad, title or text, sub)
		end
		for i, sc in ipairs(s.scenarios or {}) do
			slip(10 + i, Colors.warn, string.format("Sự kiện: %s (còn %d tháng)", sc.name or sc.id, sc.monthsLeft or 0), sc.description)
		end
	end
	return obj
end

-- Toast ---------------------------------------------------------------------------------
function Overlays.toasts(gui)
	local holder = C.new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(440, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(0.5, 0, 0, 96),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 40,
		Parent = gui,
	})
	C.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).Parent = holder
	local counter = 0
	local live = {} -- toast đang hiện, cũ nhất ở đầu
	local MAX_TOASTS = 4
	local obj = {}
	function obj.show(text, kind)
		counter = counter + 1
		-- quá MAX_TOASTS thì bỏ cái cũ nhất, không để che kín màn hình
		while #live >= MAX_TOASTS do
			local oldest = table.remove(live, 1)
			if oldest.Parent then
				oldest:Destroy()
			end
		end
		local color = (kind == "error" and Colors.bad) or (kind == "good" and Colors.success) or Colors.accent
		local toast = C.panel({ Name = "Toast", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Radius = Theme.Radius.lg, StrokeTransparency = 0.8, LayoutOrder = counter, ZIndex = 40, Parent = holder })
		C.padding(11, 14).Parent = toast
		local badge = Icons.badge(kind == "error" and "alert" or (kind == "good" and "check" or "info"), { Size = 26, IconSize = kind == "good" and 14 or 26, Color = kind == "good" and Colors.onAccent or color, Soft = kind == "good" and color or Colors.panel, ZIndex = 41, Parent = toast })
		badge.Name = "Mark"
		C.label({ Text = text, TextSize = 13, Font = Theme.FontBold, Wrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -36, 0, 0), Position = UDim2.fromOffset(36, 3), ZIndex = 41, Parent = toast })
		C.popIn(toast, 0.9, 0.25)
		table.insert(live, toast)
		task.delay(4, function()
			for i, t in ipairs(live) do
				if t == toast then
					table.remove(live, i)
					break
				end
			end
			if toast.Parent then
				C.fadeOut(toast, 0.35, function()
					if toast.Parent then
						toast:Destroy()
					end
				end)
			end
		end)
	end
	return obj
end

-- Thẻ thông tin. 2 kiểu: mẫu công trình (nút "i" ở bảng Xây dựng, có hình 3D)
-- và công trình trên sa bàn (bấm ô khi không cầm tool). kiểu sau tự đóng sau 8s, PHÁ DỠ phải bấm 2 lần.
-- bấm ô phụ của công trình 2x2 cũng mở thẻ của cả công trình
-- ctx: { previewModel(id) -> (model, span, top), onChoose(id), onDemolish(index) }
function Overlays.detailPanel(gui, ctx)
	local panel = C.panel({
		Name = "DetailPanel",
		Size = UDim2.fromOffset(310, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(0, 12, 1, -86),
		AnchorPoint = Vector2.new(0, 1),
		Radius = Theme.Radius.xl,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	})
	C.padding(14).Parent = panel
	C.list(Enum.FillDirection.Vertical, 8).Parent = panel
	local header = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 0, Parent = panel })
	local swatch = C.new("Frame", { Name = "Swatch", BorderSizePixel = 0, Size = UDim2.fromOffset(36, 36), Parent = header })
	C.corner(10).Parent = swatch
	local swatchCode = C.label({ Text = "", Font = Theme.FontDisplay, TextSize = 13, XAlign = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = swatch })
	local title = C.label({ Text = "", Font = Theme.FontDisplay, TextSize = 17, Truncate = true, Size = UDim2.new(1, -92, 1, 0), Position = UDim2.fromOffset(46, 0), Parent = header })
	-- hình 3D của mẫu, ViewportFrame riêng chứ không nằm trong thành phố
	local view = C.new("ViewportFrame", { Name = "Preview", BackgroundColor3 = Colors.panelAlt, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 140), LayoutOrder = 1, Visible = false, Parent = panel })
	C.corner(Theme.Radius.md).Parent = view
	local viewCamera = Instance.new("Camera")
	viewCamera.FieldOfView = 40
	viewCamera.Parent = view
	view.CurrentCamera = viewCamera
	local lines = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
	C.list(Enum.FillDirection.Vertical, 4).Parent = lines

	-- positions[kiểu] = { Position, AnchorPoint }, Main.client sửa lại theo layout màn hình
	local obj = {
		frame = panel,
		index = nil,
		variant = nil,
		positions = {
			placed = { panel.Position, panel.AnchorPoint },
			catalog = { panel.Position, panel.AnchorPoint },
		},
	}
	local function place(mode)
		panel.Position = obj.positions[mode][1]
		panel.AnchorPoint = obj.positions[mode][2]
	end
	local token = 0
	local armed = false -- đã bấm PHÁ DỠ 1 lần, chờ lần 2
	local previewId, previewModel = nil, nil
	local lastSnap = nil
	local render

	function obj.close()
		panel.Visible = false
		obj.index = nil
		obj.variant = nil
		token = token + 1
	end
	C.closeButton({ Name = "CloseDetail", Size = 30, Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = header }, obj.close)

	local action = C.button({ Name = "Action", Text = "", TextSize = 13, Variant = "primary", Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 3, Visible = false, Parent = panel }, function()
		if obj.variant then
			local id = obj.variant
			obj.close()
			ctx.onChoose(id)
		elseif obj.index and not armed then
			armed = true
			obj.scheduleClose()
			render(lastSnap)
		elseif obj.index then
			local anchor = obj.anchor
			obj.close()
			ctx.onDemolish(anchor)
		end
	end)

	local function addLine(i, text, color, font)
		C.label({ Text = text, Font = font or Theme.FontMedium, TextSize = 13, Color = color or Colors.text, Wrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = i, Parent = lines })
	end

	-- xanh: đang hoạt động, đỏ: chưa nối đường
	local function addStatus(i, text, color)
		local p = C.pill({ Text = text, TextSize = 12, Color = soft(color), TextColor = color, Height = 26, LayoutOrder = i, Parent = lines })
		p.TextWrapped = false
		return p
	end

	local function addRow(i, name, value, color)
		local row = C.new("Frame", { Name = "Row", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = i, Parent = lines })
		C.label({ Text = name, Font = Theme.FontMedium, TextSize = 12, Color = Colors.textDim, Size = UDim2.new(0.4, 0, 1, 0), Parent = row })
		C.label({ Name = "Value", Text = value, Font = Theme.FontBold, TextSize = 12, Color = color or Colors.text, XAlign = Enum.TextXAlignment.Right, Size = UDim2.new(0.6, 0, 1, 0), Position = UDim2.fromScale(0.4, 0), Parent = row })
		C.new("Frame", { BackgroundColor3 = Colors.rule, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), Parent = row })
	end

	local function setHeader(id, text)
		swatch.BackgroundColor3 = Theme.land(id)
		swatchCode.Text = Config.BUILDINGS[id].code
		swatchCode.TextColor3 = Theme.landInk(id)
		title.Text = text
	end

	local function showPreview(id)
		if previewId == id then
			return
		end
		previewId = id
		if previewModel then
			previewModel:Destroy()
		end
		local model, span, top = ctx.previewModel(id)
		model.Parent = view
		previewModel = model
		-- nhìn chéo giống camera toàn cảnh. cầu bao bán kính R, FOV dọc 40 độ thì phải lùi >= R / sin 20 độ
		-- (khoảng 2.92R) mới lọt khung. khung rộng hơn cao nên chiều ngang luôn đủ
		local h = math.max(top, 4)
		local radius = math.sqrt(span * span / 2 + (h / 2) ^ 2)
		local center = Vector3.new(0, h / 2, 0)
		viewCamera.CFrame = CFrame.lookAt(center + Vector3.new(1, 0.9, 1).Unit * radius * 3.1, center)
	end

	local function sizeText(def)
		return def.size > 1 and string.format("%dx%d = %d ô", def.size, def.size, def.size * def.size) or "1 ô"
	end

	local function renderVariant(s, id)
		local def = Config.BUILDINGS[id]
		setHeader(id, def.label)
		view.Visible = true
		showPreview(id)
		local price = s and CityEngine.priceOf(s, id) or def.price
		local short = s ~= nil and s.budget < price
		addRow(1, "Loại đất", string.format("%s (%s)", def.zone, def.code))
		addRow(2, "Giá xây", short and string.format("%s, thiếu %s", Util.formatMoneyFull(price), Util.formatMoneyFull(price - s.budget)) or Util.formatMoneyFull(price), short and Colors.bad or nil)
		addRow(3, "Diện tích", sizeText(def))
		if def.cap then
			addRow(4, "Chỗ ở", string.format("%d người", def.cap))
		end
		if def.jobs then
			addRow(5, "Chỗ làm", string.format("%d người", def.jobs))
		end
		if def.rev then
			addRow(6, "Doanh thu", Util.formatMoneyFull(def.rev) .. " / người / tháng")
		end
		if def.pts then
			addRow(7, "Dịch vụ", string.format("+%d điểm, đủ cho %d dân", def.pts, def.pts * Config.FORMULA.residentsPerPoint))
		end
		addRow(8, "Bảo trì", Util.formatMoneyFull(def.maint) .. " / tháng")
		addRow(9, "Phá dỡ hoàn", Util.formatMoneyFull(math.floor(def.price * Config.DEMOLISH_REFUND)))
		addLine(10, Config.BUILDING_NOTES[id] or "", Colors.textDim)
		local finished = s ~= nil and (s.status == "ENDED" or s.status == "FAILED")
		action.Visible = true
		action.Text = "CHỌN ĐỂ XÂY"
		C.setButtonColor(action, Colors.accent)
		action.TextColor3 = Colors.onAccent
		C.setEnabled(action, not finished)
	end

	local function renderPlaced(s)
		local i = CityEngine.anchorOf(s.cells, obj.index)
		obj.anchor = i
		local kind = s.cells[i]
		local def = Config.BUILDINGS[kind]
		view.Visible = false
		action.Visible = false
		if not def then
			local col, row = CityLayout.cellXY(i)
			swatch.BackgroundColor3 = Colors.panelAlt
			swatchCode.Text = ""
			title.Text = string.format("Ô trống (cột %d, hàng %d)", col, row)
			addLine(1, "Chọn một loại đất ở bảng Xây dựng rồi bấm vào ô này để xây.", Colors.textDim)
			return
		end
		setHeader(kind, i == Config.GATE_INDEX and "Cổng thành phố" or (def.size > 1 and string.format("%s %dx%d", def.label, def.size, def.size) or def.label))
		local d = CityEngine.compute(s, s.population)
		if d.conn[i] then
			addStatus(1, kind == "road" and "Đã nối về CỔNG" or "Đang hoạt động (đã nối đường)", Colors.good)
		else
			addStatus(1, kind == "road" and "Chưa nối về CỔNG" or "Chưa nối đường về CỔNG", Colors.bad)
			if kind ~= "road" then
				addLine(2, "Chưa có dân, chưa có doanh thu, vẫn tốn bảo trì.", Colors.bad)
			end
		end
		addLine(3, Config.BUILDING_NOTES[kind] or "", Colors.textDim)
		if def.cap then
			addRow(4, "Chỗ ở", string.format("%d người", def.cap))
		elseif def.jobs and d.conn[i] then
			local workers = Util.round(def.jobs * d.f)
			local perMonth = (def.rev or 0) * def.jobs * d.f * (def.kind == "shop" and d.G or 1)
			addRow(4, "Người làm", string.format("%d/%d", workers, def.jobs))
			addRow(5, "Doanh thu", Util.formatMoneyFull(perMonth) .. "/tháng")
		end
		addRow(6, "Bảo trì", Util.formatMoneyFull(def.maint) .. "/tháng", Colors.textDim)
		local finished = s.status == "ENDED" or s.status == "FAILED"
		if i ~= Config.GATE_INDEX and not finished then
			local refund = Util.formatMoneyFull(math.floor(def.price * Config.DEMOLISH_REFUND))
			action.Visible = true
			action.Text = armed and ("BẤM LẦN NỮA ĐỂ PHÁ (HOÀN " .. refund .. ")") or ("Phá dỡ, hoàn " .. refund)
			C.setButtonColor(action, armed and Colors.danger or Colors.panelAlt)
			action.TextColor3 = armed and Colors.onAccent or Colors.bad
			C.setEnabled(action, true)
		end
	end

	render = function(snap)
		lastSnap = snap
		local s = snap and snap.session
		if obj.variant then
			clear(lines)
			renderVariant(s, obj.variant)
		elseif obj.index and s and type(s.cells) == "table" then
			clear(lines)
			renderPlaced(s)
		end
	end

	function obj.scheduleClose()
		token = token + 1
		local myToken = token
		task.delay(8, function()
			if token == myToken then
				obj.close()
			end
		end)
	end

	-- công trình trên sa bàn
	function obj.open(index, snap)
		obj.variant = nil
		obj.index = index
		armed = false
		place("placed")
		panel.Visible = true
		C.popIn(panel, 0.95, 0.18)
		render(snap)
		obj.scheduleClose()
	end

	-- mẫu trong danh mục, không tự đóng vì người chơi đang đọc
	function obj.openVariant(id, snap)
		obj.index = nil
		obj.variant = id
		armed = false
		token = token + 1
		place("catalog")
		panel.Visible = true
		C.popIn(panel, 0.95, 0.18)
		render(snap)
	end

	function obj.update(snap)
		if panel.Visible then
			render(snap)
		end
	end

	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape and panel.Visible then
			obj.close()
		end
	end)
	return obj
end

-- pháo giấy màu đất, chỉ trang trí nên không chặn click (attribute Decor)
local function confetti(gui, origin, count)
	local palette = {}
	for _, cat in ipairs(Config.CATEGORY_ORDER) do
		table.insert(palette, Theme.land(cat))
	end
	for k = 1, count do
		local angle = (k / count) * math.pi * 2 + math.random() * 0.4
		local dist = 140 + math.random() * 160
		local piece = C.new("Frame", {
			Name = "Confetti",
			BackgroundColor3 = palette[(k % #palette) + 1],
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(8 + math.random(0, 6), 5 + math.random(0, 4)),
			Position = origin,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = math.random(0, 180),
			ZIndex = 29,
			Parent = gui,
		})
		piece:SetAttribute("Decor", true)
		C.corner(2).Parent = piece
		local target = origin + UDim2.fromOffset(math.cos(angle) * dist, math.sin(angle) * dist * 0.7 + 80)
		TweenService:Create(piece, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = target, Rotation = piece.Rotation + math.random(-240, 240) }):Play()
		TweenService:Create(piece, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.7), { BackgroundTransparency = 1 }):Play()
		task.delay(1.3, function()
			piece:Destroy()
		end)
	end
end

-- Băng chúc mừng lúc bắt đầu ván ---------------
function Overlays.stamp(gui)
	local banner = C.panel({
		Name = "ApprovalStamp",
		Size = UDim2.fromOffset(400, 104),
		Position = UDim2.fromScale(0.42, 0.42),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Radius = 26,
		StrokeTransparency = 0.75,
		ZIndex = 30,
		Parent = gui,
	})
	banner.Visible = false
	C.gradient(Colors.success, Colors.jobs, 20).Parent = banner
	local badge = Icons.badge("play", { Size = 56, IconSize = 26, Color = Colors.success, Soft = Colors.panel, Position = UDim2.new(0, 24, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 31, Parent = banner })
	badge.Name = "Seal"
	local titleLabel = C.label({ Name = "StampTitle", Text = "", Font = Theme.FontDisplay, TextSize = 26, Color = Colors.onAccent, Size = UDim2.new(1, -110, 0, 32), Position = UDim2.fromOffset(96, 22), ZIndex = 31, Parent = banner })
	local subLabel = C.label({ Name = "StampSub", Text = "", Font = Theme.FontBold, TextSize = 14, Color = Colors.onAccent, Size = UDim2.new(1, -110, 0, 20), Position = UDim2.fromOffset(96, 56), ZIndex = 31, Parent = banner })
	local scale = Instance.new("UIScale")
	scale.Parent = banner
	local token = 0
	local obj = { frame = banner }
	function obj.show(title, sub)
		token = token + 1
		local myToken = token
		titleLabel.Text = title
		subLabel.Text = sub or ""
		C.restoreFade(banner)
		scale.Scale = 0.6
		banner.Visible = true
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		confetti(gui, banner.Position, 26)
		task.delay(1.6, function()
			if myToken ~= token then
				return
			end
			TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.85 }):Play()
			C.fadeOut(banner, 0.35, function()
				if myToken == token then
					banner.Visible = false
					C.restoreFade(banner)
				end
			end)
		end)
	end
	return obj
end

-- Màn kết thúc + viền đỏ khi phá sản -------------------
function Overlays.endScreen(gui, ctx)
	local vignette = C.new("Frame", {
		Name = "FailVignette",
		BackgroundTransparency = 1,
		-- UIStroke vẽ ra ngoài khung nên thu khung lại cho viền nằm trong màn hình
		Size = UDim2.new(1, -28, 1, -28),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 5,
		Parent = gui,
	})
	vignette:SetAttribute("Decor", true)
	C.corner(28).Parent = vignette
	local vStroke = C.new("UIStroke", { Color = Colors.danger, Thickness = 14, Transparency = 0.4, Parent = vignette })

	local card = C.panel({
		Name = "EndCard",
		Size = UDim2.fromOffset(480, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.fromScale(0.42, 0.48),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Radius = 26,
		StrokeTransparency = 0.78,
		Visible = false,
		ZIndex = 45,
		Parent = gui,
	})
	C.padding(22, 24).Parent = card
	C.list(Enum.FillDirection.Vertical, 12, Enum.HorizontalAlignment.Center).Parent = card

	-- huy chương: vàng là hoàn thành, đỏ là phá sản, số tháng ở giữa
	local medal = C.new("Frame", { Name = "Seal", BackgroundColor3 = Colors.panel, BorderSizePixel = 0, Size = UDim2.fromOffset(88, 88), LayoutOrder = 1, ZIndex = 46, Parent = card })
	C.round().Parent = medal
	local medalGradient = C.gradient(Colors.gold, Colors.amber, 45)
	medalGradient.Parent = medal
	local medalRing = C.new("Frame", { Name = "Ring", BackgroundTransparency = 1, Size = UDim2.new(1, -14, 1, -14), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 46, Parent = medal })
	C.round().Parent = medalRing
	C.stroke(Colors.panel, 3, 0.15).Parent = medalRing
	local medalNumber = C.label({ Name = "StampTitle", Text = "", Font = Theme.FontDisplay, TextSize = 30, Color = Colors.onAccent, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 18), ZIndex = 47, Parent = medal })
	local medalSub = C.label({ Name = "StampSub", Text = "", Font = Theme.FontBold, TextSize = 11, Color = Colors.onAccent, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 52), ZIndex = 47, Parent = medal })

	local title = C.label({ Text = "", Font = Theme.FontDisplay, TextSize = 28, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 2, ZIndex = 46, Parent = card })
	local reasonLabel = C.label({ Text = "", Font = Theme.FontMedium, TextSize = 13, Color = Colors.bad, XAlign = Enum.TextXAlignment.Center, Wrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 3, ZIndex = 46, Parent = card })
	local recordPill = C.pill({ Name = "Record", Text = "Kỷ lục mới!", TextSize = 12, Color = Colors.goldSoft, TextColor = Colors.warn, Height = 26, LayoutOrder = 4, ZIndex = 46, Parent = card })

	-- lưới số liệu 3x2
	local grid = C.new("Frame", { Name = "Table", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 132), LayoutOrder = 5, ZIndex = 46, Parent = card })
	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.new(1 / 3, -6, 0, 62)
	gridLayout.CellPadding = UDim2.fromOffset(8, 8)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = grid
	local cellValues = {}
	local LABELS = { { "THÁNG", "Tháng" }, { "ĐIỂM", "Điểm" }, { "KỶ LỤC", "Kỷ lục" }, { "DÂN SỐ", "Dân số" }, { "HẠNH PHÚC", "Hạnh phúc" }, { "NGÂN SÁCH", "Ngân sách" } }
	for k, l in ipairs(LABELS) do
		local cell = C.well({ Name = "Cell_" .. l[1], Size = UDim2.fromOffset(100, 62), LayoutOrder = k, ZIndex = 46, Parent = grid })
		C.label({ Text = l[2], Font = Theme.FontBold, TextSize = 11, Color = Colors.textDim, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(1, -12, 0, 14), Position = UDim2.fromOffset(6, 10), ZIndex = 47, Parent = cell })
		cellValues[l[1]] = C.label({ Text = "", Font = Theme.FontDisplay, TextSize = 19, XAlign = Enum.TextXAlignment.Center, Truncate = true, Size = UDim2.new(1, -12, 0, 24), Position = UDim2.fromOffset(6, 28), ZIndex = 47, Parent = cell })
	end

	local buttons = C.new("Frame", { Name = "Buttons", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 6, ZIndex = 46, Parent = card })
	C.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center).Parent = buttons
	C.button({ Text = "CHƠI VÁN MỚI", Variant = "success", Font = Theme.FontDisplay, TextSize = 14, Size = UDim2.fromOffset(150, 44), LayoutOrder = 1, ZIndex = 46, Parent = buttons }, function()
		ctx.onNewGame()
	end)
	C.button({ Text = "Xem lịch sử", Variant = "secondary", Size = UDim2.fromOffset(130, 44), LayoutOrder = 2, ZIndex = 46, Parent = buttons }, function()
		ctx.onHistory()
	end)
	C.button({ Text = "Ngắm thành phố", Variant = "white", Size = UDim2.fromOffset(140, 44), LayoutOrder = 3, ZIndex = 46, Parent = buttons }, function()
		card.Visible = false
	end)

	local shownFor = nil
	local pulse = nil
	local obj = {}
	function obj.update(snap)
		local s = snap.session
		if not s then
			return
		end
		local failed = s.status == "FAILED"
		local ended = s.status == "ENDED"
		vignette.Visible = failed
		if failed and not pulse then
			pulse = TweenService:Create(vStroke, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.85 })
			pulse:Play()
		elseif not failed and pulse then
			pulse:Cancel()
			pulse = nil
		end
		if (failed or ended) and shownFor ~= s.id then
			shownFor = s.id
			title.Text = ended and "Hoàn thành nhiệm kỳ!" or "Thành phố phá sản"
			title.TextColor3 = ended and Colors.text or Colors.bad
			reasonLabel.Text = failed and string.format("Ngân sách thâm hụt quá %s.", Util.formatMoneyFull(-Config.FAIL_BUDGET)) or ""
			reasonLabel.Visible = failed
			local score = s.prosperityScore or 0
			local best = (snap.profile and snap.profile.bestScore) or 0
			cellValues["THÁNG"].Text = string.format("%d / %d", s.month, s.maxMonths)
			cellValues["ĐIỂM"].Text = Util.formatInt(score)
			cellValues["DÂN SỐ"].Text = Util.formatInt(s.population or 0)
			cellValues["HẠNH PHÚC"].Text = tostring(Util.round(s.happiness))
			cellValues["HẠNH PHÚC"].TextColor3 = Theme.happinessColor(s.happiness)
			cellValues["NGÂN SÁCH"].Text = Util.formatMoneyFull(s.budget)
			cellValues["NGÂN SÁCH"].TextColor3 = s.budget < 0 and Colors.bad or Colors.text
			cellValues["KỶ LỤC"].Text = Util.formatInt(best)
			-- kỷ lục mới khi điểm ván này chính là điểm cao nhất
			recordPill.Visible = ended and score > 0 and score >= best
			medalGradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, ended and Colors.gold or Colors.danger),
				ColorSequenceKeypoint.new(1, ended and Colors.amber or Colors.dangerDark),
			})
			medalNumber.Text = tostring(s.month)
			medalSub.Text = ended and "THÁNG" or "PHÁ SẢN"
			card.Visible = true
			C.popIn(card, 0.85, 0.35)
			if ended then
				confetti(gui, card.Position, 34)
			end
		elseif not failed and not ended then
			card.Visible = false
		end
	end
	return obj
end

return Overlays
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[-- Màu, phông, bo góc dùng chung cho UI.
-- Màu đất chỉ lấy từ Config.BUILDINGS[...].color (ô chọn loại đất, lô đất, nhà trên sa bàn), đừng khai báo lại ở đây.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("EconCity"):WaitForChild("Config"))

local Theme = {}

-- Builder Sans có sẵn trong Roblox, đủ dấu tiếng Việt. số dùng Bold, không cần monospace
Theme.Font = Enum.Font.BuilderSans
Theme.FontMedium = Enum.Font.BuilderSansMedium
Theme.FontBold = Enum.Font.BuilderSansBold
Theme.FontDisplay = Enum.Font.BuilderSansExtraBold
Theme.FontNumber = Enum.Font.BuilderSansBold

local rgb = Color3.fromRGB

Theme.Colors = {
	panel = rgb(255, 255, 255),
	panelAlt = rgb(242, 245, 250), -- ô lót trong thẻ, nút phụ
	panelHover = rgb(232, 238, 247),
	stroke = rgb(219, 226, 236), -- viền, đường kẻ mảnh
	strokeStrong = rgb(196, 206, 220),
	rule = rgb(231, 236, 243),
	shadow = rgb(11, 18, 32), -- viền bóng quanh thẻ, đi với transparency cao
	overlay = rgb(12, 20, 36), -- nền che sau modal

	text = rgb(24, 34, 52),
	textDim = rgb(84, 98, 120),
	textMuted = rgb(103, 117, 138), -- contrast >= 4.5:1 trên nền trắng
	onAccent = rgb(255, 255, 255),

	-- accent: ô đang chọn, tab, slider
	accent = rgb(46, 107, 255),
	accentDark = rgb(29, 79, 216),
	accentSoft = rgb(229, 237, 255),

	success = rgb(34, 179, 94), -- nút Bắt đầu / Chạy tiếp / Chơi ván mới
	successDark = rgb(22, 135, 69),
	amber = rgb(245, 165, 36), -- Tạm dừng
	amberDark = rgb(199, 124, 14),
	danger = rgb(229, 72, 77),
	dangerDark = rgb(184, 42, 48),
	violet = rgb(124, 92, 255), -- nút bot xây mẫu, chỉ có trong Studio
	violetDark = rgb(93, 64, 214),

	good = rgb(26, 158, 85),
	warn = rgb(196, 120, 0),
	bad = rgb(224, 54, 74),
	info = rgb(46, 107, 255),
	stamp = rgb(229, 72, 77), -- ô "!" và viền phá sản (tên cũ)
	highlight = rgb(229, 237, 255), -- dòng "Bạn" trên bảng xếp hạng
	track = rgb(227, 232, 240),

	-- màu icon của từng chỉ số
	gold = rgb(245, 179, 1),
	goldSoft = rgb(255, 245, 214),
	people = rgb(124, 92, 255),
	peopleSoft = rgb(238, 234, 255),
	jobs = rgb(20, 160, 200),
	jobsSoft = rgb(223, 244, 250),
	mood = rgb(240, 80, 122),
	moodSoft = rgb(253, 231, 238),
}

Theme.Radius = { sm = 8, md = 12, lg = 16, xl = 20 }
Theme.PanelTransparency = 0
Theme.FrameThickness = 1.5 -- viền bóng quanh thẻ
Theme.LineThickness = 1

-- t < 1 thì pha với trắng (nhà trên sa bàn dùng màu nhạt)
function Theme.land(kind, t)
	local def = Config.BUILDINGS[kind]
	local c = def and rgb(def.color[1], def.color[2], def.color[3]) or Theme.Colors.textMuted
	if t and t < 1 then
		return Color3.new(1, 1, 1):Lerp(c, t)
	end
	return c
end

-- màu chữ đặt trên ô màu đất
function Theme.landInk(kind)
	local def = Config.BUILDINGS[kind]
	return (def and def.inkLight) and rgb(255, 255, 255) or Theme.Colors.text
end

-- dùng cho gờ nổi dưới nút
function Theme.darken(c, amount)
	return c:Lerp(Color3.new(0, 0, 0), amount or 0.22)
end

-- h: 0-100. dưới 50 là đỏ vì không ai chuyển đến nữa (docs/luat-choi-moi.md mục 4)
function Theme.happinessColor(h)
	if h >= 65 then
		return Theme.Colors.good
	elseif h >= 50 then
		return Theme.Colors.warn
	end
	return Theme.Colors.bad
end

Theme.StatusText = {
	ACTIVE = "Đang chạy",
	PAUSED = "Tạm dừng",
	ENDED = "Đã kết thúc",
	FAILED = "Phá sản",
}

-- chữ trên thanh điều khiển, viết kiểu câu như phần còn lại của UI
Theme.StatusTitle = {
	ACTIVE = "Đang chạy",
	PAUSED = "Tạm dừng",
	ENDED = "Đã kết thúc",
	FAILED = "Phá sản",
}

function Theme.statusColor(status)
	if status == "ACTIVE" then
		return Theme.Colors.good
	elseif status == "PAUSED" then
		return Theme.Colors.amber
	elseif status == "ENDED" then
		return Theme.Colors.info
	end
	return Theme.Colors.bad
end

return Theme
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterCharacterScripts" referent="RBX0000002A"><Properties><string name="Name">StarterCharacterScripts</string></Properties></Item></Item><Item class="StarterGui" referent="RBX0000002C"><Properties><string name="Name">StarterGui</string></Properties></Item></roblox>